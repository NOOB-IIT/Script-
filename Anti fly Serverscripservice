--------------------------------------------------------------------------------
-- MAIN ANTI-FLY HEURISTIC LOOP
--------------------------------------------------------------------------------
Players.PlayerRemoving:Connect(function(player)
	playerFlyBuffer[player] = nil
end)

while task.wait(0.25) do
	for _, player in ipairs(Players:GetPlayers()) do
		-- Owner & Whitelist Check
		if isWhitelisted(player) then continue end
		if player:GetAttribute("IsFlyPunished") then continue end

		local character = player.Character
		if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
			local humanoid = character.Humanoid
			local rootPart = character.HumanoidRootPart

			-- Innocent Exclusions: Swimming, Sitting, Climbing, Death, Ragdoll
			local state = humanoid:GetState()
			if humanoid.Health <= 0 
				or humanoid.Sit 
				or state == Enum.HumanoidStateType.Swimming 
				or state == Enum.HumanoidStateType.Climbing
				or state == Enum.HumanoidStateType.PlatformStanding then
				playerFlyBuffer[player] = 0
				continue
			end

			-- Raycast Check for Ground Detection
			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			raycastParams.FilterDescendantsInstances = {character}

			local rayDown = Workspace:Raycast(rootPart.Position, Vector3.new(0, -RAY_CAST_DEPTH, 0), raycastParams)

			if rayDown then
				-- Player is grounded
				playerFlyBuffer[player] = math.max(0, (playerFlyBuffer[player] or 0) - 0.5)
			else
				local velocityY = rootPart.AssemblyLinearVelocity.Y

				-- Natural Falling Check (Gravity velocity < -15)
				if velocityY < -15 and state == Enum.HumanoidStateType.Freefall then
					-- Legit Fall: Reset buffer
					playerFlyBuffer[player] = math.max(0, (playerFlyBuffer[player] or 0) - 0.5)
				else
					-- Suspicious airborne hovering or rapid climbing
					if velocityY > MAX_VERTICAL_SPEED then
						playerFlyBuffer[player] = (playerFlyBuffer[player] or 0) + 1.0
					else
						playerFlyBuffer[player] = (playerFlyBuffer[player] or 0) + 0.25
					end
				end

				-- Trigger Punishment sequence
				if (playerFlyBuffer[player] or 0) >= MAX_HOVER_TIME then
					task.spawn(function()
						executeScareSequence(player)
					end)
				end
			end
		end
	end
end
