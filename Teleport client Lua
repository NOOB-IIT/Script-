local dotsTask: thread? = nil
local function startDots()
	dotsTask = task.spawn(function()
		local dots = {"", ".", "..", "..."}
		local i = 1
		while true do
			loadingLabel.Text = "Teleporting" .. dots[i]
			i = (i % #dots) + 1
			task.wait(0.35)
		end
	end)
end
local function stopDots()
	if dotsTask then
		task.cancel(dotsTask)
		dotsTask = nil
	end
end

