local isOpen = false
local function setOpen(open: boolean)
	isOpen = open
	if open then
		listFrame.Visible = true
		listFrame.Size = UDim2.new(0, 440, 0, 0)
		TweenService:Create(listFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 440, 0, 400),
		}):Play()
	else
		local tween = TweenService:Create(listFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 440, 0, 0),
		})
		tween:Play()
		tween.Completed:Connect(function()
			if not isOpen then
				listFrame.Visible = false
			end
		end)
	end
end

