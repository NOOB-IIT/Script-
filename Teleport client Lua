local percentLabel = Instance.new("TextLabel")
percentLabel.Size = UDim2.new(0, 320, 0, 20)
percentLabel.AnchorPoint = Vector2.new(0.5, 0.5)
percentLabel.Position = UDim2.new(0.5, 0, 0.5, 34)
percentLabel.BackgroundTransparency = 1
percentLabel.TextColor3 = TEXT_GRAY
percentLabel.TextTransparency = 1
percentLabel.Font = Enum.Font.Gotham
percentLabel.TextSize = 14
percentLabel.Text = "0%"
percentLabel.Parent = fadeFrame

local progressThread: thread? = nil
local function startFakeProgress()
	if progressThread then task.cancel(progressThread) end
	progressThread = task.spawn(function()
		local progress = 0
		barFill.Size = UDim2.new(0, 0, 1, 0)
		while progress < 90 do
			progress += math.random(3, 8)
			progress = math.min(progress, 90)
			barFill.Size = UDim2.new(progress / 100, 0, 1, 0)
			percentLabel.Text = math.floor(progress) .. "%"
			task.wait(math.random(8, 16) / 100)
		end
	end)
end

local function finishProgress()
	if progressThread then
		task.cancel(progressThread)
		progressThread = nil
	end
	local tween = TweenService:Create(barFill, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 1, 0) })
	tween:Play()
	percentLabel.Text = "100%"
end

local function fadeOut()
	playSound(whooshSound)
	startDots()
	startFakeProgress()
	local t1 = TweenService:Create(fadeFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { BackgroundTransparency = 0 })
	local t2 = TweenService:Create(loadingLabel, TweenInfo.new(0.35), { TextTransparency = 0 })
	local t3 = TweenService:Create(barBack, TweenInfo.new(0.35), { BackgroundTransparency = 0 })
	local t4 = TweenService:Create(barFill, TweenInfo.new(0.35), { BackgroundTransparency = 0 })
	local t5 = TweenService:Create(percentLabel, TweenInfo.new(0.35), { TextTransparency = 0 })
	t1:Play(); t2:Play(); t3:Play(); t4:Play(); t5:Play()
	t1.Completed:Wait()
end

local function fadeIn()
	finishProgress()
	task.wait(0.15)
	stopDots()
	playSound(arriveSound)
	TweenService:Create(fadeFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(loadingLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
	TweenService:Create(barBack, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(barFill, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(percentLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
end

streamReadyEvent.OnClientEvent:Connect(fadeIn)

