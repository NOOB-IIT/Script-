-- ============ SOUND IDS - inhe apni pasand ki id se replace karo ============
local SOUND_IDS = {
	Click = "rbxassetid://0",
	Whoosh = "rbxassetid://0",
	Arrive = "rbxassetid://0",
}

local soundFolder = Instance.new("Folder")
soundFolder.Name = "TeleportSounds"
soundFolder.Parent = SoundService

local function makeSound(id: string, volume: number)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume
	s.Parent = soundFolder
	return s
end

local clickSound = makeSound(SOUND_IDS.Click, 0.5)
local whooshSound = makeSound(SOUND_IDS.Whoosh, 0.6)
local arriveSound = makeSound(SOUND_IDS.Arrive, 0.6)

local function playSound(s: Sound)
	if s.SoundId ~= "" and s.SoundId ~= "rbxassetid://0" then
		s:Play()
	end
end

-- ============ THEME ============
local ACCENT = Color3.fromRGB(88, 166, 255)
local BG_DARK = Color3.fromRGB(20, 20, 24)
local BG_CARD = Color3.fromRGB(32, 32, 38)
local BG_CARD_HOVER = Color3.fromRGB(44, 44, 52)
local TEXT_WHITE = Color3.fromRGB(255, 255, 255)
local TEXT_GRAY = Color3.fromRGB(160, 160, 170)

local function addCorner(inst: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = inst
	return c
end

local function addStroke(inst: Instance, color: Color3, thickness: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Parent = inst
	return s
end

local function addShadow(parent: GuiObject)
	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.Size = UDim2.new(1, 16, 1, 16)
	shadow.Position = UDim2.new(0, -8, 0, -4)
	shadow.BackgroundColor3 = Color3.new(0, 0, 0)
	shadow.BackgroundTransparency = 0.6
	shadow.ZIndex = parent.ZIndex - 1
	shadow.Parent = parent.Parent
	addCorner(shadow, 16)
	return shadow
end

