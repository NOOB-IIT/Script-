local locationButtons: {[string]: TextButton} = {}

local function populateLocations()
	local locations = getLocationsFunction:InvokeServer()
	for _, loc in ipairs(locations) do
		local btn = Instance.new("TextButton")
		btn.BackgroundColor3 = BG_CARD
		btn.AutoButtonColor = false
		btn.Text = ""
		btn.Parent = scrollFrame
		addCorner(btn, 12)
		local stroke = addStroke(btn, loc.IsCurrent and ACCENT or Color3.fromRGB(55, 55, 63), loc.IsCurrent and 2 or 1)

		local icon = Instance.new("ImageLabel")
		icon.Size = UDim2.new(1, -10, 0, 58)
		icon.Position = UDim2.new(0, 5, 0, 5)
		icon.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
		icon.Image = loc.Image or ""
		icon.ScaleType = Enum.ScaleType.Crop
		icon.Parent = btn
		addCorner(icon, 8)

		if loc.IsCurrent then
			local badge = Instance.new("TextLabel")
			badge.Size = UDim2.new(0, 20, 0, 20)
			badge.Position = UDim2.new(1, -26, 0, 10)
			badge.BackgroundColor3 = ACCENT
			badge.Text = "📍"
			badge.TextSize = 12
			badge.Parent = btn
			addCorner(badge, 10)
		end

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -6, 0, 18)
		label.Position = UDim2.new(0, 3, 0, 65)
		label.BackgroundTransparency = 1
		label.TextColor3 = TEXT_WHITE
		label.Font = Enum.Font.GothamBold
		label.TextSize = 12
		label.TextTruncate = Enum.TextTruncate.AtEnd
		label.Text = loc.Name
		label.Parent = btn

		if loc.Description and loc.Description ~= "" then
			local subLabel = Instance.new("TextLabel")
			subLabel.Size = UDim2.new(1, -6, 0, 14)
			subLabel.Position = UDim2.new(0, 3, 0, 82)
			subLabel.BackgroundTransparency = 1
			subLabel.TextColor3 = TEXT_GRAY
			subLabel.Font = Enum.Font.Gotham
			subLabel.TextSize = 10
			subLabel.TextTruncate = Enum.TextTruncate.AtEnd
			subLabel.Text = loc.Description
			subLabel.Parent = btn
		end

		btn.MouseEnter:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = BG_CARD_HOVER }):Play()
			TweenService:Create(stroke, TweenInfo.new(0.15), { Color = ACCENT }):Play()
		end)
		btn.MouseLeave:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = BG_CARD }):Play()
			TweenService:Create(stroke, TweenInfo.new(0.15), { Color = loc.IsCurrent and ACCENT or Color3.fromRGB(55, 55, 63) }):Play()
		end)

		btn.MouseButton1Click:Connect(function()
			if loc.IsCurrent then return end
			playSound(clickSound)
			setOpen(false)
			fadeOut()
			teleportRequestEvent:FireServer(loc.Name)
		end)

		locationButtons[loc.Name:lower()] = btn
	end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local query = searchBox.Text:lower()
	for name, btn in pairs(locationButtons) do
		btn.Visible = query == "" or name:find(query, 1, true) ~= nil
	end
end)

populateLocations()
