}

local function setCommon(part, name, parent, material, color)
    part.Name = name
    part.Material = material or MATERIAL.Body
    part.Color = color or C.BodySilver
    part.Anchored = true
    part.CanTouch = false
    part.CanQuery = false
    part.CanCollide = not CONFIG.MakeNonCollidable
    part.CastShadow = true
    part.Parent = parent or F.Shell
    return part
end

local function box(name, size, cframe, material, color, parent)
    local part = Instance.new("Part")
    part.Size = size
    part.CFrame = cframe
    return setCommon(part, name, parent, material, color)
end

local function boxAt(name, size, position, material, color, parent)
    return box(name, size, CFrame.new(position), material, color, parent)
end

local function cylinder(name, radius, height, cframe, material, color, parent, axis)
    local part = Instance.new("Part")
    part.Shape = Enum.PartType.Cylinder
    if axis == "X" then
        part.Size = Vector3.new(height, radius * 2, radius * 2)
        part.CFrame = cframe * CFrame.Angles(0, 0, math.rad(90))
    elseif axis == "Z" then
        part.Size = Vector3.new(radius * 2, radius * 2, height)
        part.CFrame = cframe * CFrame.Angles(math.rad(90), 0, 0)
    else
        part.Size = Vector3.new(radius * 2, height, radius * 2)
        part.CFrame = cframe
    end
    return setCommon(part, name, parent, material, color)
end

local function sphere(name, radius, cframe, material, color, parent)
    local part = Instance.new("Part")
    part.Shape = Enum.PartType.Ball
    part.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
    part.CFrame = cframe
    return setCommon(part, name, parent, material, color)
end

local function wedge(name, size, cframe, material, color, parent)
    local part = Instance.new("WedgePart")
    part.Size = size
    part.CFrame = cframe
    return setCommon(part, name, parent, material, color)
end

local function cornerWedge(name, size, cframe, material, color, parent)
    local part = Instance.new("CornerWedgePart")
    part.Size = size
    part.CFrame = cframe
    return setCommon(part, name, parent, material, color)
end

local function invisibleAnchor(name, position, parent)
    local part = boxAt(name, Vector3.new(0.12, 0.12, 0.12), position, MATERIAL.Plastic, C.Black, parent)
    part.Transparency = 1
    part.CanCollide = false
    part.CastShadow = false
    return part
end

local function setTransparency(part, transparency)
    part.Transparency = transparency
    return part
end

local function addAttribute(instance, name, value)
    instance:SetAttribute(name, value)
    return instance
end

local function addCylinderBand(name, position, radius, height, axis, material, color, parent)
    local item = cylinder(name, radius, height, CFrame.new(position), material, color, parent, axis)
    return item
end

local function addBolt(name, position, radius, color, parent)
    local bolt = cylinder(name, radius, metres(0.025), CFrame.new(position), MATERIAL.Iron, color or C.IronBright, parent, "Z")
    return bolt
end

local function addVerticalBolt(name, position, radius, color, parent)
    return cylinder(name, radius, metres(0.025), CFrame.new(position), MATERIAL.Iron, color or C.IronBright, parent, "Y")
end

local function addHorizontalRail(name, x, y, z, length, radius, color, parent)
    return cylinder(name, radius, length, CFrame.new(x, y, z), MATERIAL.Iron, color or C.IronBright, parent, "X")
end

local function addPipe(name, startPosition, endPosition, radius, color, parent)
    local startVector = Vector3.new(startPosition.X, startPosition.Y, startPosition.Z)
    local endVector = Vector3.new(endPosition.X, endPosition.Y, endPosition.Z)
    local delta = endVector - startVector
    local length = delta.Magnitude
    local midpoint = (startVector + endVector) / 2
    local pipe = cylinder(name, radius, length, CFrame.lookAt(midpoint, endVector), MATERIAL.Iron, color or C.BrakeRed, parent, "Y")
    return pipe
end

local function addTextSign(name, text, position, size, face, color, textColor, parent)
    local sign = boxAt(name, size, position, MATERIAL.Plastic, color or C.LabelBlue, parent or F.Labels)
    local gui = Instance.new("SurfaceGui")
    gui.Name = name .. "_SurfaceGui"
    gui.Face = face or Enum.NormalId.Front
    gui.AlwaysOnTop = false
    gui.LightInfluence = 0
    gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    gui.PixelsPerStud = 48
    gui.Parent = sign
    local label = Instance.new("TextLabel")
    label.Name = "Text"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = textColor or C.White
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.60
    label.Parent = gui
    return sign
end

local function addSurfaceText(part, text, face, textColor, font)
    local gui = Instance.new("SurfaceGui")
    gui.Name = "Printed_" .. text:gsub("%s", "_")
    gui.Face = face or Enum.NormalId.Front
    gui.AlwaysOnTop = false
    gui.LightInfluence = 0.2
    gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    gui.PixelsPerStud = 42
    gui.Parent = part
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = textColor or C.White
    label.TextScaled = true
    label.Font = font or Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.72
    label.Parent = gui
    return gui
end

local function addDecalPanel(name, position, size, text, parent, face)
    local panel = boxAt(name, size, position, MATERIAL.Plastic, C.LabelBlue, parent or F.Labels)
    addSurfaceText(panel, text, face or Enum.NormalId.Front, C.White, Enum.Font.GothamBold)
    return panel
end

local function registerMetadata(index, title, detail, category)
    if not CONFIG.AddTechnicalMetadata then
        return
    end
    local entry = Instance.new("StringValue")
    entry.Name = string.format("%03d_%s", index, title:gsub("[^%w_]", "_"))
    entry.Value = detail
    entry:SetAttribute("Category", category or "Geometry")
    entry.Parent = F.Metadata
end

local function tag(part, subsystem, description)
    part:SetAttribute("Subsystem", subsystem)
    part:SetAttribute("Description", description)
    return part
end

local function bodyPart(name, size, cframe, material, color)
    return tag(box(name, size, cframe, material, color, F.Shell), "Body shell", name)
end

local function liveryPart(name, size, cframe, color)
    return tag(box(name, size, cframe, MATERIAL.Plastic, color, F.Livery), "Livery", name)
end

local function hardwarePart(name, size, cframe, material, color, parent)
    return tag(box(name, size, cframe, material, color, parent or F.Hardware), "Hardware", name)
end

local function mirrorSide(side)
    return side == 1 and "Right" or "Left"
end

local function sideZ(side, inset)
    return side * (DIM.BodySide + (inset or 0))
end

local function faceForSide(side)
    return side == 1 and Enum.NormalId.Right or Enum.NormalId.Left
end

local function sideCFrame(side, x, y, extraRotation)
    local rotation = CFrame.Angles(0, side == 1 and 0 or math.pi, 0)
    if extraRotation then
        rotation = rotation * extraRotation
    end
    return CFrame.new(x, y, sideZ(side)) * rotation
end

local function sideBox(name, side, x, y, height, width, material, color, parent)
    local thickness = metres(0.055)
    local size = Vector3.new(width, height, thickness)
    return box(name .. "_" .. mirrorSide(side), size, sideCFrame(side, x, y), material, color, parent)
end

local function sidePlate(name, side, x, y, width, height, color, parent)
    local plate = sideBox(name, side, x, y, height, width, MATERIAL.Plastic, color, parent)
    plate:SetAttribute("Side", mirrorSide(side))
    return plate
end

local function sideCylinder(name, side, x, y, radius, length, color, parent)
    local cframe = CFrame.new(x, y, sideZ(side, metres(0.05))) * CFrame.Angles(0, math.pi / 2, 0)
    local item = cylinder(name .. "_" .. mirrorSide(side), radius, length, cframe, MATERIAL.Iron, color, parent, "Z")
    item:SetAttribute("Side", mirrorSide(side))
    return item
end

local function addRivetLine(prefix, side, x, y, count, spacing, parent)
    for index = 1, count do
        local offset = (index - (count + 1) / 2) * spacing
        addBolt(prefix .. "_" .. index .. "_" .. mirrorSide(side), Vector3.new(x + offset, y, sideZ(side, metres(0.06))), metres(0.018), C.IronBright, parent or F.Hardware)
    end
end

local function addPanelSeam(prefix, side, x, y, width, height, parent)
    local seam = sidePlate(prefix .. "_Seam", side, x, y, width, height, C.StainlessDark, parent or F.Hardware)
    seam.Transparency = 0.35
    return seam
end

local function addWindowFrame(prefix, side, x, y, width, height)
    local depth = metres(0.06)
    local z = sideZ(side, metres(0.08))
    local frameColor = C.StainlessDark
    local pane = box(prefix .. "_TintedGlass_" .. mirrorSide(side), Vector3.new(width, height, depth), CFrame.new(x, y, z), MATERIAL.Glass, C.WindowBlue, F.Windows)
    pane.Transparency = 0.18
    pane.Reflectance = 0.15
    pane:SetAttribute("WindowSide", mirrorSide(side))
    local top = sideBox(prefix .. "_TopFrame", side, x, y + height / 2 + metres(0.07), metres(0.13), width + metres(0.16), MATERIAL.Stainless, frameColor, F.Windows)
    local bottom = sideBox(prefix .. "_BottomFrame", side, x, y - height / 2 - metres(0.07), metres(0.13), width + metres(0.16), MATERIAL.Stainless, frameColor, F.Windows)
    local front = sideBox(prefix .. "_FrontFrame", side, x - width / 2 - metres(0.08), y, height, metres(0.13), MATERIAL.Stainless, frameColor, F.Windows)
    local rear = sideBox(prefix .. "_RearFrame", side, x + width / 2 + metres(0.08), y, height, metres(0.13), MATERIAL.Stainless, frameColor, F.Windows)
    top:SetAttribute("WindowPart", "Top")
    bottom:SetAttribute("WindowPart", "Bottom")
    front:SetAttribute("WindowPart", "Front")
    rear:SetAttribute("WindowPart", "Rear")
    local reflection = sidePlate(prefix .. "_Reflection", side, x - width * 0.22, y + height * 0.15, width * 0.10, height * 0.60, C.WindowReflection, F.Windows)
    reflection.Transparency = 0.45
    return pane
end

local function addWindowDivider(prefix, side, x, y, width, height, position)
    local dividerX = x + (position or 0) * width
    local divider = sideBox(prefix .. "_Divider", side, dividerX, y, height, metres(0.055), MATERIAL.Stainless, C.StainlessDark, F.Windows)
    divider.Transparency = 0.15
    return divider
end

local function addWindowVent(prefix, side, x, y, width)
    local vent = sidePlate(prefix .. "_Vent", side, x, y, width, metres(0.11), C.StainlessDark, F.Windows)
    vent.Transparency = 0.20
    for index = -2, 2 do
        local slit = sideBox(prefix .. "_VentSlot_" .. index, side, x + index * width / 5, y, metres(0.15), metres(0.025), MATERIAL.Plastic, C.Black, F.Windows)
        slit.Transparency = 0.05
    end
    return vent
end

local function addDoorFrame(prefix, side, x, y)
    local doorWidth = DIM.DoorWidth
    local doorHeight = DIM.DoorHeight
    local panel = sideBox(prefix .. "_DoorPanel", side, x, y, doorHeight, doorWidth, MATERIAL.Stainless, C.RailBlueDark, F.Doors)
    panel:SetAttribute("DoorState", "SealedStatic")
    local window = sidePlate(prefix .. "_DoorWindow", side, x, y + metres(0.33), doorWidth * 0.60, doorHeight * 0.38, C.WindowBlue, F.Doors)
    window.Material = MATERIAL.Glass
    window.Transparency = 0.10
    local upperFrame = sideBox(prefix .. "_UpperDoorFrame", side, x, y + metres(0.33) + doorHeight * 0.19, metres(0.10), doorWidth * 0.68, MATERIAL.Stainless, C.Stainless, F.Doors)
    local lowerFrame = sideBox(prefix .. "_LowerDoorFrame", side, x, y + metres(0.33) - doorHeight * 0.19, metres(0.10), doorWidth * 0.68, MATERIAL.Stainless, C.Stainless, F.Doors)
    local handle = sideCylinder(prefix .. "_DoorHandle", side, x + doorWidth * 0.28, y - metres(0.05), metres(0.035), metres(0.22), C.SafetyYellow, F.Doors)
    handle.CFrame = handle.CFrame * CFrame.Angles(math.pi / 2, 0, 0)
    local hingeTop = sideCylinder(prefix .. "_TopHinge", side, x - doorWidth / 2 - metres(0.07), y + doorHeight * 0.33, metres(0.045), metres(0.12), C.IronBright, F.Doors)
    local hingeBottom = sideCylinder(prefix .. "_BottomHinge", side, x - doorWidth / 2 - metres(0.07), y - doorHeight * 0.33, metres(0.045), metres(0.12), C.IronBright, F.Doors)
    hingeTop.CFrame = hingeTop.CFrame * CFrame.Angles(math.pi / 2, 0, 0)
    hingeBottom.CFrame = hingeBottom.CFrame * CFrame.Angles(math.pi / 2, 0, 0)
    return panel
end

local function addStepAssembly(prefix, side, x)
    local z = sideZ(side, metres(0.17))
    local step1 = box(prefix .. "_Step_Lower_" .. mirrorSide(side), Vector3.new(metres(1.00), metres(0.12), metres(0.46)), CFrame.new(x, metres(0.38), z), MATERIAL.Stainless, C.StainlessDark, F.Doors)
    local step2 = box(prefix .. "_Step_Upper_" .. mirrorSide(side), Vector3.new(metres(0.82), metres(0.12), metres(0.30)), CFrame.new(x, metres(0.68), z), MATERIAL.Stainless, C.Stainless, F.Doors)
    local supportFront = box(prefix .. "_StepSupport_Front_" .. mirrorSide(side), Vector3.new(metres(0.10), metres(0.50), metres(0.10)), CFrame.new(x - metres(0.36), metres(0.48), z), MATERIAL.Iron, C.Iron, F.Doors)
    local supportRear = box(prefix .. "_StepSupport_Rear_" .. mirrorSide(side), Vector3.new(metres(0.10), metres(0.50), metres(0.10)), CFrame.new(x + metres(0.36), metres(0.48), z), MATERIAL.Iron, C.Iron, F.Doors)
    return step1, step2, supportFront, supportRear
end

local function addDoorWarning(prefix, side, x)
    local sign = sidePlate(prefix .. "_Warning", side, x, metres(2.08), metres(0.42), metres(0.18), C.SafetyYellow, F.Livery)
    addSurfaceText(sign, "CAUTION", faceForSide(side), C.Black, Enum.Font.GothamBold)
    return sign
end

local function addRoofGrille(prefix, position, width, depth)
    local grille = boxAt(prefix .. "_Grille", Vector3.new(width, metres(0.05), depth), position, MATERIAL.Stainless, C.StainlessDark, F.Roof)
    for index = -4, 4 do
        local slot = boxAt(prefix .. "_Slot_" .. index, Vector3.new(metres(0.04), metres(0.07), depth * 0.78), position + Vector3.new(index * width / 9, metres(0.05), 0), MATERIAL.Plastic, C.Black, F.Roof)
        slot.Transparency = 0.04
    end
    return grille
end

local function addRoofAC(prefix, x)
    local y = Y.RoofTop + metres(0.16)
    local body = boxAt(prefix .. "_ACBody", Vector3.new(metres(4.12), metres(0.36), metres(1.82)), Vector3.new(x, y, 0), MATERIAL.Stainless, C.RoofSilver, F.Roof)
    body:SetAttribute("Equipment", "Rooftop packaged AC unit")
    local front = boxAt(prefix .. "_FrontCap", Vector3.new(metres(0.20), metres(0.30), metres(1.92)), Vector3.new(x - metres(1.96), y, 0), MATERIAL.Plastic, C.RoofDark, F.Roof)
    local rear = boxAt(prefix .. "_RearCap", Vector3.new(metres(0.20), metres(0.30), metres(1.92)), Vector3.new(x + metres(1.96), y, 0), MATERIAL.Plastic, C.RoofDark, F.Roof)
    addRoofGrille(prefix .. "_LeftGrille", Vector3.new(x, y + metres(0.21), -metres(0.54)), metres(3.10), metres(0.36))
    addRoofGrille(prefix .. "_RightGrille", Vector3.new(x, y + metres(0.21), metres(0.54)), metres(3.10), metres(0.36))
    for side = -1, 1, 2 do
        local fan = cylinder(prefix .. "_FanMotor_" .. side, metres(0.16), metres(0.12), CFrame.new(x + side * metres(0.86), y + metres(0.25), 0), MATERIAL.Iron, C.IronBright, F.Roof, "Y")
        local cap = sphere(prefix .. "_FanCap_" .. side, metres(0.11), CFrame.new(x + side * metres(0.86), y + metres(0.35), 0), MATERIAL.Plastic, C.RoofDark, F.Roof)
        cap:SetAttribute("Equipment", "AC condenser fan cover")
        fan:SetAttribute("Equipment", "AC fan motor")
    end
    for side = -1, 1, 2 do
        hardwarePart(prefix .. "_Mount_" .. side, Vector3.new(metres(0.16), metres(0.18), metres(1.35)), CFrame.new(x + side * metres(1.55), Y.RoofTop, 0), MATERIAL.Iron, C.Iron, F.Roof)
    end
    return body
end

local function addRoofCableTray(x, z, length)
    local tray = boxAt("Roof_CableTray_" .. x .. "_" .. z, Vector3.new(length, metres(0.09), metres(0.15)), Vector3.new(x, Y.RoofTop + metres(0.10), z), MATERIAL.Stainless, C.StainlessDark, F.Roof)
    for index = -5, 5 do
        addVerticalBolt("RoofTray_Bolt_" .. x .. "_" .. z .. "_" .. index, Vector3.new(x + index * length / 12, Y.RoofTop + metres(0.16), z), metres(0.018), C.IronBright, F.Hardware)
    end
    return tray
