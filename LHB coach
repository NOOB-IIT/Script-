local function addBogie(prefix, centerX)
    local parent = F.Bogies
    local frameY = Y.Bogie
    local sideDistance = metres(1.22)
    local wheelGauge = metres(1.52)
    local frame = boxAt(prefix .. "_MainFrame", Vector3.new(metres(4.60), metres(0.32), metres(2.40)), Vector3.new(centerX, frameY, 0), MATERIAL.Iron, C.Iron, parent)
    local leftBeam = boxAt(prefix .. "_LeftSideBeam", Vector3.new(metres(4.72), metres(0.43), metres(0.25)), Vector3.new(centerX, frameY, -sideDistance), MATERIAL.Iron, C.IronBright, parent)
    local rightBeam = boxAt(prefix .. "_RightSideBeam", Vector3.new(metres(4.72), metres(0.43), metres(0.25)), Vector3.new(centerX, frameY, sideDistance), MATERIAL.Iron, C.IronBright, parent)
    local bolster = boxAt(prefix .. "_Bolster", Vector3.new(metres(1.24), metres(0.44), metres(2.65)), Vector3.new(centerX, frameY + metres(0.16), 0), MATERIAL.Iron, C.IronBright, parent)
    local centrePlate = cylinder(prefix .. "_CentrePlate", metres(0.45), metres(0.20), CFrame.new(centerX, frameY + metres(0.44), 0), MATERIAL.Iron, C.StainlessDark, parent, "Y")
    local pivot = cylinder(prefix .. "_Pivot", metres(0.17), metres(0.65), CFrame.new(centerX, frameY + metres(0.65), 0), MATERIAL.Iron, C.Iron, parent, "Y")
    frame:SetAttribute("Equipment", "LHB FIAT bogie main frame")
    leftBeam:SetAttribute("Equipment", "Left bogie side beam")
    rightBeam:SetAttribute("Equipment", "Right bogie side beam")
    for axleIndex, axleOffset in ipairs({ -DIM.BogieWheelOffset, DIM.BogieWheelOffset }) do
        local axleX = centerX + axleOffset
        local axle = cylinder(prefix .. "_Axle_" .. axleIndex, metres(0.10), wheelGauge * 2.0, CFrame.new(axleX, Y.WheelCentre, 0), MATERIAL.Iron, C.IronBright, parent, "Z")
        axle:SetAttribute("Equipment", "Wheelset axle")
        for side = -1, 1, 2 do
            local z = side * wheelGauge
            local wheel = cylinder(prefix .. "_Wheel_" .. axleIndex .. "_" .. side, DIM.WheelRadius, DIM.WheelWidth, CFrame.new(axleX, Y.WheelCentre, z), MATERIAL.Rubber, C.Rubber, parent, "Z")
            wheel:SetAttribute("Equipment", "Steel wheel tyre")
            local hub = cylinder(prefix .. "_Hub_" .. axleIndex .. "_" .. side, metres(0.17), metres(0.27), CFrame.new(axleX, Y.WheelCentre, z + side * metres(0.13)), MATERIAL.Iron, C.IronBright, parent, "Z")
            local cap = cylinder(prefix .. "_HubCap_" .. axleIndex .. "_" .. side, metres(0.10), metres(0.30), CFrame.new(axleX, Y.WheelCentre, z + side * metres(0.28)), MATERIAL.Iron, C.StainlessDark, parent, "Z")
            for spoke = 1, 8 do
                local angle = (spoke / 8) * math.pi * 2
                local spokeX = axleX + math.cos(angle) * metres(0.28)
                local spokeY = Y.WheelCentre + math.sin(angle) * metres(0.28)
                boxAt(prefix .. "_WheelSpoke_" .. axleIndex .. "_" .. side .. "_" .. spoke, Vector3.new(metres(0.07), metres(0.48), metres(0.06)), Vector3.new(spokeX, spokeY, z + side * metres(0.19)), MATERIAL.Iron, C.IronBright, parent)
            end
        end
    end
    for side = -1, 1, 2 do
        local z = side * sideDistance
        for axleIndex, axleOffset in ipairs({ -DIM.BogieWheelOffset, DIM.BogieWheelOffset }) do
            local axleX = centerX + axleOffset
            local spring = cylinder(prefix .. "_Spring_" .. axleIndex .. "_" .. side, metres(0.18), metres(0.65), CFrame.new(axleX, metres(1.31), z), MATERIAL.Iron, C.IronBright, parent, "Y")
            local springTop = cylinder(prefix .. "_SpringTop_" .. axleIndex .. "_" .. side, metres(0.24), metres(0.10), CFrame.new(axleX, metres(1.66), z), MATERIAL.Iron, C.Iron, parent, "Y")
            local springBottom = cylinder(prefix .. "_SpringBottom_" .. axleIndex .. "_" .. side, metres(0.24), metres(0.10), CFrame.new(axleX, metres(0.97), z), MATERIAL.Iron, C.Iron, parent, "Y")
            spring:SetAttribute("Equipment", "Primary suspension spring")
            springTop:SetAttribute("Equipment", "Primary suspension spring seat")
            springBottom:SetAttribute("Equipment", "Primary suspension spring seat")
        end
        local brakeBeam = boxAt(prefix .. "_BrakeBeam_" .. side, Vector3.new(metres(4.20), metres(0.15), metres(0.12)), Vector3.new(centerX, metres(0.91), z), MATERIAL.Iron, C.Iron, parent)
        brakeBeam:SetAttribute("Equipment", "Bogie brake beam")
    end
    for side = -1, 1, 2 do
        local z = side * sideDistance
        local damper = addPipe(prefix .. "_Damper_" .. side, Vector3.new(centerX - metres(0.95), metres(1.02), z), Vector3.new(centerX + metres(0.95), metres(1.64), z), metres(0.07), C.IronBright, parent)
        damper:SetAttribute("Equipment", "Secondary suspension damper")
        local brakeCylinder = cylinder(prefix .. "_BogieBrake_" .. side, metres(0.17), metres(0.76), CFrame.new(centerX, metres(0.95), z * 0.88), MATERIAL.Iron, C.IronBright, parent, "X")
        brakeCylinder:SetAttribute("Equipment", "Bogie brake actuator")
    end
    return frame
end

