local function generateQuizAPI(topic, difficultyName, onSuccess, onError)
    task.spawn(function()
        local sysPrompt = "You are a quiz generator. Always reply with valid JSON only. No markdown, no explanation, no extra text."
        local diffDesc = difficultyName
        local diffExtra = ""
        if diffDesc == "Easy" then diffExtra = "Simple, general knowledge, easy for anyone."
        elseif diffDesc == "Medium" then diffExtra = "Some thinking, moderate difficulty, common specific facts."
        elseif diffDesc == "Hard" then diffExtra = "Challenging, requiring solid topic knowledge."
        elseif diffDesc == "Very Hard" then diffExtra = "Very difficult, deep knowledge, niche details."
        elseif diffDesc == "Extreme" then diffExtra = "Extremely difficult, expert-level, obscure facts."
        elseif diffDesc == "Deadly" then diffExtra = "BRUTALLY hard, borderline impossible, PhD-grade knowledge, confusing close options." end
        local userPrompt = string.format([[
Generate exactly 10 %s multiple-choice questions about: "%s"
Difficulty: %s — %s

Return ONLY valid JSON:
{
  "questions": [
    {"question":"Question?","options":["optA","optB","optC","optD"],"correctText":"optA","wordAnswer":"WORD"}
  ]
}
Rules:
- Exactly 10 questions
- Each has exactly 4 options
- correctText exactly matches one of 4 options
- wordAnswer = single UPPERCASE word (no spaces)
- Match requested difficulty (%s)
- Topic: %s
]], diffDesc, topic, diffDesc, diffExtra, diffDesc, topic)
        local msgs = { { role = "system", content = sysPrompt }, { role = "user", content = userPrompt } }
        local body = HttpService:JSONEncode({ model = State.currentModel.id, messages = msgs, temperature = 0.8, max_tokens = State.currentModel.maxTokens })
        local success, response = pcall(function()
            return HttpService:RequestAsync({
                Url = CONFIG.ApiEndpoint, Method = "POST",
                Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. State.apiKey },
                Body = body,
            })
        end)
        if not (success and response and response.Success) then
            if onError then onError("Request failed") end
            return
        end
        local ok, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if not (ok and decoded and decoded.choices and decoded.choices[1]) then
            if onError then onError("Bad response") end
            return
        end
        local raw = decoded.choices[1].message.content
        raw = string.gsub(raw, "```json", "")
        raw = string.gsub(raw, "```", "")
        raw = string.match(raw, "%b{}") or raw
        local ok2, parsed = pcall(function() return HttpService:JSONDecode(raw) end)
        if not (ok2 and parsed and parsed.questions and #parsed.questions > 0) then
            if onError then onError("Failed to parse") end
            return
        end
        local qs = {}
        for i = 1, math.min(10, #parsed.questions) do
            local q = parsed.questions[i]
            if q.question and q.options and #q.options >= 4 and q.correctText and q.wordAnswer then
                table.insert(qs, {
                    question = tostring(q.question),
                    options = { tostring(q.options[1]), tostring(q.options[2]), tostring(q.options[3]), tostring(q.options[4]) },
                    correctText = tostring(q.correctText),
                    wordAnswer = string.upper(string.gsub(tostring(q.wordAnswer), "%s+", "")),
                })
            end
        end
        if #qs == 0 then if onError then onError("No valid questions") end return end
        if onSuccess then onSuccess(qs) end
    end)
end

