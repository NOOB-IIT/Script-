local BotState = {
    active = false,
    phase = "idle", -- idle, topic_poll, confirm_topic, difficulty_poll, generating, running_quiz
    topicVotes = {},      -- [userId] = {name, topic}
    difficultyVotes = {}, -- [userId] = {name, diff}
    confirmVotes = {},    -- [userId] = "yes"/"no"
    bannedPlayers = {},   -- [UPPER_NAME] = true
    stopVotes = {},       -- [userId] = true
    banVotes = {},        -- [UPPER_TARGET] = {[userId]=true}
    usedTopics = {},      -- [topic] = true
    currentTopic = "",
    currentDifficulty = "",
    chatConn = nil,
    sessionId = 0,
    quizRunning = false,
    pollTick = 0,
    botPanelRefs = {},
}

local function botChat(msg) sendChat(msg) end

local function botSafeDisconnect()
    if BotState.chatConn then
        pcall(function() BotState.chatConn:Disconnect() end)
        BotState.chatConn = nil
    end
end

local function botRefreshPanel()
    for i = 1, #BotState.botPanelRefs do
        local r = BotState.botPanelRefs[i]
        if r and r.update then pcall(r.update) end
    end
end

local function botPickTopicFromList(excludeTopic)
    local avail = {}
    for _, t in ipairs(FALLBACK_TOPICS) do
        if not BotState.usedTopics[t] and t ~= excludeTopic then
            table.insert(avail, t)
        end
    end
    if #avail == 0 then
        BotState.usedTopics = {}
        avail = FALLBACK_TOPICS
    end
    return avail[math.random(1, #avail)]
end

local function botTopTopics()
    local counts = {}
    for _, v in pairs(BotState.topicVotes) do
        local t = v.topic
        if not counts[t] then counts[t] = { count = 0, name = t } end
        counts[t].count = counts[t].count + 1
    end
    local arr = {}
    for _, c in pairs(counts) do table.insert(arr, c) end
    table.sort(arr, function(a, b) return a.count > b.count end)
    return arr
end

local function botTopDifficulty()
    local counts = {}
    for _, v in pairs(BotState.difficultyVotes) do
        local d = v.diff
        if not counts[d] then counts[d] = { count = 0, name = d } end
        counts[d].count = counts[d].count + 1
    end
    local arr = {}
    for _, c in pairs(counts) do table.insert(arr, c) end
    table.sort(arr, function(a, b) return a.count > b.count end)
    if #arr > 0 then return arr[1].name end
    return nil
end

local function botStopQuizOnly()
    local g = getG()
    pcall(function() if g.REDHUB_QUIZ_STOP then g.REDHUB_QUIZ_STOP() end end)
    BotState.quizRunning = false
end

local function botOnChat(player, message)
    if not BotState.active then return end
    if State.killed then return end
    local pn = string.upper(player.Name)
    if BotState.bannedPlayers[pn] then return end

    local rawTrimmed = string.match(message, "^%s*(.-)%s*$")
    local upperMsg = string.upper(rawTrimmed)

    -- === /ban detection (any phase) ===
    local banTarget = string.match(rawTrimmed, "^[Bb][Aa][Nn]%s+(.+)$")
    if not banTarget then banTarget = string.match(rawTrimmed, "^/[Bb][Aa][Nn]%s+(.+)$") end
    if banTarget then
        banTarget = string.gsub(banTarget, "^%s*(.-)%s*$", "%1")
        local tu = string.upper(banTarget)
        if tu ~= "" and tu ~= pn then
            if not BotState.banVotes[tu] then BotState.banVotes[tu] = {} end
            if not BotState.banVotes[tu][player.UserId] then
                BotState.banVotes[tu][player.UserId] = true
                local cnt = 0
                for _ in pairs(BotState.banVotes[tu]) do cnt = cnt + 1 end
                botChat("🚫 Ban vote on '" .. banTarget .. "': " .. cnt .. "/5")
                if cnt >= 5 then
                    BotState.bannedPlayers[tu] = true
                    botChat("⛔ '" .. banTarget .. "' has been BANNED from this quiz! (votes: 5)")
                    local g = getG()
                    pcall(function() if g.REDHUB_QUIZ_BAN then g.REDHUB_QUIZ_BAN(banTarget) end end)
                end
            end
        end
        return
    end

    -- === Stop (only during quiz running) ===
    if BotState.quizRunning and (upperMsg == "STOP" or upperMsg == "!STOP") then
        if not BotState.stopVotes[player.UserId] then
            BotState.stopVotes[player.UserId] = true
            local cnt = 0
            for _ in pairs(BotState.stopVotes) do cnt = cnt + 1 end
            botChat("🛑 Stop vote from " .. player.DisplayName .. ": " .. cnt .. "/5")
            if cnt >= 5 then
                botChat("🔴 5 STOP votes reached! Aborting quiz & restarting poll...")
                BotState.stopVotes = {}
                botStopQuizOnly()
                BotState.phase = "idle"
                task.wait(2)
                task.spawn(function() if BotState.active then BotState.startTopicPoll() end end)
            end
        end
        return
    end

    -- === Topic Poll ===
    if BotState.phase == "topic_poll" then
        if BotState.topicVotes[player.UserId] then return end -- 1 topic per player
        if #rawTrimmed >= 2 and #rawTrimmed <= 40 and not string.find(rawTrimmed, "/") then
            -- only accept if it looks like a topic (no command-like)
            BotState.topicVotes[player.UserId] = { name = player.DisplayName, topic = rawTrimmed }
            botChat("✅ " .. player.DisplayName .. " voted: \"" .. rawTrimmed .. "\"")
            botRefreshPanel()
        end
        return
    end

    -- === Confirmation (YES/NO) ===
    if BotState.phase == "confirm_topic" then
        if upperMsg == "YES" or upperMsg == "Y" or upperMsg == "HAAN" or upperMsg == "HA" then
            if not BotState.confirmVotes[player.UserId] then
                BotState.confirmVotes[player.UserId] = "yes"
                botChat("👍 " .. player.DisplayName .. " → YES")
            end
        elseif upperMsg == "NO" or upperMsg == "N" or upperMsg == "NAHI" then
            if not BotState.confirmVotes[player.UserId] then
                BotState.confirmVotes[player.UserId] = "no"
                botChat("👎 " .. player.DisplayName .. " → NO")
            end
        end
        return
    end

    -- === Difficulty Poll ===
    if BotState.phase == "difficulty_poll" then
        if BotState.difficultyVotes[player.UserId] then return end
        for _, d in ipairs(DIFFICULTIES) do
            local dn = string.upper(d.name)
            local ds = string.upper(d.short)
            if upperMsg == dn or upperMsg == ds or upperMsg == string.gsub(dn, "%s", "") then
                BotState.difficultyVotes[player.UserId] = { name = player.DisplayName, diff = d.name }
                botChat("🎯 " .. player.DisplayName .. " voted: " .. d.name)
                botRefreshPanel()
                return
            end
        end
        return
    end
end

local function botAttachListener()
    botSafeDisconnect()
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        BotState.chatConn = TextChatService.MessageReceived:Connect(function(t)
            if t.TextSource then
                local p = Players:GetPlayerByUserId(t.TextSource.UserId)
                if p then botOnChat(p, t.Text) end
            end
        end)
    else
        BotState.chatConn = Players.PlayerAdded:Connect(function(p) p.Chatted:Connect(function(m) botOnChat(p, m) end) end)
    end
end

-- ===== BOT FLOW =====
function BotState.startTopicPoll()
    if not BotState.active or State.killed then return end
    BotState.sessionId = BotState.sessionId + 1
    local session = BotState.sessionId
    BotState.phase = "topic_poll"
    BotState.topicVotes = {}
    BotState.confirmVotes = {}
    BotState.difficultyVotes = {}
    BotState.stopVotes = {}
    BotState.banVotes = {}
    botRefreshPanel()

    botChat("━━━━━━━━━━━━━━━━━━━━━━━━━━")
    botChat("🤖 RED HUB BOT is live!")
    botChat("📢 TOPIC POLL — 60 seconds!")
    botChat("💬 Type a topic name in chat (one topic per player)")
    botChat("🚫 5x '/ban name' to ban a user")
    botChat("━━━━━━━━━━━━━━━━━━━━━━━━━━")

    local function stillActive() return BotState.active and BotState.sessionId == session and not State.killed and BotState.phase == "topic_poll" end

    task.spawn(function()
        for i = 1, 6 do
            task.wait(10)
            if not stillActive() then return end
            local votes = 0
            for _ in pairs(BotState.topicVotes) do votes = votes + 1 end
            local remain = 60 - i * 10
            botChat("⏱️ " .. remain .. "s left — " .. votes .. " vote(s) so far... ⏳")
            botRefreshPanel()
        end
        task.wait(0.2)
        if not stillActive() then return end
        BotState.endTopicPoll()
    end)
end

function BotState.endTopicPoll()
    if not BotState.active or State.killed then return end
    BotState.phase = "idle"
    local top = botTopTopics()
    if #top == 0 then
        -- No votes → AI picks topic
        botChat("😴 No one voted! AI will pick a favourite topic...")
        task.wait(2)
        local picked = botPickTopicFromList()
        BotState.currentTopic = picked
        BotState.usedTopics[picked] = true
        botChat("🤖 AI picked: \"" .. picked .. "\"")
        task.wait(1)
        BotState.startConfirmTopic()
    else
        -- Announce top 3
        botChat("🏆 TOPIC POLL RESULTS:")
        for i = 1, math.min(3, #top) do
            local medal = (i == 1 and "🥇" or i == 2 and "🥈" or "🥉")
            botChat(medal .. " " .. top[i].name .. " — " .. top[i].count .. " vote(s)")
            task.wait(1.2)
        end
        task.wait(1)
        BotState.currentTopic = top[1].name
        BotState.usedTopics[top[1].name] = true
        botChat("🎬 Locked in: \"" .. BotState.currentTopic .. "\"")
        task.wait(2)
        BotState.startDifficultyPoll()
    end
end

function BotState.startConfirmTopic()
    if not BotState.active or State.killed then return end
    BotState.phase = "confirm_topic"
    BotState.confirmVotes = {}
    botRefreshPanel()
    local session = BotState.sessionId
    local function stillActive() return BotState.active and BotState.sessionId == session and BotState.phase == "confirm_topic" and not State.killed end
    botChat("❓ Are you all satisfied with topic: \"" .. BotState.currentTopic .. "\"?")
    botChat("👍 Type YES to accept, 👎 type NO to change")
    botChat("⚠️ Need 2+ NO to change topic. No votes = proceed.")
    task.wait(15)
    if not stillActive() then return end
    local yesCnt, noCnt = 0, 0
    for _, v in pairs(BotState.confirmVotes) do
        if v == "yes" then yesCnt = yesCnt + 1 else noCnt = noCnt + 1 end
    end
    botChat("📊 Confirmation: " .. yesCnt .. " YES · " .. noCnt .. " NO")
    if noCnt >= 2 then
        botChat("🔄 2+ NO votes — changing topic...")
        task.wait(2)
        local newTopic = botPickTopicFromList(BotState.currentTopic)
        BotState.currentTopic = newTopic
        BotState.usedTopics[newTopic] = true
        botChat("🤖 New AI topic: \"" .. newTopic .. "\"")
        task.wait(2)
        BotState.startDifficultyPoll()
    else
        botChat("✅ Topic accepted! Moving to difficulty...")
        task.wait(2)
        BotState.startDifficultyPoll()
    end
end

function BotState.startDifficultyPoll()
    if not BotState.active or State.killed then return end
    BotState.phase = "difficulty_poll"
    BotState.difficultyVotes = {}
    botRefreshPanel()
    local session = BotState.sessionId
    local function stillActive() return BotState.active and BotState.sessionId == session and BotState.phase == "difficulty_poll" and not State.killed end
    botChat("━━━━━━━━━━━━━━━━━━━━━━━━━━")
    botChat("🎯 DIFFICULTY POLL — 20 seconds!")
    botChat("💬 Type one of: Easy · Medium · Hard · Very Hard · Extreme · Deadly")
    botChat("━━━━━━━━━━━━━━━━━━━━━━━━━━")
    task.spawn(function()
        task.wait(10)
        if not stillActive() then return end
        local votes = 0
        for _ in pairs(BotState.difficultyVotes) do votes = votes + 1 end
        botChat("⏱️ 10s left — " .. votes .. " difficulty vote(s)...")
        task.wait(10)
        if not stillActive() then return end
        BotState.endDifficultyPoll()
    end)
end

function BotState.endDifficultyPoll()
    if not BotState.active or State.killed then return end
    BotState.phase = "generating"
    botRefreshPanel()
    local topDiff = botTopDifficulty()
    if topDiff then
        BotState.currentDifficulty = topDiff
        botChat("🏆 Difficulty locked: " .. topDiff)
    else
        BotState.currentDifficulty = "Hard"
        botChat("😴 No difficulty votes → defaulting to Hard")
    end
    task.wait(2)
    if not BotState.active or State.killed then return end
    -- Set state for consistency
    for i = 1, #DIFFICULTIES do
        if DIFFICULTIES[i].name == BotState.currentDifficulty then
            State.currentDiff = DIFFICULTIES[i]
            break
        end
    end
    State.currentTopic = BotState.currentTopic
    botChat("🎬 Generating " .. BotState.currentDifficulty .. " quiz about \"" .. BotState.currentTopic .. "\"...")
    botChat("⏳ AI is cooking... (please wait ~10-20s)")
    generateQuizAPI(BotState.currentTopic, BotState.currentDifficulty, function(qs)
        if not BotState.active or State.killed then return end
        State.generatedQuestions = qs
        State.quizLocked = true
        botChat("✅ " .. #qs .. " questions generated! Starting quiz in chat...")
        task.wait(3)
        if not BotState.active or State.killed then return end
        local s = buildScript(BotState.currentTopic, BotState.currentDifficulty, qs)
        local loader = loadstring or load
        local fn, err = loader(s)
        if not fn then
            botChat("❌ Load error: " .. tostring(err))
            BotState.phase = "idle"
            botRefreshPanel()
            return
        end
        BotState.phase = "running_quiz"
        BotState.quizRunning = true
        botRefreshPanel()
        task.spawn(function()
            local ok, e = pcall(fn)
            if not ok then warn("[RedHub Bot Quiz] Runtime: " .. tostring(e)) end
            BotState.quizRunning = false
            if BotState.phase == "running_quiz" then
                BotState.phase = "idle"
                botRefreshPanel()
            end
        end)
    end, function(err)
        botChat("❌ Generation failed: " .. tostring(err) .. " — try again.")
        BotState.phase = "idle"
        botRefreshPanel()
    end)
end

function BotState.start()
    if State.killed then return end
    if not State.apiKey or #State.apiKey < 10 then
        botChat("⚠ Bot needs API key! Set it in main window first.")
        return
    end
    BotState.active = true
    BotState.usedTopics = {}
    BotState.bannedPlayers = {}
    botAttachListener()
    botRefreshPanel()
    botChat("⏳ Bot starting in 2 seconds...")
    task.wait(2)
    if not BotState.active then return end
    BotState.startTopicPoll()
end

function BotState.stop()
    if not BotState.active then return end
    BotState.active = false
    botStopQuizOnly()
    botSafeDisconnect()
    BotState.phase = "idle"
    BotState.topicVotes = {}
    BotState.difficultyVotes = {}
    BotState.confirmVotes = {}
    BotState.stopVotes = {}
    BotState.banVotes = {}
    botRefreshPanel()
    botChat("🛑 Bot STOPPED by host.")
end

