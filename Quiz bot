            new("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = "Q" .. i .. ". " .. q.question, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Color3.fromRGB(240,240,250), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 1, ZIndex = 54, Parent = qCard })
            local optsText = " "
            for j = 1, #q.options do local letter = string.sub("ABCD", j, j) optsText = optsText .. letter .. ") " .. q.options[j] if j < #q.options then optsText = optsText .. " " end end
            new("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = optsText, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = Color3.fromRGB(180,180,210), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, ZIndex = 54, Parent = qCard })
            new("TextLabel", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = "✔ Answer: " .. q.correctText .. " • Word: " .. q.wordAnswer, Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = State.currentTheme.accent, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 3, ZIndex = 54, Parent = qCard })
            table.insert(questionCards, qCard)
        end
        task.defer(function() preview.CanvasSize = UDim2.new(0, 0, 0, previewLayout.AbsoluteContentSize.Y + 20) end)
    end

    -- Action row (5 buttons) above bot row
    local actionRow = new("Frame", { Size = UDim2.new(1, -24, 0, actionRowH), Position = UDim2.new(0, 12, 1, -(botRowH + botRowGap + actionRowH + bottomPad)), BackgroundTransparency = 1, ZIndex = 52, Parent = win })
    local btnDefs = {
        { name="▶ Run", color=Color3.fromRGB(52,211,153), action="run" },
        { name="📋 Copy", color=Color3.fromRGB(96,165,250), action="copy" },
        { name="🛑 Stop", color=Color3.fromRGB(251,191,36), action="stop" },
        { name="🚫 Ban", color=Color3.fromRGB(248,113,113), action="ban" },
        { name="↩ Back", color=Color3.fromRGB(130,130,160), action="back" },
    }
    local gap = 4
    local btnW = math.floor((winW - 24 - gap * 4) / 5)
    for i, bd in ipairs(btnDefs) do
        local btn = new("TextButton", { Size = UDim2.fromOffset(btnW, actionRowH - 6), Position = UDim2.fromOffset((i - 1) * (btnW + gap), 3), BackgroundColor3 = bd.color, BorderSizePixel = 0, Text = bd.name, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = Color3.fromRGB(255,255,255), AutoButtonColor = false, ZIndex = 53, Parent = actionRow })
        corner(btn, 8)
        btn.MouseButton1Click:Connect(function()
            if bd.action == "run" then
                if #State.generatedQuestions == 0 then statusLabel.Text = "⚠ Generate a quiz first" statusLabel.TextColor3 = Color3.fromRGB(251,191,36) statusLabel.Visible = true return end
                local s = buildScript(State.currentTopic, State.currentDiff.name, State.generatedQuestions)
                QuizControl.run(s, statusLabel)
            elseif bd.action == "copy" then
                if #State.generatedQuestions == 0 then statusLabel.Text = "⚠ Generate a quiz first" statusLabel.TextColor3 = Color3.fromRGB(251,191,36) statusLabel.Visible = true return end
                local s = buildScript(State.currentTopic, State.currentDiff.name, State.generatedQuestions)
                QuizControl.copy(s, statusLabel)
            elseif bd.action == "stop" then
                QuizControl.stop(statusLabel)
            elseif bd.action == "ban" then
                local banFrame = new("Frame", { Size = UDim2.fromOffset(260, 130), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(22, 22, 30), BorderSizePixel = 0, ZIndex = 300, Parent = ScreenGui })
                corner(banFrame, 12); stroke(banFrame, Color3.fromRGB(80, 40, 50), 1.5, 0)
                new("TextLabel", { Size = UDim2.new(1, -20, 0, 22), Position = UDim2.new(0, 10, 0, 10), BackgroundTransparency = 1, Text = "🚫 Ban player", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Color3.fromRGB(255,255,255), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 301, Parent = banFrame })
                local banInput = new("TextBox", { Size = UDim2.new(1, -20, 0, 34), Position = UDim2.new(0, 10, 0, 38), BackgroundColor3 = Color3.fromRGB(32, 32, 42), BorderSizePixel = 0, Text = "", PlaceholderText = "Username...", PlaceholderColor3 = Color3.fromRGB(110,110,140), Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Color3.fromRGB(240,240,250), ClearTextOnFocus = false, ZIndex = 301, Parent = banFrame })
                corner(banInput, 8)
                local banOk = new("TextButton", { Size = UDim2.fromOffset(100, 30), Position = UDim2.new(0, 10, 1, -40), BackgroundColor3 = Color3.fromRGB(248,113,113), BorderSizePixel = 0, Text = "Ban", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Color3.fromRGB(255,255,255), AutoButtonColor = false, ZIndex = 301, Parent = banFrame })
                corner(banOk, 6)
                local banCancel = new("TextButton", { Size = UDim2.fromOffset(100, 30), Position = UDim2.new(1, -110, 1, -40), BackgroundColor3 = Color3.fromRGB(60,60,80), BorderSizePixel = 0, Text = "Cancel", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Color3.fromRGB(220,220,240), AutoButtonColor = false, ZIndex = 301, Parent = banFrame })
                corner(banCancel, 6)
                banOk.MouseButton1Click:Connect(function() QuizControl.ban(banInput.Text, statusLabel) pcall(function() banFrame:Destroy() end) task.delay(2, function() if statusLabel.Parent then statusLabel.Visible = false end end) end)
                banCancel.MouseButton1Click:Connect(function() pcall(function() banFrame:Destroy() end) end)
            elseif bd.action == "back" then
                pcall(function() local g = getG() if g.REDHUB_QUIZ_STOP then g.REDHUB_QUIZ_STOP() end g.REDHUB_QUIZ_STOP = nil g.REDHUB_QUIZ_BAN = nil end)
                clearCards()
                if welcomeLabel and welcomeLabel.Parent then welcomeLabel.Visible = true end
                topicInput.Text = ""
                State.currentTopic = ""
                State.generatedQuestions = {}
                State.quizLocked = false
                statusLabel.Text = "↩ Reset — enter a new topic"
                statusLabel.TextColor3 = Color3.fromRGB(150,150,180)
                statusLabel.Visible = true
                task.delay(2, function() if statusLabel.Parent then statusLabel.Visible = false end end)
            end
        end)
        btn.MouseEnter:Connect(function() tween(btn, 0.15, { Size = UDim2.fromOffset(btnW, actionRowH - 2), Position = UDim2.fromOffset((i - 1) * (btnW + gap), 1) }) end)
        btn.MouseLeave:Connect(function() tween(btn, 0.15, { Size = UDim2.fromOffset(btnW, actionRowH - 6), Position = UDim2.fromOffset((i - 1) * (btnW + gap), 3) }) end)
    end

    -- Bot row (full-width bot button below action row)
    local botRow = new("Frame", { Size = UDim2.new(1, -24, 0, botRowH), Position = UDim2.new(0, 12, 1, -(botRowH + bottomPad)), BackgroundTransparency = 1, ZIndex = 52, Parent = win })
    local botBtn = new("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(139,92,246), BorderSizePixel = 0,
        Text = "🤖  BOT MODE  —  Auto Poll → Generate → Run",
        Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.fromRGB(255,255,255),
        AutoButtonColor = false, ZIndex = 53, Parent = botRow,
    })
    corner(botBtn, 10)
    grad(botBtn, Color3.fromRGB(139,92,246), Color3.fromRGB(91,33,182), 90)
    botBtn.MouseButton1Click:Connect(function()
        if State.killed then return end
        if not State.apiKey or #State.apiKey < 10 then
            statusLabel.Text = "⚠ Set API key first" statusLabel.TextColor3 = Color3.fromRGB(251,191,36) statusLabel.Visible = true
            return
        end
        buildBotPanel()
    end)
    botBtn.MouseEnter:Connect(function() tween(botBtn, 0.15, { Size = UDim2.fromScale(1, 1.03) }) end)
    botBtn.MouseLeave:Connect(function() tween(botBtn, 0.15, { Size = UDim2.fromScale(1, 1) }) end)

    -- Generate handler
    local function doGenerate()
        if State.isGenerating then return end
        if State.quizLocked then
            statusLabel.Text = "⚠ Press BACK first to start a new quiz"
            statusLabel.TextColor3 = Color3.fromRGB(251,191,36)
            statusLabel.Visible = true
            task.delay(2.5, function() if statusLabel.Parent then statusLabel.Visible = false end end)
            return
        end
        local topic = topicInput.Text
        if topic == "" then statusLabel.Text = "⚠ Enter a topic first" statusLabel.TextColor3 = Color3.fromRGB(251,191,36) statusLabel.Visible = true return end
        State.isGenerating = true
        State.currentTopic = topic
        genBtn.Text = "..."
        statusLabel.Text = "⏳ Generating " .. State.currentDiff.name .. " quiz: " .. topic
        statusLabel.TextColor3 = State.currentDiff.color
        statusLabel.Visible = true
        clearCards()
        if welcomeLabel and welcomeLabel.Parent then welcomeLabel.Visible = false end
        generateQuizAPI(topic, State.currentDiff.name, function(qs)
            genBtn.Text = "Generate"
            State.isGenerating = false
            State.generatedQuestions = qs
            State.quizLocked = true
            renderQuestions(qs)
            statusLabel.Text = "✔ " .. #qs .. " " .. State.currentDiff.name .. " questions ready: " .. topic .. " • Press Back to start new"
            statusLabel.TextColor3 = State.currentDiff.color
            statusLabel.Visible = true
            task.delay(4, function() if statusLabel.Parent then statusLabel.Visible = false end end)
        end, function(err)
            genBtn.Text = "Generate"
            State.isGenerating = false
            statusLabel.Text = "⚠ " .. tostring(err)
            statusLabel.TextColor3 = Color3.fromRGB(248,113,113)
        end)
    end
    genBtn.MouseButton1Click:Connect(doGenerate)
    topicInput.FocusLost:Connect(function(enter) if enter then doGenerate() end end)

    -- Mini panel
    local miniPanel
    local function buildMiniPanel()
        if miniPanel and miniPanel.Parent then return end
        miniPanel = new("Frame", { Name = "MiniPanel", Size = UDim2.fromOffset(126, 42), Position = UDim2.new(1, -136, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.fromRGB(20, 20, 28), BorderSizePixel = 0, ZIndex = 500, Parent = ScreenGui })
        corner(miniPanel, 21); stroke(miniPanel, State.currentTheme.accent, 1.5, 0.4); dragify(miniPanel)
        local expandBtn = new("TextButton", { Size = UDim2.fromOffset(42, 42), Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 501, Parent = miniPanel })
        local expandBg = new("Frame", { Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = State.currentTheme.accent, BorderSizePixel = 0, ZIndex = 500, Parent = expandBtn })
        corner(expandBg, 15); grad(expandBg, State.currentTheme.accent, State.currentTheme.userBubble, 45)
        new("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "Q", Font = Enum.Font.GothamBlack, TextSize = 15, TextColor3 = Color3.fromRGB(255,255,255), ZIndex = 501, Parent = expandBg })
        local miniMusic = new("TextButton", { Size = UDim2.fromOffset(42, 42), Position = UDim2.new(0, 42, 0, 0), BackgroundTransparency = 1, Text = "♪", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = State.musicOn and State.currentTheme.accent or Color3.fromRGB(120,120,140), AutoButtonColor = false, ZIndex = 501, Parent = miniPanel })
        local miniClose = new("TextButton", { Size = UDim2.fromOffset(42, 42), Position = UDim2.new(0, 84, 0, 0), BackgroundTransparency = 1, Text = "✕", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Color3.fromRGB(248,113,113), AutoButtonColor = false, ZIndex = 501, Parent = miniPanel })
        expandBtn.MouseButton1Click:Connect(function()
            if not State.minimized then return end
            State.minimized = false
            pcall(function() miniPanel:Destroy() end)
            miniPanel = nil
            win.Visible = true
        end)
        miniMusic.MouseButton1Click:Connect(function()
            if State.musicOn then stopMusic() miniMusic.TextColor3 = Color3.fromRGB(120,120,140) else playMusic() miniMusic.TextColor3 = State.currentTheme.accent end
        end)
        miniClose.MouseButton1Click:Connect(KILL_EVERYTHING)
        miniPanel.Size = UDim2.fromOffset(0, 42)
        tween(miniPanel, 0.3, { Size = UDim2.fromOffset(126, 42) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end
    minBtn.MouseButton1Click:Connect(function()
        if State.minimized then return end
        State.minimized = true
        win.Visible = false
        buildMiniPanel()
    end)

    tween(win, 0.3, { BackgroundTransparency = 0 })
end

-- ===== START FLOW =====
local function startFlow()
    task.wait(0.15)
    buildKeySystem(function()
        task.wait(0.2)
        if State.killed then return end
        if State.apiKey and #State.apiKey > 10 then
            buildMainWindow()
            task.wait(0.3)
            local toast = new("TextLabel", { Size = UDim2.fromOffset(220, 32), Position = UDim2.new(0.5, -110, 0, 12), BackgroundColor3 = Color3.fromRGB(24, 40, 30), BackgroundTransparency = 0.05, Text = " Auto-verified session", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Color3.fromRGB(180,240,200), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 400, Parent = ScreenGui })
            corner(toast, 8)
            task.wait(1.4)
            tween(toast, 0.3, { BackgroundTransparency = 1, TextTransparency = 1 })
            task.delay(0.4, function() pcall(function() toast:Destroy() end) end)
        else
            buildApiKeySystem(function()
                if State.killed then return end
                task.wait(0.05)
                buildMainWindow()
            end)
        end
    end)
end

playMusic()
createFloatingMusicBtn()
playLoading(function()
    if not State.killed then startFlow() end
end)

print("[RED HUB QUIZ GEN v4.2 — BOT MODE] Loaded. Discord: " .. CONFIG.DiscordInvite)
