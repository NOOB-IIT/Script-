local function AddDockBtn(symbol, title, tabTarget)
    local b = Instance.new("TextButton")
    b.Text = symbol .. (title ~= "" and (" " .. title) or "")
    b.Size = title ~= "" and UDim2.new(0, 85, 0, 28) or UDim2.new(0, 30, 0, 28)
    b.BackgroundColor3 = title ~= "" and RedTheme.Get("Accent") or Color3.fromRGB(0, 0, 0)
    b.BackgroundTransparency = title ~= "" and 0 or 1
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.BorderSizePixel = 0
    b.Parent = BottomDock
    RedUI.Corner(b, 14)

    b.MouseButton1Click:Connect(function()
        RedAudio.Play("Click")
        if tabTarget and TabBtns[tabTarget] then
            currentTab = tabTarget
            for n, btn in pairs(TabBtns) do
                btn.BackgroundTransparency = (n == tabTarget and 0 or 1)
                btn.BackgroundColor3 = RedTheme.Get("Accent")
                btn.TextColor3 = (n == tabTarget and Color3.fromRGB(255, 255, 255) or RedTheme.Get("TextSecondary"))
                Pages[n].Visible = (n == tabTarget)
            end
        else
            ShowToast("Feature", "Module ready for custom scripts", "Info")
        end
    end)
end

