-- [STEP 4] Fast Event Dispatcher (Signal)
local RedSignal = {}
RedSignal.__index = RedSignal
function RedSignal.new()
    return setmetatable({ _listeners = {} }, RedSignal)
end
function RedSignal:Connect(fn)
    local conn = {
        _signal = self,
        _fn = fn,
        _connected = true,
        Disconnect = function(c)
            c._connected = false
            for i, l in ipairs(c._signal._listeners) do
                if l == c then table.remove(c._signal._listeners, i) break end
            end
        end
    }
    table.insert(self._listeners, conn)
    return conn
end
function RedSignal:Fire(...)
    for _, l in ipairs(self._listeners) do
        if l and l._connected then
            task.spawn(l._fn, ...)
        end
    end
end

