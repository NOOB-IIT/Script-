--=============================================================
local QuizEngine = {}

local function qState() return State.quizState end

local function shuffleOptions(quizItem)
    local choices = {}
    for i = 1, #quizItem.RawOptions do choices[i] = quizItem.RawOptions[i] end
    local letters = {"A", "B", "C", "D"}

    for i = #choices, 2, -1 do
        local j = math.random(i)
        choices[i], choices[j] = choices[j], choices[i]
    end

    local qs = qState()
    qs.currentDynamicOptions = {}
    qs.correctAnswer = ""

    for index, optionText in ipairs(choices) do
        local prefix = letters[index]
        table.insert(qs.currentDynamicOptions, prefix .. ") " .. optionText)
        if optionText == quizItem.CorrectText then
            qs.correctAnswer = prefix
        end
    end
end

local function smartWait(seconds, targetSession)
    local qs = qState()
    local elapsed = 0
    while elapsed < seconds do
        if not qs.quizActive or qs.questionSession ~= targetSession then return false end
        task.wait(0.2)
        elapsed = elapsed + 0.2
    end
    return true
end

local function showLeaderboard()
    local qs = qState()
    qs.quizActive = false
    qs.optionsAllowed = false
    qs.isProcessingAnswer = true

    sendChatMessage("📊 --- FINAL LEADERBOARD ---")
    task.wait(3)

    local sortedScores = {}
    for userId, score in pairs(qs.playerScores) do
        table.insert(sortedScores, { name = qs.playerNames[userId] or "Unknown", score = score })
    end
    table.sort(sortedScores, function(a, b) return a.score > b.score end)

    if #sortedScores == 0 then
        sendChatMessage("No points scored! Quiz over. 🔥")
    else
        for rank, data in ipairs(sortedScores) do
            sendChatMessage("🏅 Rank " .. rank .. ": " .. data.name .. " - " .. data.score .. " Pts")
            task.wait(2.5)
        end
    end
    task.wait(3)
    sendChatMessage("📢 Quiz finished! Made with RED HUB QUIZ GEN 🎯")
    State.quizRunning = false
end

local askNextQuestion

local function triggerWin(player)
    local qs = qState()
    if not qs.quizActive or qs.isProcessingAnswer then return end
    qs.isProcessingAnswer = true
    qs.quizActive = false
    qs.optionsAllowed = false

    qs.playerScores[player.UserId] = (qs.playerScores[player.UserId] or 0) + 10
    qs.playerNames[player.UserId] = player.Name .. " (" .. player.DisplayName .. ")"
    sendChatMessage("🎉 " .. player.DisplayName .. " Correct Answer! (+10 Pts) 🎉")

    qs.currentQuestionIndex = qs.currentQuestionIndex + 1
    task.wait(2)

    if qs.currentQuestionIndex > #State.generatedQuestions then
        showLeaderboard()
    else
        qs.isProcessingAnswer = false
        task.spawn(askNextQuestion)
    end
end

local function onPlayerChatted(player, message)
    local qs = qState()
    if not qs.quizActive or qs.isProcessingAnswer then return end
    local playerNameUpper = string.upper(player.Name)

    if qs.blacklistedPlayers[playerNameUpper] then return end
    if isTaggedText(message) then return end

    local rawTrimmed = string.match(message, "^%s*(.-)%s*$")
    local upperMsg = string.upper(rawTrimmed)
    local cleanMsg = string.gsub(upperMsg, "[^%w]", "")

    local matchedLetter = string.match(upperMsg, "^([A-D])$")

    if cleanMsg == qs.currentWordAnswer then
        triggerWin(player)
        return
    end

    if matchedLetter then
        if not qs.optionsAllowed or qs.hasGuessedOption[player.UserId] then return end
        qs.hasGuessedOption[player.UserId] = true
        if matchedLetter == qs.correctAnswer then
            triggerWin(player)
        end
    end
end

askNextQuestion = function()
    local qs = qState()
    if qs.currentQuestionIndex > #State.generatedQuestions then
        showLeaderboard()
        return
    end

    qs.questionSession = qs.questionSession + 1
    local currentSession = qs.questionSession

    local currentQuiz = State.generatedQuestions[qs.currentQuestionIndex]

    shuffleOptions(currentQuiz)
    qs.currentWordAnswer = string.upper(string.gsub(currentQuiz.WordAnswer, "[^%w]", ""))

    qs.hasGuessedOption = {}
    qs.quizActive = true
    qs.optionsAllowed = false
    qs.isProcessingAnswer = false

    if isTaggedText(currentQuiz.Question) then
        sendChatMessage("⚠️ [AUTO-SKIP] Question tagged by chat filter! Skipping...")
        qs.currentQuestionIndex = qs.currentQuestionIndex + 1
        task.wait(2)
        task.spawn(askNextQuestion)
        return
    end

    sendChatMessage("💡 Answer with Full Word OR A/B/C/D option!")
    if not smartWait(3, currentSession) then return end

    sendChatMessage(currentQuiz.Question)
    if not smartWait(10, currentSession) then return end

    qs.optionsAllowed = true
    for _, opt in ipairs(qs.currentDynamicOptions) do
        if isTaggedText(opt) then
            sendChatMessage("⚠️ [AUTO-SKIP] Options tagged by filter! Skipping...")
            qs.currentQuestionIndex = qs.currentQuestionIndex + 1
            task.wait(2)
            task.spawn(askNextQuestion)
            return
        end

        sendChatMessage(opt)
        if not smartWait(2, currentSession) then return end
    end

    if not smartWait(12, currentSession) then return end

    if qs.quizActive and qs.questionSession == currentSession then
        qs.quizActive = false
        sendChatMessage("⏳ Time's up! Correct Answer: " .. qs.correctAnswer .. " (" .. currentQuiz.WordAnswer .. ")")
        qs.currentQuestionIndex = qs.currentQuestionIndex + 1
        task.wait(3)

        if qs.currentQuestionIndex > #State.generatedQuestions then
            showLeaderboard()
        else
            task.spawn(askNextQuestion)
        end
    end
end

function QuizEngine.start()
    local qs = qState()
    if #State.generatedQuestions == 0 then
        sendChatMessage("⚠️ No questions generated. Please generate a quiz first.")
        return
    end

    -- Reset state
    qs.playerScores = {}
    qs.playerNames = {}
    qs.hasGuessedOption = {}
    qs.currentQuestionIndex = 1
    qs.questionSession = 0
    qs.quizActive = false
    qs.optionsAllowed = false
    qs.isProcessingAnswer = false

    -- Hook chat connection
    pcall(function()
        if qs.connection then qs.connection:Disconnect() end
    end)

    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        qs.connection = TextChatService.MessageReceived:Connect(function(t)
            if t.TextSource then
                local p = Players:GetPlayerByUserId(t.TextSource.UserId)
                if p then onPlayerChatted(p, t.Text) end
            end
        end)
    else
        qs.connection = Players.PlayerAdded:Connect(function(p)
            p.Chatted:Connect(function(m) onPlayerChatted(p, m) end)
        end)
        for _, p in ipairs(Players:GetPlayers()) do
            p.Chatted:Connect(function(m) onPlayerChatted(p, m) end)
        end
    end

    State.quizRunning = true
    sendChatMessage("(C) Made with RED HUB QUIZ GEN")
    task.wait(2)
    sendChatMessage("=== 🎯 QUIZ STARTING — Topic: " .. State.currentTopic .. " ===")
    task.wait(2)
    task.spawn(askNextQuestion)
end

function QuizEngine.stop(silent)
    local qs = qState()
    qs.quizActive = false
    qs.optionsAllowed = false
    State.quizRunning = false
    if not silent then
        sendChatMessage("🛑 Quiz STOPPED by admin.")
    end
end

function QuizEngine.ban(name)
    local qs = qState()
    qs.blacklistedPlayers[string.upper(name)] = true
    sendChatMessage("🚫 Player '" .. name .. "' has been BANNED from the quiz.")
end

