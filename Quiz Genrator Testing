        local rot = 0
        while loading.Parent do
            rot = rot + 0.04
            for i = 1, #dots do
                local d = dots[i]
                if d.Parent then
                    local a = (i / numDots) * math.pi * 2 + rot
                    d.Position = UDim2.new(0.5, math.cos(a) * 85, 0.5, math.sin(a) * 85)
                end
            end
            RunService.RenderStepped:Wait()
        end
    end)

    task.spawn(function()
        while loading.Parent and ring.Parent do
            tween(ring, 1.0, { Size = UDim2.fromOffset(160, 160) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1.0)
            if not (loading.Parent and ring.Parent) then break end
            tween(ring, 1.0, { Size = UDim2.fromOffset(140, 140) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1.0)
        end
    end)

    tween(title, 0.6, { TextTransparency = 0 })
    tween(sub, 0.8, { TextTransparency = 0.3 })

    local steps = { "Initializing", "Secure channel", "Loading models", "Ready" }
    task.spawn(function()
        for i = 1, #steps do
            if not loading.Parent then return end
            sub.Text = steps[i]
            task.wait(0.6)
        end
        task.wait(0.2)
        tween(loading, 0.35, { BackgroundTransparency = 1 })
        for _, d in ipairs(loading:GetDescendants()) do
            pcall(function()
                if d:IsA("Frame") and d.BackgroundTransparency < 1 then
                    tween(d, 0.3, { BackgroundTransparency = 1 })
                end
                if d:IsA("TextLabel") then
                    tween(d, 0.3, { TextTransparency = 1 })
                end
                if d:IsA("UIStroke") then
                    tween(d, 0.3, { Transparency = 1 })
                end
            end)
        end
        task.wait(0.4)
        pcall(function() loading:Destroy() end)
        if onComplete and not State.killed then pcall(onComplete) end
    end)
end

