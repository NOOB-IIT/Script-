    table.insert(lines, "    playerScores[player.UserId] = (playerScores[player.UserId] or 0) + 10")
    table.insert(lines, "    playerNames[player.UserId] = player.Name .. \" (\" .. player.DisplayName .. \")\"")
    table.insert(lines, "    sendChatMessage(\"🎉 \" .. player.DisplayName .. \" Correct Answer! (+10 Pts) 🎉\")")
    table.insert(lines, "    currentQuestionIndex = currentQuestionIndex + 1")
    table.insert(lines, "    task.wait(2)")
    table.insert(lines, "    if currentQuestionIndex > #quizDatabase then showLeaderboard()")
    table.insert(lines, "    else isProcessingAnswer = false task.spawn(askNextQuestion) end")
    table.insert(lines, "end")
    table.insert(lines, "")
    table.insert(lines, "local function onPlayerChatted(player, message)")
    table.insert(lines, "    if not quizActive or isProcessingAnswer then return end")
    table.insert(lines, "    if blacklistedPlayers[string.upper(player.Name)] then return end")
    table.insert(lines, "    if isTaggedText(message) then return end")
    table.insert(lines, "    local raw = string.match(message, \"^%s*(.-)%s*$\")")
    table.insert(lines, "    local upper = string.upper(raw)")
    table.insert(lines, "    local clean = string.gsub(upper, \"[^%w]\", \"\")")
    table.insert(lines, "    local matched = string.match(upper, \"^([A-D])$\")")
    table.insert(lines, "    if clean == currentWordAnswer then triggerWin(player) return end")
    table.insert(lines, "    if matched then")
    table.insert(lines, "        if not optionsAllowed or hasGuessedOption[player.UserId] then return end")
    table.insert(lines, "        hasGuessedOption[player.UserId] = true")
    table.insert(lines, "        if matched == correctAnswer then triggerWin(player) end")
    table.insert(lines, "    end")
    table.insert(lines, "end")
    table.insert(lines, "")
    table.insert(lines, "if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then")
    table.insert(lines, "    TextChatService.MessageReceived:Connect(function(t)")
    table.insert(lines, "        if t.TextSource then local p = Players:GetPlayerByUserId(t.TextSource.UserId) if p then onPlayerChatted(p, t.Text) end end")
    table.insert(lines, "    end)")
    table.insert(lines, "else")
    table.insert(lines, "    Players.PlayerAdded:Connect(function(p) p.Chatted:Connect(function(m) onPlayerChatted(p, m) end) end)")
    table.insert(lines, "    for _, p in ipairs(Players:GetPlayers()) do p.Chatted:Connect(function(m) onPlayerChatted(p, m) end) end")
    table.insert(lines, "end")
    table.insert(lines, "")
    table.insert(lines, "askNextQuestion = function()")
    table.insert(lines, "    if currentQuestionIndex > #quizDatabase then showLeaderboard() return end")
    table.insert(lines, "    questionSession = questionSession + 1")
    table.insert(lines, "    local curSession = questionSession")
    table.insert(lines, "    local currentQuiz = quizDatabase[currentQuestionIndex]")
    table.insert(lines, "    shuffleOptions(currentQuiz)")
    table.insert(lines, "    currentWordAnswer = string.upper(string.gsub(currentQuiz.WordAnswer, \"[^%w]\", \"\"))")
    table.insert(lines, "    hasGuessedOption = {} quizActive = true optionsAllowed = false isProcessingAnswer = false")
    table.insert(lines, "    if isTaggedText(currentQuiz.Question) then")
    table.insert(lines, "        sendChatMessage(\"⚠️ [AUTO-SKIP] Question tagged! Skipping...\")")
    table.insert(lines, "        currentQuestionIndex = currentQuestionIndex + 1")
    table.insert(lines, "        task.wait(2) task.spawn(askNextQuestion) return")
    table.insert(lines, "    end")
    table.insert(lines, "    sendChatMessage(\"💡 Answer with Full Word OR A/B/C/D option!\")")
    table.insert(lines, "    if not smartWait(3, curSession) then return end")
    table.insert(lines, "    sendChatMessage(currentQuiz.Question)")
    table.insert(lines, "    if not smartWait(10, curSession) then return end")
    table.insert(lines, "    optionsAllowed = true")
    table.insert(lines, "    for _, opt in ipairs(currentDynamicOptions) do")
    table.insert(lines, "        if isTaggedText(opt) then")
    table.insert(lines, "            sendChatMessage(\"⚠️ [AUTO-SKIP] Options tagged! Skipping...\")")
    table.insert(lines, "            currentQuestionIndex = currentQuestionIndex + 1")
    table.insert(lines, "            task.wait(2) task.spawn(askNextQuestion) return")
    table.insert(lines, "        end")
    table.insert(lines, "        sendChatMessage(opt)")
    table.insert(lines, "        if not smartWait(2, curSession) then return end")
    table.insert(lines, "    end")
    table.insert(lines, "    if not smartWait(12, curSession) then return end")
    table.insert(lines, "    if quizActive and questionSession == curSession then")
    table.insert(lines, "        quizActive = false")
    table.insert(lines, "        sendChatMessage(\"⏳ Time's up! Answer: \" .. correctAnswer .. \" (\" .. currentQuiz.WordAnswer .. \")\")")
    table.insert(lines, "        currentQuestionIndex = currentQuestionIndex + 1")
    table.insert(lines, "        task.wait(3)")
    table.insert(lines, "        if currentQuestionIndex > #quizDatabase then showLeaderboard()")
    table.insert(lines, "        else task.spawn(askNextQuestion) end")
    table.insert(lines, "    end")
    table.insert(lines, "end")
    table.insert(lines, "")
    table.insert(lines, "sendChatMessage(\"(C) Made with RED HUB QUIZ GEN\")")
    table.insert(lines, "task.wait(2)")
    table.insert(lines, "sendChatMessage(\"=== 🎯 QUIZ STARTING — Topic: " .. State.currentTopic .. " ===\")")
    table.insert(lines, "task.wait(2)")
    table.insert(lines, "askNextQuestion()")
    return table.concat(lines, "\n")
end

