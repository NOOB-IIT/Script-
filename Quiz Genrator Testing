    -- === GENERATE FLOW ===
    local function doGenerate()
        if State.isGenerating then return end
        local topic = topicInput.Text
        if topic == "" then
            statusLabel.Text = "⚠ Enter a topic first"
            statusLabel.Visible = true
            return
        end

        State.isGenerating = true
        State.currentTopic = topic
        genBtn.Text = "..."
        genBtn.AutoButtonColor = false
        statusLabel.Text = "⏳ Generating quiz on: " .. topic
        statusLabel.TextColor3 = State.currentTheme.accent
        statusLabel.Visible = true
        clearQuestions()
        if welcomeLabel and welcomeLabel.Parent then welcomeLabel.Visible = false end

        task.spawn(function()
            local sysPrompt = "You are a quiz generator. Always reply with valid JSON only. No markdown, no explanation, no extra text."
            local userPrompt = string.format([[
Generate exactly 10 hard multiple-choice questions about: "%s"

Return ONLY valid JSON in this EXACT format (no markdown, no code fences, no explanation):
{
  "questions": [
    {"question": "Question text here?", "options": ["optA", "optB", "optC", "optD"], "correctText": "optA", "wordAnswer": "ONE_WORD_ANSWER"}
  ]
}

Rules:
- Exactly 10 questions
- Each has exactly 4 options
- correctText must exactly match one of the 4 options
- wordAnswer = single UPPERCASE word (no spaces) players can type to win instantly
- Questions should be hard, specific, interesting
- Topic: %s
]], topic, topic)

            local msgs = {
                { role = "system", content = sysPrompt },
                { role = "user",   content = userPrompt },
            }

            local body = HttpService:JSONEncode({
                model = State.currentModel.id,
                messages = msgs,
                temperature = 0.8,
                max_tokens = State.currentModel.maxTokens,
            })

            local success, response = pcall(function()
                return HttpService:RequestAsync({
                    Url = CONFIG.ApiEndpoint,
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["Authorization"] = "Bearer " .. State.apiKey,
                    },
                    Body = body,
                })
            end)

            genBtn.Text = "Generate"
            State.isGenerating = false

            if not (success and response and response.Success) then
                statusLabel.Text = "⚠ Request failed"
                statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
                return
            end

            local ok, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if not (ok and decoded and decoded.choices and decoded.choices[1]) then
                statusLabel.Text = "⚠ Bad response"
                statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
                return
            end

            local raw = decoded.choices[1].message.content
            -- strip code fences
            raw = string.gsub(raw, "```json", "")
            raw = string.gsub(raw, "```", "")
            raw = string.match(raw, "%b{}") or raw

            local ok2, parsed = pcall(function() return HttpService:JSONDecode(raw) end)
            if not (ok2 and parsed and parsed.questions and #parsed.questions > 0) then
                statusLabel.Text = "⚠ Failed to parse quiz. Try again."
                statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
                return
            end

            -- Normalize
            local qs = {}
            for i = 1, math.min(10, #parsed.questions) do
                local q = parsed.questions[i]
                if q.question and q.options and #q.options >= 4 and q.correctText and q.wordAnswer then
                    table.insert(qs, {
                        question = tostring(q.question),
                        options = { q.options[1], q.options[2], q.options[3], q.options[4] },
                        correctText = tostring(q.correctText),
                        wordAnswer = string.upper(string.gsub(tostring(q.wordAnswer), "%s+", "")),
                    })
                end
            end

            if #qs == 0 then
                statusLabel.Text = "⚠ No valid questions parsed"
                statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
                return
            end

            State.generatedQuestions = qs
            renderQuestions(qs)

            statusLabel.Text = "✔ " .. #qs .. " questions generated for: " .. topic
            statusLabel.TextColor3 = State.currentTheme.accent
            statusLabel.Visible = true
            task.wait(2.5)
            if statusLabel.Parent then statusLabel.Visible = false end
        end)
    end

