        State.musicSound.Parent = SoundService
    end)
end

local function refreshAllMusicButtons()
    for i = 1, #State.musicBtnRefs do
        local ref = State.musicBtnRefs[i]
        if ref and ref.update then pcall(ref.update) end
    end
end

local function playMusic()
    pcall(function()
        if State.musicSound and not State.musicSound.IsPlaying then
            State.musicSound:Play()
        end
    end)
    State.musicOn = true
    refreshAllMusicButtons()
end

local function stopMusic()
    pcall(function() if State.musicSound then State.musicSound:Stop() end end)
    State.musicOn = false
    refreshAllMusicButtons()
end

local function destroyMusic()
    pcall(function()
        if State.musicSound then
            State.musicSound:Stop()
            State.musicSound:Destroy()
            State.musicSound = nil
        end
    end)
    State.musicOn = false
end

initMusic()

