local function initMusic()
    pcall(function()
        State.musicSound = Instance.new("Sound")
        State.musicSound.Name = "RedHubMusic"
        State.musicSound.SoundId = CONFIG.MusicAsset
        State.musicSound.Volume = CONFIG.MusicVolume
