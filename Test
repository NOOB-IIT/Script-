local function refreshList()
    for _, c in ipairs(listScroll:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
    local q = (searchBox.Text or ""):lower()
    local plrs = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and (q == "" or p.Name:lower():sub(1, #q) == q or p.DisplayName:lower():sub(1, #q) == q) then
            table.insert(plrs, p)
        end
    end
    if #plrs == 0 then
        local e = Instance.new("TextLabel")
        e.Size = UDim2.new(1, 0, 0, 30)
        e.BackgroundTransparency = 1
        e.Text = "No other players found"
        e.TextColor3 = T.Muted
        e.Font = Enum.Font.Gotham
        e.TextSize = 11
        e.ZIndex = 9
        e.Parent = listScroll
        return
    end
    for i, p in ipairs(plrs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 32)
        btn.BackgroundColor3 = (selectedPlayer == p) and T.Accent or T.PanelLt
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.LayoutOrder = i
        btn.ZIndex = 9
        btn.Parent = listScroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        styleBtn(btn, (selectedPlayer == p) and T.Accent or T.PanelLt)

        local av = Instance.new("ImageLabel")
        av.Size = UDim2.new(0, 24, 0, 24)
        av.Position = UDim2.new(0, 4, 0.5, -12)
        av.BackgroundColor3 = T.Panel
        av.Image = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=48&h=48"
        av.ZIndex = 10
        av.Parent = btn
        Instance.new("UICorner", av).CornerRadius = UDim.new(1, 0)

        local nm = Instance.new("TextLabel")
        nm.Size = UDim2.new(1, -36, 1, 0)
        nm.Position = UDim2.new(0, 32, 0, 0)
        nm.BackgroundTransparency = 1
        nm.Text = p.Name .. " (" .. p.DisplayName .. ")"
        nm.TextColor3 = Color3.new(1, 1, 1)
        nm.Font = Enum.Font.GothamBold
        nm.TextSize = 11
        nm.TextXAlignment = Enum.TextXAlignment.Left
        nm.ZIndex = 10
        nm.Parent = btn

        btn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            footerLabel.Text = "👤 " .. p.Name
            footerSub.Text = "Ready — Choose Attach, Action or Utility"
            sClick()
            refreshList()
        end)
    end
end

