local TabPages, TabButtons = {}, {}
local tabCounter = 0

local function showTab(name)
    for n, p in pairs(TabPages) do p.Visible = (n == name) end
    for n, b in pairs(TabButtons) do
        local act = (n == name)
        TweenService:Create(b, TweenInfo.new(0.15), {
            BackgroundColor3 = act and T.Accent or T.Panel,
            TextColor3 = act and Color3.new(1, 1, 1) or T.Muted,
        }):Play()
    end
end

local function createTab(name, icon)
    tabCounter = tabCounter + 1
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 80, 0, 26)
    btn.BackgroundColor3 = T.Panel
    btn.Text = icon .. " " .. name
    btn.TextColor3 = T.Muted
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 9
    btn.LayoutOrder = tabCounter
    btn.ZIndex = 7
    btn.Parent = tabsBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    styleBtn(btn, T.Panel)
    btn.MouseButton1Click:Connect(function() sClick(); showTab(name) end)
    TabButtons[name] = btn

    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = T.Accent
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.ZIndex = 6
    page.Parent = content

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 6); pad.PaddingBottom = UDim.new(0, 6)
    pad.PaddingLeft = UDim.new(0, 8); pad.PaddingRight = UDim.new(0, 8)
    pad.Parent = page

    local lst = Instance.new("UIListLayout")
    lst.Padding = UDim.new(0, 5)
    lst.SortOrder = Enum.SortOrder.LayoutOrder
    lst.Parent = page

    TabPages[name] = page
    return page
end

