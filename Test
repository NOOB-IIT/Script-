    elseif LastWeldType == "side_glance" then executeSideGlanceLock()
    elseif LastWeldType == "shadow_glitch" then executeShadowGlitch()
    elseif LastWeldType == "crawler" then executeCrawlerPosition()
    elseif LastWeldType == "hover_crown" then executeHoverCrown()
    elseif LastWeldType == "leg_drag" then executeLegDragFollow()
    elseif LastWeldType == "bow_down" then executeBowDown()
    elseif LastWeldType == "point_mock" then executePointMock()
    elseif LastWeldType == "blow_kiss" then executeBlowKiss()
    elseif LastWeldType == "flex_pose" then executeFlexPose()
    elseif LastWeldType == "slap_back" then executeSlapBack()
    elseif LastWeldType == "handshake" then executeHandshakePose()
    elseif LastWeldType == "pat_head" then executePatHead()
    elseif LastWeldType == "belly_dance" then executeBellyDance()
    elseif LastWeldType == "spank" then executeSpankOffset()
    elseif LastWeldType == "kiss" then executeZeroDelayKiss()
    elseif LastWeldType == "hug" then executeZeroDelayHug()
    elseif LastWeldType == "pos69" then executeZeroDelay69()
    elseif LastWeldType == "shoulder" then executeShoulderSit()
    elseif LastWeldType == "headsit" then executeHeadSit()
    elseif LastWeldType == "carry" then executeCarry()
    elseif LastWeldType == "slap" then executeZeroDelaySlap()
    elseif LastWeldType == "stare" then executeZeroDelayStare()
    elseif LastWeldType == "bang" then runBang(LastWeldAnimId or 148840371, 2.2)
    end
end

