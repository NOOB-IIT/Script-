-- Update Player List with Alphabetical Sorting (A to Z)
local function UpdatePlayerList()
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    -- Gather players except local player
    local playerList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playerList, player)
        end
    end
    
    -- Sort alphabetically based on DisplayName (A-Z)
    table.sort(playerList, function(a, b)
        return a.DisplayName:lower() < b.DisplayName:lower()
    end)
    
    local ySize = 0
    for _, player in ipairs(playerList) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new(1, -4, 0, 28)
        pBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
        pBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
        pBtn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")"
        pBtn.TextXAlignment = Enum.TextXAlignment.Left
        pBtn.TextSize = 12
        pBtn.Font = Enum.Font.Gotham
        pBtn.Parent = ScrollFrame
        
        pBtn.MouseButton1Click:Connect(function()
            TextBox.Text = player.Name
            isOpen = false
            DropdownBar.Text = "  Select Player  ^"
            ScrollFrame.Visible = false
            MainFrame.Size = UDim2.new(0, 340, 0, 235)
            VanishBtn.Position = UDim2.new(0.06, 0, 0, 92)
        end)
        ySize = ySize + 32
    end
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

UpdatePlayerList()
Players.PlayerAdded:Connect(UpdatePlayerList)
Players.PlayerRemoving:Connect(UpdatePlayerList)

-- Vanish Execution System
local VanishedPlayers = {}

local function VanishTarget(inputName)
    local target = nil
    local cleanInput = string.lower(inputName):gsub("@", "")
    
    for _, p in pairs(Players:GetPlayers()) do
        if string.lower(p.Name) == cleanInput or string.lower(p.DisplayName) == cleanInput or 
           string.lower(p.Name):match("^" .. cleanInput) or string.lower(p.DisplayName):match("^" .. cleanInput) then
            target = p
            break
        end
    end

    if target and target ~= LocalPlayer then
        VanishedPlayers[target.UserId] = true
        
        if target.Character then
            target.Character:Destroy()
        end
        
        target.CharacterAdded:Connect(function(char)
            if VanishedPlayers[target.UserId] then
                task.wait()
                char:Destroy()
            end
        end)
        
        TextBox.Text = "Success: " .. target.DisplayName
        task.wait(2)
        TextBox.Text = ""
    else
        TextBox.Text = "Player not found!"
        task.wait(1.5)
        TextBox.Text = ""
    end
end

-- Chat Block via TextChatService
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.OnIncomingMessage = function(message)
        if message.TextSource then
            local player = Players:GetPlayerByUserId(message.TextSource.UserId)
            if player and VanishedPlayers[player.UserId] then
                local prop = Instance.new("TextChatMessageProperties")
                prop.Text = ""
                return prop
            end
        end
    end
end

-- Vanish Button Trigger
VanishBtn.MouseButton1Click:Connect(function()
    local nameInput = TextBox.Text
    if nameInput ~= "" and nameInput ~= "Enter Player Name or Display Name..." then
        VanishTarget(nameInput)
    end
end)

-- Draggable Logic
local dragging, dragInput, dragStart, startPos

TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

RunService.RenderStepped:Connect(function()
    if dragging and dragInput then
        local delta = dragInput.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
