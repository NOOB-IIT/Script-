local function stopEverything()
    HUB.active = false
    MusicPlayer.stop()
    if AFB.Mode ~= "OFF" and AFB.SavedCFrame and hrp and hrp.Parent then
        pcall(function()
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CFrame = AFB.SavedCFrame
        end)
    end
    AFB.Mode = "OFF"
    AFB.SavedCFrame = nil
    if baseplate and baseplate.Parent then
        baseplate:Destroy()
        baseplate = nil
    end
    CONFIG.RescueEnabled    = false
    CONFIG.BaseplateEnabled = false
    gui.Enabled = false
    print("[RED HUB] All stopped ✔")
end

