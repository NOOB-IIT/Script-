local function makeTitleBtn(text, xOff, baseColor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 52, 0, 30)
    btn.Position = UDim2.new(1, xOff, 0, 8)
    btn.BackgroundColor3 = BTN_BG
    btn.Text = text
    btn.TextColor3 = WHITE
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.BorderSizePixel = 0
    btn.Parent = titleBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = baseColor
    stroke.Thickness = 1.5
    stroke.Transparency = 0.4
    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 5, 0, 5)
    dot.Position = UDim2.new(0, 3, 0, 3)
    dot.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    dot.BorderSizePixel = 0
    dot.Parent = btn
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
    btn.MouseEnter:Connect(function()
        hover()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(90, 20, 30)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = BTN_BG}):Play()
    end)
    return btn, stroke, dot
end

