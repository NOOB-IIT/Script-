-- Baseplate
local baseplate = nil
local function updateBaseplate()
    if not baseplate or not baseplate.Parent then return end
    baseplate.Color = CONFIG.BaseplateColor
    baseplate.Material = CONFIG.BaseplateMaterial
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        baseplate.Position = Vector3.new(hrp.Position.X, CONFIG.BaseplateHeight, hrp.Position.Z)
    end
end
local function createBaseplate()
    if baseplate and baseplate.Parent then baseplate:Destroy() end
    local p = Instance.new("Part")
    p.Name = "REDHUB_InfiniteBaseplate"
    p.Size = Vector3.new(2000, 4, 2000)
    p.Position = Vector3.new(0, CONFIG.BaseplateHeight, 0)
    p.Anchored = true
    p.CanCollide = true
    p.CanTouch = true
    p.CanQuery = true
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Color = CONFIG.BaseplateColor
    p.Material = CONFIG.BaseplateMaterial
    p.Parent = workspace
    baseplate = p
    win()
end
local function removeBaseplate()
    if baseplate and baseplate.Parent then
        baseplate:Destroy()
        baseplate = nil
    end
    fail()
end

task.spawn(function()
    local last = CONFIG.BaseplateEnabled
    while HUB.active do
        task.wait(0.1)
        if CONFIG.BaseplateEnabled ~= last then
            last = CONFIG.BaseplateEnabled
            if CONFIG.BaseplateEnabled then createBaseplate() else removeBaseplate() end
        end
        if baseplate and baseplate.Parent then updateBaseplate() end
    end
end)

-- Rescue
local char     = LP.Character or LP.CharacterAdded:Wait()
local humanoid = char:WaitForChild("Humanoid")
local hrp      = char:WaitForChild("HumanoidRootPart")

local lastSafePos   = hrp.Position
local fallOriginPos = nil
local wasOnGround   = true
local rescuing      = false

local function isOnGround()
    local fm = humanoid.FloorMaterial
    return fm and fm ~= Enum.Material.Air
end

local function updateFallOrigin()
    if not hrp or not hrp.Parent then return end
    local grounded = isOnGround()
    if grounded then
        lastSafePos = hrp.Position
        wasOnGround = true
    else
        if wasOnGround then
            fallOriginPos = lastSafePos
            wasOnGround = false
        end
    end
end

local function doRescue()
    if rescuing then return end
    if not hrp or not hrp.Parent then return end
    if not humanoid or humanoid.Health <= 0 then return end
    if AFB.Mode ~= "OFF" then return end
    rescuing = true
    win()
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    local target = nil
    if CONFIG.FallOriginEnabled and fallOriginPos then
        local look = hrp.CFrame.LookVector
        local back = -look * CONFIG.FallBackStuds
        target = fallOriginPos + back + Vector3.new(0, 5, 0)
    elseif lastSafePos then
        target = lastSafePos + Vector3.new(0, 5, 0)
    end
    if target then
        pcall(function()
            hrp.CFrame = CFrame.new(target)
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = RED
    flash.BackgroundTransparency = 0.6
    flash.BorderSizePixel = 0
    flash.ZIndex = 100
    flash.Parent = gui
    TweenService:Create(flash, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
    Debris:AddItem(flash, 0.6)
    task.wait(1.5)
    rescuing = false
end

LP.CharacterAdded:Connect(function(c)
    char     = c
    humanoid = c:WaitForChild("Humanoid")
    hrp      = c:WaitForChild("HumanoidRootPart")
    lastSafePos   = hrp.Position
    fallOriginPos = nil
    wasOnGround   = true
    rescuing      = false
    if AFB.Mode ~= "OFF" then
        AFB.Mode = "OFF"
        AFB.SavedCFrame = nil
    end
end)

-- AFB
local function getRotation(mode)
    if mode == "FRONT" then return CFrame.Angles(math.rad(90), 0, 0) end
    if mode == "BACK"  then return CFrame.Angles(math.rad(-90), 0, 0) end
    if mode == "HEAD"  then return CFrame.Angles(math.rad(180), 0, 0) end
    return CFrame.Angles(0, 0, 0)
end

local function resetAllButtonVisuals()
    afbFBtn.BackgroundColor3 = BTN_BG
    afbBBtn.BackgroundColor3 = BTN_BG
    ahsBtn.BackgroundColor3  = BTN_BG
    afbFDot.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    afbBDot.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    ahsDot.BackgroundColor3  = Color3.fromRGB(100, 100, 100)
end

local function activateMode(newMode)
    if not hrp or not hrp.Parent then return end
    if AFB.Mode == newMode then
        if AFB.SavedCFrame and hrp.Parent then
            pcall(function()
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.CFrame = AFB.SavedCFrame
            end)
        end
        AFB.Mode = "OFF"
        AFB.SavedCFrame = nil
        resetAllButtonVisuals()
        whoosh()
        return
    end
    if AFB.Mode == "OFF" then
        AFB.SavedCFrame = hrp.CFrame
        charge()
    end
    resetAllButtonVisuals()
    AFB.Mode = newMode
    local activeColor = RED
    if newMode == "FRONT" then
        afbFDot.BackgroundColor3 = RED_LT
        afbFBtn.BackgroundColor3 = RED_DK
    elseif newMode == "BACK" then
        activeColor = BLUE
        afbBDot.BackgroundColor3 = BLUE_LT
        afbBBtn.BackgroundColor3 = Color3.fromRGB(20, 40, 90)
    elseif newMode == "HEAD" then
        activeColor = GREEN
        ahsDot.BackgroundColor3 = GREEN_LT
        ahsBtn.BackgroundColor3 = Color3.fromRGB(20, 80, 40)
        flip()
    end
    local rot = getRotation(newMode)
    local savedPos = AFB.SavedCFrame.Position
    local target = CFrame.new(savedPos.X, AFB.HighY, savedPos.Z) * rot
    pcall(function()
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = target
    end)
    local fx = Instance.new("Frame")
    fx.Size = UDim2.new(1, 0, 1, 0)
    fx.BackgroundColor3 = activeColor
    fx.BackgroundTransparency = 0.7
    fx.BorderSizePixel = 0
    fx.ZIndex = 90
    fx.Parent = gui
    TweenService:Create(fx, TweenInfo.new(0.7), {BackgroundTransparency = 1}):Play()
    Debris:AddItem(fx, 0.8)
    power()
end

afbFBtn.MouseButton1Click:Connect(function() activateMode("FRONT") end)
