-- Volume slider
do
    local dragging = false
    local function setVol(input)
        local rel = input.Position.X - volSlider.AbsolutePosition.X
        local alpha = math.clamp(rel / volSlider.AbsoluteSize.X, 0, 1)
        volFill.Size = UDim2.new(alpha, 0, 1, 0)
        volKnob.Position = UDim2.new(alpha, -6, 0.5, -6)
        MusicPlayer.volume = alpha
        if MusicPlayer.current then
            MusicPlayer.current.Volume = alpha
        end
    end
    volSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setVol(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setVol(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

