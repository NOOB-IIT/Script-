-- Music Player Engine
local MusicPlayer = { current = nil, song = nil, paused = false, volume = 0.6, activeTab = "Bolly", customSong = nil }

function MusicPlayer.stop()
    if MusicPlayer.current then
        pcall(function() MusicPlayer.current:Stop() end)
        pcall(function() MusicPlayer.current:Destroy() end)
        MusicPlayer.current = nil
    end
    MusicPlayer.song = nil
    npLbl.Text = "▶ No song"
    playBtn.Text = "▶"
end

function MusicPlayer.play(song, isCustom)
    MusicPlayer.stop()
    MusicPlayer.paused = false
    MusicPlayer.song = song
    npLbl.Text = "▶ " .. song.name

    local s = Instance.new("Sound")
    s.Name = "REDHUB_Music"
    s.SoundId = song.id
    s.Volume = MusicPlayer.volume
    s.Looped = false
    s.Parent = SoundService
    s:Play()
    MusicPlayer.current = s
    playBtn.Text = "⏸"

    -- Detect if sound loaded
    task.delay(0.8, function()
        if MusicPlayer.current == s then
            if s.TimeLength == 0 then
                npLbl.Text = "⚠ Not playing — try Custom ID"
                npLbl.TextColor3 = Color3.fromRGB(255, 150, 100)
            else
                npLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
            end
        end
    end)

    s.Ended:Connect(function()
        if HUB.active and MusicPlayer.current == s then
            if not isCustom then MusicPlayer.next() end
        end
    end)
end

function MusicPlayer.toggle()
    if not MusicPlayer.current then return end
    MusicPlayer.paused = not MusicPlayer.paused
    if MusicPlayer.paused then
        MusicPlayer.current:Pause()
        playBtn.Text = "▶"
    else
        MusicPlayer.current:Resume()
        playBtn.Text = "⏸"
    end
end

function MusicPlayer.next()
    local songs = MUSIC_DB[MusicPlayer.activeTab]
    if not songs or #songs == 0 then return end
    local idx = 1
    for i, s in ipairs(songs) do
        if MusicPlayer.song and s.name == MusicPlayer.song.name then idx = i break end
    end
    idx = idx % #songs + 1
    MusicPlayer.play(songs[idx])
end

function MusicPlayer.prev()
    local songs = MUSIC_DB[MusicPlayer.activeTab]
    if not songs or #songs == 0 then return end
    local idx = 1
    for i, s in ipairs(songs) do
        if MusicPlayer.song and s.name == MusicPlayer.song.name then idx = i break end
    end
    idx = idx - 1
    if idx < 1 then idx = #songs end
    MusicPlayer.play(songs[idx])
end

-- Highlight helper
local function clearHighlights()
    for _, c in ipairs(songListFrame:GetChildren()) do
        if c:IsA("TextButton") then
            c.Text = c.Text:gsub("▶ ", "   "):gsub("♪ ", "   ")
