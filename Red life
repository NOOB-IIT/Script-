local function snd(id, vol, pitch)
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = (vol or 0.5) * 1.6
        s.PlaybackSpeed = pitch or 1
        s.Parent = SoundService
        s:Play()
        Debris:AddItem(s, 4)
    end)
end

