RunService.Heartbeat:Connect(function()
    if not HUB.active then return end
    if not gui.Enabled then return end
    if AFB.Mode ~= "OFF" and AFB.SavedCFrame then
        local currentHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if currentHrp then
            local rot = getRotation(AFB.Mode)
            local sp = AFB.SavedCFrame.Position
            currentHrp.CFrame = CFrame.new(sp.X, AFB.HighY, sp.Z) * rot
            currentHrp.AssemblyLinearVelocity  = Vector3.zero
            currentHrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
    if not hrp or not hrp.Parent then return end
    if not humanoid or humanoid.Health <= 0 then return end
    updateFallOrigin()
    local pos = hrp.Position
    local voidY = workspace.FallenPartsDestroyHeight
    if typeof(voidY) ~= "number" or voidY ~= voidY or voidY == -math.huge or voidY == math.huge then
        voidY = -500
    end
    local triggerY = voidY + CONFIG.VoidDistance
    if CONFIG.RescueEnabled and not rescuing and AFB.Mode == "OFF" and pos.Y <= triggerY then
        task.spawn(doRescue)
    end
    statusLbl.Text = string.format("Y: %.0f | Void: %.0f\nOrigin: %s",
        pos.Y, voidY,
        fallOriginPos and string.format("%.0f,%.0f,%.0f", fallOriginPos.X, fallOriginPos.Y, fallOriginPos.Z) or "---")
    infoLbl.Text = "Mode: " .. AFB.Mode
end)

