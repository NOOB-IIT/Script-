-- Build song list
local function buildSongList(cat)
    for _, c in ipairs(songListFrame:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local songs = MUSIC_DB[cat] or {}
    for i, song in ipairs(songs) do
        local sb = Instance.new("TextButton")
        sb.Size = UDim2.new(1, -8, 0, 26)
        sb.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
        sb.Text = "▶  " .. song.name
        sb.TextColor3 = WHITE
        sb.Font = Enum.Font.GothamMedium
        sb.TextSize = 11
        sb.TextXAlignment = Enum.TextXAlignment.Left
        sb.BorderSizePixel = 0
        sb.Parent = songListFrame
        Instance.new("UICorner", sb).CornerRadius = UDim.new(0, 6)

        sb.MouseEnter:Connect(function()
            TweenService:Create(sb, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 50, 70)}):Play()
        end)
        sb.MouseLeave:Connect(function()
            if MusicPlayer.song ~= song then
                TweenService:Create(sb, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(28, 28, 35)}):Play()
            end
        end)
        sb.MouseButton1Click:Connect(function()
            click()
            MusicPlayer.activeTab = cat
            MusicPlayer.play(song)
            clearHighlights()
            sb.Text = "♪  " .. song.name
            sb.BackgroundColor3 = Color3.fromRGB(20, 70, 120)
        end)
    end
end

