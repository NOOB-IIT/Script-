    local holder = new("Frame", {
        Size = UDim2.fromOffset(220, 220),
        Position = UDim2.new(0.5, 0, 0.5, -20),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        ZIndex = 905,
        Parent = loading,
    })

    local ring = new("Frame", {
        Size = UDim2.fromOffset(140, 140),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        ZIndex = 905,
        Parent = holder,
    })
    corner(ring, 999)
    stroke(ring, State.currentTheme.accent, 3, 0.2)
    grad(ring, State.currentTheme.accent, State.currentTheme.userBubble, 0)

    local dots = {}
    local numDots = 12
    for i = 1, numDots do
        local angle = (i / numDots) * math.pi * 2
        local d = new("Frame", {
            Size = UDim2.fromOffset(4, 4),
            Position = UDim2.new(0.5, math.cos(angle) * 85, 0.5, math.sin(angle) * 85),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = State.currentTheme.accent,
            BackgroundTransparency = (i / numDots) * 0.8,
            BorderSizePixel = 0,
            ZIndex = 906,
            Parent = holder,
        })
        corner(d, 2)
        table.insert(dots, d)
    end

    local title = new("TextLabel", {
        Size = UDim2.fromOffset(400, 40),
        Position = UDim2.new(0.5, 0, 0.5, -10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Text = "RED HUB",
        Font = Enum.Font.GothamBlack,
        TextSize = 28,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextTransparency = 1,
        ZIndex = 910,
        Parent = holder,
    })

    local sub = new("TextLabel", {
        Size = UDim2.fromOffset(400, 18),
        Position = UDim2.new(0.5, 0, 0.5, 24),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Text = "Loading...",
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = Color3.fromRGB(160, 160, 180),
        TextTransparency = 1,
        ZIndex = 910,
        Parent = holder,
    })

    task.spawn(function()
        local rot = 0
        while loading.Parent do
            rot = rot + 0.04
            for i, d in ipairs(dots) do
                if not d.Parent then break end
                local a = (i / numDots) * math.pi * 2 + rot
                d.Position = UDim2.new(0.5, math.cos(a) * 85, 0.5, math.sin(a) * 85)
            end
            RunService.RenderStepped:Wait()
        end
    end)

    task.spawn(function()
        while loading.Parent and ring.Parent do
            tween(ring, 1.0, { Size = UDim2.fromOffset(160, 160) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1.0)
            if not (loading.Parent and ring.Parent) then break end
            tween(ring, 1.0, { Size = UDim2.fromOffset(140, 140) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
            task.wait(1.0)
        end
    end)

    tween(title, 0.6, { TextTransparency = 0 })
    tween(sub, 0.8, { TextTransparency = 0.3 })

    local steps = { "Initializing", "Secure channel", "Loading models", "Ready" }
    task.spawn(function()
        for _, s in ipairs(steps) do
            if not loading.Parent then return end
            sub.Text = s
            task.wait(0.6)
        end
        task.wait(0.2)
        tween(loading, 0.35, { BackgroundTransparency = 1 })
        for _, d in ipairs(loading:GetDescendants()) do
            pcall(function()
                if d:IsA("Frame") and d.BackgroundTransparency < 1 then tween(d, 0.3, { BackgroundTransparency = 1 }) end
                if d:IsA("TextLabel") then tween(d, 0.3, { TextTransparency = 1 }) end
                if d:IsA("UIStroke") then tween(d, 0.3, { Transparency = 1 }) end
            end)
        end
        task.wait(0.4)
        pcall(function() loading:Destroy() end)
        if onComplete and not State.killed then onComplete() end
    end)
end

