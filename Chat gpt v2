local function initMusic()
    pcall(function()
        State.musicSound = Instance.new("Sound")
        State.musicSound.Name = "RedHubMusic"
        State.musicSound.SoundId = CONFIG.MusicAsset
        State.musicSound.Volume = CONFIG.MusicVolume
        State.musicSound.Looped = true
        State.musicSound.Parent = SoundService
    end)
end

local function playMusic()
    pcall(function()
        if State.musicSound and not State.musicSound.IsPlaying then State.musicSound:Play() end
    end)
    State.musicOn = true
    if State.refreshMusicButtons then State.refreshMusicButtons() end
end

local function stopMusic()
    pcall(function() if State.musicSound then State.musicSound:Stop() end end)
    State.musicOn = false
    if State.refreshMusicButtons then State.refreshMusicButtons() end
end

local function destroyMusic()
    pcall(function()
        if State.musicSound then
            State.musicSound:Stop()
            State.musicSound:Destroy()
            State.musicSound = nil
        end
    end)
    State.musicOn = false
end

initMusic()

