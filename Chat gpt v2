                Text = "  Auto-verified session",
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextColor3 = Color3.fromRGB(180, 240, 200),
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 400,
                Parent = ScreenGui,
            })
            corner(toast, 8)
            task.wait(1.4)
            tween(toast, 0.3, { BackgroundTransparency = 1, TextTransparency = 1 })
            task.delay(0.4, function() pcall(function() toast:Destroy() end) end)
        else
            buildApiKeySystem(function()
                if State.killed then return end
                task.wait(0.15)
                buildMainWindow()
            end)
        end
    end)
