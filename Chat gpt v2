--=============================================================
local function sendToGroq(userText, chatScroll, layout, sendBtn)
    if not State.apiKey then
        addMessage(layout, "assistant", "No API key set.")
        return
    end
    if State.isTyping then return end
    State.isTyping = true
    sendBtn.Text = "·"

    table.insert(State.messages, { role = "user", content = userText })
    addMessage(layout, "user", userText)
    task.wait(0.1)
    local _, kill = showTyping(layout)
    task.wait(0.1)
    chatScroll.CanvasPosition = Vector2.new(0, chatScroll.CanvasSize.Y.Offset)

    local msgs = { { role = "system", content = State.currentModel.system } }
    for _, m in ipairs(State.messages) do table.insert(msgs, m) end

    local body = HttpService:JSONEncode({
        model = State.currentModel.id,
        messages = msgs,
        temperature = 0.7,
        max_tokens = State.currentModel.maxTokens,
    })

    local success, response = pcall(function()
        return HttpService:RequestAsync({
            Url = CONFIG.ApiEndpoint,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. State.apiKey,
            },
            Body = body,
        })
    end)

    kill()

    if success and response and response.Success then
        local ok, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if ok and decoded and decoded.choices and decoded.choices[1] then
            local reply = decoded.choices[1].message.content
            table.insert(State.messages, { role = "assistant", content = reply })
            addMessage(layout, "assistant", reply)
        else
            addMessage(layout, "assistant", "Failed to parse response.")
        end
    else
        local err = "Request failed."
        if response and response.Body then
            local ok, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if ok and decoded and decoded.error and decoded.error.message then
                err = decoded.error.message
            end
        end
        addMessage(layout, "assistant", err)
    end

    State.isTyping = false
    sendBtn.Text = "➤"
    task.wait(0.1)
    chatScroll.CanvasPosition = Vector2.new(0, chatScroll.CanvasSize.Y.Offset)
end

