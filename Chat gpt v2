local function startFlow()
    task.wait(0.15)

    buildKeySystem(function()
        task.wait(0.2)
        if State.killed then return end

        if State.apiKey and #State.apiKey > 10 then
            buildMainWindow()
            task.wait(0.3)
            local toast = new("TextLabel", {
                Size = UDim2.fromOffset(220, 32),
                Position = UDim2.new(0.5, -110, 0, 12),
                BackgroundColor3 = Color3.fromRGB(24, 40, 30),
