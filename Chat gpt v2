-- WHATSAPP-STYLE MESSAGE BUBBLE
--=============================================================
local function addMessage(layout, role, text)
    local isUser = (role == "user")
    local theme = State.currentTheme

    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        ZIndex = 5,
        Parent = layout.Parent,
    })

    -- Bubble color: user = theme.userBubble, AI = dark grey
    local bubbleColor = isUser and theme.userBubble or Color3.fromRGB(32, 32, 42)

    local bubble = new("TextLabel", {
        Size = UDim2.new(0.82, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = isUser and UDim2.new(1, 0, 0, 0) or UDim2.new(0, 0, 0, 0),
        AnchorPoint = isUser and Vector2.new(1, 0) or Vector2.new(0, 0),
        BackgroundColor3 = bubbleColor,
        BorderSizePixel = 0,
        Text = text,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = Color3.fromRGB(240, 240, 250),
        RichText = true,
        ZIndex = 6,
        Parent = row,
    })
    -- WhatsApp: sender's bubble has sharp bottom-right, receiver sharp bottom-left
    -- UICorner is uniform, so we use a smaller radius for bubble and add a small tail
    corner(bubble, 10)
    pad(bubble, 9, 13, 9, 13)

    -- WhatsApp-style small tail (a rotated square near bottom corner)
    local tailSize = 10
    local tail = new("Frame", {
        Size = UDim2.fromOffset(tailSize, tailSize),
        Position = isUser and UDim2.new(1, -tailSize/2 - 2, 1, -tailSize/2 - 2) or UDim2.new(0, tailSize/2 + 2, 1, -tailSize/2 - 2),
        AnchorPoint = isUser and Vector2.new(1, 1) or Vector2.new(0, 1),
        BackgroundColor3 = bubbleColor,
        BorderSizePixel = 0,
        Rotation = 45,
        ZIndex = 5,  -- behind bubble
        Parent = row,
    })

    -- Track user bubble for theme updates
    if isUser then
        table.insert(State.userBubbles, bubble)
    end

    bubble.TextTransparency = 1
    bubble.BackgroundTransparency = 1
    tail.BackgroundTransparency = 1
    tween(bubble, 0.25, { TextTransparency = 0, BackgroundTransparency = 0 })
    tween(tail, 0.25, { BackgroundTransparency = 0 })

    task.spawn(function()
        for _ = 1, 20 do
            task.wait(0.05)
            if not row.Parent then return end
            local h = bubble.AbsoluteSize.Y
            if h > 0 then
                row.Size = UDim2.new(1, 0, 0, math.max(h, 32))
                -- reposition tail to bottom of the bubble
                task.wait(0.05)
                if tail.Parent then
                    if isUser then
                        tail.Position = UDim2.new(1, -tailSize/2 - 2, 0, math.max(h, 32) - tailSize/2 - 2)
                    else
                        tail.Position = UDim2.new(0, tailSize/2 + 2, 0, math.max(h, 32) - tailSize/2 - 2)
                    end
                end
                break
            end
        end
    end)

    return row
end

local function showTyping(layout)
    local row = new("Frame", {
        Size = UDim2.new(0, 60, 0, 32),
        BackgroundColor3 = Color3.fromRGB(32, 32, 42),
        BorderSizePixel = 0,
        ZIndex = 5,
        Parent = layout.Parent,
    })
    corner(row, 10)
    stroke(row, Color3.fromRGB(45, 45, 60), 1, 0)

    local dots = {}
    for i = 1, 3 do
        local d = new("Frame", {
            Size = UDim2.fromOffset(6, 6),
            Position = UDim2.new(0, 12 + (i - 1) * 12, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = Color3.fromRGB(150, 150, 180),
            BorderSizePixel = 0,
            ZIndex = 6,
            Parent = row,
        })
        corner(d, 3)
        table.insert(dots, d)
    end

    local run = true
    task.spawn(function()
        while run and row.Parent do
            for i, d in ipairs(dots) do
                if not run or not row.Parent or not d.Parent then break end
                tween(d, 0.25, { Position = UDim2.new(0, 12 + (i - 1) * 12, 0.5, -5) }, Enum.EasingStyle.Sine)
                task.wait(0.13)
                if not run or not row.Parent or not d.Parent then break end
                tween(d, 0.25, { Position = UDim2.new(0, 12 + (i - 1) * 12, 0.5, 0) }, Enum.EasingStyle.Sine)
            end
        end
    end)
    return row, function() run = false pcall(function() row:Destroy() end) end
end

