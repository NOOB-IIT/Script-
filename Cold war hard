local function sendChatMessage(msg)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local textChannels = TextChatService:FindFirstChild("TextChannels")
			local channel = textChannels and textChannels:FindFirstChild("RBXGeneral")
			if channel then 
				channel:SendAsync(msg) 
			else
				local foundChannel = TextChatService:FindFirstChild("RBXGeneral", true)
				if foundChannel and foundChannel:IsA("TextChannel") then
					foundChannel:SendAsync(msg)
				end
			end
		else
			ChatService:Chat(workspace, msg, Enum.ChatColor.Blue)
		end
	end)
end

