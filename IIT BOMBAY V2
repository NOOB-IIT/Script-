local isUnVanishOpen = false

local function UpdateLayout()
    if isMinimized then
        ContentContainer.Visible = false
        MainFrame.Size = UDim2.new(0, 340, 0, 42)
        MinBtn.Text = "+"
        return
    end
    
    MinBtn.Text = "-"
    ContentContainer.Visible = true
    
    local yPos = 8
    
    VanishBox.Position = UDim2.new(0.06, 0, 0, yPos)
    yPos = yPos + 40
    
    DropdownBar.Position = UDim2.new(0.06, 0, 0, yPos)
    DropdownBar.Text = isOpen and "  Select Player  v" or "  Select Player  ^"
    yPos = yPos + 38
    
    if isOpen then
        ScrollFrame.Position = UDim2.new(0.06, 0, 0, yPos)
        ScrollFrame.Visible = true
        yPos = yPos + 104
    else
        ScrollFrame.Visible = false
    end
    
    VanishBtn.Position = UDim2.new(0.06, 0, 0, yPos)
    yPos = yPos + 46
    
    UnVanishBox.Position = UDim2.new(0.06, 0, 0, yPos)
    yPos = yPos + 40
    
    UnVanishDropdownBar.Position = UDim2.new(0.06, 0, 0, yPos)
    UnVanishDropdownBar.Text = isUnVanishOpen and "  Select Vanished Player  v" or "  Select Vanished Player  ^"
    yPos = yPos + 38
    
    if isUnVanishOpen then
        UnVanishScrollFrame.Position = UDim2.new(0.06, 0, 0, yPos)
        UnVanishScrollFrame.Visible = true
        yPos = yPos + 104
    else
        UnVanishScrollFrame.Visible = false
    end
    
    UnVanishBtn.Position = UDim2.new(0.06, 0, 0, yPos)
    yPos = yPos + 42
    
    Footer.Position = UDim2.new(0, 0, 0, yPos)
    yPos = yPos + 26
    
    ContentContainer.Size = UDim2.new(1, 0, 1, -42)
    MainFrame.Size = UDim2.new(0, 340, 0, 42 + yPos)
end

-- ==================== SYSTEM LOGIC ==================== --

local VanishedPlayers = {}
local HiddenCharacters = {}
local CharacterConnections = {}

-- Updates Normal Player List
local function UpdatePlayerList()
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local playerList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not VanishedPlayers[player.UserId] then
            table.insert(playerList, player)
        end
    end
    
    table.sort(playerList, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    
    local ySize = 0
    for _, player in ipairs(playerList) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new(1, -4, 0, 28)
        pBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
        pBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
        pBtn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")"
        pBtn.TextXAlignment = Enum.TextXAlignment.Left
        pBtn.TextSize = 12
        pBtn.Font = Enum.Font.Gotham
        pBtn.Parent = ScrollFrame
        
        pBtn.MouseButton1Click:Connect(function()
            VanishBox.Text = player.Name
            isOpen = false
            UpdateLayout()
        end)
        ySize = ySize + 32
    end
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

-- Updates Vanished Player List
local function UpdateUnVanishList()
    for _, child in pairs(UnVanishScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local vList = {}
    for userId, isV in pairs(VanishedPlayers) do
        if isV then
            local player = Players:GetPlayerByUserId(userId)
            if player then
                table.insert(vList, player)
            else
                VanishedPlayers[userId] = nil
                HiddenCharacters[userId] = nil
                if CharacterConnections[userId] then
                    CharacterConnections[userId]:Disconnect()
                    CharacterConnections[userId] = nil
                end
            end
        end
    end
    
    table.sort(vList, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
    
    local ySize = 0
    for _, player in ipairs(vList) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new(1, -4, 0, 28)
        pBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
        pBtn.TextColor3 = Color3.fromRGB(230, 230, 230)
        pBtn.Text = "  " .. player.DisplayName .. " (@" .. player.Name .. ")"
        pBtn.TextXAlignment = Enum.TextXAlignment.Left
        pBtn.TextSize = 12
        pBtn.Font = Enum.Font.Gotham
        pBtn.Parent = UnVanishScrollFrame
        
        pBtn.MouseButton1Click:Connect(function()
            UnVanishBox.Text = player.Name
            isUnVanishOpen = false
            UpdateLayout()
        end)
        ySize = ySize + 32
    end
    UnVanishScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ySize)
end

-- Actions
local function VanishTarget(inputName)
    local target = nil
    local cleanInput = string.lower(inputName):gsub("@", "")
    
    for _, p in pairs(Players:GetPlayers()) do
        if string.lower(p.Name) == cleanInput or string.lower(p.DisplayName) == cleanInput or 
           string.lower(p.Name):match("^" .. cleanInput) or string.lower(p.DisplayName):match("^" .. cleanInput) then
            target = p
            break
        end
    end

    if target and target ~= LocalPlayer then
        VanishedPlayers[target.UserId] = true
        
        local function hideChar(char)
            if char and char.Parent then
                HiddenCharacters[target.UserId] = char
                char.Parent = nil -- Local hiding (Preserves model & VC)
            end
        end

        if target.Character then
            hideChar(target.Character)
        end
        
        if not CharacterConnections[target.UserId] then
            CharacterConnections[target.UserId] = target.CharacterAdded:Connect(function(char)
                if VanishedPlayers[target.UserId] then
                    task.wait(0.1)
                    hideChar(char)
                end
            end)
        end

        UpdatePlayerList()
        UpdateUnVanishList()
        
        VanishBox.Text = "Success: " .. target.DisplayName
        task.wait(2)
        VanishBox.Text = ""
    else
        VanishBox.Text = "Player not found!"
        task.wait(1.5)
        VanishBox.Text = ""
    end
end

local function UnVanishTarget(inputName)
    local target = nil
    local cleanInput = string.lower(inputName):gsub("@", "")
    
    for userId, _ in pairs(VanishedPlayers) do
        local p = Players:GetPlayerByUserId(userId)
        if p and (string.lower(p.Name) == cleanInput or string.lower(p.DisplayName) == cleanInput or 
           string.lower(p.Name):match("^" .. cleanInput) or string.lower(p.DisplayName):match("^" .. cleanInput)) then
            target = p
            break
        end
    end

    if target then
        VanishedPlayers[target.UserId] = nil
        
        -- Restore character model & Voice Chat instantly
        local char = HiddenCharacters[target.UserId] or target.Character
        if char then
            char.Parent = workspace
        end
        HiddenCharacters[target.UserId] = nil
        
        if CharacterConnections[target.UserId] then
            CharacterConnections[target.UserId]:Disconnect()
            CharacterConnections[target.UserId] = nil
        end
        
        UpdatePlayerList()
        UpdateUnVanishList()
        
        UnVanishBox.Text = "Success: " .. target.DisplayName
        task.wait(2)
        UnVanishBox.Text = ""
    else
        UnVanishBox.Text = "Vanished player not found!"
        task.wait(1.5)
        UnVanishBox.Text = ""
    end
end

