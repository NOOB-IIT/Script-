-- Populate Players List
local function RefreshPlayersList()
	for _, child in ipairs(PlayersListFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 30)
			btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
			btn.TextColor3 = Color3.new(1, 1, 1)
			btn.Font = Enum.Font.SourceSans
			btn.Text = player.Name
			btn.Parent = PlayersListFrame

			btn.MouseButton1Click:Connect(function()
				PlayerNameBox.Text = player.Name
			end)
		end
	end
	PlayersListFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

RefreshPlayersList()

-- Physics Glue Logic
local bangConnection
local function BangPlayer(targetUsername, height, speed)
	local targetPlayer = Players:FindFirstChild(targetUsername)
	if not targetPlayer or not targetPlayer.Character then
		warn("Target player nahi mila ya character loaded nahi hai!")
		return
	end

	local myChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")

	if not myRoot or not targetRoot then return end

	bangConnection = RunService.Heartbeat:Connect(function()
		pcall(function()
			if sethiddenproperty then
				sethiddenproperty(myRoot, "PhysicsRepRootPart", targetRoot)
			end
		end)

		myRoot.CFrame = CFrame.new(targetRoot.Position + Vector3.new(0, height, 0)) * CFrame.Angles(-math.pi / 2, 0, 0)
		myRoot.AssemblyLinearVelocity = Vector3.new(speed, speed, speed)
		myRoot.AssemblyAngularVelocity = Vector3.new(speed, speed, speed)
	end)
end

-- Stop bang and reset
local function StopBang()
	if bangConnection then
		bangConnection:Disconnect()
		bangConnection = nil
	end

	local myChar = LocalPlayer.Character
	if myChar then
		local myRoot = myChar:FindFirstChild("HumanoidRootPart")
		if myRoot then
			pcall(function()
				if sethiddenproperty then
					sethiddenproperty(myRoot, "PhysicsRepRootPart", nil)
				end
			end)
			myRoot.AssemblyLinearVelocity = Vector3.zero
			myRoot.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

-- Start Button click
StartButton.MouseButton1Click:Connect(function()
	if minimized then
		toggleMinimize()
	end
	local targetName = PlayerNameBox.Text
	if targetName == "" then
		warn("Please enter a player name!")
		return
	end
	local heightValue = tonumber(string.match(HeightLabel.Text, "%d+")) or 5
	local speedValue = tonumber(string.match(SpeedLabel.Text, "%d+")) or 9999
	BangPlayer(targetName, heightValue, speedValue)
end)

