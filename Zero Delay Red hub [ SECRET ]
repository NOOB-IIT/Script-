--[[
    ============================================================
    Client-Side Weld Module
    ------------------------------------------------------------
    A lightweight weld system that attaches the local player's
    character to a target BasePart and maintains the attachment
    every frame using RenderStepped / Heartbeat.

    Dependencies:
        - Players
        - RunService
        - PhysicsService

    Notes:
        - Designed to run in a client environment (LocalScript
          or executor runtime).
        - Uses a dedicated collision group to isolate welded
          assemblies from the rest of the world.
    ============================================================
]]

local Players        = game:GetService("Players")
local RunService     = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")

local localplr = Players.LocalPlayer

-- ------------------------------------------------------------
-- Configuration
-- ------------------------------------------------------------
-- Offset applied to the target part when positioning the root.
WeldOffset      = CFrame.new(0, 0, 1.3)

-- Linear velocity applied to the root while welded.
WeldVelocity    = Vector3.new(0, 0, 0)

-- Optional animation played on the character during the weld.
WeldAnimID      = 0

-- Determines whether the camera focuses on the welded part.
ViewPartOnWeld  = true

-- When enabled, uses the high-compatibility weld implementation
-- (LowsUNCWeldTo). Recommended for most environments.
LSS             = true

-- Reference to the active weld instance.
CurrentWeld     = nil

-- ------------------------------------------------------------
-- Collision Group Setup
-- ------------------------------------------------------------
-- A randomized group name is generated to avoid clashing with
-- any groups already registered by the game.
local WELD_GROUP = (function()
    local buff    = buffer.create(20)
    local charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

    for i = 1, 20 do
        buffer.writeu8(buff, i - 1, string.byte(charset, math.random(1, #charset)))
    end

    return buffer.tostring(buff)
end)()

pcall(function()
    PhysicsService:RegisterCollisionGroup(WELD_GROUP)
    PhysicsService:CollisionGroupSetCollidable(WELD_GROUP, WELD_GROUP, true)
end)

-- ------------------------------------------------------------
-- Configuration Setters
-- ------------------------------------------------------------
function changeWeldOffset(cfr)
    WeldOffset = cfr
end

function changeWeldVelocity(vec)
    WeldVelocity = vec
end

function changeWeldAnim(id)
    WeldAnimID = id
    if CurrentWeld then
        CurrentWeld.UpdateAnim()
    end
end

-- ============================================================
-- Function: LowsUNCWeldTo
-- ------------------------------------------------------------
-- Primary weld implementation. Temporarily reparents the target
-- part to workspace.Terrain, disables its joints, and pins the
-- character's root to the target every frame.
--
-- This approach is resilient across a wide range of executor
-- environments and minimizes interference from the server's
-- default physics replication.
-- ============================================================
function LowsUNCWeldTo(Part, OverwriteVPOW)
    if not Part.Parent then
        return
    end

    -- If the target is a player character, disable the neck joint
    -- so the character does not resist the weld.
    if Players:GetPlayerFromCharacter(Part.Parent) then
        local Humanoid = Part.Parent:FindFirstChildWhichIsA("Humanoid")
        if Humanoid then
            Humanoid.RequiresNeck = false
        end
    end

    local Character = localplr.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local Root  = Character.HumanoidRootPart.AssemblyRootPart
    local Start = CFrame.new(Root.Position)

    local Weld         = {}
    local Enabled      = false
    local PartJoints   = {}
    local OldProps     = {}
    local OldCharProps = {}

    Weld.Part = Part

    -- Optional animation playback.
    local AnimTrack = nil
    if WeldAnimID then
        local Animator = Character:FindFirstChildWhichIsA("Animator", true)
        if Animator then
            local Animation   = Instance.new("Animation")
            Animation.AnimationId = "rbxassetid://" .. tostring(WeldAnimID)
            AnimTrack = Animator:LoadAnimation(Animation)
            AnimTrack:Play()
        end
    end

    -- --------------------------------------------------------
    -- Weld:Enable
    -- Applies or reverts the modified state of the target part
    -- and the character's body parts.
    -- --------------------------------------------------------
    function Weld:Enable(toggle)
        Enabled = toggle

        if not toggle then
            -- Restore original joints, part properties, and
            -- character collision settings.
            for _, Joint in next, PartJoints do
                Joint.Enabled = true
            end

            for PropName, Value in next, OldProps do
                Part[PropName] = Value
            end

            for part, props in next, OldCharProps do
                if not part or not part.Parent then
                    continue
                end
                part.CollisionGroup = props.Group
                part.CanCollide      = props.Collide
            end
            return
        end

        -- Cache existing joints so they can be restored later.
        PartJoints = Part:GetJoints()

        -- Cache original part properties.
        for _, PropName in next, {"Size", "CanCollide", "Anchored", "Parent", "CollisionGroup"} do
            OldProps[PropName] = Part[PropName]
        end

        -- Cache and modify character part collision state.
        for _, p in next, Character:GetDescendants() do
            if not p:IsA("BasePart") then
                continue
            end

            OldCharProps[p] = {
                Group   = p.CollisionGroup,
                Collide = p.CanCollide,
            }

            p.CollisionGroup = WELD_GROUP
            p.CanCollide     = true
        end

        -- Prepare the target part for the weld.
        Part.Size           = Vector3.new(25, 3, 25)
        Part.Anchored       = false
        Part.CanCollide     = true
        Part.CollisionGroup = WELD_GROUP
        Part.Parent         = workspace.Terrain

        -- Disable the target's original joints so nothing else
        -- attempts to move it.
        for _, Joint in next, PartJoints do
            Joint.Enabled = false
        end
    end

    -- Determine whether the camera should follow the welded part.
    local ViewPartOnWeldC = ViewPartOnWeld
    if OverwriteVPOW ~= nil then
        ViewPartOnWeldC = OverwriteVPOW
    end

    local OldSubject = workspace.CurrentCamera.CameraSubject
    if ViewPartOnWeldC then
        workspace.CurrentCamera.CameraSubject = Part
    end

    -- --------------------------------------------------------
    -- Weld.UpdateAnim
    -- Reloads the currently assigned animation on demand.
    -- --------------------------------------------------------
    function Weld.UpdateAnim()
        local Animator = Character:FindFirstChildWhichIsA("Animator", true)
        if Animator then
            if AnimTrack then
                AnimTrack:Stop()
                AnimTrack:Destroy()
            end

            local Animation = Instance.new("Animation")
            Animation.AnimationId = "rbxassetid://" .. tostring(WeldAnimID)
            AnimTrack = Animator:LoadAnimation(Animation)
            AnimTrack:Play()
        end
    end

    -- --------------------------------------------------------
    -- Weld:Destroy
    -- Terminates the weld thread and restores all modified state.
    -- --------------------------------------------------------
    local thread = nil

    function Weld:Destroy()
        workspace.CurrentCamera.CameraSubject = OldSubject

        if thread then
            task.cancel(thread)
        end

        Weld:Enable(false)

        if AnimTrack then
            AnimTrack:Stop()
            AnimTrack:Destroy()
        end
    end

    -- --------------------------------------------------------
    -- Main Loop
    -- Continuously anchors the character to the target's CFrame
    -- while zeroing out unwanted velocities.
    -- --------------------------------------------------------
    thread = task.spawn(function()
        while task.wait() do
            if not Enabled then
                continue
            end

            Part.CFrame = Start
            Root.CFrame = Start * WeldOffset

            Part.AssemblyLinearVelocity  = Vector3.zero
            Part.AssemblyAngularVelocity = Vector3.zero
            Root.AssemblyLinearVelocity  = WeldVelocity
            Root.AssemblyAngularVelocity = Vector3.zero

            RunService.RenderStepped:Wait()

            Part.CFrame = Start
            Root.CFrame = Start * CFrame.new(0, 4, 0)

            Part.AssemblyLinearVelocity  = Vector3.zero
            Part.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    Weld:Enable(true)
    CurrentWeld = Weld

    return Weld
end

-- ============================================================
-- Function: WeldTo
-- ------------------------------------------------------------
-- Public entry point. Delegates to LowsUNCWeldTo when LSS is
-- enabled; otherwise uses a Heartbeat-driven fallback that pins
-- the root to the target part each frame.
-- ============================================================
function WeldTo(TargetPart, OverwriteVPOW)
    if LSS then
        return LowsUNCWeldTo(TargetPart, OverwriteVPOW)
    end

    local Character = localplr.Character
    if not Character then
        return nil
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then
        return nil
    end

    -- Optional animation playback.
    local AnimTrack = nil
    if WeldAnimID then
        local Animator = Character:FindFirstChildWhichIsA("Animator", true)
        if Animator then
            local Animation   = Instance.new("Animation")
            Animation.AnimationId = "rbxassetid://" .. tostring(WeldAnimID)
            AnimTrack = Animator:LoadAnimation(Animation)
            AnimTrack:Play()
        end
    end

    local Weld       = {}
    local Connection = nil

    Weld.Part = TargetPart

    -- Disable collision on character parts to prevent
    -- unintended pushback during the weld.
    for _, v in pairs(Character:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.Massless   = true
        end
    end

    -- Reapply root positioning every Heartbeat tick.
    Connection = RunService.Heartbeat:Connect(function()
        if not Character or not TargetPart or not Character.Parent or not TargetPart.Parent then
            if Weld.Destroy then
                Weld:Destroy()
            end
            return
        end

        Root.CFrame = TargetPart.CFrame * WeldOffset
        Root.AssemblyLinearVelocity  = WeldVelocity
        Root.AssemblyAngularVelocity = Vector3.zero

        -- Notify the physics replication system of the new root
        -- when supported by the host environment.
        if sethiddenproperty then
            pcall(function()
                sethiddenproperty(Root, "PhysicsRepRootPart", TargetPart)
            end)
        end
    end)

    -- Determine whether the camera should follow the welded part.
    local ViewPartOnWeldC = ViewPartOnWeld
    if OverwriteVPOW ~= nil then
        ViewPartOnWeldC = OverwriteVPOW
    end

    local OldSubject = workspace.CurrentCamera.CameraSubject
    if ViewPartOnWeldC then
        workspace.CurrentCamera.CameraSubject = TargetPart
    end

    -- --------------------------------------------------------
    -- Weld.UpdateAnim
    -- --------------------------------------------------------
    function Weld.UpdateAnim()
        local Animator = Character:FindFirstChildWhichIsA("Animator", true)
        if Animator then
            if AnimTrack then
                AnimTrack:Stop()
                AnimTrack:Destroy()
            end

            local Animation = Instance.new("Animation")
            Animation.AnimationId = "rbxassetid://" .. tostring(WeldAnimID)
            AnimTrack = Animator:LoadAnimation(Animation)
            AnimTrack:Play()
        end
    end

    -- --------------------------------------------------------
    -- Weld:Destroy
    -- --------------------------------------------------------
    function Weld:Destroy()
        workspace.CurrentCamera.CameraSubject = OldSubject

        if Connection then
            Connection:Disconnect()
        end

        if AnimTrack then
            AnimTrack:Stop()
            AnimTrack:Destroy()
        end

        if Root then
            Root.AssemblyLinearVelocity  = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
        end
    end

    CurrentWeld = Weld
    return Weld
end

-- ============================================================
-- Function: Unweld
-- ------------------------------------------------------------
-- Clears the active weld instance and releases all references.
-- ============================================================
function Unweld()
    if CurrentWeld then
        CurrentWeld:Destroy()
        CurrentWeld = nil
    end
end

-- ============================================================
-- Usage Example
-- ------------------------------------------------------------
-- Attach the local character to a target player's root part:
--
--     local target = Players:FindFirstChild("PlayerName")
--     if target and target.Character then
--         local root = target.Character:FindFirstChild("HumanoidRootPart")
--         if root then
--             Unweld()
--             WeldTo(root)
--         end
--     end
--
-- To release the weld:
--
--     Unweld()
-- ============================================================
