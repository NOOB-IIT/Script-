-- 7. HOSTEL BUILDING GENERATOR (WITH EXTERIOR SIGNBOARDS)
-----------------------------------------------------------------------
local function buildHostelBuilding(buildingName, buildingCFrame, wallColorName, hostelDisplayName)
	local buildingFolder = Instance.new("Folder")
	buildingFolder.Name = buildingName
	buildingFolder.Parent = MainFolder

	local halfRooms = ROOMS_PER_FLOOR / 2
	local totalBuildingWidth = halfRooms * ROOM_W
	local totalBuildingDepth = (ROOM_D * 2) + HALLWAY_W
	
	local liftDepth = 14
	local liftWidth = HALLWAY_W

	for floor = 1, FLOORS do
		local floorY = (floor - 1) * ROOM_H + (ROOM_H / 2)
		local floorCFrame = buildingCFrame * CFrame.new(0, floorY, 0)
		local floorFolder = Instance.new("Folder")
		floorFolder.Name = "Floor_" .. tostring(floor)
		floorFolder.Parent = buildingFolder

		createPart("CorridorFloor", Vector3.new(totalBuildingWidth, WALL_THICK, HALLWAY_W), floorCFrame * CFrame.new(0, -ROOM_H/2 + WALL_THICK/2, 0), "Dark stone grey", Enum.Material.Concrete, floorFolder)
		createPart("CorridorCeiling", Vector3.new(totalBuildingWidth, WALL_THICK, HALLWAY_W), floorCFrame * CFrame.new(0, ROOM_H/2 - WALL_THICK/2, 0), "Institutional white", Enum.Material.SmoothPlastic, floorFolder)

		for cl = -1, 1 do
			local corrLamp = createPart("CorridorLamp", Vector3.new(4, 0.3, 1.5), floorCFrame * CFrame.new(cl * 35, ROOM_H/2 - 0.4, 0), "Institutional white", Enum.Material.Neon, floorFolder)
			local cLight = Instance.new("PointLight", corrLamp)
			cLight.Brightness = 0.5 
			cLight.Range = 18 
			cLight.Color = Color3.fromRGB(255, 250, 230)
		end

		-- Elevator Setup
		local eleCabinCF = floorCFrame * CFrame.new(-totalBuildingWidth/2 - liftDepth/2, 0, 0)
		createPart("EleFloor", Vector3.new(liftDepth, WALL_THICK, liftWidth), eleCabinCF * CFrame.new(0, -ROOM_H/2 + WALL_THICK/2, 0), "Really black", Enum.Material.SmoothPlastic, floorFolder)
		createPart("EleCeil", Vector3.new(liftDepth, WALL_THICK, liftWidth), eleCabinCF * CFrame.new(0, ROOM_H/2 - WALL_THICK/2, 0), "Really black", Enum.Material.SmoothPlastic, floorFolder)

		createPart("EleWallBack", Vector3.new(WALL_THICK, ROOM_H, liftWidth), eleCabinCF * CFrame.new(-liftDepth/2 + WALL_THICK/2, 0, 0), "Dark stone grey", Enum.Material.Concrete, floorFolder)
		createPart("EleWallSide1", Vector3.new(liftDepth, ROOM_H, WALL_THICK), eleCabinCF * CFrame.new(0, 0, liftWidth/2 - WALL_THICK/2), "Dark stone grey", Enum.Material.Concrete, floorFolder)
		createPart("EleWallSide2", Vector3.new(liftDepth, ROOM_H, WALL_THICK), eleCabinCF * CFrame.new(0, 0, -liftWidth/2 + WALL_THICK/2), "Dark stone grey", Enum.Material.Concrete, floorFolder)

		local doorWidth = 10
		local sideWallW = (liftWidth - doorWidth) / 2
		local frontX = liftDepth/2 - WALL_THICK/2

		createPart("EleFrontL", Vector3.new(WALL_THICK, ROOM_H, sideWallW), eleCabinCF * CFrame.new(frontX, 0, -liftWidth/2 + sideWallW/2), "Medium stone grey", Enum.Material.Concrete, floorFolder)
		createPart("EleFrontR", Vector3.new(WALL_THICK, ROOM_H, sideWallW), eleCabinCF * CFrame.new(frontX, 0, liftWidth/2 - sideWallW/2), "Medium stone grey", Enum.Material.Concrete, floorFolder)
		createPart("EleFrontTop", Vector3.new(WALL_THICK, ROOM_H - 8, doorWidth), eleCabinCF * CFrame.new(frontX, ROOM_H/2 - (ROOM_H - 8)/2, 0), "Medium stone grey", Enum.Material.Concrete, floorFolder)

		local liftLight = Instance.new("PointLight")
		liftLight.Brightness = 0.5  
		liftLight.Range = 20
		liftLight.Color = Color3.fromRGB(255, 255, 255)
		liftLight.Parent = createPart("LiftRoofLight", Vector3.new(4, 0.2, 4), eleCabinCF * CFrame.new(0, ROOM_H/2 - 0.5, 0), "Ghost grey", Enum.Material.Neon, floorFolder)

		local eleDoorL = createPart("EleDoorL", Vector3.new(0.4, 8, doorWidth/2), eleCabinCF * CFrame.new(frontX, -ROOM_H/2 + 4, -doorWidth/4), "Ghost grey", Enum.Material.SmoothPlastic, floorFolder)
		local eleDoorR = createPart("EleDoorR", Vector3.new(0.4, 8, doorWidth/2), eleCabinCF * CFrame.new(frontX, -ROOM_H/2 + 4, doorWidth/4), "Ghost grey", Enum.Material.SmoothPlastic, floorFolder)
		
		local closedCFL = eleDoorL.CFrame
		local closedCFR = eleDoorR.CFrame
		local openCFL = closedCFL * CFrame.new(0, 0, -doorWidth/2 + 0.2)
		local openCFR = closedCFR * CFrame.new(0, 0, doorWidth/2 - 0.2)
		
		eleDoorL:SetAttribute("ClosedCF", closedCFL)
		eleDoorL:SetAttribute("OpenCF", openCFL)
		eleDoorR:SetAttribute("ClosedCF", closedCFR)
		eleDoorR:SetAttribute("OpenCF", openCFR)

		local doorBtnX = frontX + 0.45 
		local doorBtn = createPart("EleDoorBtn", Vector3.new(0.5, 1.8, 1.4), eleCabinCF * CFrame.new(doorBtnX, -1, doorWidth/2 + 1.2), "Really black", Enum.Material.SmoothPlastic, floorFolder)
		createPart("BtnLight", Vector3.new(0.55, 0.8, 0.8), eleCabinCF * CFrame.new(doorBtnX, -1, doorWidth/2 + 1.2), "Bright red", Enum.Material.Neon, floorFolder)
		
		local doorPrompt = Instance.new("ProximityPrompt", doorBtn)
		doorPrompt.ActionText = "Call Lift"
		doorPrompt.ObjectText = "Floor " .. tostring(floor) .. " Elevator"
		doorPrompt.MaxActivationDistance = 15
		doorPrompt.RequiresLineOfSight = false 

		doorPrompt.Triggered:Connect(function(player)
			doorPrompt.Enabled = false 
			task.wait(3)
			TweenService:Create(eleDoorL, TweenInfo.new(0.8), {CFrame = openCFL}):Play()
			TweenService:Create(eleDoorR, TweenInfo.new(0.8), {CFrame = openCFR}):Play()
			
			task.wait(4)
			TweenService:Create(eleDoorL, TweenInfo.new(0.8), {CFrame = closedCFL}):Play()
			TweenService:Create(eleDoorR, TweenInfo.new(0.8), {CFrame = closedCFR}):Play()
			
			task.wait(4)
			if isPlayerInsideCabin(player, eleCabinCF, Vector3.new(liftDepth, ROOM_H, liftWidth)) then
				attentionSound:Play()
				openElevatorGui(player, buildingCFrame, floorFolder, totalBuildingWidth, liftDepth, liftWidth, eleCabinCF)
			end
			doorPrompt.Enabled = true
		end)

		local panelBtn = createPart("EleInsideBtn", Vector3.new(0.5, 1.8, 1.4), eleCabinCF * CFrame.new(-liftDepth/2 + 0.4, -1, 0), "Really black", Enum.Material.SmoothPlastic, floorFolder)
		createPart("PanelLight", Vector3.new(0.6, 0.8, 0.8), eleCabinCF * CFrame.new(-liftDepth/2 + 0.4, -1, 0), "Bright red", Enum.Material.Neon, floorFolder)
		
		local panelPrompt = Instance.new("ProximityPrompt", panelBtn)
		panelPrompt.ActionText = "Open Panel"
		panelPrompt.ObjectText = "Lift Controls"
		panelPrompt.MaxActivationDistance = 15
		panelPrompt.RequiresLineOfSight = false

		panelPrompt.Triggered:Connect(function(player)
			openElevatorGui(player, buildingCFrame, floorFolder, totalBuildingWidth, liftDepth, liftWidth, eleCabinCF)
		end)

		-- Rooms Construction
		for r = 1, ROOMS_PER_FLOOR do
			local isSideA = (r <= halfRooms)
			local rIndex = isSideA and r or (r - halfRooms)
			local xOffset = (rIndex - 0.5 - (halfRooms / 2)) * ROOM_W
			local zOffset = isSideA and (HALLWAY_W/2 + ROOM_D/2) or -(HALLWAY_W/2 + ROOM_D/2)

			local roomCFrame = floorCFrame * CFrame.new(xOffset, 0, zOffset)
			if not isSideA then roomCFrame = roomCFrame * CFrame.Angles(0, math.rad(180), 0) end

			local roomFolder = Instance.new("Folder")
			roomFolder.Name = "Room_" .. tostring((floor * 100) + r)
			roomFolder.Parent = floorFolder
			buildSingleRoom(roomCFrame, (floor * 100) + r, wallColorName, (floor == 1), roomFolder)
		end
		task.wait(0.01)
	end

	-- Roof & Outer Walls
	local roomSideDepth = ROOM_D
	createPart("LeftEndWallBack", Vector3.new(WALL_THICK, FLOORS * ROOM_H, roomSideDepth), buildingCFrame * CFrame.new(-totalBuildingWidth/2 - WALL_THICK/2, (FLOORS*ROOM_H)/2, HALLWAY_W/2 + ROOM_D/2), wallColorName, Enum.Material.SmoothPlastic, buildingFolder)
	createPart("LeftEndWallFront", Vector3.new(WALL_THICK, FLOORS * ROOM_H, roomSideDepth), buildingCFrame * CFrame.new(-totalBuildingWidth/2 - WALL_THICK/2, (FLOORS*ROOM_H)/2, -HALLWAY_W/2 - ROOM_D/2), wallColorName, Enum.Material.SmoothPlastic, buildingFolder)
	
	local upperHeight = (FLOORS - 1) * ROOM_H
	createPart("RightEndWallUpper", Vector3.new(WALL_THICK, upperHeight, totalBuildingDepth), buildingCFrame * CFrame.new(totalBuildingWidth/2 + WALL_THICK/2, ROOM_H + upperHeight/2, 0), wallColorName, Enum.Material.SmoothPlastic, buildingFolder)

	local roofY = FLOORS * ROOM_H + 0.5
	createPart("TerraceFloor", Vector3.new(totalBuildingWidth + 4, 1.2, totalBuildingDepth + 4), buildingCFrame * CFrame.new(0, roofY, 0), "Dark stone grey", Enum.Material.Concrete, buildingFolder)

	-- Ground Level Exterior Signboard (Hostel Name)
	local nameBoard = createPart("HostelNameBoard", Vector3.new(42, 5, 0.8), buildingCFrame * CFrame.new(0, 8, -totalBuildingDepth/2 - 0.5), "Really black", Enum.Material.SmoothPlastic, buildingFolder)
	local sgSign = Instance.new("SurfaceGui", nameBoard)
	sgSign.Face = Enum.NormalId.Front
	local txtSign = Instance.new("TextLabel", sgSign)
	txtSign.Size = UDim2.new(1, -20, 1, -10)
	txtSign.Position = UDim2.new(0, 10, 0, 5)
	txtSign.BackgroundTransparency = 1
	txtSign.Text = hostelDisplayName
	txtSign.TextColor3 = Color3.fromRGB(255, 215, 0)
	txtSign.TextScaled = true
	txtSign.Font = Enum.Font.GothamBold
end

