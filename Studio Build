local isGateBusy = false
local function toggleMainGate()
	if isGateBusy then return end
	isGateBusy = true
	
	TweenService:Create(gateDoorL, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = openCFL}):Play()
	TweenService:Create(gateDoorR, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = openCFR}):Play()
	
	task.wait(4.5)
	
	TweenService:Create(gateDoorL, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {CFrame = closedCFL}):Play()
	TweenService:Create(gateDoorR, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {CFrame = closedCFR}):Play()
	
	task.wait(1.3)
	isGateBusy = false
end

