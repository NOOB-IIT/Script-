-- 8. INTERACTION MANAGER
-----------------------------------------------------------------------
MainFolder.DescendantAdded:Connect(function(child)
	if child:IsA("ProximityPrompt") then
		child.Triggered:Connect(function(player)
			local action = child.ActionText
			local parentPart = child.Parent
			
			if action == "Open / Close" then
				local isOpen = not (parentPart:GetAttribute("IsOpen") or false)
				parentPart:SetAttribute("IsOpen", isOpen)
				
				local closedCF = parentPart:GetAttribute("ClosedCF")
				local pivotOffset = CFrame.new(-parentPart.Size.X/2, 0, 0)
				local pivotWorld = closedCF * pivotOffset
				
				local targetCF = isOpen and (pivotWorld * CFrame.Angles(0, math.rad(90), 0) * pivotOffset:Inverse()) or closedCF
				TweenService:Create(parentPart, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = targetCF}):Play()

			elseif action == "Toggle Lamp" then
				local pointLight = parentPart:FindFirstChildWhichIsA("PointLight")
				if pointLight then
					pointLight.Enabled = not pointLight.Enabled
					parentPart.Material = pointLight.Enabled and Enum.Material.Neon or Enum.Material.SmoothPlastic
				end

			elseif action == "Toggle Fan" then
				local blades = parentPart.Parent:FindFirstChild("FanBlades")
				if blades then
					blades:SetAttribute("IsSpinning", not (blades:GetAttribute("IsSpinning") or false))
				end
			end
		end)
	end
end)

RunService.Heartbeat:Connect(function()
	for _, desc in ipairs(MainFolder:GetDescendants()) do
		if desc.Name == "FanBlades" and desc:GetAttribute("IsSpinning") then
			desc.CFrame = desc.CFrame * CFrame.Angles(0, math.rad(18), 0)
		end
	end
end)

