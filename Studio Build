-- HELPER FUNCTIONS
-----------------------------------------------------------------------
local function createPart(name, size, cframe, color, material, parent, anchored, transparency)
	local part = Instance.new("Part")
	part.Name = name or "Part"
	part.Size = size
	part.CFrame = cframe
	part.BrickColor = BrickColor.new(color)
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = (anchored == nil) and true or anchored
	part.Transparency = transparency or 0
	part.Parent = parent
	return part
end

local function createSeat(name, size, cframe, parent)
	local seat = Instance.new("Seat")
	seat.Name = name or "ChairSeat"
	seat.Size = size
	seat.CFrame = cframe
	seat.Anchored = true
	seat.Transparency = 1
	seat.Parent = parent
	return seat
end

local function createPoster(name, size, cframe, text, fontColor, bgColor, parent)
	local framePart = createPart(name, size, cframe, bgColor, Enum.Material.SmoothPlastic, parent)
	local sg = Instance.new("SurfaceGui", framePart)
	sg.Face = Enum.NormalId.Front
	
	local label = Instance.new("TextLabel", sg)
	label.Size = UDim2.new(1, -10, 1, -10)
	label.Position = UDim2.new(0, 5, 0, 5)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = fontColor
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextWrapped = true
	return framePart
end

