	title.Parent = frame

	local monitorConn
	monitorConn = RunService.Heartbeat:Connect(function()
		if not isPlayerInsideCabin(player, cabinCF, Vector3.new(liftDepth, ROOM_H, liftWidth)) then
			if sg and sg.Parent then sg:Destroy() end
			if monitorConn then monitorConn:Disconnect() end
		end
	end)

	for f = 1, FLOORS do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.85, 0, 0, 42)
		btn.Position = UDim2.new(0.075, 0, 0, 55 + (f - 1) * 47)
		btn.Text = "FLOOR " .. tostring(f) .. (f == 1 and " (GROUND)" or "")
		btn.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.GothamBold
		btn.TextSize = 16
		btn.Parent = frame

		btn.MouseButton1Click:Connect(function()
			if monitorConn then monitorConn:Disconnect() end
			sg:Destroy() 
			
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				task.wait(4)
				local targetY = (f - 1) * ROOM_H + (ROOM_H / 2)
				local targetCabinCF = buildingCFrame * CFrame.new(-totalBuildingWidth/2 - liftDepth/2, targetY, 0)
				player.Character:PivotTo(targetCabinCF * CFrame.new(0, -ROOM_H/2 + 3, 0))

				local buildingFolder = currentFloorFolder.Parent
				local targetFloorFolder = buildingFolder:FindFirstChild("Floor_" .. tostring(f))
				if targetFloorFolder then
					local tDoorL = targetFloorFolder:FindFirstChild("EleDoorL")
					local tDoorR = targetFloorFolder:FindFirstChild("EleDoorR")
					
					if tDoorL and tDoorR then
						task.wait(0.5)
						TweenService:Create(tDoorL, TweenInfo.new(0.8), {CFrame = tDoorL:GetAttribute("OpenCF")}):Play()
						TweenService:Create(tDoorR, TweenInfo.new(0.8), {CFrame = tDoorR:GetAttribute("OpenCF")}):Play()

						task.delay(4, function()
							TweenService:Create(tDoorL, TweenInfo.new(0.8), {CFrame = tDoorL:GetAttribute("ClosedCF")}):Play()
							TweenService:Create(tDoorR, TweenInfo.new(0.8), {CFrame = tDoorR:GetAttribute("ClosedCF")}):Play()
						end)
					end
				end
			end
		end)
	end
	sg.Parent = pGui
end

