local function isPlayerInsideCabin(player, cabinCF, cabinSize)
	if not (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) then return false end
	local pPos = player.Character.HumanoidRootPart.Position
	local localPos = cabinCF:PointToObjectSpace(pPos)
	return (math.abs(localPos.X) <= cabinSize.X / 2) and (math.abs(localPos.Z) <= cabinSize.Z / 2)
end

