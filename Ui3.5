function RedTheme.Get(key)
    local cur = RedTheme.Palettes[RedTheme.CurrentThemeName] or RedTheme.Palettes["Crimson Eclipse"]
    return cur[key] or Color3.fromRGB(255, 255, 255)
end

function RedTheme.Bind(instance, property, colorKey)
    table.insert(RedTheme.Listeners, {
        Instance = instance,
        Property = property,
        ColorKey = colorKey
    })
    pcall(function()
        instance[property] = RedTheme.Get(colorKey)
    end)
end

function RedTheme.SetTheme(name)
    if not RedTheme.Palettes[name] then return end
    RedTheme.CurrentThemeName = name
    for i = #RedTheme.Listeners, 1, -1 do
        local l = RedTheme.Listeners[i]
        if l.Instance and l.Instance.Parent then
            pcall(function()
                TweenService:Create(l.Instance, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    [l.Property] = RedTheme.Get(l.ColorKey)
                }):Play()
            end)
        else
            table.remove(RedTheme.Listeners, i)
        end
    end
    RedAudio.Play("TabSwitch")
end

-- Tween Helper Library
local RedTween = {}
function RedTween.Play(instance, duration, props, style, direction)
    style = style or Enum.EasingStyle.Quad
    direction = direction or Enum.EasingDirection.Out
    local t = TweenService:Create(instance, TweenInfo.new(duration, style, direction), props)
    t:Play()
    return t
end

function RedTween.Spring(instance, duration, props)
    return RedTween.Play(instance, duration, props, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

