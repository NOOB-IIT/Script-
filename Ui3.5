local function RenderFriends()
    for _, child in ipairs(friendsScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local list = RedTelemetry.FriendsOnlineList

    -- EMPTY STATE: When user has 0 friends currently online
    if #list == 0 then
        local emptyCard = Instance.new("Frame")
        emptyCard.Size = UDim2.new(1, 0, 0, 120)
        emptyCard.BackgroundColor3 = Color3.fromRGB(15, 12, 19)
        emptyCard.BorderSizePixel = 0
        emptyCard.Parent = friendsScroll
        RedUI.Corner(emptyCard, 14)
        RedUI.Stroke(emptyCard, RedTheme.Get("CardStroke"), 1.2)

        local eTitle = RedUI.Label(emptyCard, "NO FRIENDS CURRENTLY ONLINE RIGHT NOW", UDim2.new(1, -24, 0, 20), UDim2.new(0, 16, 0, 14), Enum.Font.GothamBlack, 12, RedTheme.Get("Accent"))
        local eDesc = RedUI.Label(emptyCard, "None of your Roblox friends are currently in a game or online on the website/app.", UDim2.new(1, -24, 0, 16), UDim2.new(0, 16, 0, 38), Enum.Font.GothamMedium, 10, RedTheme.Get("TextSecondary"))
        local eNote = RedUI.Label(emptyCard, "Checked directly across your Roblox account social graph. Click REFRESH to re-scan.", UDim2.new(1, -24, 0, 16), UDim2.new(0, 16, 0, 58), Enum.Font.GothamMedium, 9, RedTheme.Get("TextMuted"))

        local recheckBtn = RedUI.Button(emptyCard, "RE-CHECK FRIENDS", UDim2.new(0, 130, 0, 24), UDim2.new(0, 16, 0, 82), RedTheme.Get("Accent"), Color3.fromRGB(255, 255, 255), 9, function()
            RedAudio.Play("PulseRecalc")
            RedTelemetry.FetchRealFriendsOnline()
        end)
        return
    end

    -- RENDER ACTUAL FRIENDS ONLY
    for _, fr in ipairs(list) do
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, 56)
        card.BackgroundColor3 = Color3.fromRGB(15, 12, 19)
        card.BorderSizePixel = 0
        card.Parent = friendsScroll
        RedUI.Corner(card, 12)
        RedUI.Stroke(card, fr.IsPlaying and RedTheme.Get("Accent") or RedTheme.Get("CardStroke"), 1.2)

        -- Friend Avatar Headshot
        local avImg = Instance.new("ImageLabel")
        avImg.Size = UDim2.new(0, 40, 0, 40)
        avImg.Position = UDim2.new(0, 8, 0.5, -20)
        avImg.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100", fr.UserId)
        avImg.BackgroundTransparency = 1
        avImg.Parent = card
        RedUI.Corner(avImg, 20)

        -- Status Indicator Dot
        local sDot = Instance.new("Frame")
        sDot.Size = UDim2.new(0, 9, 0, 9)
        sDot.Position = UDim2.new(0, 38, 0.5, 10)
        sDot.BackgroundColor3 = fr.IsPlaying and RedTheme.Get("StatusGreen") or Color3.fromRGB(0, 215, 255)
        sDot.BorderSizePixel = 0
        sDot.Parent = card
        RedUI.Corner(sDot, 5)

        -- Friend Names
        local dNameLbl = RedUI.Label(card, fr.DisplayName, UDim2.new(0, 150, 0, 16), UDim2.new(0, 54, 0, 8), Enum.Font.GothamBlack, 11, RedTheme.Get("TextPrimary"))
        local uNameLbl = RedUI.Label(card, "@" .. fr.Username, UDim2.new(0, 150, 0, 14), UDim2.new(0, 54, 0, 24), Enum.Font.GothamMedium, 9, RedTheme.Get("TextMuted"))

        -- Experience Thumbnail or Online Status Badge
        if fr.IsPlaying then
            -- Experience Game Icon
            local gThumb = Instance.new("ImageLabel")
            gThumb.Size = UDim2.new(0, 32, 0, 32)
            gThumb.Position = UDim2.new(0, 210, 0.5, -16)
            gThumb.Image = (fr.PlaceId and fr.PlaceId > 0) and string.format("rbxthumb://type=GameIcon&id=%d&w=150&h=150", fr.PlaceId) or "rbxassetid://0"
            gThumb.BackgroundTransparency = 1
            gThumb.Parent = card
            RedUI.Corner(gThumb, 6)

            local gNameLbl = RedUI.Label(card, fr.GameTitle, UDim2.new(1, -330, 0, 16), UDim2.new(0, 248, 0, 10), Enum.Font.GothamBold, 10, RedTheme.Get("StatusGreen"))
            local stLbl = RedUI.Label(card, "Playing Now", UDim2.new(1, -330, 0, 14), UDim2.new(0, 248, 0, 28), Enum.Font.GothamMedium, 9, RedTheme.Get("TextSecondary"))

            -- Join Button
            local joinBtn = RedUI.Button(card, "JOIN GAME", UDim2.new(0, 76, 0, 26), UDim2.new(1, -84, 0.5, -13), RedTheme.Get("Accent"), Color3.fromRGB(255, 255, 255), 9, function()
                RedAudio.Play("Click")
                pcall(function()
                    if fr.PlaceId and fr.PlaceId > 0 then
                        TeleportService:Teleport(fr.PlaceId)
                    end
                end)
            end)
        else
            -- Friend is Online on website / menus
            local onTag = Instance.new("Frame")
            onTag.Size = UDim2.new(0, 95, 0, 18)
            onTag.Position = UDim2.new(0, 210, 0.5, -9)
            onTag.BackgroundColor3 = Color3.fromRGB(12, 28, 42)
            onTag.BorderSizePixel = 0
            onTag.Parent = card
            RedUI.Corner(onTag, 6)
            RedUI.Stroke(onTag, Color3.fromRGB(0, 215, 255), 1.0)
            RedUI.Label(onTag, "ONLINE IN MENUS", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), Enum.Font.GothamBlack, 8, Color3.fromRGB(0, 215, 255), Enum.TextXAlignment.Center)

            local oStatus = RedUI.Label(card, "Active on Roblox Platform", UDim2.new(1, -320, 0, 16), UDim2.new(0, 315, 0.5, -8), Enum.Font.GothamMedium, 9, RedTheme.Get("TextSecondary"))
        end
    end
end

