        Notification = { Id = "rbxassetid://6895079634", Vol = 0.8, Pitch = 1.0 }
    }

    local soundCache = {}

    function RedAudio.Play(presetName)
        if not RedAudio.Enabled then return end
        local cfg = RedAudio.Presets[presetName]
        if not cfg then return end

        if AudioVisualizerHook then
            task.spawn(AudioVisualizerHook)
        end

        task.spawn(function()
            local snd = soundCache[presetName]
            if not snd or not snd.Parent then
                snd = Instance.new("Sound")
                snd.Name = "Snd_" .. presetName
                snd.SoundId = cfg.Id
                snd.Volume = (cfg.Vol or 0.6) * RedAudio.MasterVolume
                snd.PlaybackSpeed = cfg.Pitch or 1.0
                snd.Parent = soundHolder
                soundCache[presetName] = snd
            else
                snd.Volume = (cfg.Vol or 0.6) * RedAudio.MasterVolume
                snd.PlaybackSpeed = cfg.Pitch or 1.0
            end
            snd:Play()
        end)
    end
end

