-- Tab Management
local Pages = {}
local TabButtons = {}
local CurrentTab = "Dashboard"

local function AddTab(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = "Page_" .. name
    page.Size = UDim2.new(1, 0, 1, 0)
    page.Position = UDim2.new(0, 0, 0, 0)
    page.BackgroundTransparency = 1
    page.ScrollBarThickness = 3
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.Visible = false
    page.Parent = ContentContainer

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 8)
    list.Parent = page

    Pages[name] = page

    local btn = Instance.new("TextButton")
    btn.Text = string.upper(name)
    btn.Size = UDim2.new(0, 82, 0, 24)
    btn.BackgroundColor3 = (name == CurrentTab and RedTheme.Get("Accent") or RedTheme.Get("CardBase"))
    btn.TextColor3 = (name == CurrentTab and Color3.fromRGB(255, 255, 255) or RedTheme.Get("TextSecondary"))
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 10
    btn.BorderSizePixel = 0
    btn.ClipsDescendants = true
    btn.Parent = TabsBar

    RedUI.Corner(btn, 8)
    local bStroke = RedUI.Stroke(btn, (name == CurrentTab and RedTheme.Get("Accent") or RedTheme.Get("CardStroke")), 1.0)

    btn.MouseEnter:Connect(function() RedAudio.Play("Hover") end)

    btn.MouseButton1Click:Connect(function()
        RedAudio.Play("TabSwitch")
        RedUI.Ripple(btn, nil, nil, RedTheme.Get("Accent"))
        for tName, p in pairs(Pages) do
            p.Visible = (tName == name)
        end
        for tName, b in pairs(TabButtons) do
            local active = (tName == name)
            RedTween.Play(b.Button, 0.2, {
                BackgroundColor3 = active and RedTheme.Get("Accent") or RedTheme.Get("CardBase"),
                TextColor3 = active and Color3.fromRGB(255, 255, 255) or RedTheme.Get("TextSecondary")
            })
            RedTween.Play(b.Stroke, 0.2, {
                Color = active and RedTheme.Get("Accent") or RedTheme.Get("CardStroke")
            })
        end
        CurrentTab = name
    end)

    TabButtons[name] = { Button = btn, Stroke = bStroke }
    return page
end

