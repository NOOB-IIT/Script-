    return l
end

function RedUI.Card(parent, size, position)
    local card = Instance.new("Frame")
    card.Size = size or UDim2.new(1, 0, 0, 80)
    if position then card.Position = position end
    card.BackgroundColor3 = RedTheme.Get("CardBase")
    card.BorderSizePixel = 0
    card.Parent = parent

    RedUI.Corner(card, 16)
    local stroke = RedUI.Stroke(card, RedTheme.Get("CardStroke"), 1.2)
    RedTheme.Bind(card, "BackgroundColor3", "CardBase")
    RedTheme.Bind(stroke, "Color", "CardStroke")

    return card, stroke
end

function RedUI.Button(parent, text, size, position, bg, textColor, textSize, callback)
    local btn = Instance.new("TextButton")
    btn.Text = text
    btn.Size = size or UDim2.new(0, 120, 0, 32)
    if position then btn.Position = position end
    btn.BackgroundColor3 = bg or RedTheme.Get("Accent")
    btn.TextColor3 = textColor or Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = textSize or 11
    btn.BorderSizePixel = 0
    btn.ClipsDescendants = true
    btn.AutoButtonColor = false
    btn.Parent = parent

    RedUI.Corner(btn, 10)
    local stroke = RedUI.Stroke(btn, Color3.fromRGB(255, 255, 255), 1.0)
    stroke.Transparency = 0.85

    -- Hover animation with Sound
    btn.MouseEnter:Connect(function()
        RedAudio.Play("Hover")
        RedTween.Play(btn, 0.18, { Size = size + UDim2.new(0, 2, 0, 2) })
        RedTween.Play(stroke, 0.18, { Transparency = 0.3 })
    end)

    btn.MouseLeave:Connect(function()
        RedTween.Play(btn, 0.18, { Size = size })
        RedTween.Play(stroke, 0.18, { Transparency = 0.85 })
    end)

    btn.MouseButton1Click:Connect(function()
        RedAudio.Play("Click")
        RedUI.Ripple(btn, nil, nil, Color3.fromRGB(255, 255, 255))
        if callback then callback() end
    end)

    return btn
end

-- Top Draggable Support for Mobile (Delta) & PC
local function makeDraggable(dragHandle, targetFrame)
    local dragging = false
    local dragInput, dragStart, startPos

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            targetFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

