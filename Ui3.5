    -- EXACT AVATAR VALUE CALCULATION SYSTEM (ROBLOX MARKETPLACE ENGINE)
    function RedTelemetry.CalculateExactAvatarRobux()
        RedTelemetry.AvatarCalculationDone = false
        RedTelemetry.AvatarCalcStatus = "Scanning Avatar..."
        RedTelemetry.ExactAvatarRobux = 0
        RedTelemetry.AvatarItemsCount = 0

        task.spawn(function()
            local totalRobux = 0
            local itemsCount = 0
            local assetIds = {}
            local seenIds = {}

            -- Step 1: Query HumanoidDescription for all equipped accessories & clothing
            local okDesc, desc = pcall(function()
                return Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
            end)

            if okDesc and desc then
                -- Comma-separated accessory asset list
                local accessoryProps = {
                    "HatAccessory", "HairAccessory", "FaceAccessory", "NeckAccessory",
                    "ShouldersAccessory", "FrontAccessory", "BackAccessory", "WaistAccessory"
                }
                for _, prop in ipairs(accessoryProps) do
                    pcall(function()
                        local rawStr = desc[prop]
                        if rawStr and rawStr ~= "" then
                            for idStr in string.gmatch(rawStr, "%d+") do
                                local id = tonumber(idStr)
                                if id and id > 0 and not seenIds[id] then
                                    seenIds[id] = true
                                    table.insert(assetIds, id)
                                end
                            end
                        end
                    end)
                end

                -- Single asset ID properties (clothing, animations, body parts)
                local singleProps = {
                    "Shirt", "Pants", "GraphicTShirt", "Face", "Head",
                    "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg",
                    "ClimbAnimation", "FallAnimation", "IdleAnimation",
                    "JumpAnimation", "RunAnimation", "SwimAnimation", "WalkAnimation"
                }
                for _, prop in ipairs(singleProps) do
                    pcall(function()
                        local val = desc[prop]
                        if typeof(val) == "number" and val > 0 and not seenIds[val] then
                            seenIds[val] = true
                            table.insert(assetIds, val)
                        elseif typeof(val) == "string" then
                            local id = tonumber(val)
                            if id and id > 0 and not seenIds[id] then
                                seenIds[id] = true
                                table.insert(assetIds, id)
                            end
                        end
                    end)
                end
            end

            -- Step 2: Fallback check on live character accessories
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    for _, child in ipairs(char:GetChildren()) do
                        if child:IsA("Accessory") then
                            local handle = child:FindFirstChild("Handle")
                            if handle then
                                local mesh = handle:FindFirstChildOfClass("SpecialMesh")
                                if mesh and mesh.MeshId ~= "" then
                                    local matchId = string.match(mesh.MeshId, "%d+")
                                    local mId = tonumber(matchId)
                                    if mId and mId > 0 and not seenIds[mId] then
                                        seenIds[mId] = true
                                        table.insert(assetIds, mId)
                                    end
                                end
                            end
                        end
                    end
                end
            end)

            RedTelemetry.AvatarCalcStatus = string.format("Querying %d Items...", #assetIds)

            -- Step 3: Query MarketplaceService for exact prices with rate-limit delay
            for _, id in ipairs(assetIds) do
                local succ, info = pcall(function()
                    return MarketplaceService:GetProductInfo(id, Enum.InfoType.Asset)
                end)
                if succ and info then
                    itemsCount = itemsCount + 1
                    if info.PriceInRobux and tonumber(info.PriceInRobux) and tonumber(info.PriceInRobux) > 0 then
                        totalRobux = totalRobux + tonumber(info.PriceInRobux)
                    end
                end
                task.wait(0.04)
            end

            RedTelemetry.ExactAvatarRobux = totalRobux
            RedTelemetry.AvatarItemsCount = itemsCount
            RedTelemetry.AvatarCalcStatus = "Complete"
            RedTelemetry.AvatarCalculationDone = true
        end)
    end

    -- Trigger initial calculation
    RedTelemetry.CalculateExactAvatarRobux()

    -- TRUE FRIENDS SYSTEM (STRICTLY USER'S ACTUAL ROBLOX FRIENDS ONLY)
    function RedTelemetry.FetchRealFriendsOnline()
        task.spawn(function()
            local friendsList = {}
            local ok, rawFriends = pcall(function()
                return Players:GetFriendsOnline(200)
            end)

            if ok and rawFriends and typeof(rawFriends) == "table" then
                for _, fr in ipairs(rawFriends) do
                    local isPlaying = false
                    local gameTitle = "Online on Roblox (Website / App)"
                    local placeId = fr.PlaceId

                    -- Determine if friend is actively playing an experience
                    if (fr.LocationType == 2) or (placeId and placeId > 0) or (fr.LastLocation and fr.LastLocation ~= "" and fr.LastLocation ~= "Website" and fr.LastLocation ~= "Mobile") then
                        isPlaying = true
                        if fr.LastLocation and fr.LastLocation ~= "" and fr.LastLocation ~= "Website" then
                            gameTitle = fr.LastLocation
                        else
                            gameTitle = "Experience ID: " .. tostring(placeId or 0)
                        end
                    end

                    table.insert(friendsList, {
                        UserId = fr.VisitorId or 0,
                        Username = fr.UserName or "Player",
                        DisplayName = fr.DisplayName or fr.UserName or "Player",
                        IsOnline = true,
                        IsPlaying = isPlaying,
                        GameTitle = gameTitle,
                        PlaceId = placeId,
                        JobId = fr.GameId
                    })
                end
            end

            RedTelemetry.FriendsOnlineList = friendsList
            RedTelemetry.ServerFriendsCount = #friendsList
        end)
    end

    -- Initial fetch & loop every 25 seconds
    RedTelemetry.FetchRealFriendsOnline()
    task.spawn(function()
        while true do
            task.wait(25)
            RedTelemetry.FetchRealFriendsOnline()
        end
    end)
end

-- UI Element Construction Library with Sound & Ripple Animations
local RedUI = {}

function RedUI.Corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = parent
    return c
end

function RedUI.Stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or RedTheme.Get("CardStroke")
    s.Thickness = thickness or 1.2
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

-- Sound Animation Ripple Effect Function
function RedUI.Ripple(parentFrame, x, y, accentColor)
    local ripple = Instance.new("Frame")
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    ripple.Position = UDim2.new(0, x or (parentFrame.AbsoluteSize.X / 2), 0, y or (parentFrame.AbsoluteSize.Y / 2))
    ripple.Size = UDim2.new(0, 4, 0, 4)
    ripple.BackgroundColor3 = accentColor or RedTheme.Get("Accent")
    ripple.BackgroundTransparency = 0.35
    ripple.BorderSizePixel = 0
    ripple.ZIndex = (parentFrame.ZIndex or 1) + 10
    ripple.Parent = parentFrame
    RedUI.Corner(ripple, 100)

    local targetSize = math.max(parentFrame.AbsoluteSize.X, parentFrame.AbsoluteSize.Y) * 1.8
    if targetSize < 80 then targetSize = 80 end

    local tween = TweenService:Create(ripple, TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, targetSize, 0, targetSize),
        BackgroundTransparency = 1
    })
    tween:Play()
    task.delay(0.45, function()
        pcall(function() ripple:Destroy() end)
    end)
end

function RedUI.Label(parent, text, size, position, font, textSize, color, alignX)
    local l = Instance.new("TextLabel")
    l.Text = text
    l.Size = size or UDim2.new(1, 0, 1, 0)
    l.Position = position or UDim2.new(0, 0, 0, 0)
    l.Font = font or Enum.Font.GothamMedium
    l.TextSize = textSize or 11
