-- 1. FPS Tracker
task.spawn(function()
    local frameCount = 0
    local lastCheck = tick()
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastCheck >= 0.5 then
            RedTelemetry.FPS = math.floor(frameCount / (now - lastCheck))
            frameCount = 0
            lastCheck = now
            if fpsLbl and fpsLbl.Parent then
                fpsLbl.Text = tostring(RedTelemetry.FPS) .. " FPS"
            end
        end
    end)
end)

-- 2. Ping & Memory Tracker
task.spawn(function()
    while MainGui and MainGui.Parent do
        pcall(function()
            local pingVal = 0
            if game:GetService("Stats").Network.ServerStatsItem:FindFirstChild("Data Ping") then
                pingVal = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            end
            RedTelemetry.Ping = pingVal
            if pingLbl and pingLbl.Parent then
                pingLbl.Text = tostring(pingVal) .. " MS"
            end

            -- Server Population
            local curPlayers = #Players:GetPlayers()
            local maxPlayers = Players.MaxPlayers or 1
            if popValLbl and popValLbl.Parent then
                popValLbl.Text = string.format("%d / %d", curPlayers, maxPlayers)
            end
            if frValLbl and frValLbl.Parent then
                frValLbl.Text = tostring(#RedTelemetry.FriendsOnlineList) .. " Friends"
            end
        end)
        task.wait(1)
    end
end)

-- 3. Live Physics (Character World Position & Speed)
task.spawn(function()
    while MainGui and MainGui.Parent do
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    RedTelemetry.CharPosition = hrp.Position
                    RedTelemetry.CharVelocity = hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.new(0, 0, 0)
                end
            end
        end)
        task.wait(0.1)
    end
end)

-- 4. Local Clock
task.spawn(function()
    while MainGui and MainGui.Parent do
        RedTelemetry.LocalTimeFormatted = os.date("%H:%M:%S")
        task.wait(1)
    end
end)


