local function RegisterThemeCard(themeName, paletteData, order)
    local card = Instance.new("TextButton")
    card.Name = "Theme_" .. themeName
    card.Text = ""
    card.LayoutOrder = order
    card.BackgroundColor3 = paletteData.CardBase
    card.BorderSizePixel = 0
    card.AutoButtonColor = false
    card.Parent = ThemeGridContainer

    RedUI.AddCorner(card, 10)
    local stroke = RedUI.AddStroke(card, (RedTheme.CurrentThemeName == themeName) and paletteData.Accent or paletteData.CardStroke, 1.5)

    -- Color Preview Dot / Badge
    local colorSwatch = Instance.new("Frame")
    colorSwatch.Name = "Swatch"
    colorSwatch.Size = UDim2.new(0, 22, 0, 22)
    colorSwatch.Position = UDim2.new(0, 12, 0, 12)
    colorSwatch.BackgroundColor3 = paletteData.Accent
    colorSwatch.BorderSizePixel = 0
    colorSwatch.Parent = card
    RedUI.AddCorner(colorSwatch, 11)

    -- Name Label
    local nameLabel = RedUI.CreateLabel(
        card,
        "Name",
        themeName,
        UDim2.new(1, -44, 0, 18),
        UDim2.new(0, 40, 0, 14),
        Enum.Font.GothamBold,
        11,
        paletteData.TextPrimary,
        Enum.TextXAlignment.Left,
        Enum.TextYAlignment.Center
    )

    -- Status Active indicator
    local statusLabel = RedUI.CreateLabel(
        card,
        "Status",
        (RedTheme.CurrentThemeName == themeName) and "ACTIVE" or "SELECT",
        UDim2.new(1, -24, 0, 16),
        UDim2.new(0, 12, 0, 42),
        Enum.Font.GothamBold,
        9,
        (RedTheme.CurrentThemeName == themeName) and paletteData.Accent or paletteData.TextMuted,
        Enum.TextXAlignment.Left,
        Enum.TextYAlignment.Center
    )

    themeCards[themeName] = { Card = card, Stroke = stroke, Status = statusLabel, Palette = paletteData }

    card.MouseButton1Click:Connect(function()
        if RedTheme.CurrentThemeName == themeName then return end
        RedTheme.SetTheme(themeName)

        for name, item in pairs(themeCards) do
            if name == themeName then
                item.Stroke.Color = item.Palette.Accent
                item.Stroke.Thickness = 2
                item.Status.Text = "ACTIVE"
                item.Status.TextColor3 = item.Palette.Accent
            else
                item.Stroke.Color = item.Palette.CardStroke
                item.Stroke.Thickness = 1
                item.Status.Text = "SELECT"
                item.Status.TextColor3 = item.Palette.TextMuted
            end
        end

        RedToast.Show("Theme Applied", "Switched palette to: " .. themeName, "Success", 2.5)
    end)
end

