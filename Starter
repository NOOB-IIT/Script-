-- MODULE 23: ADVANCED SYSTEM DIAGNOSTICS & TELEMETRY MONITOR
-- ============================================================================
local RedDiagnostics = {}
do
    RedDiagnostics.PingHistory = {}
    RedDiagnostics.FpsHistory = {}
    RedDiagnostics.MaxHistoryPoints = 60

    function RedDiagnostics.RecordSample(fps, ping)
        table.insert(RedDiagnostics.FpsHistory, fps)
        if #RedDiagnostics.FpsHistory > RedDiagnostics.MaxHistoryPoints then
            table.remove(RedDiagnostics.FpsHistory, 1)
        end

        table.insert(RedDiagnostics.PingHistory, ping)
        if #RedDiagnostics.PingHistory > RedDiagnostics.MaxHistoryPoints then
            table.remove(RedDiagnostics.PingHistory, 1)
        end
    end

    function RedDiagnostics.GetAverageFps()
        local sum = 0
        local count = #RedDiagnostics.FpsHistory
        if count == 0 then return 60 end
        for i = 1, count do
            sum = sum + RedDiagnostics.FpsHistory[i]
        end
        return math.floor(sum / count)
    end

    function RedDiagnostics.GetAveragePing()
        local sum = 0
        local count = #RedDiagnostics.PingHistory
        if count == 0 then return 50 end
        for i = 1, count do
            sum = sum + RedDiagnostics.PingHistory[i]
        end
        return math.floor(sum / count)
    end

    task.spawn(function()
        while task.wait(1) do
            RedDiagnostics.RecordSample(RedTelemetry.CurrentFPS, RedTelemetry.CurrentPing)
        end
    end)
end

