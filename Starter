        if not instance then return end
        local entry = {
            Instance = instance,
            Property = propertyName,
            ThemeKey = themeKey,
            Duration = customTweenDuration or 0.35
        }
        table.insert(RedTheme.BoundInstances, entry)

        -- Initial set
        local targetColor = RedTheme.Get(themeKey)
        if targetColor then
            pcall(function()
                instance[propertyName] = targetColor
            end)
