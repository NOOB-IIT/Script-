-- MODULE 24: COLOR & GRADIENT MATHEMATICAL UTILITIES
-- ============================================================================
local RedColor = {}
do
    function RedColor.Lerp(colorA, colorB, alpha)
        return Color3.new(
            colorA.R + (colorB.R - colorA.R) * alpha,
            colorA.G + (colorB.G - colorA.G) * alpha,
            colorA.B + (colorB.B - colorA.B) * alpha
        )
    end

    function RedColor.Darken(color, factor)
        factor = factor or 0.8
        return Color3.new(
            math.clamp(color.R * factor, 0, 1),
            math.clamp(color.G * factor, 0, 1),
            math.clamp(color.B * factor, 0, 1)
        )
    end

    function RedColor.Lighten(color, factor)
        factor = factor or 1.2
        return Color3.new(
            math.clamp(color.R * factor, 0, 1),
            math.clamp(color.G * factor, 0, 1),
            math.clamp(color.B * factor, 0, 1)
        )
    end

    function RedColor.ToHex(color)
        local r = math.floor(color.R * 255)
        local g = math.floor(color.G * 255)
        local b = math.floor(color.B * 255)
        return string.format("#%02X%02X%02X", r, g, b)
    end

    function RedColor.FromHex(hex)
        hex = hex:gsub("#", "")
        local r = tonumber(hex:sub(1, 2), 16) or 255
        local g = tonumber(hex:sub(3, 4), 16) or 255
        local b = tonumber(hex:sub(5, 6), 16) or 255
        return Color3.fromRGB(r, g, b)
    end
end

