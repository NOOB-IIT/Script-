-- MODULE 7: REAL-TIME TELEMETRY & HARDWARE PROFILER
-- ============================================================================
local RedTelemetry = {}
do
    RedTelemetry.CurrentFPS = 60
    RedTelemetry.CurrentPing = 50
    RedTelemetry.ServerPlayerCount = 1
    RedTelemetry.ServerMaxPlayers = 12
    RedTelemetry.FriendsInServer = 0
    RedTelemetry.FriendList = {}
    RedTelemetry.AccountAgeText = "0 Days"
    RedTelemetry.PlayerThumbnail = ""
    RedTelemetry.LocalTimeFormatted = "12:00:00 AM"
    RedTelemetry.Greeting = "Welcome"

    local frameCount = 0
    local lastFpsUpdate = tick()

    -- FPS Counter Tracker
    RunService.RenderStepped:Connect(function(deltaTime)
        frameCount = frameCount + 1
        local now = tick()
        if now - lastFpsUpdate >= 0.5 then
            RedTelemetry.CurrentFPS = math.floor(frameCount / (now - lastFpsUpdate))
            frameCount = 0
            lastFpsUpdate = now
        end
    end)

    -- Ping / Latency Tracker
    task.spawn(function()
        while task.wait(1.5) do
            local ping = 60
            local success, statsItem = pcall(function()
                return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
            end)
            if success and statsItem then
                ping = math.floor(statsItem)
            else
                local s, netPing = pcall(function()
                    return math.floor(LocalPlayer:GetNetworkPing() * 1000)
                end)
                if s and netPing and netPing > 0 then
                    ping = netPing
                end
            end
            RedTelemetry.CurrentPing = math.clamp(ping, 1, 999)
        end
    end)

    -- Player Details, Greeting & Time Routine
    function RedTelemetry.UpdateLocalClock()
        local date = os.date("*t")
        local hour = date.hour
        local minute = date.min
        local second = date.sec
        local period = "AM"

        if hour >= 12 then
            period = "PM"
            if hour > 12 then hour = hour - 12 end
        elseif hour == 0 then
            hour = 12
        end

        RedTelemetry.LocalTimeFormatted = string.format("%02d:%02d:%02d %s", hour, minute, second, period)

        -- Dynamic Greeting based on 24hr time
        local rawHour = date.hour
        if rawHour >= 4 and rawHour < 12 then
            RedTelemetry.Greeting = "Good morning"
        elseif rawHour >= 12 and rawHour < 17 then
            RedTelemetry.Greeting = "Good afternoon"
        elseif rawHour >= 17 and rawHour < 22 then
            RedTelemetry.Greeting = "Good evening"
        else
            RedTelemetry.Greeting = "Good night"
        end
    end

    -- Account Age Formatter (Years, Months, Days)
    function RedTelemetry.CalculateAccountAge()
        local days = LocalPlayer.AccountAge or 0
        local years = math.floor(days / 365)
        local remainingDays = days % 365

        if years > 0 then
            RedTelemetry.AccountAgeText = string.format("%d Yrs, %d Days", years, remainingDays)
        else
            RedTelemetry.AccountAgeText = string.format("%d Days", days)
        end
    end

    -- Server & Friends Scanner
    function RedTelemetry.ScanServerAndFriends()
        local allPlayers = Players:GetPlayers()
        RedTelemetry.ServerPlayerCount = #allPlayers
        RedTelemetry.ServerMaxPlayers = Players.MaxPlayers or 20

        local count = 0
        local friends = {}
        for _, otherPlayer in ipairs(allPlayers) do
            if otherPlayer ~= LocalPlayer then
                local success, isFriend = pcall(function()
                    return LocalPlayer:IsFriendsWith(otherPlayer.UserId)
                end)
                if success and isFriend then
                    count = count + 1
                    table.insert(friends, otherPlayer.DisplayName .. " (@" .. otherPlayer.Name .. ")")
                end
            end
        end
        RedTelemetry.FriendsInServer = count
        RedTelemetry.FriendList = friends
    end

    -- Fetch Avatar Thumbnail
    task.spawn(function()
        local thumbType = Enum.ThumbnailType.HeadShot
        local thumbSize = Enum.ThumbnailSize.Size150x150
        local success, content, isReady = pcall(function()
            return Players:GetUserThumbnailAsync(LocalPlayer.UserId, thumbType, thumbSize)
        end)
        if success and content then
            RedTelemetry.PlayerThumbnail = content
        else
            RedTelemetry.PlayerThumbnail = "rbxasset://textures/ui/GuiImagePlaceholder.png"
        end
    end)

    RedTelemetry.CalculateAccountAge()
    RedTelemetry.UpdateLocalClock()
    RedTelemetry.ScanServerAndFriends()

    -- Continuous Clock update loop
    task.spawn(function()
        while task.wait(1) do
            RedTelemetry.UpdateLocalClock()
        end
    end)

    -- Continuous Server scan loop
    task.spawn(function()
        while task.wait(5) do
            RedTelemetry.ScanServerAndFriends()
        end
    end)
end

