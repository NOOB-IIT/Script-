do
    function RedTween.Create(instance, tweenInfo, goal)
        return TweenService:Create(instance, tweenInfo, goal)
    end

    function RedTween.Play(instance, duration, goal, style, direction)
        local info = TweenInfo.new(
            duration or 0.3,
            style or Enum.EasingStyle.Quart,
            direction or Enum.EasingDirection.Out
        )
        local tween = TweenService:Create(instance, info, goal)
        tween:Play()
        return tween
    end

    function RedTween.Spring(instance, duration, goal)
        return RedTween.Play(instance, duration or 0.45, goal, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    function RedTween.Pulse(instance, duration, scaleDelta)
        scaleDelta = scaleDelta or 1.05
        local originalSize = instance.Size
        local targetSize = UDim2.new(
            originalSize.X.Scale * scaleDelta,
            originalSize.X.Offset,
            originalSize.Y.Scale * scaleDelta,
            originalSize.Y.Offset
        )
        local grow = TweenService:Create(instance, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = targetSize
        })
        grow:Play()
        grow.Completed:Connect(function()
            TweenService:Create(instance, TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = originalSize
            }):Play()
        end)
    end
end

