-- MODULE 2: HIGH PERFORMANCE FAST-SIGNAL (EVENT DISPATCHER)
-- ============================================================================
local RedSignal = {}
RedSignal.__index = RedSignal

function RedSignal.new()
    local self = setmetatable({}, RedSignal)
    self._listeners = {}
    return self
end

function RedSignal:Connect(fn)
    assert(type(fn) == "function", "RedSignal:Connect expects a function")
    local connection = {
        _signal = self,
        _fn = fn,
        _connected = true,
        Disconnect = function(conn)
            if not conn._connected then return end
            conn._connected = false
            local list = conn._signal._listeners
            for i = 1, #list do
                if list[i] == conn then
                    table.remove(list, i)
                    break
                end
            end
        end
    }
    table.insert(self._listeners, connection)
    return connection
end

function RedSignal:Fire(...)
    local list = self._listeners
    local count = #list
    for i = 1, count do
        local conn = list[i]
        if conn and conn._connected then
            task.spawn(conn._fn, ...)
        end
    end
end

function RedSignal:Wait()
    local thread = coroutine.running()
    local conn
    conn = self:Connect(function(...)
        conn:Disconnect()
        task.spawn(thread, ...)
    end)
    return coroutine.yield()
end

function RedSignal:Destroy()
    for _, conn in ipairs(self._listeners) do
        conn._connected = false
    end
    table.clear(self._listeners)
end

