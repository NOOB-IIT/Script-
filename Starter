-- MODULE 6: UNIFIED TOUCH & MOUSE DRAGGABLE HANDLER
-- ============================================================================
local RedDrag = {}
do
    function RedDrag.MakeDraggable(handle, frameToMove, smoothFactor)
        smoothFactor = smoothFactor or 0.18
        local dragging = false
        local dragInput = nil
        local dragStart = nil
        local startPos = nil

        local function update(input)
            local delta = input.Position - dragStart
            local targetPos = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
            RedTween.Play(frameToMove, smoothFactor, { Position = targetPos }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        end

        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frameToMove.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        handle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                update(input)
            end
        end)
    end
end

