-- Tab Registration Matrix
local Tabs = {}
local TabButtons = {}
local ActiveTabName = "Dashboard"

local function RegisterTab(tabName, layoutOrder)
    local button = Instance.new("TextButton")
    button.Name = "TabBtn_" .. tabName
    button.Text = tabName
    button.Size = UDim2.new(0, 108, 0, 32)
    button.LayoutOrder = layoutOrder
    button.BackgroundColor3 = (tabName == ActiveTabName) and RedTheme.Get("Accent") or Color3.fromRGB(0, 0, 0)
    button.BackgroundTransparency = (tabName == ActiveTabName) and 0 or 1
    button.TextColor3 = (tabName == ActiveTabName) and Color3.fromRGB(255, 255, 255) or RedTheme.Get("TextSecondary")
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Parent = TopTabsContainer

    RedUI.AddCorner(button, 16)

    -- Page container for this tab
    local page = RedUI.CreateScroll(PagesContainer, "Page_" .. tabName, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0))
    page.Visible = (tabName == ActiveTabName)

    local pageList = Instance.new("UIListLayout")
    pageList.SortOrder = Enum.SortOrder.LayoutOrder
    pageList.Padding = UDim.new(0, 12)
    pageList.Parent = page

    local pagePad = Instance.new("UIPadding")
    pagePad.PaddingTop = UDim.new(0, 4)
    pagePad.PaddingBottom = UDim.new(0, 20)
    pagePad.PaddingLeft = UDim.new(0, 4)
    pagePad.PaddingRight = UDim.new(0, 8)
    pagePad.Parent = page

    Tabs[tabName] = page
    TabButtons[tabName] = button

    button.MouseButton1Click:Connect(function()
        if ActiveTabName == tabName then return end
        RedAudio.Play("TabSwitch")

        local prevTabName = ActiveTabName
        ActiveTabName = tabName

        -- Update buttons state
        for name, btn in pairs(TabButtons) do
            if name == tabName then
                RedTween.Play(btn, 0.25, {
                    BackgroundColor3 = RedTheme.Get("Accent"),
                    BackgroundTransparency = 0,
                    TextColor3 = Color3.fromRGB(255, 255, 255)
                })
            else
                RedTween.Play(btn, 0.25, {
                    BackgroundTransparency = 1,
                    TextColor3 = RedTheme.Get("TextSecondary")
                })
            end
        end

        -- Page transition
        for name, pg in pairs(Tabs) do
            if name == tabName then
                pg.Visible = true
                pg.Position = UDim2.new(0, 15, 0, 0)
                RedTween.Play(pg, 0.25, { Position = UDim2.new(0, 0, 0, 0) })
            else
                pg.Visible = false
            end
        end
    end)

    return page, button
end

