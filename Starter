        -- Re-animate all bound instances smoothly
        for i = #RedTheme.BoundInstances, 1, -1 do
            local item = RedTheme.BoundInstances[i]
            if item.Instance and item.Instance.Parent then
                local targetColor = palette[item.ThemeKey]
                if targetColor then
