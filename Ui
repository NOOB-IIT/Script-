local function getPlayerColor(userId)
    local colors = {
        Color3.fromRGB(255, 87, 87),   -- Coral Red
        Color3.fromRGB(78, 205, 196),  -- Turquoise
        Color3.fromRGB(255, 190, 11),  -- Yellow
        Color3.fromRGB(168, 85, 247),  -- Violet
        Color3.fromRGB(56, 189, 248),  -- Sky Blue
        Color3.fromRGB(244, 114, 182), -- Pink
        Color3.fromRGB(52, 211, 153),  -- Mint
        Color3.fromRGB(251, 146, 60)   -- Orange
    }
    local num = tonumber(userId) or 1
    local idx = (num % #colors) + 1
    return colors[idx]
end

