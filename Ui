-- Server & Friends Telemetry
function RedTelemetry.ScanServer()
    pcall(function()
        local plrs = Players:GetPlayers()
        RedTelemetry.ServerPlayerCount = #plrs
        RedTelemetry.ServerMaxPlayers = Players.MaxPlayers or 20
        local fCount, friends = 0, {}
        for _, p in ipairs(plrs) do
            if p ~= LocalPlayer then
                local s, isF = pcall(function() return LocalPlayer:IsFriendsWith(p.UserId) end)
                if s and isF then
                    fCount = fCount + 1
                    table.insert(friends, { Name = p.DisplayName, User = p.Name, Id = p.UserId })
                end
            end
        end
        RedTelemetry.FriendsInServer = fCount
        RedTelemetry.FriendList = friends
    end)
end

-- Online Friends Game Presence Scanner (for Friends Tab)
function RedTelemetry.ScanOnlineFriendsPresences()
    pcall(function()
        if not LocalPlayer then return end
        local friendPages = Players:GetFriendsOnline(100)
        local presences = {}
        for _, item in ipairs(friendPages) do
            local status = "Online"
            local gameName = "Website / In Menus"
            local joinable = false
            local placeId = item.PlaceId
            local jobId = item.GameId

            if item.LocationType == 1 then
                status = "In Game"
                gameName = item.LastLocation or "Playing a Game"
                joinable = (placeId ~= nil and placeId > 0)
            elseif item.LocationType == 2 then
                status = "In Studio"
                gameName = "Roblox Studio"
            end

            table.insert(presences, {
                UserId = item.VisitorId,
                Username = item.UserName,
                DisplayName = item.DisplayName or item.UserName,
                Status = status,
                GameName = gameName,
                PlaceId = placeId,
                JobId = jobId,
                Joinable = joinable
            })
        end
        RedTelemetry.FriendsPresences = presences
    end)
end

