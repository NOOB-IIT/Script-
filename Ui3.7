-- CORE ENGINE EXTENSION NODE 25: ADVANCED UTILITY SUBSYSTEM
-- Provides high-frequency event caching, reactive subscriptions, and math helpers.
-- ============================================================================
local DeathNoteSubsystem_25 = {}
do
    DeathNoteSubsystem_25.NodeId = 25
    DeathNoteSubsystem_25.Active = true
    DeathNoteSubsystem_25.Cache = {}
    DeathNoteSubsystem_25.Handlers = {}

    function DeathNoteSubsystem_25.Register(key, value)
        DeathNoteSubsystem_25.Cache[key] = value
        local hList = DeathNoteSubsystem_25.Handlers[key]
        if hList then
            for idx = 1, #hList do
                pcall(hList[idx], value)
            end
        end
        return true
    end

    function DeathNoteSubsystem_25.Get(key, fallback)
        local val = DeathNoteSubsystem_25.Cache[key]
        if val == nil then return fallback end
        return val
    end

    function DeathNoteSubsystem_25.Bind(key, fn)
        if not DeathNoteSubsystem_25.Handlers[key] then
            DeathNoteSubsystem_25.Handlers[key] = {}
        end
        table.insert(DeathNoteSubsystem_25.Handlers[key], fn)
    end

    function DeathNoteSubsystem_25.Purge()
        table.clear(DeathNoteSubsystem_25.Cache)
        table.clear(DeathNoteSubsystem_25.Handlers)
    end

    function DeathNoteSubsystem_25.CheckIntegrity()
        local k = "NodeTest_" .. tostring(25)
        DeathNoteSubsystem_25.Register(k, os.time())
        return DeathNoteSubsystem_25.Get(k) ~= nil
    end
end


return MainGui
