        TextColor3 = Settings.Theme.TextWhite,
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        LayoutOrder = #QuizButtons + 1,
        TextXAlignment = Enum.TextXAlignment.Left
    })
    Create("UICorner", {Parent = btn, CornerRadius = UDim.new(0, 8)})
    Create("UIStroke", {Parent = btn, Color = Settings.Theme.MainRed, Thickness = 1})
    AnimateHover(btn, Color3.fromRGB(25, 5, 5), Color3.fromRGB(55, 10, 10))
    AnimateClick(btn)
    btn.MouseButton1Click:Connect(function()
        Notify("Loading", "Loading: " .. quizTitle, "info")
        pcall(function()
            loadstring(game:HttpGet(rawGithubUrl))()
        end)
    end)
    table.insert(QuizButtons, {Button = btn, Title = quizTitle})
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local searchText = string.lower(SearchBox.Text)
    for _, item in ipairs(QuizButtons) do
        if searchText == "" or string.find(string.lower(item.Title), searchText) then
            item.Button.Visible = true
        else
            item.Button.Visible = false
        end
    end
end)

