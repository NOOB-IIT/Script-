-- KEY VERIFICATION
-- ═══════════════════════════════════════════════════════════════
KeyInputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        if KeyInputBox.Text == Settings.Key then
            Notify("Success", "Key accepted! Loading hub...", "success")

            local fadeOut = TweenService:Create(KeyCanvas, TweenInfo.new(0.5), {BackgroundTransparency = 1})
            TweenService:Create(Overlay, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
            TweenService:Create(KeyBg, TweenInfo.new(0.5), {ImageTransparency = 1}):Play()
            TweenService:Create(KeyStroke, TweenInfo.new(0.5), {Transparency = 1}):Play()
            for _, child in pairs(KeyCanvas:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextBox") then
                    pcall(function() TweenService:Create(child, TweenInfo.new(0.5), {TextTransparency = 1}):Play() end)
                end
            end
            fadeOut:Play()
            fadeOut.Completed:Wait()
            KeyCanvas.Visible = false

            MainCanvas.Visible = true
            MainCanvas.Size = UDim2.new(0, 0, 0, 0)
            MainCanvas.Position = UDim2.new(0.5, 0, 0.5, 0)
            MainCanvas.AnchorPoint = Vector2.new(0.5, 0.5)

            local popTween = TweenService:Create(MainCanvas, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = DEFAULT_SIZE
            })
            popTween:Play()
            popTween.Completed:Wait()
            MainCanvas.AnchorPoint = Vector2.new(0, 0)
            MainCanvas.Position = DEFAULT_POS

            Tabs["Quizzes"].Button.BackgroundColor3 = Settings.Theme.MainRed
            Tabs["Quizzes"].Button.TextColor3 = Settings.Theme.TextWhite
            Tabs["Quizzes"].Content.Visible = true
        else
            KeyInputBox.Text = "❌ Invalid Key"
            KeyInputBox.TextColor3 = Settings.Theme.ErrorRed
            Notify("Error", "Invalid key! Join Discord for key.", "error")
            task.wait(1.5)
            if KeyInputBox.Text == "❌ Invalid Key" then
                KeyInputBox.Text = ""
                KeyInputBox.TextColor3 = Color3.fromRGB(0, 0, 0)
            end
        end
    end
end)

