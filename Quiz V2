local function AddQuiz(quizTitle, rawGithubUrl)
    local btn = Create("TextButton", {
        Parent = QuizzesTab,
        Size = UDim2.new(1, -10, 0, 48),
        BackgroundColor3 = Color3.fromRGB(25, 5, 5),
