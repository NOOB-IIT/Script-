-- Draggable brand bar
do
    local drag = false
    local start, startPos
    BrandBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = true
            start = i.Position
            startPos = BrandBar.Position
        end
    end)
    BrandBar.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - start
            BrandBar.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    BrandBar.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

-- =========================================================
--  REBRAND FUNCTION (aggressive)
-- =========================================================
local function rebrand(content)
    if type(content) ~= "string" then return content end

    local subs = {
        -- Hub names
        ["The Chosen Hub Windui"]  = BRAND,
        ["The Chosen Hub"]         = BRAND,
        ["TheChosenHub"]           = "REDHUB",
        ["Chosen Hub"]             = BRAND,
        ["ChosenHub"]              = "REDHUB",
        ["chosen hub"]             = BRAND,
        ["XVC Hub"]                = BRAND,
        ["XVCHub"]                 = "REDHUB",
        ["XvcHub"]                 = "REDHUB",
        ["xvc hub"]                = BRAND,
        ["XVCHubLoader"]           = "REDHUBLoader",
        ["XVC"]                    = "RED",
        -- Credits / owners
        ["Aviaxen"]                = CREDIT,
        ["aviaxen"]                = CREDIT:lower(),
        ["by Chosen"]              = "by " .. CREDIT,
        ["by Aviaxen"]             = "by " .. CREDIT,
        ["By Aviaxen"]             = "By " .. CREDIT,
        ["by The Chosen Hub"]      = "by " .. CREDIT,
        ["By The Chosen Hub"]      = "By " .. CREDIT,
        ["by XVC"]                 = "by " .. CREDIT,
        ["By XVC"]                 = "By " .. CREDIT,
        ["credits to them"]        = "credits to " .. CREDIT,
        ["credits to Aviaxen"]     = "credits to " .. CREDIT,
        -- Discord
        ["discord.gg/rTw5M8dRXN"]  = DISCORD_SHOW,
        ["discord.gg/"]            = DISCORD_SHOW:gsub("discord%.gg/", "discord.gg/"),
    }

    for k, v in pairs(subs) do
        local pattern = k:gsub("[%(%)%.%%%+%-%*%?%[%]%^%$]", "%%%1")
        content = content:gsub(pattern, v)
    end
    return content
end

