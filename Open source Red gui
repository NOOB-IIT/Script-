local buttonsenabled = true

local function SaveSettings()
    if pcall(function() return writefile end) then
        writefile("XVCHubSettings.json", HttpService:JSONEncode(Settings))
    end
end

local function makeButton(name, title, subtitle, xPos, onClick)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = Frame
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Position = UDim2.new(xPos, 0, 0, 234)
    btn.Size = UDim2.new(0, 214, 0, 106)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.ZIndex = 2

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 10)
    c.Parent = btn

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 28, 32)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 0, 0))
    })
    grad.Rotation = 135
    grad.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Parent = btn
    stroke.Color = Color3.fromRGB(255, 30, 30)
    stroke.Thickness = 1.3
    stroke.Transparency = 1

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Parent = btn
    nameLbl.BackgroundTransparency = 1
    nameLbl.Position = UDim2.new(0, 0, 0, 20)
    nameLbl.Size = UDim2.new(1, 0, 0, 28)
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.Text = title
    nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLbl.TextSize = 17
    nameLbl.TextTransparency = 1
    nameLbl.ZIndex = 3

    local subLbl = Instance.new("TextLabel")
    subLbl.Parent = btn
    subLbl.BackgroundTransparency = 1
    subLbl.Position = UDim2.new(0, 0, 0, 50)
    subLbl.Size = UDim2.new(1, 0, 0, 20)
    subLbl.Font = Enum.Font.Code
    subLbl.Text = subtitle
    subLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    subLbl.TextSize = 11
    subLbl.TextTransparency = 1
    subLbl.ZIndex = 3

    local line = Instance.new("Frame")
    line.Parent = btn
    line.BackgroundColor3 = Color3.fromRGB(255, 30, 30)
    line.BorderSizePixel = 0
    line.Position = UDim2.new(0, 20, 0, 80)
    line.Size = UDim2.new(0, 60, 0, 2)
    line.BackgroundTransparency = 1
    line.ZIndex = 3

    btn.MouseEnter:Connect(function()
        TS:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(45, 0, 0)}):Play()
        TS:Create(stroke, TweenInfo.new(0.18), {Transparency = 0, Thickness = 2}):Play()
        TS:Create(nameLbl, TweenInfo.new(0.18), {TextColor3 = Color3.fromRGB(255, 80, 80)}):Play()
        pcall(function() playSound("rbxassetid://9120389156", 0.35, 1.5) end)
    end)
    btn.MouseLeave:Connect(function()
        TS:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(22, 22, 26)}):Play()
        TS:Create(stroke, TweenInfo.new(0.18), {Transparency = 0.3, Thickness = 1.3}):Play()
        TS:Create(nameLbl, TweenInfo.new(0.18), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end)

    btn.MouseButton1Down:Connect(function()
        playSound("rbxassetid://9120389156", 1, 1.3)
        onClick()
    end)

    task.delay(0.15, function()
        TS:Create(btn, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
        TS:Create(stroke, TweenInfo.new(0.5), {Transparency = 0.3}):Play()
        TS:Create(nameLbl, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
        TS:Create(subLbl, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
        TS:Create(line, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
    end)

    return btn
end

local function loadLibrary(url, libName)
    XVCHubLoader:Destroy()
    BrandBar.Visible = true

    -- Fade in brand bar
    BrandBar.BackgroundTransparency = 1
    BBStroke.Transparency = 1
    TS:Create(BrandBar, TweenInfo.new(0.5), {BackgroundTransparency = 0.12}):Play()
    TS:Create(BBStroke, TweenInfo.new(0.5), {Transparency = 0.2}):Play()

    local ok, content = pcall(function() return game:HttpGet(url) end)
    if ok and content then
        local ok2, rebranded = pcall(rebrand, content)
        local final = (ok2 and rebranded) or content
        local ok3, err = pcall(function() loadstring(final)() end)
        if not ok3 then warn("[" .. BRAND .. "] " .. libName .. " load error: " .. tostring(err)) end
    else
        warn("[" .. BRAND .. "] Failed to download " .. libName)
    end
end

