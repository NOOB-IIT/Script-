-- ============== Settings ==============
local function SafeLoadSettings()
    if pcall(function() return readfile and readfile("XVCHubSettings.json") end) then
        local fd = readfile("XVCHubSettings.json")
        if fd and fd ~= "" then
            local ok, dec = pcall(function() return HttpService:JSONDecode(fd) end)
            if ok and dec then Settings = dec end
        end
    end
end
SafeLoadSettings()

local gethui = gethui or get_hidden_gui
local function parentToHidden(gui)
    if gethui then gui.Parent = gethui()
    elseif game:GetService("CoreGui"):FindFirstChildWhichIsA("ScreenGui") then
        gui.Parent = game:GetService("CoreGui")
    else
        gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end
end

