-- ============= AUTOLOAD =============
if Settings.SelectedLibrary and Settings.AutoLoad then
    task.wait(0.4)
    BrandBar.Visible = true
    BrandBar.BackgroundTransparency = 0.12
    BBStroke.Transparency = 0.2
    local url
    if Settings.SelectedLibrary == "Windui" then
        url = WINDUI_URL
    elseif Settings.SelectedLibrary == "Rayfield" then
        url = RAYFIELD_URL
    end
    if url then
        local ok, content = pcall(function() return game:HttpGet(url) end)
        if ok and content then
            local ok2, reb = pcall(rebrand, content)
            loadstring((ok2 and reb) or content)()
            XVCHubLoader:Destroy()
        end
    end
end
