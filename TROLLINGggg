local function findPlayers(q)
    q=(q or ""):lower(); local l={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then
            if q=="" or p.Name:lower():sub(1,#q)==q or p.DisplayName:lower():sub(1,#q)==q then table.insert(l,p) end
        end
    end
    return l
end

