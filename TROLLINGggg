-- Core weld helpers
local function runPreset(x,y,z,rx,ry,rz,animId)
    if not selectedPlayer then notify("RED HUB","Select player"); sError(); return end
    stopThrust(); stopMotion(); stopFling()
    pcall(function() SlX.set(x,false); SlY.set(y,false); SlZ.set(z,false); SlRX.set(rx,false); SlRY.set(ry,false); SlRZ.set(rz,false) end)
    V.X,V.Y,V.Z=x,y,z; V.RX,V.RY,V.RZ=rx,ry,rz
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld=nil end
    stopAllMyAnims(); stopCopying()
    CurrentTarget=selectedPlayer
    local tc=selectedPlayer.Character; if not tc then return end
    local th=tc:FindFirstChildOfClass("Humanoid")
    local tr=((th and th.RigType==Enum.HumanoidRigType.R15) and tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart"))
    if not tr then return end
    pcall(function() workspace.FallenPartsDestroyHeight=0/0 end)
    storeWeldInfo(selectedPlayer,animId,false,"weld"); hookTargetRespawn(selectedPlayer)
    local ok,w=pcall(function() return WeldTo(tr,animId,false) end)
    if ok and w then CurrentWeld=w; sSuccess(); screenFlash(T.Accent); burst(main,T.Accent,12); notify("RED HUB","→ "..selectedPlayer.Name) end
end

-- Bang: thigh-to-thigh (auto Y per rig)
local function runBang(animId,speed,rangeOverride)
    if not selectedPlayer or not selectedPlayer.Character then notify("RED HUB","Select player"); return end
    stopThrust(); stopMotion(); stopFling()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld=nil end
    stopAllMyAnims(); stopCopying()
    CurrentTarget=selectedPlayer
    local tc=selectedPlayer.Character
    local th=tc:FindFirstChildOfClass("Humanoid")
    local tr=((th and th.RigType==Enum.HumanoidRigType.R15) and tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart"))
    if not tr then return end
    -- Thigh alignment
    local yOff = isR15(LP) and -0.5 or 0
    local touchZ = (getTorsoDepth(LP.Character) + getTorsoDepth(tc)) / 2
    V.X=0; V.Y=yOff; V.Z=touchZ; V.RX,V.RY,V.RZ=0,0,0
    ThrustTouchZ=touchZ; ThrustDirection=1
    if rangeOverride then ThrustRange=rangeOverride; pcall(function() if UIRefs.SlDist then UIRefs.SlDist.set(rangeOverride,true) end end) end
    if speed then ThrustSpeed=speed end
    pcall(function() workspace.FallenPartsDestroyHeight=0/0 end)
    storeWeldInfo(selectedPlayer,animId,true,"bang"); hookTargetRespawn(selectedPlayer)
    local ok,w=pcall(function() return WeldTo(tr,animId,false) end)
    if ok and w then CurrentWeld=w; startThrust(); sSuccess(); screenFlash(T.Accent); burst(main,T.Accent,14); notify("RED HUB","💥 Bang → "..selectedPlayer.Name) end
end

-- F.Bang: thigh-to-face (auto)
local function runFBang(animId,speed,rangeOverride,isAgg,wType)
    if not selectedPlayer or not selectedPlayer.Character then return end
    stopThrust(); stopMotion(); stopFling()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld=nil end
    stopAllMyAnims(); stopCopying()
    CurrentTarget=selectedPlayer
    local head=selectedPlayer.Character:FindFirstChild("Head"); if not head then return end
    -- Thigh at their face level: Y=0 puts my HRP at their head center, my thigh (HRP-level) at their face
    local yOff = 0
    local myHead=LP.Character and LP.Character:FindFirstChild("Head")
    local touchZ = -((myHead and myHead.Size.Z or 1) + head.Size.Z) / 2 - 0.3
    V.X=0; V.Y=yOff; V.Z=touchZ; V.RX,V.RY,V.RZ=0,180,0
    ThrustTouchZ=touchZ; ThrustDirection=-1
    if rangeOverride then ThrustRange=rangeOverride; pcall(function() if UIRefs.SlDist then UIRefs.SlDist.set(rangeOverride,true) end end) end
    if speed then ThrustSpeed=speed end
    pcall(function() workspace.FallenPartsDestroyHeight=0/0 end)
    storeWeldInfo(selectedPlayer,animId,true,wType or "fbang"); hookTargetRespawn(selectedPlayer)
    local ok,w=pcall(function() return WeldTo(head,animId,false) end)
    if ok and w then CurrentWeld=w; startThrust(); sSuccess(); screenFlash(isAgg and T.Pink or T.Accent); burst(main,isAgg and T.Pink or T.Accent,16); notify("RED HUB","💦 F.Bang → "..selectedPlayer.Name) end
end

