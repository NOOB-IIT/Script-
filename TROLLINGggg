-- COPY
local function startCopying(tp)
    stopCopying()
    if not tp or not AnimCopyEnabled then return end
    local mr,tr=getRig(LP),getRig(tp)
    if not mr or not tr then return end
    if mr~=tr then notify("RED HUB","Rig mismatch"); return end
    local tc,mc=tp.Character,LP.Character
    if not tc or not mc then return end
    local tH,mH=tc:FindFirstChildOfClass("Humanoid"),mc:FindFirstChildOfClass("Humanoid")
    if not tH or not mH then return end
    local tA,mA=tH:FindFirstChildOfClass("Animator"),mH:FindFirstChildOfClass("Animator")
    if not tA or not mA then return end
    for _,track in ipairs(tA:GetPlayingAnimationTracks()) do
        local ok,nt=pcall(function()
            local a=Instance.new("Animation"); a.AnimationId=track.Animation.AnimationId
            local t=mA:LoadAnimation(a); t:AdjustSpeed(V.Speed); t:Play(track.TimePosition or 0); return t
        end)
        if ok and nt then table.insert(CopiedTracks,nt) end
    end
    AnimCopyConn=tA.AnimationPlayed:Connect(function(track)
        if not AnimCopyEnabled then return end
        for _,t in ipairs(CopiedTracks) do pcall(function() t:Stop() end) end
        CopiedTracks={}
        local ok,nt=pcall(function()
            local a=Instance.new("Animation"); a.AnimationId=track.Animation.AnimationId
            local t=mA:LoadAnimation(a); t:AdjustSpeed(V.Speed); t:Play(0); return t
        end)
        if ok and nt then table.insert(CopiedTracks,nt) end
    end)
end
local function updateCopySpeed() for _,t in ipairs(CopiedTracks) do pcall(function() t:AdjustSpeed(V.Speed) end) end end

-- WELD
local function WeldTo(TPart,AnimId,UseCopy)
    local char=LP.Character; if not char then return nil end
    local root=char:FindFirstChild("HumanoidRootPart")
    if not root or not char:FindFirstChildOfClass("Humanoid") then return nil end
    stopAllMyAnims()
    if UseCopy then startCopying(CurrentTarget)
    elseif AnimId and AnimId~=0 then
        stopCopying()
        local anim=char:FindFirstChildWhichIsA("Animator",true)
        if anim then
            local a=Instance.new("Animation"); a.AnimationId="rbxassetid://"..tostring(AnimId)
            local ok,tr=pcall(function() return anim:LoadAnimation(a) end)
            if ok and tr then pcall(function() tr:AdjustSpeed(V.Speed); tr:Play() end); table.insert(PlayedAnims,tr) end
        end
    end
    for _,p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false; p.Massless=true end end
    local W={}; local conn
    conn=RunService.Heartbeat:Connect(function()
        if not char.Parent or not TPart.Parent then if W.Destroy then W:Destroy() end return end
        local off=CFrame.new(V.X,V.Y,V.Z)*CFrame.Angles(math.rad(V.RX),math.rad(V.RY),math.rad(V.RZ))
        root.CFrame=TPart.CFrame*off
        root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero
        if sethiddenproperty then
            pcall(function()
                sethiddenproperty(root,"PhysicsRepRootPart",TPart)
                if InstanceHandleNew then sethiddenproperty(root,"PhysicsRepRootRef",InstanceHandleNew(TPart)) end
            end)
        end
    end)
    function W:Destroy()
        if conn then conn:Disconnect(); conn=nil end
        stopCopying(); stopAllMyAnims(); stopThrust(); stopMotion(); stopFling()
        if root then root.AssemblyLinearVelocity=Vector3.zero; root.AssemblyAngularVelocity=Vector3.zero end
    end
    return W
end

