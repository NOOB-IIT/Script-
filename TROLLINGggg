    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)
    local ks=Instance.new("UIStroke"); ks.Color=T.Accent; ks.Thickness=2; ks.Parent=knob
    local vb=Instance.new("TextBox"); vb.Size=UDim2.new(0,50,0,24); vb.Position=UDim2.new(1,-54,0.5,-12); vb.BackgroundColor3=T.PanelLt; vb.Text=tostring(dv); vb.TextColor3=T.Text; vb.Font=Enum.Font.Gotham; vb.TextSize=11; vb.ClearTextOnFocus=false; vb.ZIndex=8; vb.Parent=r
    Instance.new("UICorner",vb).CornerRadius=UDim.new(0,4)
    local cur=dv
    local function setV(v,fire) v=math.clamp(v,mn,mx); cur=v; vb.Text=tostring(math.floor(v*100+0.5)/100); local pc=(v-mn)/(mx-mn); fill.Size=UDim2.new(pc,0,1,0); knob.Position=UDim2.new(pc,-9,0.5,-9); if fire and onChg then onChg(v) end end
    local drg=false
    local function upd(i) local rx=i.Position.X-bg.AbsolutePosition.X; local pc=math.clamp(rx/bg.AbsoluteSize.X,0,1); setV(mn+pc*(mx-mn),true) end
    bg.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drg=true; upd(i); sHover() end end)
    bg.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drg=false end end)
    UIS.InputChanged:Connect(function(i) if drg and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd(i) end end)
    vb.FocusLost:Connect(function() local n=tonumber(vb.Text); if n then setV(n,true); sClick() else setV(cur,false) end end)
    setV(dv,false)
    return {set=setV,get=function() return cur end}
end
