-- HELPERS
local function getRig(p) if not p or not p.Character then return nil end local h=p.Character:FindFirstChildOfClass("Humanoid") return h and h.RigType or nil end
local function isR15(p) return getRig(p)==Enum.HumanoidRigType.R15 end
local function getHeadHeight(c) if not c then return 1.5 end local h=c:FindFirstChild("Head") local hrp=c:FindFirstChild("HumanoidRootPart") if not h or not hrp then return 1.5 end return h.Position.Y-hrp.Position.Y end
local function getTorsoDepth(c) if not c then return 1 end local t=c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") if t then return t.Size.Z end return 1 end

local function stopAllMyAnims() for _,t in ipairs(PlayedAnims) do pcall(function() t:Stop() end) pcall(function() t:Destroy() end) end PlayedAnims={} end
local function stopCopying() if AnimCopyConn then AnimCopyConn:Disconnect(); AnimCopyConn=nil end for _,t in ipairs(CopiedTracks) do pcall(function() t:Stop() end) pcall(function() t:Destroy() end) end CopiedTracks={} end
local function stopThrust() ThrustActive=false; if ThrustConn then ThrustConn:Disconnect(); ThrustConn=nil end end
local function startThrust()
    stopThrust(); ThrustActive=true; local t0=tick()
    ThrustConn=RunService.Heartbeat:Connect(function()
        if not ThrustActive then return end
        local e=tick()-t0; local ph=(math.sin(e*ThrustSpeed*math.pi*2)+1)/2
        V.Z=ThrustTouchZ+ThrustDirection*ph*ThrustRange
    end)
end
local function stopMotion() MotionMode="none"; if MotionConn then MotionConn:Disconnect(); MotionConn=nil end end
local function stopPOV() if OriginalCameraSubject then pcall(function() cam.CameraSubject=OriginalCameraSubject end) OriginalCameraSubject=nil end end
local function stopFling() FlingActive=false; if FlingConn then FlingConn:Disconnect(); FlingConn=nil end end

local function startMotion(mode)
    stopMotion(); MotionMode=mode; local t0=tick()
    MotionConn=RunService.Heartbeat:Connect(function()
        if MotionMode=="none" then return end
        local t=tick()-t0
        if MotionMode=="orbit" then
            local a=t*OrbitSpeed*math.pi*2
            V.X=math.cos(a)*OrbitRadius; V.Z=math.sin(a)*OrbitRadius; V.Y=0
        elseif MotionMode=="bounce" then
            V.Y=math.abs(math.sin(t*BounceSpeed*math.pi))*BounceHeight
        elseif MotionMode=="suck" then
            local pr=math.min(t/SuckDuration,1)
            V.Z=-1-(4)*pr  -- from front to further front (was sucking from far)
            V.Z=-1-4*pr
            V.Z=-1*(1- pr*0.8)  -- hmm let me use different formula
            V.Z=-1-3*math.sin(t*math.pi)  -- oscillate
            if pr>=1 then stopMotion() end
        end
    end)
end

