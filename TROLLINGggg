-- FLING with duration options
local function flingTarget(duration)
    if not selectedPlayer or not selectedPlayer.Character then notify("RED HUB","Select"); return end
    local hrp=selectedPlayer.Character:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    cleanAll(); CurrentTarget=selectedPlayer
    pcall(function() workspace.FallenPartsDestroyHeight=0/0 end)
