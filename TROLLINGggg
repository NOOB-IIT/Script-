local function ripple(b,i)
    local r=Instance.new("Frame"); r.AnchorPoint=Vector2.new(0.5,0.5)
    r.Position=UDim2.new(0,i.Position.X-b.AbsolutePosition.X,0,i.Position.Y-b.AbsolutePosition.Y)
    r.Size=UDim2.new(0,0,0,0); r.BackgroundColor3=Color3.new(1,1,1); r.BackgroundTransparency=0.5
    r.ZIndex=b.ZIndex+2; r.Parent=b
    Instance.new("UICorner",r).CornerRadius=UDim.new(1,0)
    local ms=math.max(b.AbsoluteSize.X,b.AbsoluteSize.Y)*2
    TweenService:Create(r,TweenInfo.new(0.6,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=UDim2.new(0,ms,0,ms),BackgroundTransparency=1}):Play()
