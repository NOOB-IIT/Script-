    storeWeldInfo(selectedPlayer,0,false,"weld"); hookTargetRespawn(selectedPlayer)
    local ok,w=pcall(function() return WeldTo(hrp,0,false) end)
    if not ok or not w then return end
    CurrentWeld=w
    FlingActive=true
    local t0=tick()
    FlingConn=RunService.Heartbeat:Connect(function()
        if not FlingActive or not CurrentWeld then FlingActive=false; if FlingConn then FlingConn:Disconnect() end return end
        if duration and (tick()-t0)>duration then FlingActive=false; if FlingConn then FlingConn:Disconnect(); FlingConn=nil end; return end
        pcall(function()
            hrp.AssemblyLinearVelocity=Vector3.new(math.random(-6000,6000),math.random(4000,9000),math.random(-6000,6000))
            hrp.AssemblyAngularVelocity=Vector3.new(math.random(-100,100),math.random(-100,100),math.random(-100,100))
        end)
    end)
    sSuccess(); notify("RED HUB","🎪 FLING → "..selectedPlayer.Name)
end

