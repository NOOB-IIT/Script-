local function burst(cf,c,ct)
    ct=ct or 16
    for i=1,ct do
        local p=Instance.new("Frame"); p.Size=UDim2.new(0,8,0,8); p.Position=UDim2.new(0.5,-4,0.5,-4)
        p.BackgroundColor3=c; p.BorderSizePixel=0; p.ZIndex=160; p.Parent=cf
        Instance.new("UICorner",p).CornerRadius=UDim.new(1,0)
        local a=(i/ct)*math.pi*2+math.random()*0.3; local d=80+math.random(-20,30)
        local dx,dy=math.cos(a)*d,math.sin(a)*d
        TweenService:Create(p,TweenInfo.new(0.8,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.new(0.5,dx-4,0.5,dy-4),Size=UDim2.new(0,2,0,2),BackgroundTransparency=1}):Play()
        Debris:AddItem(p,1)
    end
end
local function shake(f,intens)
    intens=intens or 4; local orig=f.Position
    for i=1,6 do TweenService:Create(f,TweenInfo.new(0.04),{Position=orig+UDim2.new(0,math.random(-intens,intens),0,math.random(-intens,intens))}):Play() task.wait(0.04) end
    TweenService:Create(f,TweenInfo.new(0.1),{Position=orig}):Play()
end

