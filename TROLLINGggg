-- JUMPSCARE with return
local function jumpscarePlayer()
    if not selectedPlayer or not selectedPlayer.Character then return end
    local head=selectedPlayer.Character:FindFirstChild("Head"); if not head then return end
    local myHrp=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"); if not myHrp then return end
    SavedCFrame=myHrp.CFrame  -- save original position
    stopThrust(); stopMotion(); stopFling()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld=nil end
    stopAllMyAnims(); stopCopying()
    CurrentTarget=selectedPlayer
    V.X=0; V.Y=0; V.Z=-0.6; V.RX,V.RY,V.RZ=0,180,0  -- in front of face
    pcall(function() workspace.FallenPartsDestroyHeight=0/0 end)
    storeWeldInfo(selectedPlayer,507770677,false,"weld"); hookTargetRespawn(selectedPlayer)
    sScream()
    local ok,w=pcall(function() return WeldTo(head,507770677,false) end)
    if ok and w then
        CurrentWeld=w
        for _,t in ipairs(PlayedAnims) do pcall(function() t:AdjustSpeed(2.5) end) end
        screenFlash(Color3.fromRGB(255,0,0)); shake(main,10)
        notify("RED HUB","😱 JUMPSCARE → "..selectedPlayer.Name); sSuccess()
        -- Return to original position after 2s
        task.spawn(function()
            task.wait(2)
            if SavedCFrame and myHrp and myHrp.Parent then
                cleanAll()
                task.wait(0.05)
                pcall(function() myHrp.CFrame=SavedCFrame end)
                notify("RED HUB","↩ Returned"); sWhoosh()
            end
        end)
    end
end

