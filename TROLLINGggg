performAutoReweld=function(tp,reason)
    if not AutoReweldEnabled then return end
    if not tp or not tp.Character then return end
    if LastWeldType=="fbangagg" then task.wait(0.3); runFBangAgg(); return end
    if LastWeldType=="bangagg" then task.wait(0.3); runBangAgg(); return end
    local th=tp.Character:FindFirstChildOfClass("Humanoid"); if not th then return end
    local tr=((th.RigType==Enum.HumanoidRigType.R15) and tp.Character:FindFirstChild("UpperTorso") or tp.Character:FindFirstChild("Torso") or tp.Character:FindFirstChild("HumanoidRootPart"))
    if not tr then return end
    cleanAll(); CurrentTarget=tp; selectedPlayer=tp
    pcall(function() workspace.FallenPartsDestroyHeight=0/0 end)
    local ok,w=pcall(function() return WeldTo(tr,LastWeldAnimId,AnimCopyEnabled) end)
    if ok and w then CurrentWeld=w; if LastWeldWasThrust then startThrust() end; sSuccess(); notify("RED HUB",(reason or "Re-weld").." → "..tp.Name) end
end

