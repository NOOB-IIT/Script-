    local bg=Instance.new("TextButton"); bg.Size=UDim2.new(1,-100,0,8); bg.Position=UDim2.new(0,44,0.5,-4); bg.BackgroundColor3=T.PanelLt; bg.Text=""; bg.AutoButtonColor=false; bg.ZIndex=8; bg.Parent=r
