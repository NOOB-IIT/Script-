local tr = ((th.RigType == Enum.HumanoidRigType.R15)
and targetPlr.Character:FindFirstChild("UpperTorso")
or  targetPlr.Character:FindFirstChild("Torso")
or  targetPlr.Character:FindFirstChild("HumanoidRootPart"))
if not tr then return end
StateManager.CleanAll()
CurrentTarget = targetPlr; selectedPlayer = targetPlr
pcall(function() Workspace.FallenPartsDestroyHeight = 0/0 end)
local ok, w = pcall(function() return WeldTo(tr, LastWeldAnimId, AnimCopyEnabled) end)
if ok and w then
