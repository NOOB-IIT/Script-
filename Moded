-- ============================================================================
local function antiParallelAction()
if not selectedPlayer or not selectedPlayer.Character then return end
StateManager.CleanAll()
CurrentTarget = selectedPlayer
local tc = selectedPlayer.Character
local tr = tc:FindFirstChild("HumanoidRootPart") or tc:FindFirstChild("Torso")
if not tr then return end
-- Transformations: X=0, Y=0, Y-Axis 180°, Z-Axis 180°
V.X = 0; V.Y = 0
V.RX = 0; V.RY = 180; V.RZ = 180
-- Dynamic Z-Offset: Smoothly shift between Z = -2 and Z = -1
local t0 = tick()
ThrustConn = RunService.Heartbeat:Connect(function()
if not CurrentWeld then return end
local elapsed = tick() - t0
local phase = (math.sin(elapsed * 3 * math.pi * 2) + 1) / 2
V.Z = -2 + phase * 1.0 -- Smoothly oscillates between -2 and -1
end)
pcall(function() Workspace.FallenPartsDestroyHeight = 0/0 end)
storeWeldInfo(selectedPlayer, 282574440, true, "69pos")
hookTargetRespawn(selectedPlayer)
local char = LP.Character
local root = char and char:FindFirstChild("HumanoidRootPart")
local animator = char and char:FindFirstChildWhichIsA("Animator", true)
if not root then return end
if animator then
local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://282574440"
local ok, trk = pcall(function() return animator:LoadAnimation(a) end)
if ok and trk then pcall(function() trk:Play() end); table.insert(PlayedAnims, trk) end
end
local conn
conn = RunService.Heartbeat:Connect(function()
if not char.Parent or not tc.Parent then if conn then conn:Disconnect() end return end
local offset = CFrame.new(V.X, V.Y, V.Z) * CFrame.Angles(math.rad(V.RX), math.rad(V.RY), math.rad(V.RZ))
root.CFrame = tr.CFrame * offset
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero
end)
local Weld = {}
function Weld:Destroy()
if conn then conn:Disconnect(); conn = nil end
if ThrustConn then ThrustConn:Disconnect(); ThrustConn = nil end
StateManager.StopAllAnims()
end
CurrentWeld = Weld
sSuccess()
notify("RED HUB", "🔄 69 Position (Y:180°, Z:180°, Z:-2 to -1) → " .. selectedPlayer.Name)
end
