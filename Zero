local NotifContainer = nil

local function notify(title, message, kind, duration)
    if not State.Settings.ShowNotifications then return end
    if not NotifContainer then return end
    duration = duration or 3
    kind = kind or "info"

    local color = CFG.Theme.Primary
    local icon = "ℹ"
    if kind == "success" then color = CFG.Theme.Success; icon = "✓"
    elseif kind == "warning" then color = CFG.Theme.Warning; icon = "⚠"
    elseif kind == "error" then color = CFG.Theme.Danger; icon = "✕"
    end

    local notif = create("Frame", {
        Size = UDim2.new(1, -12, 0, 58),
        BackgroundColor3 = CFG.Theme.SurfaceLight,
        BorderSizePixel = 0,
        BackgroundTransparency = 0.05,
        Parent = NotifContainer,
    })
    corner(notif, 8)
    stroke(notif, color, 1.5)

    local accent = create("Frame", {
        Size = UDim2.new(0, 4, 1, -12),
        Position = UDim2.new(0, 6, 0, 6),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = notif,
    })
    corner(accent, 2)

    create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 16),
        Position = UDim2.new(0, 18, 0, 7),
        BackgroundTransparency = 1,
        Text = icon .. "  " .. tostring(title),
        TextColor3 = color,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif,
    })

    create("TextLabel", {
        Size = UDim2.new(1, -24, 0, 30),
        Position = UDim2.new(0, 18, 0, 22),
        BackgroundTransparency = 1,
        Text = tostring(message),
        TextColor3 = CFG.Theme.TextDim,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        Parent = notif,
    })

    -- Slide in
    notif.Position = UDim2.new(1.2, 0, 0, 0)
    tween(notif, {Position = UDim2.new(0, 0, 0, 0)}, 0.25)

    task.delay(duration, function()
        if notif and notif.Parent then
            tween(notif, {Position = UDim2.new(1.2, 0, 0, 0), BackgroundTransparency = 1}, 0.25)
            task.wait(0.3)
            notif:Destroy()
        end
    end)
end

-- ═══════════════════════════════════════════════════════════════
-- CORE: WELD (from user's original logic)
-- ═══════════════════════════════════════════════════════════════
local function WeldTo(TargetPart, Offset)
    local Character = LocalPlayer.Character
    if not Character then return nil end
    local Root = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildWhichIsA("Humanoid")
    if not Root or not Humanoid then return nil end

    for _, v in ipairs(Character:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
            v.Massless  = true
        end
    end

    local Connection
    local Weld = {}

    Connection = RunService.Heartbeat:Connect(function()
        if not Character.Parent or not TargetPart or not TargetPart.Parent then
            if Weld.Destroy then Weld:Destroy() end
            return
        end
        Root.CFrame = TargetPart.CFrame * Offset
        Root.AssemblyLinearVelocity  = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero

        if sethiddenproperty then
            pcall(function()
                sethiddenproperty(Root, "PhysicsRepRootPart", TargetPart)
                sethiddenproperty(Root, "PhysicsRepRootRef", InstanceHandle.new(TargetPart))
            end)
        end
    end)

    function Weld:Destroy()
        if Connection then Connection:Disconnect() end
        if Root then
            Root.AssemblyLinearVelocity  = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    return Weld
end

-- ═══════════════════════════════════════════════════════════════
-- CORE: ANIMATION COPY
-- ═══════════════════════════════════════════════════════════════
local function getTargetAnimations(targetPlayer)
    local result = {}
    if not targetPlayer or not targetPlayer.Character then return result end
    local tHum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not tHum then return result end
    local ok, tracks = pcall(function() return tHum:GetPlayingAnimationTracks() end)
    if not ok or not tracks then return result end
    for _, track in ipairs(tracks) do
        local anim = track.Animation
        if anim and anim.AnimationId and anim.AnimationId ~= "" then
            table.insert(result, {
                AnimationId = anim.AnimationId,
                Speed       = track.Speed or 1,
                Name        = track.Name or "Unknown",
            })
        end
    end
    return result
end

local function stopCopiedAnimations()
    for _, info in ipairs(State.CopiedTracks) do
        pcall(function()
            info.track:Stop(0)
            info.track:Destroy()
        end)
    end
    State.CopiedTracks = {}
end

local function playAnimations(animData, speedMult)
    local char = LocalPlayer.Character
    if not char then return 0 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return 0 end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    stopCopiedAnimations()
    local count = 0
    for _, data in ipairs(animData) do
        local newAnim = Instance.new("Animation")
        newAnim.AnimationId = data.AnimationId
        local ok, track = pcall(function() return animator:LoadAnimation(newAnim) end)
        if ok and track then
            track:Play()
            local baseSpd = data.Speed or 1
            track:AdjustSpeed((speedMult or 1) * baseSpd)
            table.insert(State.CopiedTracks, {track = track, baseSpeed = baseSpd})
            count = count + 1
        end
    end
    return count
end

local function updateSpeedAll(mult)
    for _, info in ipairs(State.CopiedTracks) do
        pcall(function() info.track:AdjustSpeed((mult or 1) * info.baseSpeed) end)
    end
end

local function doUnweld()
    if State.CurrentWeld then
        pcall(function() State.CurrentWeld:Destroy() end)
        State.CurrentWeld = nil
    end
    workspace.FallenPartsDestroyHeight = State.OriginalFPDH
end

