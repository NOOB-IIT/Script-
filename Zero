local function applyPreset(p)
    if not State.SelectedPlayer then
        notify("No Target", "Select a player first", "warning")
        return
    end
    local part = getTargetPart(State.SelectedPlayer)
    if not part then
        notify("Target Error", "Target character not found", "error")
        return
    end
    doUnweld()
    workspace.FallenPartsDestroyHeight = 0/0
    local offset = CFrame.new(p.x, p.y, p.z) * CFrame.Angles(math.rad(p.rx), math.rad(p.ry), math.rad(p.rz))
    State.CurrentWeld = WeldTo(part, offset)
    State.Stats.WeldCount = State.Stats.WeldCount + 1

    -- Update weld page inputs to match preset
    weldX_tb.Text = tostring(p.x)
    weldY_tb.Text = tostring(p.y)
    weldZ_tb.Text = tostring(p.z)
    rotX_tb.Text = tostring(p.rx)
    rotY_tb.Text = tostring(p.ry)
    rotZ_tb.Text = tostring(p.rz)
    computeOffset()

    -- Play preset animation
    if p.anim ~= 0 then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            if animator then
                stopCopiedAnimations()
                local a = Instance.new("Animation")
                a.AnimationId = "rbxassetid://" .. tostring(p.anim)
                local t = animator:LoadAnimation(a)
                t:Play()
                t:AdjustSpeed(State.AnimSpeed)
                table.insert(State.CopiedTracks, {track = t, baseSpeed = 1})
            end
        end
    end

    setStatus("Preset: " .. p.name, true)
    notify("Preset Applied", p.icon .. " " .. p.name .. " applied", "success")
end

