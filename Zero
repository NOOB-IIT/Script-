-- Toggle switch
local function toggleSwitch(parent, label, default, xPos, width)
    local container = create("Frame", {
        Size = UDim2.new(width or 1, 0, 0, 32),
        BackgroundTransparency = 1,
        Parent = parent,
    })
    if xPos then container.Position = xPos end

    create("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = CFG.Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = container,
    })

    local switch = create("Frame", {
        Size = UDim2.new(0, 44, 0, 22),
        Position = UDim2.new(1, -44, 0.5, -11),
        BackgroundColor3 = default and CFG.Theme.Primary or CFG.Theme.SurfaceLight,
        BorderSizePixel = 0,
        Parent = container,
    })
    corner(switch, 11)

    local knob = create("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = default and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = switch,
    })
    corner(knob, 9)

    local state = default
    local clickArea = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = container,
    })

    clickArea.MouseButton1Click:Connect(function()
        state = not state
        tween(switch, {BackgroundColor3 = state and CFG.Theme.Primary or CFG.Theme.SurfaceLight}, 0.15)
        tween(knob, {Position = state and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2)}, 0.15)
    end)

    return container, function() return state end
end

