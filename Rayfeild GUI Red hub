local killStat = homeTab:CreateStat({ name = "Total Kills", prefix = "", value = getgenv().KillCount, maxValue = 99999 })
local function updateKillUI(n) getgenv().KillCount = n killStat:Set(getgenv().KillCount) end

local cachedHealth, processedVictims = {}, {}

local function trackLeaderstats(folder)
    local killKeywords = {"kills","kos","wipeouts","knockouts","frags","defeats","streaks","bounty"}
    local function checkValue(child)
        if child:IsA("ValueBase") then
            local childName = child.Name:lower()
            for _, kw in ipairs(killKeywords) do
                if childName:find(kw) then
                    child.Changed:Connect(function(nv)
                        if nv == 0 then updateKillUI(0)
                        elseif nv > getgenv().KillCount then updateKillUI(nv) end
                    end)
                    if child.Value > getgenv().KillCount then updateKillUI(child.Value) end
                    break
                end
            end
        end
    end
    for _, child in ipairs(folder:GetChildren()) do checkValue(child) end
    folder.ChildAdded:Connect(checkValue)
end

local function setupLocalPlayerStats()
    local currentLeaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if currentLeaderstats then trackLeaderstats(currentLeaderstats) end
    LocalPlayer.ChildAdded:Connect(function(child)
        if child.Name == "leaderstats" then trackLeaderstats(child) end
    end)
end
task.spawn(setupLocalPlayerStats)

