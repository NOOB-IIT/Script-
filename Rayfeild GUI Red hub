getgenv().ChamsEnabled = false
local ChamsTargets, ChamsConnections = {}, {}

local function removeChams(player)
    local data = ChamsTargets[player.Name]
    if data and data.Highlight then data.Highlight:Destroy() end
    ChamsTargets[player.Name] = nil
    if ChamsConnections[player.Name] then ChamsConnections[player.Name]:Disconnect() ChamsConnections[player.Name] = nil end
end

local function applyChams(player, character)
    if player == LocalPlayer or not character or not getgenv().ChamsEnabled then return end
    local oldData = ChamsTargets[player.Name]
    if oldData and oldData.Highlight then oldData.Highlight:Destroy() end
    ChamsTargets[player.Name] = nil
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    local rootPart = character:WaitForChild("HumanoidRootPart", 5) or humanoid.RootPart or character:FindFirstChildWhichIsA("BasePart")
    if not rootPart or not character:IsDescendantOf(workspace) then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "RedChamsHighlight"
    highlight.FillColor = getgenv().EspColor or Color3.fromRGB(255, 30, 30)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Adornee = character
    highlight.Parent = character
    highlight.Enabled = false
    ChamsTargets[player.Name] = { Player = player, Character = character, Highlight = highlight, Root = rootPart, Distance = 99999 }
    humanoid.Died:Connect(function()
        if ChamsTargets[player.Name] and ChamsTargets[player.Name].Character == character then
            ChamsTargets[player.Name] = nil
            if highlight then highlight:Destroy() end
        end
    end)
end

local function addChams(player)
    if player == LocalPlayer then return end
    if ChamsConnections[player.Name] then ChamsConnections[player.Name]:Disconnect() ChamsConnections[player.Name] = nil end
    if player.Character then task.spawn(function() applyChams(player, player.Character) end) end
    ChamsConnections[player.Name] = player.CharacterAdded:Connect(function(character)
        if not getgenv().ChamsEnabled then return end
        task.wait(0.2)
        if getgenv().ChamsEnabled then applyChams(player, character) end
    end)
end

local function refreshAllChams()
    if not getgenv().ChamsEnabled then return end
    for _, data in pairs(ChamsTargets) do if data.Highlight then data.Highlight:Destroy() end end
    ChamsTargets = {}
    for _, player in ipairs(Players:GetPlayers()) do if player ~= LocalPlayer then addChams(player) end end
end

