                if player ~= LocalPlayer then
                    local char = player.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if hum and root then
                        local pName = player.Name
                        local ch = hum.Health
                        local ph = cachedHealth[pName] or 100
                        cachedHealth[pName] = ch
                        if (ch <= 0 and ph > 0) or (not char.Parent and ph < 75) then
                            if not processedVictims[pName] then
                                processedVictims[pName] = true
                                task.delay(3, function() processedVictims[pName] = nil end)
                                local distance = (myRoot.Position - root.Position).Magnitude
                                if distance <= 28 then
                                    local cur = getgenv().KillCount
                                    task.wait(0.05)
                                    if getgenv().KillCount == cur then updateKillUI(getgenv().KillCount + 1) end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

