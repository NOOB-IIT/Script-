getgenv().ESPData    = getgenv().ESPData or {}

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local function getGui(name)
    local gui = CoreGui:FindFirstChild(name)
    if gui then return gui end
    gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local ok = pcall(function() gui.Parent = CoreGui end)
    if not ok then gui.Parent = PlayerGui end
    return gui
end

local EspGui    = getGui("RedHub_EspGui")
local TracerGui = getGui("RedHub_Tracers_Gui")

local function getCamera() return workspace.CurrentCamera end

local function destroyVisuals(data)
    if not data then return end
    if data.RenderConnection then data.RenderConnection:Disconnect() data.RenderConnection = nil end
    if data.Highlight then data.Highlight:Destroy() data.Highlight = nil end
    if data.Billboard then data.Billboard:Destroy() data.Billboard = nil end
    if data.Box then data.Box:Destroy() data.Box = nil end
    if data.Tracer then data.Tracer:Destroy() data.Tracer = nil end
end

local function cleanupPlayer(player)
    local data = getgenv().ESPData[player]
    if not data then return end
    destroyVisuals(data)
    if data.CharacterConnection then data.CharacterConnection:Disconnect() data.CharacterConnection = nil end
    getgenv().ESPData[player] = nil
end

local function getAvatarParts(character)
    if not character then return nil, nil end
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    local head = character:FindFirstChild("Head")
    if not root or not root:IsA("BasePart") then
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Transparency < 1 then root = obj break end
        end
    end
    if not head or not head:IsA("BasePart") then head = root end
    return root, head
end

local function createESP(player, character)
    if player == LocalPlayer or not getgenv().EspEnabled then return end
    if not character or player.Character ~= character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local rootPart, head = getAvatarParts(character)
    if not rootPart or not head then
        task.delay(0.5, function()
            if getgenv().EspEnabled and player.Character == character and character:IsDescendantOf(workspace) then
                createESP(player, character)
            end
        end)
        return
    end
    local data = getgenv().ESPData[player] or {}
    getgenv().ESPData[player] = data
    destroyVisuals(data)
    data.Character, data.RootPart, data.Head, data.Humanoid = character, rootPart, head, humanoid

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.Adornee = character
    highlight.FillColor = getgenv().EspColor
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    data.Highlight = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESPInfo"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(200, 45)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = character
    data.Billboard = billboard

    local nameLabel = Instance.new("TextLabel")
    nameLabel.BackgroundTransparency = 1
    nameLabel.Size = UDim2.new(1, 0, 0, 20)
    nameLabel.Font = Enum.Font.GothamBlack
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
    nameLabel.TextSize = 14
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Parent = billboard

    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Position = UDim2.fromOffset(0, 20)
    distanceLabel.Size = UDim2.new(1, 0, 0, 18)
    distanceLabel.Font = Enum.Font.GothamBold
    distanceLabel.Text = "[0 studs]"
    distanceLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
    distanceLabel.TextSize = 12
    distanceLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distanceLabel.TextStrokeTransparency = 0
    distanceLabel.Parent = billboard

    local box = Instance.new("Frame")
    box.Name = player.Name .. "_ESPBox"
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    box.Parent = EspGui
    data.Box = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Thickness = 1.5
    boxStroke.Color = getgenv().EspColor
    boxStroke.Parent = box

    local tracer = Instance.new("Frame")
    tracer.Name = player.Name .. "_ESPTracer"
    tracer.BackgroundTransparency = 1
    tracer.BorderSizePixel = 0
    tracer.Size = UDim2.fromScale(1, 1)
    tracer.Visible = false
    tracer.Parent = TracerGui
    data.Tracer = tracer

    local tracerShadow = Instance.new("Frame")
    tracerShadow.Name = "Shadow"
    tracerShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    tracerShadow.BackgroundTransparency = 0.65
    tracerShadow.BorderSizePixel = 0
    tracerShadow.AnchorPoint = Vector2.new(0.5, 0.5)
    tracerShadow.ZIndex = 1
    tracerShadow.Parent = tracer

    local tracerLine = Instance.new("Frame")
    tracerLine.Name = "Line"
    tracerLine.BackgroundColor3 = getgenv().EspColor
    tracerLine.BorderSizePixel = 0
    tracerLine.AnchorPoint = Vector2.new(0.5, 0.5)
    tracerLine.ZIndex = 2
    tracerLine.Parent = tracer

    data.RenderConnection = RunService.RenderStepped:Connect(function()
        if not getgenv().EspEnabled then
            highlight.Enabled = false billboard.Enabled = false box.Visible = false tracer.Visible = false return
        end
        if player.Character ~= character or not character:IsDescendantOf(workspace) or humanoid.Health <= 0 then
            highlight.Enabled = false billboard.Enabled = false box.Visible = false tracer.Visible = false return
        end
        local currentRoot, currentHead = getAvatarParts(character)
        if currentRoot then rootPart = currentRoot data.RootPart = currentRoot end
        if currentHead then head = currentHead data.Head = currentHead if billboard.Adornee ~= currentHead then billboard.Adornee = currentHead end end
        if not rootPart then box.Visible = false tracer.Visible = false return end
        local myChar = LocalPlayer.Character
        if not myChar then box.Visible = false tracer.Visible = false return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart
        if not myRoot then box.Visible = false tracer.Visible = false return end
        local camera = getCamera()
        if not camera then return end
        local color = getgenv().EspColor
        highlight.FillColor = color
        boxStroke.Color = color
        tracerLine.BackgroundColor3 = color
        local boundingCFrame, boundingSize = character:GetBoundingBox()
        local boundsCenter = boundingCFrame.Position
        local distance = (myRoot.Position - boundsCenter).Magnitude
        distanceLabel.Text = "[" .. math.floor(distance) .. " studs]"
        highlight.Enabled = true billboard.Enabled = true
        if distance > 1000 then box.Visible = false tracer.Visible = false return end
        local topWorld = boundsCenter + Vector3.new(0, boundingSize.Y/2, 0)
        local bottomWorld = boundsCenter - Vector3.new(0, boundingSize.Y/2, 0)
        local topScreen = camera:WorldToViewportPoint(topWorld)
        local bottomScreen = camera:WorldToViewportPoint(bottomWorld)
        if topScreen.Z <= 0 or bottomScreen.Z <= 0 then box.Visible = false tracer.Visible = false return end
        local height = math.abs(bottomScreen.Y - topScreen.Y)
        local width = math.max(height * 0.55, 2)
        if height < 2 then box.Visible = false else
            box.Size = UDim2.fromOffset(width, height)
            box.Position = UDim2.fromOffset(bottomScreen.X - width/2, topScreen.Y)
            box.Visible = true
        end
        local feetScreen, feetVisible = camera:WorldToViewportPoint(bottomWorld)
        if not feetVisible or feetScreen.Z <= 0 then tracer.Visible = false return end
        local startX, startY = camera.ViewportSize.X / 2, camera.ViewportSize.Y
        local endX, endY = feetScreen.X, feetScreen.Y
        local dx, dy = endX - startX, endY - startY
        local lineLength = math.sqrt(dx*dx + dy*dy)
        if lineLength <= 1 then tracer.Visible = false return end
        local angle = math.deg(math.atan2(dy, dx))
        local cx, cy = (startX + endX)/2, (startY + endY)/2
        tracerLine.Size = UDim2.fromOffset(lineLength, 2)
        tracerLine.Position = UDim2.fromOffset(cx, cy)
        tracerLine.Rotation = angle
        tracerShadow.Size = UDim2.fromOffset(lineLength, 4)
        tracerShadow.Position = UDim2.fromOffset(cx, cy)
        tracerShadow.Rotation = angle
        tracer.Visible = true
    end)
end

local function setupPlayer(player)
    if player == LocalPlayer then return end
    local data = getgenv().ESPData[player] or {}
    getgenv().ESPData[player] = data
    if data.CharacterConnection then data.CharacterConnection:Disconnect() data.CharacterConnection = nil end
    data.CharacterConnection = player.CharacterAdded:Connect(function(character)
        local deadline = os.clock() + 5
        repeat
            task.wait(0.1)
            if not getgenv().EspEnabled or player.Character ~= character then return end
            if character:FindFirstChildOfClass("Humanoid") and character:FindFirstChildWhichIsA("BasePart", true) then break end
        until os.clock() >= deadline
        if getgenv().EspEnabled and player.Character == character then createESP(player, character) end
    end)
    if player.Character then
        task.spawn(function()
            local character = player.Character
            local deadline = os.clock() + 5
            repeat
                task.wait(0.1)
                if not getgenv().EspEnabled or player.Character ~= character then return end
                if character:FindFirstChildOfClass("Humanoid") and character:FindFirstChildWhichIsA("BasePart", true) then break end
            until os.clock() >= deadline
            if getgenv().EspEnabled and player.Character == character then createESP(player, character) end
        end)
    end
end

getgenv().EnableESP = function()
    getgenv().EspEnabled = true
    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then setupPlayer(p) end end
end

getgenv().DisableESP = function()
    getgenv().EspEnabled = false
    for p in pairs(getgenv().ESPData) do cleanupPlayer(p) end
end

getgenv().RefreshESP = function()
    if not getgenv().EspEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local data = getgenv().ESPData[p]
            if not data then setupPlayer(p)
            elseif data.Character ~= p.Character and p.Character then createESP(p, p.Character) end
        end
    end
end

