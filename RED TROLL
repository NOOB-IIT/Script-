local function UpdateDropdownList()
	for _, child in ipairs(dropdownFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	local serverPlayers = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then table.insert(serverPlayers, p) end
	end
	table.sort(serverPlayers, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)

	for _, p in ipairs(serverPlayers) do
		local pBtn = Instance.new("TextButton")
		pBtn.Size = UDim2.new(1, 0, 0, 25)
		pBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
		pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
		pBtn.Font = Enum.Font.SourceSans
		pBtn.TextSize = 14
		pBtn.ZIndex = 6
		pBtn.Parent = dropdownFrame

		pBtn.MouseButton1Click:Connect(function()
			targetBox.Text = p.Name
			dropdownFrame.Visible = false
			dropdownToggle.Text = "^"
		end)
	end
	dropdownFrame.CanvasSize = UDim2.new(0, 0, 0, #serverPlayers * 25)
end

dropdownToggle.MouseButton1Click:Connect(function()
	dropdownFrame.Visible = not dropdownFrame.Visible
	dropdownToggle.Text = dropdownFrame.Visible and "v" or "^"
	if dropdownFrame.Visible then UpdateDropdownList() end
end)

