---------------------------------------------------------
-- BALANCED & STABLE FLING LOGIC
---------------------------------------------------------

local function GetTargetPlayer(searchName)
	searchName = tostring(searchName or ""):lower()
	if searchName == "" then return nil end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local pName = player.Name:lower()
			local dName = (player.DisplayName or ""):lower()
			if pName:sub(1, #searchName) == searchName or dName:sub(1, #searchName) == searchName then return player end
		end
	end
	return nil
end

local isFlinging = false
local isFlingingAll = false

local function FlingPlayer(targetUsername, duration)
	if isFlinging then return end
	duration = duration or 2.0 -- Set default duration to 2 seconds

	local targetPlayer = GetTargetPlayer(targetUsername)
	if not targetPlayer or not targetPlayer.Character then
		if not isFlingingAll then
			flingButton.Text = "Player Not Found!"
			flingButton.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
			task.wait(1.5)
			flingButton.Text = "FLING PLAYER"
			flingButton.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
		end
		return
	end

	local myChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")

	if not myRoot or not targetRoot then return end

	isFlinging = true
	if not isFlingingAll then
		flingButton.Text = "FLINGING..."
		flingButton.BackgroundColor3 = Color3.fromRGB(255, 120, 0)
	end

	local savedCFrame = myRoot.CFrame
	local connection
	local startTime = tick()

	connection = RunService.Heartbeat:Connect(function()
		if (tick() - startTime >= duration) or not targetRoot.Parent or not targetPlayer.Character or (isFlingingAll == false and flingAllButton.Text == "FLINGING ALL...") then
			if connection then connection:Disconnect() end

			-- Reset velocity and teleport safely back to original spot
			myRoot.AssemblyLinearVelocity = Vector3.zero
			myRoot.AssemblyAngularVelocity = Vector3.zero
			myRoot.CFrame = savedCFrame
			
			pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", nil) end)

			isFlinging = false
			if not isFlingingAll then
				flingButton.Text = "FLING PLAYER"
				flingButton.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
			end
			return
		end

		local timePassed = tick() - startTime
		
		-- Jameen ke thoda andar (-3.5 studs) se target ki chest (+1.0 stud) tak movement
		local yOffset = math.sin(timePassed * 300) * 2.25 - 1.25
		
		myRoot.CFrame = CFrame.new(targetRoot.Position + Vector3.new(0, yOffset, 0)) * CFrame.Angles(-math.pi / 2, 0, 0)
		
		-- Force updated to 40,000
		myRoot.AssemblyLinearVelocity = Vector3.new(40000, 40000, 40000)
		myRoot.AssemblyAngularVelocity = Vector3.new(40000, 40000, 40000)

		pcall(function() sethiddenproperty(myRoot, "PhysicsRepRootPart", targetRoot) end)
	end)
end

-- Single Player Fling Trigger (2 Seconds)
flingButton.MouseButton1Click:Connect(function()
	if not isFlingingAll then
		FlingPlayer(targetBox.Text, 2.0)
	end
end)

-- Fling All Trigger (2 Seconds per player)
flingAllButton.MouseButton1Click:Connect(function()
	if isFlingingAll then return end
	isFlingingAll = true
	flingAllButton.Text = "FLINGING ALL..."
	flingAllButton.BackgroundColor3 = Color3.fromRGB(255, 120, 0)
	
	task.spawn(function()
		while isFlingingAll do
			local allPlayers = Players:GetPlayers()
			for _, p in ipairs(allPlayers) do
				if not isFlingingAll then break end
				
				if p ~= LocalPlayer then
					FlingPlayer(p.Name, 2.0) -- 2 seconds duration per target
					task.wait(2.05)
				end
			end
			task.wait(0.3)
		end
		flingAllButton.Text = "FLING ALL"
		flingAllButton.BackgroundColor3 = Color3.fromRGB(220, 20, 20)
	end)
end)

