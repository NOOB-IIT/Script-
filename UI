topicBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 255)
topicBtn.TextColor3 = Color3.new(1, 1, 1)
topicBtn.Parent = aiFrame

-- 2. Logic Connecting (RemoteEvents / Functions)
local QuestProgress = Remotes.QuestProgress
local StakeAction = Remotes.StakeAction
local TopicRequest = Remotes.TopicRequest
local GetReport = Remotes.GetReport

-- Quest Update Sunna
QuestProgress.OnClientEvent:Connect(function(quests)
    local text = ""
    for _, q in ipairs(quests) do
        local status = "Incomplete"
        if q.Completed then status = "DONE" end
        text = text .. q.Name .. " [" .. q.Progress .. "/" .. q.Target .. "] - " .. status .. "\n"
    end
    questList.Text = text
end)

-- Stake Button (Server ko bhejo)
stakeBtn.MouseButton1Click:Connect(function()
    StakeAction:FireServer(SharedConfig.StakeAmount)
end)

-- Report Button (Server se data lo)
reportBtn.MouseButton1Click:Connect(function()
    local data = GetReport:InvokeServer()
    if data then
        local text = string.format("REPORT:\nCash: %d\nPoints: %d\nWins: %d\nLosses: %d", data.Cash, data.Points, data.Wins, data.Losses)
        questList.Text = text -- Temporary report dikhane ke liye
    end
end)

-- AI Topic Button (Server se topic lo)
topicBtn.MouseButton1Click:Connect(function()
    topicLabel.Text = "Thinking..."
    local topic = TopicRequest:InvokeServer()
    topicLabel.Text = topic
end)
