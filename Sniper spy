            local hue = (tick() * 0.5) % 1
            targetLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
            targetLabel.Text = string.format("%s\nDistance: %.1f studs (%.1f m)", 
                player.Name, distance, distance * 0.28)
