-- Update zoom label
local function updateZoomLabel()
    local zoomMultiplier = maxFOV / Camera.FieldOfView
    zoomLabel.Text = string.format("Zoom: %.1fx", zoomMultiplier)
end

-- Toggle aim
local function toggleAim()
    aiming = not aiming
    if aiming then
        -- Show black frames
        topFrame.Visible = true
        bottomFrame.Visible = true
        leftFrame.Visible = true
        rightFrame.Visible = true
        topLeft.Visible = true
        topRight.Visible = true
        bottomLeft.Visible = true
        bottomRight.Visible = true
        
        -- Show crosshair
        crosshairH.Visible = true
        crosshairV.Visible = true
        centerDot.Visible = true
        for _, dot in ipairs(milDots) do
            dot.Visible = true
        end
        
        targetLabel.Visible = false
        zoomInBtn.Visible = true
        zoomOutBtn.Visible = true
        zoomLabel.Visible = true
        currentFOV = zoomFOV
        TweenService:Create(Camera, TweenInfo.new(0.3), {FieldOfView = zoomFOV}):Play()
        updateZoomLabel()
        
        dragStartPos = nil
        isDragging = false
    else
        -- Hide everything
        topFrame.Visible = false
        bottomFrame.Visible = false
        leftFrame.Visible = false
        rightFrame.Visible = false
        topLeft.Visible = false
        topRight.Visible = false
        bottomLeft.Visible = false
        bottomRight.Visible = false
        
        crosshairH.Visible = false
        crosshairV.Visible = false
        centerDot.Visible = false
        for _, dot in ipairs(milDots) do
            dot.Visible = false
        end
        
        targetLabel.Visible = false
        zoomInBtn.Visible = false
        zoomOutBtn.Visible = false
        zoomLabel.Visible = false
        TweenService:Create(Camera, TweenInfo.new(0.3), {FieldOfView = maxFOV}):Play()
        currentFOV = maxFOV
        touchStartDistance = nil
        touchStartFOV = nil
        dragStartPos = nil
        isDragging = false
    end
end

-- Zoom functions
local function zoomIn()
    if aiming then
        zoomFOV = math.max(minFOV, Camera.FieldOfView - zoomSpeed)
        Camera.FieldOfView = zoomFOV
        currentFOV = zoomFOV
        updateZoomLabel()
    end
end

local function zoomOut()
    if aiming then
        zoomFOV = math.min(maxFOV, Camera.FieldOfView + zoomSpeed)
        Camera.FieldOfView = zoomFOV
        currentFOV = zoomFOV
        updateZoomLabel()
    end
end

