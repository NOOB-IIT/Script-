-- Touch handling
UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
    if not aiming then return end
    
    local touches = UserInputService:GetTouches()
    if #touches == 1 then
        dragStartPos = touch.Position
        isDragging = true
    elseif #touches == 2 then
        local pos1 = touches[1].Position
        local pos2 = touches[2].Position
        touchStartDistance = (pos1 - pos2).Magnitude
        touchStartFOV = Camera.FieldOfView
        isDragging = false
        dragStartPos = nil
    end
end)

UserInputService.TouchMoved:Connect(function(touch, gameProcessed)
    if not aiming then return end
    
    local touches = UserInputService:GetTouches()
    if #touches == 1 and isDragging and dragStartPos then
        local delta = touch.Position - dragStartPos
        dragStartPos = touch.Position
        
        local fovRatio = Camera.FieldOfView / maxFOV
        local rotationScale = sensitivityMultiplier * fovRatio
        
        local currentCFrame = Camera.CFrame
        local rotation = CFrame.Angles(0, -delta.X * rotationScale, 0) * CFrame.Angles(-delta.Y * rotationScale, 0, 0)
        Camera.CFrame = currentCFrame * rotation
    elseif #touches == 2 and touchStartDistance and touchStartFOV then
        local pos1 = touches[1].Position
        local pos2 = touches[2].Position
        local newDistance = (pos1 - pos2).Magnitude
        local scale = newDistance / touchStartDistance
        local newFOV = math.clamp(touchStartFOV / scale, minFOV, maxFOV)
        Camera.FieldOfView = newFOV
        zoomFOV = newFOV
        currentFOV = newFOV
        updateZoomLabel()
    end
end)

UserInputService.TouchEnded:Connect(function(touch, gameProcessed)
    if not aiming then return end
    
    local touches = UserInputService:GetTouches()
    if #touches < 2 then
        touchStartDistance = nil
        touchStartFOV = nil
    end
    if #touches == 0 then
        isDragging = false
        dragStartPos = nil
    end
end)

-- Raycast for target
local function getPlayerUnderCenter()
    local viewportSize = Camera.ViewportSize
    local ray = Camera:ViewportPointToRay(viewportSize.X/2, viewportSize.Y/2, 0)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {Character}
    
    local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, raycastParams)
    if result and result.Instance then
        local hitChar = result.Instance:FindFirstAncestorOfClass("Model")
        if hitChar then
            local hitPlayer = Players:GetPlayerFromCharacter(hitChar)
            if hitPlayer and hitPlayer ~= LocalPlayer then
                local distance = (Camera.CFrame.Position - result.Position).Magnitude
                return hitPlayer, distance, result.Position
            end
        end
    end
    return nil, nil, nil
end

-- Main update
RunService.RenderStepped:Connect(function()
    if aiming then
        local player, distance, hitPos = getPlayerUnderCenter()
        if player and distance then
