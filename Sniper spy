local function createCrosshairPart(name, size, position, transparency)
    local part = Instance.new("Frame")
    part.Name = name
    part.Size = size
    part.Position = position
    part.BackgroundColor3 = Color3.new(0, 0, 0)
    part.BackgroundTransparency = transparency or 0.4
    part.BorderSizePixel = 0
    part.Visible = false
    part.ZIndex = 200
    part.Parent = screenGui
    return part
end

