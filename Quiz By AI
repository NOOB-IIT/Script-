        local winner = announceResults()
        if not winner then break end
        if not botActive then break end
        local questions = generateQuiz(winner)
        if not questions then sendChat("💔 Bot could not generate quiz. Ending session.") break end
        if not botActive then break end
        runQuiz(questions, winner)
        while not quizFinished and botActive do
            task.wait(1)
            local sc = 0
            for _ in pairs(stopVoters) do sc = sc + 1 end
            if sc >= STOP_THRESHOLD then
                sendChat("🔄 5 players voted to change topic! Restarting poll...")
                quizActive = false
                optionsAllowed = false
                isProcessingAnswer = true
                break
            end
        end
        if not botActive then break end
        local sc = 0
        for _ in pairs(stopVoters) do sc = sc + 1 end
        if sc >= STOP_THRESHOLD then
            stopVoters = {}
            task.wait(3)
        else
            break
        end
    end
    getgenv().REDHUB_BOT_ACTIVE = false
    sendChat("🤖 Bot session ended. GG everyone! 🎮")
    botActive = false
    currentPhase = "idle"
end)
]])
    return table.concat(L, "\n")
end

