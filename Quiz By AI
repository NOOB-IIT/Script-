local function triggerWin(player)
    if not quizActive or isProcessingAnswer or not botActive then return end
    isProcessingAnswer = true
    quizActive = false
    optionsAllowed = false
    playerScores[player.UserId] = (playerScores[player.UserId] or 0) + 10
    playerNames[player.UserId] = player.Name .. " (" .. player.DisplayName .. ")"
    sendChat("🎉 " .. player.DisplayName .. " got it RIGHT! +10 Pts 🎉")
    currentQuestionIndex = currentQuestionIndex + 1
    task.wait(2)
    if currentQuestionIndex > #currentQuizDB then
        showLeaderboard()
    else
        isProcessingAnswer = false
        task.spawn(askNextQuestion)
    end
end

local function smartWait(sec)
    local elapsed = 0
    while elapsed < sec do
        if not quizActive or not botActive then return false end
        task.wait(0.2)
        elapsed = elapsed + 0.2
    end
    return true
end

askNextQuestion = function()
    if not botActive then return end
    if currentQuestionIndex > #currentQuizDB then showLeaderboard() return end
    local cq = currentQuizDB[currentQuestionIndex]
    shuffleOptions(cq)
    currentWordAnswer = string.upper(string.gsub(cq.wordAnswer, "[^%w]", ""))
    hasGuessedOption = {}
    quizActive = true
    optionsAllowed = false
    isProcessingAnswer = false
    if isTagged(cq.question) then
        sendChat("⚠️ [AUTO-SKIP] Question filtered!")
        currentQuestionIndex = currentQuestionIndex + 1
        task.wait(2)
        task.spawn(askNextQuestion)
        return
    end
    sendChat("💡 Answer with FULL WORD or A/B/C/D!")
    if not smartWait(3) then return end
    sendChat("❓ " .. cq.question)
    if not smartWait(10) then return end
    optionsAllowed = true
    for _, opt in ipairs(currentDynamicOptions) do
        if isTagged(opt) then
            sendChat("⚠️ [AUTO-SKIP] Options filtered!")
            currentQuestionIndex = currentQuestionIndex + 1
            task.wait(2)
            task.spawn(askNextQuestion)
            return
        end
        sendChat(opt)
        if not smartWait(2) then return end
    end
    if not smartWait(12) then return end
    if quizActive then
        quizActive = false
        sendChat("⏳ Time's up! Answer: " .. correctAnswer .. " (" .. cq.wordAnswer .. ")")
        currentQuestionIndex = currentQuestionIndex + 1
        task.wait(3)
        if currentQuestionIndex > #currentQuizDB then showLeaderboard() else task.spawn(askNextQuestion) end
    end
end

