    task.wait(2)
    sendChat("💡 Ideas: Anime, Football, Minecraft, Science...")
    task.wait(2)
    sendChat("🔥 POLL IS OPEN — SUGGEST NOW! 🔥")
    local lastReminder = -1
    while tick() - startTime < POLL_DURATION do
        task.wait(0.5)
        local remaining = math.floor(POLL_DURATION - (tick() - startTime))
        if remaining <= 10 and remaining >= 1 and remaining ~= lastReminder then
            lastReminder = remaining
            if remaining == 10 or remaining == 5 then
                sendChat("⏰ " .. remaining .. " seconds left! Vote NOW!")
            end
        end
        local sc = 0
        for _ in pairs(stopVoters) do sc = sc + 1 end
        if sc >= STOP_THRESHOLD then
            sendChat("🛑 Poll cancelled by " .. STOP_THRESHOLD .. " players!")
            return false
        end
        if not botActive then return false end
    end
    return true
end

