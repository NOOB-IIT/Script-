-- CHAT HANDLER
local function onPlayerChat(player, message)
    if not botActive then return end
    local lowerName = string.lower(player.Name)

    local banTarget = string.match(message, "^/%s*[Bb][Aa][Nn]%s+(.+)$")
    if banTarget then
        local target = string.match(banTarget, "^%s*(.-)%s*$")
        if target and target ~= "" then
            local key = string.lower(target)
            if not banRequests[key] then banRequests[key] = { display = target, banners = {} } end
            banRequests[key].banners[player.UserId] = true
            local count = 0
            for _ in pairs(banRequests[key].banners) do count = count + 1 end
            sendChat("🚫 " .. player.DisplayName .. " wants to ban '" .. target .. "' (" .. count .. "/" .. BAN_THRESHOLD .. ")")
            if count >= BAN_THRESHOLD then
                bannedPlayers[key] = true
                sendChat("⛔ '" .. target .. "' has been BANNED by vote!")
            end
        end
        return
    end

    if bannedPlayers[lowerName] then return end

    local cleanMsg = string.match(message, "^%s*(.-)%s*$")
    local normMsg = normalize(cleanMsg)

    if normMsg == "stop" then
        stopVoters[player.UserId] = true
        local sc = 0
        for _ in pairs(stopVoters) do sc = sc + 1 end
        sendChat("🛑 " .. player.DisplayName .. " wants to STOP (" .. sc .. "/" .. STOP_THRESHOLD .. ")")
        return
    end

    if currentPhase == "poll" then
        if pollVotes[player.UserId] then return end
        if cleanMsg == "" then return end
        pollVotes[player.UserId] = { topic = cleanMsg }
        local key = string.lower(cleanMsg)
        if not topicCounts[key] then topicCounts[key] = { display = cleanMsg, count = 0 } end
        topicCounts[key].count = topicCounts[key].count + 1
        if topicCounts[key].count == 1 then
            sendChat("✅ " .. player.DisplayName .. " suggested: " .. cleanMsg)
        else
            sendChat("✅ " .. player.DisplayName .. " also voted: " .. cleanMsg .. " (" .. topicCounts[key].count .. ")")
        end
        return
    end

    if currentPhase == "quiz" then
        if not quizActive or isProcessingAnswer then return end
        if isTagged(cleanMsg) then return end
        local upperMsg = string.upper(cleanMsg)
        local noPunct = string.gsub(upperMsg, "[^%w]", "")
        if noPunct == currentWordAnswer then triggerWin(player) return end
        local letter = string.match(upperMsg, "^([A-D])$")
        if letter then
            if not optionsAllowed or hasGuessedOption[player.UserId] then return end
            hasGuessedOption[player.UserId] = true
            if letter == correctAnswer then triggerWin(player) end
        end
    end
end

