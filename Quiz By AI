local BotControl = {}
function BotControl.start(statusLabel)
    if not State.apiKey or #State.apiKey < 20 then
        if statusLabel then statusLabel.Text = "⚠ Set API key first" statusLabel.TextColor3 = Color3.fromRGB(251,191,36) statusLabel.Visible = true end
        return
    end
    local g = getG()
    if g.REDHUB_BOT_ACTIVE then
        pcall(function() if g.REDHUB_BOT_STOP then g.REDHUB_BOT_STOP() end end)
        task.wait(0.3)
    end
    pcall(function() if g.REDHUB_QUIZ_STOP then g.REDHUB_QUIZ_STOP() end end)
    local scriptText = buildBotScript(State.apiKey, State.currentModel.id, CONFIG.ApiEndpoint, State.currentDiff.name)
    local loader = loadstring or load
    if not loader then if statusLabel then statusLabel.Text = "⚠ loadstring not available" statusLabel.TextColor3 = Color3.fromRGB(248,113,113) statusLabel.Visible = true end return end
    local fn, err = loader(scriptText)
    if not fn then if statusLabel then statusLabel.Text = "⚠ Load error: " .. tostring(err) statusLabel.TextColor3 = Color3.fromRGB(248,113,113) statusLabel.Visible = true end return end
    State.botRunning = true
    State.botStatus = "running"
    State.runningThread = task.spawn(function()
        local ok, e = pcall(fn)
        if not ok then warn("[RedHub Bot] Runtime: " .. tostring(e)) end
        State.botRunning = false
        State.botStatus = "ended"
    end)
    if statusLabel then
        statusLabel.Text = "🤖 Bot is LIVE! Check chat 🎤"
        statusLabel.TextColor3 = Color3.fromRGB(139,92,246)
        statusLabel.Visible = true
    end
end
function BotControl.stop(statusLabel)
    local g = getG()
    local ok = false
    pcall(function() if g.REDHUB_BOT_STOP then g.REDHUB_BOT_STOP() ok = true end end)
    State.botRunning = false
    State.botStatus = "stopped"
    if statusLabel then
        statusLabel.Text = ok and "🛑 Bot stopped" or "⚠ No bot running"
        statusLabel.TextColor3 = ok and Color3.fromRGB(251,191,36) or Color3.fromRGB(248,113,113)
        statusLabel.Visible = true
    end
end

