local function generateQuiz(topic)
    sendChat("📝 Generating " .. DIFFICULTY .. " quiz on '" .. topic .. "'...")
    task.wait(1)
    sendChat("⏳ Please wait — AI is thinking...")
    local sysPrompt = "You are a quiz generator. Always reply with valid JSON only. No markdown, no explanation, no extra text."
    local diffExtra = ""
    if DIFFICULTY == "Easy" then diffExtra = "Questions should be simple, general knowledge, easy for anyone to answer."
    elseif DIFFICULTY == "Medium" then diffExtra = "Questions should require some thinking, moderate difficulty, common but specific facts."
    elseif DIFFICULTY == "Hard" then diffExtra = "Questions should be challenging, requiring solid knowledge of the topic."
    elseif DIFFICULTY == "Very Hard" then diffExtra = "Questions should be very difficult, requiring deep knowledge and niche details."
    elseif DIFFICULTY == "Extreme" then diffExtra = "Questions should be extremely difficult, expert-level, obscure facts."
    elseif DIFFICULTY == "Deadly" then diffExtra = "Questions should be BRUTALLY hard, borderline impossible for casual players, requiring expert-level PhD-grade knowledge with confusing close options."
    end
    local userPrompt = string.format([[Generate exactly 10 %s multiple-choice questions about: "%s"
Difficulty: %s — %s
Return ONLY valid JSON in this EXACT format (no markdown, no code fences):
{"questions":[{"question":"Question text?","options":["optA","optB","optC","optD"],"correctText":"optA","wordAnswer":"WORD"}]}
Rules:
- Exactly 10 questions
- Each has exactly 4 options
- correctText must exactly match one of the 4 options
- wordAnswer = single UPPERCASE word (no spaces) players can type to win instantly
- Match the requested difficulty level (%s)
- Topic: %s]], DIFFICULTY, topic, DIFFICULTY, diffExtra, DIFFICULTY, topic)
    local body = HttpService:JSONEncode({
        model = MODEL_ID,
        messages = {
            {role = "system", content = sysPrompt},
            {role = "user", content = userPrompt},
        },
        temperature = 0.8,
        max_tokens = 4096,
    })
    local ok, resp = pcall(function()
        return HttpService:RequestAsync({
            Url = API_ENDPOINT,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
            Body = body,
        })
    end)
    if not (ok and resp and resp.Success) then sendChat("❌ API request failed!") return nil end
    local ok2, dec = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    if not (ok2 and dec and dec.choices and dec.choices[1]) then sendChat("❌ Bad API response!") return nil end
    local raw = dec.choices[1].message.content
    raw = string.gsub(raw, "```json", "")
    raw = string.gsub(raw, "```", "")
    raw = string.match(raw, "%b{}") or raw
    local ok3, parsed = pcall(function() return HttpService:JSONDecode(raw) end)
    if not (ok3 and parsed and parsed.questions) then sendChat("❌ Failed to parse quiz!") return nil end
    local qs = {}
    for i = 1, math.min(10, #parsed.questions) do
        local q = parsed.questions[i]
        if q.question and q.options and #q.options >= 4 and q.correctText and q.wordAnswer then
            table.insert(qs, {
                question = tostring(q.question),
                options = { tostring(q.options[1]), tostring(q.options[2]), tostring(q.options[3]), tostring(q.options[4]) },
                correctText = tostring(q.correctText),
                wordAnswer = string.upper(string.gsub(tostring(q.wordAnswer), "%s+", "")),
            })
        end
    end
    if #qs == 0 then sendChat("❌ No valid questions generated!") return nil end
    return qs
end

