local function shuffleOptions(q)
    local choices = {unpack(q.options)}
    local letters = {"A","B","C","D"}
    for i = #choices, 2, -1 do local j = math.random(i) choices[i], choices[j] = choices[j], choices[i] end
    currentDynamicOptions = {}
    correctAnswer = ""
    for idx, opt in ipairs(choices) do
        table.insert(currentDynamicOptions, letters[idx] .. ") " .. opt)
        if opt == q.correctText then correctAnswer = letters[idx] end
    end
end

local function isTagged(t) return string.find(t or "", "###") ~= nil end
local askNextQuestion

local function showLeaderboard()
    quizActive = false
    optionsAllowed = false
    isProcessingAnswer = true
    sendChat("📊 ══════ FINAL LEADERBOARD ══════ 📊")
