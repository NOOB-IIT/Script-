local QuizControl = {}

function QuizControl.run(scriptText, statusLabel)
    if not loadstring and not load then
        statusLabel.Text = "⚠ loadstring not available"
        statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
        statusLabel.Visible = true
        return
    end
    local g = getG()
    pcall(function() g.REDHUB_QUIZ_STOP = nil end)
    pcall(function() g.REDHUB_QUIZ_BAN = nil end)

    local loader = loadstring or load
    local fn, err = loader(scriptText)
    if not fn then
        statusLabel.Text = "⚠ Load error: " .. tostring(err)
        statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
        statusLabel.Visible = true
        return
    end
    State.runningThread = task.spawn(function()
        local ok, e = pcall(fn)
        if not ok then warn("[RedHub Quiz] Runtime: " .. tostring(e)) end
    end)
    statusLabel.Text = "✔ Quiz script running in chat!"
    statusLabel.TextColor3 = State.currentTheme.accent
    statusLabel.Visible = true
end

function QuizControl.stop(statusLabel)
    local g = getG()
    local ok = false
    pcall(function()
        if g.REDHUB_QUIZ_STOP then g.REDHUB_QUIZ_STOP() ok = true end
    end)
    statusLabel.Text = ok and "🛑 Quiz stopped — message sent to chat" or "⚠ No running quiz"
    statusLabel.TextColor3 = ok and Color3.fromRGB(251, 191, 36) or Color3.fromRGB(248, 113, 113)
    statusLabel.Visible = true
end

function QuizControl.ban(username, statusLabel)
    if not username or username == "" then
        statusLabel.Text = "⚠ Enter a username"
        statusLabel.TextColor3 = Color3.fromRGB(251, 191, 36)
        statusLabel.Visible = true
        return
    end
    local g = getG()
    local ok = false
    pcall(function()
        if g.REDHUB_QUIZ_BAN then g.REDHUB_QUIZ_BAN(username) ok = true end
    end)
    statusLabel.Text = ok and ("🚫 Banned: " .. username) or "⚠ No quiz running"
    statusLabel.TextColor3 = ok and Color3.fromRGB(248, 113, 113) or Color3.fromRGB(251, 191, 36)
    statusLabel.Visible = true
end

function QuizControl.copy(scriptText, statusLabel)
    pcall(function()
        if setclipboard then setclipboard(scriptText) end
    end)
    statusLabel.Text = "✔ Full script copied to clipboard"
    statusLabel.TextColor3 = State.currentTheme.accent
    statusLabel.Visible = true
end

