    local function doGenerate()
        if State.isGenerating then return end

        -- ✅ FIX 2: require Back before new topic
        if State.quizLocked then
            statusLabel.Text = "⚠ Press BACK first to start a new quiz"
            statusLabel.TextColor3 = Color3.fromRGB(251, 191, 36)
            statusLabel.Visible = true
            task.delay(2.5, function() if statusLabel.Parent then statusLabel.Visible = false end end)
            return
        end

        local topic = topicInput.Text
        if topic == "" then
            statusLabel.Text = "⚠ Enter a topic first"
            statusLabel.TextColor3 = Color3.fromRGB(251, 191, 36)
            statusLabel.Visible = true
            return
        end

        State.isGenerating = true
        State.currentTopic = topic
        genBtn.Text = "..."
        statusLabel.Text = "⏳ Generating " .. State.currentDiff.name .. " quiz: " .. topic
        statusLabel.TextColor3 = State.currentDiff.color
        statusLabel.Visible = true
        clearCards()
        if welcomeLabel and welcomeLabel.Parent then welcomeLabel.Visible = false end

        task.spawn(function()
            local sysPrompt = "You are a quiz generator. Always reply with valid JSON only. No markdown, no explanation, no extra text."

            local diffDesc = State.currentDiff.name
            local diffExtra = ""
            if diffDesc == "Easy" then
                diffExtra = "Questions should be simple, general knowledge, easy for anyone to answer."
            elseif diffDesc == "Medium" then
                diffExtra = "Questions should require some thinking, moderate difficulty, common but specific facts."
            elseif diffDesc == "Hard" then
                diffExtra = "Questions should be challenging, requiring solid knowledge of the topic."
            elseif diffDesc == "Very Hard" then
                diffExtra = "Questions should be very difficult, requiring deep knowledge and niche details."
            elseif diffDesc == "Extreme" then
                diffExtra = "Questions should be extremely difficult, expert-level, obscure facts that only specialists would know."
            elseif diffDesc == "Deadly" then
                diffExtra = "Questions should be BRUTALLY hard, borderline impossible for casual players, requiring expert-level PhD-grade knowledge with confusing close options."
            end

            local userPrompt = string.format([[
Generate exactly 10 %s multiple-choice questions about: "%s"

Difficulty: %s — %s

Return ONLY valid JSON in this EXACT format (no markdown, no code fences):
{
  "questions": [
    {"question": "Question text?", "options": ["optA", "optB", "optC", "optD"], "correctText": "optA", "wordAnswer": "WORD"}
  ]
}

Rules:
- Exactly 10 questions
- Each has exactly 4 options
- correctText must exactly match one of the 4 options
- wordAnswer = single UPPERCASE word (no spaces) players can type to win instantly
- Match the requested difficulty level (%s)
- Topic: %s
]], diffDesc, topic, diffDesc, diffExtra, diffDesc, topic)

            local msgs = {
                { role = "system", content = sysPrompt },
                { role = "user",   content = userPrompt },
            }

            local body = HttpService:JSONEncode({
                model = State.currentModel.id,
                messages = msgs,
                temperature = 0.8,
                max_tokens = State.currentModel.maxTokens,
            })

            local success, response = pcall(function()
                return HttpService:RequestAsync({
                    Url = CONFIG.ApiEndpoint,
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["Authorization"] = "Bearer " .. State.apiKey,
                    },
                    Body = body,
                })
            end)

            genBtn.Text = "Generate"
            State.isGenerating = false

            if not (success and response and response.Success) then
                statusLabel.Text = "⚠ Request failed"
                statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
                return
            end

            local ok, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
            if not (ok and decoded and decoded.choices and decoded.choices[1]) then
                statusLabel.Text = "⚠ Bad response"
                statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
                return
            end

            local raw = decoded.choices[1].message.content
            raw = string.gsub(raw, "```json", "")
            raw = string.gsub(raw, "```", "")
            raw = string.match(raw, "%b{}") or raw

            local ok2, parsed = pcall(function() return HttpService:JSONDecode(raw) end)
            if not (ok2 and parsed and parsed.questions and #parsed.questions > 0) then
                statusLabel.Text = "⚠ Failed to parse quiz. Try again."
                statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
                return
            end

            local qs = {}
            for i = 1, math.min(10, #parsed.questions) do
                local q = parsed.questions[i]
                if q.question and q.options and #q.options >= 4 and q.correctText and q.wordAnswer then
                    table.insert(qs, {
                        question = tostring(q.question),
                        options = { tostring(q.options[1]), tostring(q.options[2]), tostring(q.options[3]), tostring(q.options[4]) },
                        correctText = tostring(q.correctText),
                        wordAnswer = string.upper(string.gsub(tostring(q.wordAnswer), "%s+", "")),
                    })
                end
            end

            if #qs == 0 then
                statusLabel.Text = "⚠ No valid questions parsed"
                statusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
                return
            end

            State.generatedQuestions = qs
            State.quizLocked = true   -- ✅ FIX 2: lock until Back
            renderQuestions(qs)

            statusLabel.Text = "✔ " .. #qs .. " " .. State.currentDiff.name .. " questions ready: " .. topic .. "  •  Press Back to start new"
            statusLabel.TextColor3 = State.currentDiff.color
            statusLabel.Visible = true
            task.delay(4, function() if statusLabel.Parent then statusLabel.Visible = false end end)
        end)
    end

