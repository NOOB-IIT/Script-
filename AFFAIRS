local function showBiodata(targetPlayer, extraDetail)
    local success, thumb = pcall(function()
        return Players:GetUserThumbnailAsync(targetPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)
    if success then AvatarImg.Image = thumb end
    
    local accCreation = os.date("%d %b %Y", os.time() - (targetPlayer.AccountAge * 86400))
    local years = math.floor(targetPlayer.AccountAge / 365)
    local days = targetPlayer.AccountAge % 365
    
    BioInfo.Text = "Name: " .. targetPlayer.DisplayName .. "\n" ..
                   "Username: @" .. targetPlayer.Name .. "\n" ..
                   "DOB / Created: " .. accCreation .. "\n" ..
                   "Account Age: " .. years .. " Yrs, " .. days .. " Days\n" ..
                   "Status: " .. (extraDetail or "Server Member")
                   
    AadhaarNoLabel.Text = "ID: XXXX XXXX " .. tostring(targetPlayer.UserId):sub(1, 4)
    BioFrame.Visible = true
end

-- ==========================================
-- DYNAMIC MULTI-COLOR WIRE ESP LOGIC
-- ==========================================
local espEnabled = false
local espObjects = {}
local ESPColors = {
    Color3.fromRGB(255, 40, 40),   -- Red
    Color3.fromRGB(40, 255, 40),   -- Green
    Color3.fromRGB(40, 160, 255),  -- Blue
    Color3.fromRGB(255, 240, 40),  -- Yellow
    Color3.fromRGB(255, 50, 255),  -- Magenta
    Color3.fromRGB(40, 255, 240),  -- Cyan
    Color3.fromRGB(255, 140, 40)   -- Orange
}

local function clearESP()
    for _, obj in ipairs(espObjects) do
        if obj.Line then pcall(function() obj.Line:Remove() end) end
        if obj.Bill then pcall(function() obj.Bill:Destroy() end) end
    end
    espObjects = {}
end

local function rebuildESP()
    clearESP()
    if not espEnabled then return end
    
    local searchName = NameInput.Text:lower():gsub("%s+", "")
    if searchName == "" then return end
    
    local targetP = nil
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower() == searchName or p.DisplayName:lower() == searchName then
            targetP = p
            break
        end
    end
    
    if not targetP or not targetP.Character or not targetP.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local friendsList = {}
    for _, other in pairs(Players:GetPlayers()) do
        if other ~= targetP and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
            local success, isFrnd = pcall(function() return targetP:IsFriendsWith(other.UserId) end)
            if success and isFrnd then
                table.insert(friendsList, other)
            end
        end
    end
    
    for i, friend in ipairs(friendsList) do
        local color = ESPColors[((i - 1) % #ESPColors) + 1]
        
        local line = nil
        if Drawing and Drawing.new then
            line = Drawing.new("Line")
            line.Thickness = 2
            line.Color = color
            line.Visible = false
        end
        
        local bGui = Instance.new("BillboardGui")
        bGui.Size = UDim2.new(0, 160, 0, 40)
        bGui.AlwaysOnTop = true
        bGui.Adornee = friend.Character:FindFirstChild("Head") or friend.Character.HumanoidRootPart
        bGui.Parent = friend.Character
        
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = color
        txt.Font = Enum.Font.SourceSansBold
        txt.TextSize = 13
        txt.TextStrokeTransparency = 0
        txt.Parent = bGui
        
        table.insert(espObjects, {
            TargetHRP = targetP.Character.HumanoidRootPart,
            FriendHRP = friend.Character.HumanoidRootPart,
            Line = line,
            Bill = bGui,
            TextLabel = txt,
            Friend = friend
        })
    end
end

RunService.RenderStepped:Connect(function()
    if not espEnabled then return end
    local Camera = workspace.CurrentCamera
    for _, item in ipairs(espObjects) do
        if item.TargetHRP and item.FriendHRP and item.TargetHRP.Parent and item.FriendHRP.Parent then
            if item.Line then
                local p1, vis1 = Camera:WorldToViewportPoint(item.TargetHRP.Position)
                local p2, vis2 = Camera:WorldToViewportPoint(item.FriendHRP.Position)
                
                if p1.Z > 0 and p2.Z > 0 then
                    item.Line.From = Vector2.new(p1.X, p1.Y)
                    item.Line.To = Vector2.new(p2.X, p2.Y)
                    item.Line.Visible = true
                else
                    item.Line.Visible = false
                end
            end
            
            local dist = math.floor((item.TargetHRP.Position - item.FriendHRP.Position).Magnitude)
            item.TextLabel.Text = item.Friend.DisplayName .. "\n[" .. dist .. "m]"
        else
            if item.Line then item.Line.Visible = false end
        end
    end
end)

