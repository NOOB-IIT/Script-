-- 1. SNEAKY TITLE CHANGER (Bypass Anti-Tamper with 6-second delay)
task.spawn(function()
    task.wait(6) -- 6 second ka wait taaki asli script load ho jaye
    local myTitle = "Universal~~By NOT_IITIAN"
    pcall(function() getgenv().Title = myTitle end)
    pcall(function() getgenv().ScriptTitle = myTitle end)
    pcall(function() shared.Title = myTitle end)
    pcall(function() _G.Title = myTitle end)
    pcall(function() rconsolename(myTitle) end)
end)

-- 2. RGB LIGHTNING NOTIFICATION SYSTEM (Safe UI)
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local NotifGui = Instance.new("ScreenGui")
NotifGui.Name = "NotIitianRGBNotif"
NotifGui.Parent = pcall(function() return CoreGui end) and CoreGui or game.Players.LocalPlayer:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 320, 0, 80)
Frame.Position = UDim2.new(1, 20, 1, -120)
Frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Frame.BorderSizePixel = 3
Frame.Parent = NotifGui

local TextLabel = Instance.new("TextLabel")
TextLabel.Size = UDim2.new(1, 0, 1, 0)
TextLabel.BackgroundTransparency = 1
TextLabel.Text = "⚡ Script Created by NOT_IITIAN ⚡\nLoading Universal..."
TextLabel.Font = Enum.Font.GothamBold
TextLabel.TextSize = 16
TextLabel.Parent = Frame

local colorConnection = RunService.RenderStepped:Connect(function()
    local hue = tick() % 3 / 3
    local rgbColor = Color3.fromHSV(hue, 1, 1)
    Frame.BorderColor3 = rgbColor
    TextLabel.TextColor3 = rgbColor
end)

Frame:TweenPosition(UDim2.new(1, -340, 1, -120), "Out", "Bounce", 0.6, true)

task.delay(10, function()
    Frame:TweenPosition(UDim2.new(1, 20, 1, -120), "In", "Quad", 0.5, true)
    task.wait(0.5)
    colorConnection:Disconnect()
    NotifGui:Destroy()
end)

