            playSuccess()
            genBtn.Text = "Generate"; State.isGenerating = false
            State.generatedQuestions = qs; State.quizLocked = true
            renderQuestions(qs)
            statusLabel.Text = #qs .. " " .. State.currentDiff.name .. " questions ready: " .. topic .. " | Press Back for new"
