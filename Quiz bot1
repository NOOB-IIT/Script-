    table.insert(L, "getgenv().REDHUB_QUIZ_BAN = function(n) if n and n~=\"\" then blacklistedPlayers[string.upper(n)]=true sendChatMessage(\"[BAN] \" .. n .. \" removed from quiz\") end end")
