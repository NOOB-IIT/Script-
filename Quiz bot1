    table.insert(L, "\tend")
    table.insert(L, "end")
    table.insert(L, "local askNextQuestion")
    table.insert(L, "local function smartWait(s, ses) local e=0 while e<s do if not quizActive or questionSession~=ses then return false end task.wait(0.2) e+=0.2 end return true end")
    table.insert(L, "local function showLeaderboard()")
    table.insert(L, "\tquizActive=false optionsAllowed=false isProcessingAnswer=true")
    table.insert(L, "\tsendChatMessage(\"Final Leaderboard | " .. topic .. " (" .. difficulty .. ")\")")
    table.insert(L, "\ttask.wait(2.5)")
