local function startFlow()
    task.wait(0.15)
    buildKeySystem(function()
        task.wait(0.2)
        if State.killed then return end
        if State.apiKey and #State.apiKey > 10 then
            buildMainWindow()
            task.wait(0.3)
            local toast = new("TextLabel", { Size = UDim2.fromOffset(220, 32), Position = UDim2.new(0.5, -110, 0, 12), BackgroundColor3 = Color3.fromRGB(24, 40, 30), BackgroundTransparency = 0.05, Text = "  Auto-verified session", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Color3.fromRGB(180,240,200), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 400, Parent = ScreenGui })
            corner(toast, 8)
            task.wait(1.4)
            tween(toast, 0.3, { BackgroundTransparency = 1, TextTransparency = 1 })
            task.delay(0.4, function() pcall(function() toast:Destroy() end) end)
        else
            buildApiKeySystem(function()
                if State.killed then return end
                task.wait(0.05)
                buildMainWindow()
            end)
        end
    end)
end

