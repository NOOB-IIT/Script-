-- ===== SCRIPT BUILDER (with FULL answer matching fix) =====
local function escapeLuaString(s)
    s = tostring(s)
    s = string.gsub(s, "\\", "\\\\")
    s = string.gsub(s, "\"", "\\\"")
    s = string.gsub(s, "\n", "\\n")
    s = string.gsub(s, "\r", "")
    return s
end

local function buildScript(topic, difficulty, questions)
    local L = {}
    table.insert(L, "-- RED HUB QUIZ | " .. topic .. " | " .. difficulty)
