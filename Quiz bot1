local QuizControl = {}

function QuizControl.run(scriptText, statusLabel)
    if not loadstring and not load then statusLabel.Text = "loadstring not available"; statusLabel.TextColor3 = Color3.fromRGB(248,113,113); statusLabel.Visible = true; return end
    local g = getG()
    pcall(function() g.REDHUB_QUIZ_STOP = nil end)
    pcall(function() g.REDHUB_QUIZ_BAN = nil end)
    local loader = loadstring or load
    local fn, err = loader(scriptText)
    if not fn then statusLabel.Text = "Load error: " .. tostring(err); statusLabel.TextColor3 = Color3.fromRGB(248,113,113); statusLabel.Visible = true; return end
    task.spawn(function()
        local ok, e = pcall(fn)
        if not ok then warn("[RedHub Quiz] Runtime: " .. tostring(e)) end
    end)
    statusLabel.Text = "Quiz running in chat!"; statusLabel.TextColor3 = State.currentTheme.accent; statusLabel.Visible = true
end

function QuizControl.stop(statusLabel)
    local g = getG()
    local ok = false
    pcall(function() if g.REDHUB_QUIZ_STOP then g.REDHUB_QUIZ_STOP() ok = true end end)
    statusLabel.Text = ok and "Quiz stopped" or "No running quiz"
    statusLabel.TextColor3 = ok and Color3.fromRGB(251,191,36) or Color3.fromRGB(248,113,113)
    statusLabel.Visible = true
end

function QuizControl.ban(username, statusLabel)
    if not username or username == "" then statusLabel.Text = "Enter a username"; statusLabel.TextColor3 = Color3.fromRGB(251,191,36); statusLabel.Visible = true; return end
    local g = getG()
    local ok = false
    pcall(function() if g.REDHUB_QUIZ_BAN then g.REDHUB_QUIZ_BAN(username) ok = true end end)
    statusLabel.Text = ok and ("Banned: " .. username) or "No quiz running"
    statusLabel.TextColor3 = ok and Color3.fromRGB(248,113,113) or Color3.fromRGB(251,191,36)
    statusLabel.Visible = true
end

function QuizControl.copy(scriptText, statusLabel)
    pcall(function() if setclipboard then setclipboard(scriptText) end end)
    statusLabel.Text = "Script copied to clipboard"
    statusLabel.TextColor3 = State.currentTheme.accent
    statusLabel.Visible = true
end

local function generateQuizAPI(topic, difficultyName, onSuccess, onError)
    task.spawn(function()
        local sysPrompt = "You are a quiz generator. Reply with valid JSON only. No markdown, no explanation."
        local diffExtra = "Moderate difficulty."
        if difficultyName == "Easy" then diffExtra = "Simple, general knowledge."
        elseif difficultyName == "Medium" then diffExtra = "Some thinking required."
        elseif difficultyName == "Hard" then diffExtra = "Challenging, solid topic knowledge."
        elseif difficultyName == "Very Hard" then diffExtra = "Very difficult, deep knowledge."
        elseif difficultyName == "Extreme" then diffExtra = "Extremely difficult, expert-level."
        elseif difficultyName == "Deadly" then diffExtra = "Brutally hard, PhD-grade knowledge." end
        local userPrompt = string.format("Generate 10 %s MCQs about: \"%s\"\nDifficulty: %s - %s\n\nReturn JSON:\n{\"questions\":[{\"question\":\"Q?\",\"options\":[\"A\",\"B\",\"C\",\"D\"],\"correctText\":\"A\",\"wordAnswer\":\"WORD\"}]}\nRules: exactly 10 questions, 4 options each, correctText exactly matches one of the 4 option texts, wordAnswer = single UPPERCASE word that is a KEY part of the correct option (no spaces), topic: %s, difficulty: %s", difficultyName, topic, difficultyName, diffExtra, topic, difficultyName)
        local msgs = { { role = "system", content = sysPrompt }, { role = "user", content = userPrompt } }
        local body = HttpService:JSONEncode({ model = State.currentModel.id, messages = msgs, temperature = 0.8, max_tokens = State.currentModel.maxTokens })
        local success, response = pcall(function()
            return HttpService:RequestAsync({
                Url = CONFIG.ApiEndpoint, Method = "POST",
                Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. State.apiKey },
                Body = body,
            })
        end)
        if not (success and response and response.Success) then if onError then onError("Request failed") end return end
        local ok, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if not (ok and decoded and decoded.choices and decoded.choices[1]) then if onError then onError("Bad response") end return end
        local raw = decoded.choices[1].message.content
        raw = string.gsub(raw, "```json", "")
        raw = string.gsub(raw, "```", "")
        raw = string.match(raw, "%b{}") or raw
        local ok2, parsed = pcall(function() return HttpService:JSONDecode(raw) end)
        if not (ok2 and parsed and parsed.questions and #parsed.questions > 0) then if onError then onError("Parse failed") end return end
        local qs = {}
        for i = 1, math.min(10, #parsed.questions) do
            local q = parsed.questions[i]
            if q.question and q.options and #q.options >= 4 and q.correctText and q.wordAnswer then
                table.insert(qs, {
                    question = tostring(q.question),
                    options = { tostring(q.options[1]), tostring(q.options[2]), tostring(q.options[3]), tostring(q.options[4]) },
                    correctText = tostring(q.correctText),
                    wordAnswer = string.upper(string.gsub(tostring(q.wordAnswer), "%s+", "")),
                })
            end
        end
        if #qs == 0 then if onError then onError("No valid questions") end return end
        if onSuccess then onSuccess(qs) end
    end)
end

local BotState = {
    active = false, phase = "idle",
    topicVotes = {}, difficultyVotes = {},
    bannedPlayers = {}, stopVotes = {}, banVotes = {}, usedTopics = {},
    currentTopic = "", currentDifficulty = "",
    chatConn = nil, sessionId = 0, quizRunning = false, panelRefs = {},
}

local botChatMutex = false
local botChatLastTime = 0
local BOT_CHAT_GAP = 2.5

local function botChat(msg)
    while botChatMutex do task.wait(0.05) end
    botChatMutex = true
    if botChatLastTime > 0 then
        local elapsed = os.clock() - botChatLastTime
        if elapsed < BOT_CHAT_GAP then task.wait(BOT_CHAT_GAP - elapsed) end
    end
    botChatLastTime = os.clock()
    sendChat(msg)
    botChatMutex = false
end

local function botDisconnect()
    if BotState.chatConn then pcall(function() BotState.chatConn:Disconnect() end); BotState.chatConn = nil end
end

local function botRefresh()
    for i = 1, #BotState.panelRefs do
        local r = BotState.panelRefs[i]
        if r and r.update then pcall(r.update) end
    end
end

local function botPickTopic(exclude)
    local avail = {}
    for _, t in ipairs(FALLBACK_TOPICS) do if not BotState.usedTopics[t] and t ~= exclude then table.insert(avail, t) end end
    if #avail == 0 then BotState.usedTopics = {}; avail = FALLBACK_TOPICS end
    return avail[math.random(1, #avail)]
end

local function botTopTopics()
    local c = {}
    for _, v in pairs(BotState.topicVotes) do
        local t = v.topic
        if not c[t] then c[t] = { count = 0, name = t } end
        c[t].count = c[t].count + 1
    end
    local arr = {}
    for _, x in pairs(c) do table.insert(arr, x) end
    table.sort(arr, function(a, b) return a.count > b.count end)
    return arr
end

local function botTopDiff()
    local c = {}
    for _, v in pairs(BotState.difficultyVotes) do
        local d = v.diff
        if not c[d] then c[d] = { count = 0, name = d } end
        c[d].count = c[d].count + 1
    end
    local arr = {}
    for _, x in pairs(c) do table.insert(arr, x) end
    table.sort(arr, function(a, b) return a.count > b.count end)
    if #arr > 0 then return arr[1].name end
    return nil
end

local function botStopQuiz()
    local g = getG()
    pcall(function() if g.REDHUB_QUIZ_STOP then g.REDHUB_QUIZ_STOP() end end)
    BotState.quizRunning = false
end

local function botOnChat(player, message)
    if not BotState.active or State.killed then return end
    local pn = string.upper(player.Name)
    if BotState.bannedPlayers[pn] then return end
    local raw = string.match(message, "^%s*(.-)%s*$")
    local upper = string.upper(raw)

    local banTarget = string.match(raw, "^[Bb][Aa][Nn]%s+(.+)$") or string.match(raw, "^/[Bb][Aa][Nn]%s+(.+)$")
    if banTarget then
        banTarget = string.gsub(banTarget, "^%s*(.-)%s*$", "%1")
        local tu = string.upper(banTarget)
        if tu ~= "" and tu ~= pn then
            if not BotState.banVotes[tu] then BotState.banVotes[tu] = {} end
            if not BotState.banVotes[tu][player.UserId] then
                BotState.banVotes[tu][player.UserId] = true
                local cnt = 0
                for _ in pairs(BotState.banVotes[tu]) do cnt = cnt + 1 end
                if cnt >= 5 then
                    BotState.bannedPlayers[tu] = true
                    task.spawn(function() botChat("[BAN] " .. banTarget .. " has been banned from this quiz (5/5 votes)") end)
                    local g = getG()
                    pcall(function() if g.REDHUB_QUIZ_BAN then g.REDHUB_QUIZ_BAN(banTarget) end end)
                end
            end
        end
        return
    end

    if BotState.quizRunning and (upper == "STOP" or upper == "!STOP") then
        if not BotState.stopVotes[player.UserId] then
            BotState.stopVotes[player.UserId] = true
            local cnt = 0
            for _ in pairs(BotState.stopVotes) do cnt = cnt + 1 end
            if cnt >= 5 then
                BotState.stopVotes = {}
                BotState.sessionId = BotState.sessionId + 1
                task.spawn(function() botChat("[STOP] 5 stop votes reached. Aborting quiz and restarting poll...") end)
                botStopQuiz()
                BotState.phase = "idle"
                task.wait(3)
                task.spawn(function() if BotState.active then BotState.startTopicPoll() end end)
            end
        end
        return
    end

    if BotState.phase == "topic_poll" then
        if BotState.topicVotes[player.UserId] then return end
        if #raw >= 2 and #raw <= 40 and not string.find(raw, "/") then
            BotState.topicVotes[player.UserId] = { name = player.DisplayName, topic = raw }
            botRefresh()
        end
        return
    end

    if BotState.phase == "difficulty_poll" then
        if BotState.difficultyVotes[player.UserId] then return end
        for _, d in ipairs(DIFFICULTIES) do
            local dn = string.upper(d.name)
            local ds = string.upper(d.short)
            if upper == dn or upper == ds or upper == string.gsub(dn, "%s", "") then
                BotState.difficultyVotes[player.UserId] = { name = player.DisplayName, diff = d.name }
                botRefresh()
                return
            end
        end
        return
    end
end

local function botAttachListener()
    botDisconnect()
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        BotState.chatConn = TextChatService.MessageReceived:Connect(function(t)
            if t.TextSource then
                local p = Players:GetPlayerByUserId(t.TextSource.UserId)
                if p then botOnChat(p, t.Text) end
            end
        end)
    else
        BotState.chatConn = Players.PlayerAdded:Connect(function(p) p.Chatted:Connect(function(m) botOnChat(p, m) end) end)
    end
end

function BotState.startTopicPoll()
    if not BotState.active or State.killed then return end
    BotState.sessionId = BotState.sessionId + 1
    local session = BotState.sessionId
    BotState.phase = "topic_poll"
    BotState.topicVotes = {}; BotState.difficultyVotes = {}
    BotState.stopVotes = {}; BotState.banVotes = {}
    botRefresh()

    local function stillActive()
        return BotState.active and BotState.sessionId == session and not State.killed and BotState.phase == "topic_poll"
    end

    task.spawn(function()
        botChat("[RED HUB BOT] Topic Poll is LIVE! You have 60 seconds.")
        task.wait(3)
        if not stillActive() then return end
        botChat("How to vote: just type a topic name in chat. Each player can vote ONE topic.")
        task.wait(3)
        if not stillActive() then return end
        botChat("Rules: A topic needs minimum 2 votes to get picked. If no topic reaches 2 votes, the AI will pick one for you.")
        task.wait(3)
        if not stillActive() then return end
        botChat("Don't like the final topic? During the quiz, 5 different players can type STOP to abort and restart the poll.")
        task.wait(3)
        if not stillActive() then return end
        botChat("To ban a rule-breaker: 5 different players type /ban their_username. That player's answers will be ignored.")

        task.wait(11)
        if not stillActive() then return end
        local v1 = 0; for _ in pairs(BotState.topicVotes) do v1 = v1 + 1 end
        botChat("[TIME] 40 seconds left - " .. v1 .. " vote(s) so far")
        botRefresh()

        task.wait(20)
        if not stillActive() then return end
        local v2 = 0; for _ in pairs(BotState.topicVotes) do v2 = v2 + 1 end
        botChat("[TIME] 20 seconds left - " .. v2 .. " vote(s) so far")
        botRefresh()

        task.wait(15)
        if not stillActive() then return end
        botChat("[TIME] 5 seconds left - final call!")

        task.wait(5)
        if not stillActive() then return end
        BotState.endTopicPoll()
    end)
end

function BotState.endTopicPoll()
    if not BotState.active or State.killed then return end
    BotState.phase = "idle"
    local top = botTopTopics()
    local qualified = {}
    for _, t in ipairs(top) do if t.count >= 2 then table.insert(qualified, t) end end

    if #qualified == 0 then
        botChat("Poll ended. No topic reached 2 votes.")
        task.wait(2)
        botChat("AI is picking a favourite topic for you...")
        task.wait(2)
        local picked = botPickTopic()
        BotState.currentTopic = picked
        BotState.usedTopics[picked] = true
        botChat("AI chose: " .. picked)
        task.wait(2.5)
        if not BotState.active or State.killed then return end
        BotState.startDifficultyPoll()
    else
        botChat("Poll ended. Counting votes...")
        local winner = qualified[1]
        BotState.currentTopic = winner.name
        BotState.usedTopics[winner.name] = true
        botChat("Winner: " .. winner.name .. " with " .. winner.count .. " votes!")
        task.wait(2)
        botChat("Starting difficulty poll now...")
        task.wait(2)
        if not BotState.active or State.killed then return end
        BotState.startDifficultyPoll()
    end
end

function BotState.startDifficultyPoll()
    if not BotState.active or State.killed then return end
    BotState.phase = "difficulty_poll"
    BotState.difficultyVotes = {}
    botRefresh()
    local session = BotState.sessionId
    local function stillActive()
        return BotState.active and BotState.sessionId == session and BotState.phase == "difficulty_poll" and not State.killed
    end
    task.spawn(function()
        botChat("Difficulty Poll - 20 seconds!")
        task.wait(2.5)
        if not stillActive() then return end
        botChat("Type one: Easy | Medium | Hard | Very Hard | Extreme | Deadly")
        task.wait(7.5)
        if not stillActive() then return end
        local v1 = 0; for _ in pairs(BotState.difficultyVotes) do v1 = v1 + 1 end
        botChat("[TIME] 10 seconds left - " .. v1 .. " vote(s) so far")
        botRefresh()
        task.wait(10)
        if not stillActive() then return end
        BotState.endDifficultyPoll()
    end)
end

function BotState.endDifficultyPoll()
    if not BotState.active or State.killed then return end
    BotState.phase = "generating"
    botRefresh()
    local topDiff = botTopDiff()
    if topDiff then
        BotState.currentDifficulty = topDiff
        botChat("Difficulty poll ended. Locked: " .. topDiff)
    else
        BotState.currentDifficulty = "Hard"
        botChat("No difficulty votes. Defaulting to Hard.")
    end
    task.wait(2.5)
    if not BotState.active or State.killed then return end
    for i = 1, #DIFFICULTIES do if DIFFICULTIES[i].name == BotState.currentDifficulty then State.currentDiff = DIFFICULTIES[i]; break end end
    State.currentTopic = BotState.currentTopic
    botChat("Generating 10 questions. Please wait ~15-20s...")
    generateQuizAPI(BotState.currentTopic, BotState.currentDifficulty, function(qs)
        if not BotState.active or State.killed then return end
        State.generatedQuestions = qs
        State.quizLocked = true
        botChat("Questions ready! Quiz starting now...")
        task.wait(3)
        if not BotState.active or State.killed then return end
        local s = buildScript(BotState.currentTopic, BotState.currentDifficulty, qs)
        local loader = loadstring or load
        local fn, err = loader(s)
        if not fn then botChat("[ERROR] Load error: " .. tostring(err)); BotState.phase = "idle"; botRefresh(); return end
        BotState.phase = "running_quiz"
        BotState.quizRunning = true
        botRefresh()
        local mySession = BotState.sessionId
        pcall(function() getG().REDHUB_QUIZ_DONE = false end)
        task.spawn(function()
            local ok, e = pcall(fn)
            if not ok then warn("[RedHub Bot Quiz] Runtime: " .. tostring(e)) end
            local elapsed = 0
            while elapsed < 600 do
                if not BotState.active or State.killed then return end
                if getG().REDHUB_QUIZ_DONE == true then break end
                task.wait(0.3)
                elapsed = elapsed + 0.3
            end
            pcall(function() getG().REDHUB_QUIZ_DONE = false end)
            BotState.quizRunning = false
            if BotState.active and BotState.sessionId == mySession and BotState.phase == "running_quiz" and not State.killed then
                BotState.phase = "waiting_next"
                botRefresh()
                botChat("Quiz finished! Next round starts in 12 seconds...")
                task.wait(12)
                if BotState.active and BotState.sessionId == mySession and not State.killed then
                    BotState.startTopicPoll()
                end
            else
                if BotState.phase == "running_quiz" then BotState.phase = "idle"; botRefresh() end
            end
        end)
    end, function(err)
        botChat("[ERROR] Generation failed: " .. tostring(err))
        BotState.phase = "idle"
        botRefresh()
    end)
end

function BotState.start()
    if State.killed then return end
    if not State.apiKey or #State.apiKey < 10 then botChat("[ERROR] Set API key first."); return end
    playSuccess(); botChatLastTime = 0
    BotState.active = true
    BotState.usedTopics = {}
    BotState.bannedPlayers = {}
    botAttachListener()
    botRefresh()
    task.wait(1)
    if not BotState.active then return end
    BotState.startTopicPoll()
end

function BotState.stop()
    botChatLastTime = 0
    if not BotState.active then return end
    BotState.active = false
    botStopQuiz()
    botDisconnect()
    BotState.phase = "idle"
    BotState.topicVotes = {}; BotState.difficultyVotes = {}
    BotState.stopVotes = {}; BotState.banVotes = {}
    botRefresh()
    botChat("[STOP] Bot stopped by host.")
end

