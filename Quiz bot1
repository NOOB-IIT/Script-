local function corner(p, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = p }) end
local function stroke(p, c, t, tr) return new("UIStroke", { Color = c or Color3.fromRGB(50, 50, 60), Thickness = t or 1, Transparency = tr or 0, Parent = p }) end
local function grad(p, c1, c2, rot) return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 0, Parent = p }) end
