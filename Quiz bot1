        table.insert(L, string.format("\t{Question=\"%s\", RawOptions=%s, CorrectText=\"%s\", WordAnswer=\"%s\"},", escapeLuaString(qText), opts, escapeLuaString(q.correctText), escapeLuaString(q.wordAnswer)))
    end
    table.insert(L, "}")
    table.insert(L, "local function shuffleOptions(item)")
