    table.insert(L, "\tif currentQuestionIndex>#quizDatabase then showLeaderboard() else isProcessingAnswer=false task.spawn(askNextQuestion) end")
    table.insert(L, "end")
    table.insert(L, "local function matchesAnswer(input)"
    table.insert(L, "\tlocal cl = cleanStr(input)")
    table.insert(L, "\tif cl == \"\" then return false end")
    table.insert(L, "\tlocal coClean = cleanStr(correctOptionText)")
    table.insert(L, "\tif cl == cleanStr(currentWordAnswer) then return true end")
    table.insert(L, "\tif coClean ~= \"\" and cl == coClean then return true end")
    table.insert(L, "\tif #cl >= 4 and #cl < #coClean and string.find(coClean, cl, 1, true) then return true end")
    table.insert(L, "\tif #coClean >= 4 and #cl > #coClean and #cl <= #coClean + 15 and string.find(cl, coClean, 1, true) then return true end")
    table.insert(L, "\treturn false")
    table.insert(L, "end")
    table.insert(L, "local function onPlayerChatted(p, msg)")
    table.insert(L, "\tif not quizActive or isProcessingAnswer then return end")
    table.insert(L, "\tif blacklistedPlayers[string.upper(p.Name)] then return end")
    table.insert(L, "\tif isTagged(msg) then return end")
    table.insert(L, "\tif matchesAnswer(msg) then triggerWin(p) return end")
    table.insert(L, "\tlocal cl = cleanStr(msg)")
    table.insert(L, "\tlocal letter = nil")
    table.insert(L, "\tif #cl == 1 and string.match(cl, \"^[A-D]$\") then letter = cl end")
    table.insert(L, "\tif not letter then local m = string.match(string.upper(msg), \"^%s*OPTION%s+([A-D])%s*$\") if m then letter = m end end")
    table.insert(L, "\tif letter then")
    table.insert(L, "\t\tif not optionsAllowed or hasGuessedOption[p.UserId] then return end")
    table.insert(L, "\t\thasGuessedOption[p.UserId] = true")
    table.insert(L, "\t\tif letter == correctAnswer then triggerWin(p) end")
    table.insert(L, "\tend")
    table.insert(L, "end")
    table.insert(L, "if TextChatService.ChatVersion==Enum.ChatVersion.TextChatService then TextChatService.MessageReceived:Connect(function(t) if t.TextSource then local p=Players:GetPlayerByUserId(t.TextSource.UserId) if p then onPlayerChatted(p,t.Text) end end end) else Players.PlayerAdded:Connect(function(p) p.Chatted:Connect(function(m) onPlayerChatted(p,m) end) end) end")
    table.insert(L, "function askNextQuestion()")
    table.insert(L, "\tif currentQuestionIndex>#quizDatabase then showLeaderboard() return end")
    table.insert(L, "\tquestionSession+=1 local cs=questionSession local cur=quizDatabase[currentQuestionIndex]")
    table.insert(L, "\tshuffleOptions(cur) currentWordAnswer=cleanStr(cur.WordAnswer)")
    table.insert(L, "\thasGuessedOption={} quizActive=true optionsAllowed=false isProcessingAnswer=false")
    table.insert(L, "\tif isTagged(cur.Question) then sendChatMessage(\"[SKIP] Tagged question\") currentQuestionIndex+=1 task.wait(2) task.spawn(askNextQuestion) return end")
    table.insert(L, "\tsendChatMessage(\"Answer with the exact option text OR just type A/B/C/D!\")")
    table.insert(L, "\tif not smartWait(2.5, cs) then return end")
    table.insert(L, "\tsendChatMessage(cur.Question)")
    table.insert(L, "\tif not smartWait(8, cs) then return end")
    table.insert(L, "\toptionsAllowed=true")
    table.insert(L, "\tfor _,o in ipairs(currentDynamicOptions) do")
    table.insert(L, "\t\tif isTagged(o) then sendChatMessage(\"[SKIP] Tagged option\") currentQuestionIndex+=1 task.wait(2) task.spawn(askNextQuestion) return end")
    table.insert(L, "\t\tsendChatMessage(o)")
    table.insert(L, "\t\tif not smartWait(1.8, cs) then return end")
    table.insert(L, "\tend")
    table.insert(L, "\tif not smartWait(10, cs) then return end")
    table.insert(L, "\tif quizActive and questionSession==cs then")
    table.insert(L, "\t\tquizActive=false sendChatMessage(\"[TIME UP] Correct: \" .. correctAnswer .. \") \" .. correctOptionText)")
    table.insert(L, "\t\tcurrentQuestionIndex+=1 task.wait(2.5)")
    table.insert(L, "\t\tif currentQuestionIndex>#quizDatabase then showLeaderboard() else task.spawn(askNextQuestion) end")
    table.insert(L, "\tend")
    table.insert(L, "end")
    table.insert(L, "task.wait(1)")
    table.insert(L, "sendChatMessage(\"(C) All rights reserved to NOT_IITIAN\")")
    table.insert(L, "task.wait(1.5)")
    table.insert(L, "sendChatMessage(\"=== " .. topic .. " (" .. difficulty .. ") QUIZ STARTING ===\")")
