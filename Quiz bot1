        if State.isGenerating then return end
        if State.quizLocked then statusLabel.Text = "Press BACK first to start a new quiz"; statusLabel.TextColor3 = Color3.fromRGB(251,191,36); statusLabel.Visible = true; task.delay(2.5, function() if statusLabel.Parent then statusLabel.Visible = false end end); return end
