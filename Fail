local function hum(model) return model and model:FindFirstChildOfClass("Humanoid") end
local function root(model)
	if not model then return nil end
	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
end

function CocaEngine.GetRig(model)
	if not model then return "Unknown" end
	if model:FindFirstChild("Torso") and not model:FindFirstChild("UpperTorso") then
		return "R6"
	elseif model:FindFirstChild("UpperTorso") then
		return "R15"
	end
	local h = hum(model)
	if h and h.RigType == Enum.HumanoidRigType.R6 then return "R6" end
	if h and h.RigType == Enum.HumanoidRigType.R15 then return "R15" end
	return "R6"
end

function CocaEngine.GetTargetTorso(model)
	if not model then return nil end
	local th = model:FindFirstChildOfClass("Humanoid")
	if th and th.RigType == Enum.HumanoidRigType.R15 then
		return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
	else
		return model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso")
	end
end

local function getTargetChar()
	if not State.Target then return nil end
	if State.Target.kind == "PLAYER" then
		local p = State.Target.player
		if p and p.Parent and p.Character then
			State.Target.instance = p.Character
			return p.Character
		end
	elseif State.Target.kind == "NPC" then
		local m = State.Target.instance
		if m and m.Parent then return m end
	end
	return nil
end

local function flatCF(cf) 
	local _, y, _ = cf:ToOrientation()
	return CFrame.new(cf.Position) * CFrame.Angles(0, y, 0) 
end

local function clampVelocity(vel)
	if vel.X ~= vel.X or vel.Y ~= vel.Y or vel.Z ~= vel.Z then return Vector3.zero end
	if vel.Magnitude > 1000 then return vel.Unit * 1000 end
	return vel
end

function CocaEngine.SnapToTarget(offset)
	local char = LP.Character
	local myRoot = char and root(char)
	local myHum  = char and hum(char)
	local tc = getTargetChar()
	local tRoot = tc and root(tc)
	if myRoot and tRoot and myHum then
		myHum.PlatformStand = true
		myHum.Sit = false
		local targetCF = tRoot.CFrame * (offset or CFrame.identity)
		pcall(function() char:PivotTo(targetCF) end)
		myRoot.CFrame = targetCF
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
	end
end

local function getTargets()
	local result = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LP and not State.WhitelistedPlayers[string.lower(player.Name)] then
			table.insert(result, {
				kind = "PLAYER",
				player = player,
				instance = player.Character,
				name = player.DisplayName,
				username = player.Name
			})
		end
	end
	table.sort(result, function(a, b)
		return string.lower(a.name) < string.lower(b.name)
	end)
	return result
end

local function targetMatches(target, query)
	query = string.lower(query or "")
	if query == "" then return true end
	return string.find(string.lower(target.name), query, 1, true) ~= nil
		or string.find(string.lower(target.username), query, 1, true) ~= nil
end

local function getAnimator(char)
	local h = hum(char)
	if not h then return nil end
	local anim = h:FindFirstChildOfClass("Animator")
	if not anim then
		anim = Instance.new("Animator")
		anim.Parent = h
	end
	return anim
end

