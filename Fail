-- 22. DRAGGING ENGINE (MOBILE TOUCH & DESKTOP MOUSE)
--============================================================
do
	local function makeDraggable(handleFrame, targetFrame)
		local dragging = false
		local dragInput = nil
		local dragStart = nil
		local startPos = nil

		handleFrame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = targetFrame.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		handleFrame.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if input == dragInput and dragging then
				local delta = input.Position - dragStart
				targetFrame.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end)
	end

	-- Make both MainFrame header and floating mobile icon draggable!
	makeDraggable(headerBar, mainFrame)
	makeDraggable(mobileToggle, mobileToggle)

	-- Desktop Hotkey Toggle (RightShift)
	UserInputService.InputBegan:Connect(function(input, gpe)
		if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
			mainFrame.Visible = not mainFrame.Visible
			CocaEngine.PlaySound(CocaEngine.SOUNDS.Click, 0.3, 1.2)
		end
	end)
end

--============================================================
-- 23. COMPREHENSIVE KINEMATICS & MATRIX TRANSFORMATION SOLVER
--============================================================
do
	local Kinematics = {}
	CocaEngine.Kinematics = Kinematics

	function Kinematics.Slerp(cf0, cf1, t)
		return cf0:Lerp(cf1, t)
	end

	function Kinematics.Orthonormalize(cf)
		local right = cf.RightVector.Unit
		local up = cf.UpVector.Unit
		local look = -cf.LookVector.Unit
		return CFrame.fromMatrix(cf.Position, right, up, look)
	end

	function Kinematics.SolveTwoBoneIK(origin, target, length1, length2)
		local offset = target - origin
		local dist = offset.Magnitude
		if dist > (length1 + length2) then
			local dir = offset.Unit
			return CFrame.new(origin, origin + dir), CFrame.new(origin + dir * length1, origin + dir * (length1 + length2))
		end

		local cosAngle1 = (dist^2 + length1^2 - length2^2) / (2 * dist * length1)
		local angle1 = math.acos(math.clamp(cosAngle1, -1, 1))

		local cosAngle2 = (length1^2 + length2^2 - dist^2) / (2 * length1 * length2)
		local angle2 = math.pi - math.acos(math.clamp(cosAngle2, -1, 1))

		local cfOrigin = CFrame.new(origin, target) * CFrame.Angles(angle1, 0, 0)
		local jointPos = (cfOrigin * CFrame.new(0, 0, -length1)).Position
		local cfJoint = CFrame.new(jointPos, target) * CFrame.Angles(-angle2, 0, 0)

		return cfOrigin, cfJoint
	end

	function Kinematics.CubicBezier(p0, p1, p2, p3, t)
		local u = 1 - t
		local tt = t * t
		local uu = u * u
		local uuu = uu * u
		local ttt = tt * t

		local p = uuu * p0
		p = p + 3 * uu * t * p1
		p = p + 3 * u * tt * p2
		p = p + ttt * p3
		return p
	end

	function Kinematics.SpringDamper(currentPos, targetPos, currentVel, stiffness, damping, dt)
		local delta = targetPos - currentPos
		local force = delta * stiffness - currentVel * damping
		local nextVel = currentVel + force * dt
		local nextPos = currentPos + nextVel * dt
		return nextPos, nextVel
	end
end

