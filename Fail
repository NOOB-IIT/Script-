function Troll.TeleportInRange(targetPlayer, distance, mode)
	if not targetPlayer or not targetPlayer.Character then
		Notify("TROLL", "Target character not found!", DANGER)
		return
	end
	local tRoot = root(targetPlayer.Character)
	local myChar = LP.Character
	local myRoot = myChar and root(myChar)
	local myHum  = myChar and hum(myChar)
	if not tRoot or not myRoot then return end

	distance = distance or 3.0
	mode = mode or "Behind"

	local offset = Vector3.new(0, 0, distance)
	if mode == "Behind" then offset = Vector3.new(0, 0, distance)
	elseif mode == "In Front" then offset = Vector3.new(0, 0, -distance)
	elseif mode == "Right" then offset = Vector3.new(distance, 0, 0)
	elseif mode == "Left" then offset = Vector3.new(-distance, 0, 0)
	elseif mode == "Above" then offset = Vector3.new(0, distance + 2, 0)
	elseif mode == "Below" then offset = Vector3.new(0, -distance, 0) end

	if myHum then
		myHum.PlatformStand = false
		myHum.Sit = false
	end

	local targetCF = tRoot.CFrame * CFrame.new(offset)
	pcall(function() myChar:PivotTo(targetCF) end)
	myRoot.CFrame = targetCF
	myRoot.AssemblyLinearVelocity = tRoot.AssemblyLinearVelocity
	myRoot.AssemblyAngularVelocity = Vector3.zero
	Notify("TROLL", "Teleported to " .. targetPlayer.Name .. " (" .. mode .. " " .. distance .. "s)", SUCCESS)
end

function Troll.FuzzyCatch(text)
	text = string.lower(text or "")
	if text == "" then return nil end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if string.lower(p.Name) == text or string.lower(p.DisplayName) == text then
				return p
			end
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if string.lower(p.Name):sub(1, #text) == text or string.lower(p.DisplayName):sub(1, #text) == text then
				return p
			end
		end
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if string.lower(p.Name):find(text, 1, true) or string.lower(p.DisplayName):find(text, 1, true) then
				return p
			end
		end
	end
	return nil
end

