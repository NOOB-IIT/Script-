	else
		btn.BackgroundColor3 = BG_ELEMENT
		btn.TextColor3 = TEXT_MAIN
		if stroke then stroke.Color = Color3.fromRGB(45, 45, 55) end
		if labelOff then btn.Text = labelOff end
