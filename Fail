		if now - lastTelemetryTick < 0.05 then return end
		lastTelemetryTick = now
		local tc = getTargetChar()
		if tc and tc.Parent then
			local tr = root(tc)
			local th = hum(tc)
			if tr then
				local p = tr.Position
				local v = Vector3.zero
				pcall(function() v = tr.AssemblyLinearVelocity end)
				if v == Vector3.zero then pcall(function() v = tr.Velocity end) end

				intelCoords.Text = string.format("📍 Pos: X: %.2f | Y: %.2f | Z: %.2f", p.X, p.Y, p.Z)
				intelVel.Text = string.format("⚡ Vel: VX: %.2f | VY: %.2f | VZ: %.2f (%.1f spd)", v.X, v.Y, v.Z, v.Magnitude)

