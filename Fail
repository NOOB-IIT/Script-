end

function CocaEngine.ToggleFeature(featureId, btnInstance, startFn, stopFn, labelOn, labelOff)
	CocaEngine.PlaySound(CocaEngine.SOUNDS.Click, 0.4, 1.0)

	if State.ActiveFeature == featureId then
		if State.ActiveFeatureStop then pcall(State.ActiveFeatureStop) end
		StateManager:Cleanup(true)
		if btnInstance then CocaEngine.SetBtnActive(btnInstance, false, labelOn, labelOff) end
		State.ActiveFeature = nil
		State.ActiveFeatureBtn = nil
		State.ActiveFeatureStop = nil
		Notify("ACTION", featureId .. " Stopped", DANGER)
		return false
	end

	if State.ActiveFeature then
		if State.ActiveFeatureStop then pcall(State.ActiveFeatureStop) end
		if State.ActiveFeatureBtn then
			local prevBtn = State.ActiveFeatureBtn
			local prevLabelOff = prevBtn:GetAttribute("LabelOff")
			CocaEngine.SetBtnActive(prevBtn, false, nil, prevLabelOff)
		end
		StateManager:Cleanup(true)
	end

	State.ActiveFeature = featureId
	State.ActiveFeatureBtn = btnInstance
	State.ActiveFeatureStop = stopFn
	if btnInstance then
		btnInstance:SetAttribute("LabelOff", labelOff or btnInstance.Text)
		CocaEngine.SetBtnActive(btnInstance, true, labelOn, labelOff)
	end
	Notify("ACTION", featureId .. " Started", SUCCESS)

	-- Synchronous 0ms immediate execution
	if startFn then startFn() end
	return true
end

