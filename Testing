-- ═══════════ HELPERS ═══════════
local function getRig(p)
    if not p or not p.Character then return nil end
    local h = p.Character:FindFirstChildOfClass("Humanoid")
    return h and h.RigType or nil
end
local function isR15(p) return getRig(p) == Enum.HumanoidRigType.R15 end

local function getHeadHeight(char)
    if not char then return 1.5 end
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not head or not hrp then return 1.5 end
    return head.Position.Y - hrp.Position.Y
end

local function getTorsoDepth(char)
    if not char then return 1 end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if torso then return torso.Size.Z end
    return 1
end

local function stopAllMyAnims()
    for _, t in ipairs(PlayedAnims) do pcall(function() t:Stop() end); pcall(function() t:Destroy() end) end
    PlayedAnims = {}
end
local function stopCopying()
    if AnimCopyConn then AnimCopyConn:Disconnect(); AnimCopyConn = nil end
    for _, t in ipairs(CopiedTracks) do pcall(function() t:Stop() end); pcall(function() t:Destroy() end) end
    CopiedTracks = {}
end

local function stopThrust()
    ThrustActive = false
    if ThrustConn then ThrustConn:Disconnect(); ThrustConn = nil end
end

-- NEW thrust: auto-touch based
local function startThrust()
    stopThrust()
    ThrustActive = true
    local t0 = tick()
    ThrustConn = RunService.Heartbeat:Connect(function()
        if not ThrustActive then return end
        local elapsed = tick() - t0
        -- phase: 0 (touch) to 1 (farthest)
        local phase = (math.sin(elapsed * ThrustSpeed * math.pi * 2) + 1) / 2
        V.Z = ThrustTouchZ + ThrustDirection * phase * ThrustRange
    end)
end

local function stopMotion()
    MotionMode = "none"
    if MotionConn then MotionConn:Disconnect(); MotionConn = nil end
end

local function startMotion(mode)
    stopMotion()
    MotionMode = mode
    local t0 = tick()
    MotionConn = RunService.Heartbeat:Connect(function()
        if MotionMode == "none" then return end
        local t = tick() - t0
        if MotionMode == "orbit" then
            local angle = t * OrbitSpeed * math.pi * 2
            V.X = math.cos(angle) * OrbitRadius
            V.Z = math.sin(angle) * OrbitRadius
            V.Y = 0
        elseif MotionMode == "bounce" then
            V.Y = math.abs(math.sin(t * BounceSpeed * math.pi)) * BounceHeight
        elseif MotionMode == "suck" then
            local progress = math.min(t / SuckDuration, 1)
            local startZ = 8
            local endZ = 1.0
            V.Z = startZ - (startZ - endZ) * progress
            if progress >= 1 then stopMotion() end
        end
    end)
end

-- ═══════════ ANTI-SIT ═══════════
local function antiSitTick()
    if not AntiSitEnabled then return end
    local c = LP.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    if h.Sit then
        h.Sit = false; h.Jump = true
        AntiSitCount = AntiSitCount + 1
        if AntiSitCountLabel then AntiSitCountLabel.Text = "🛡 Blocked: " .. AntiSitCount .. " times" end
    end
    for _, obj in ipairs(c:GetDescendants()) do
        if obj:IsA("Weld") and obj.Name == "SeatWeld" then pcall(function() obj:Destroy() end) end
    end
end

local function hookCharAntiSit(char)
    local h = char:FindFirstChildOfClass("Humanoid")
    if not h then return end
    h:GetPropertyChangedSignal("Sit"):Connect(function()
        if h.Sit and AntiSitEnabled then
            h.Sit = false; h.Jump = true
            AntiSitCount = AntiSitCount + 1
            if AntiSitCountLabel then AntiSitCountLabel.Text = "🛡 Blocked: " .. AntiSitCount .. " times" end
        end
    end)
end

local function enableAntiSit()
    AntiSitEnabled = true; AntiSitCount = 0
    if AntiSitCountLabel then AntiSitCountLabel.Text = "🛡 Blocked: 0 times" end
    if AntiSitConn then AntiSitConn:Disconnect() end
    AntiSitConn = RunService.Heartbeat:Connect(antiSitTick)
    if AntiSitCharConn then AntiSitCharConn:Disconnect() end
    AntiSitCharConn = LP.CharacterAdded:Connect(function(char) task.wait(0.2); hookCharAntiSit(char) end)
    if LP.Character then hookCharAntiSit(LP.Character) end
end

local function disableAntiSit()
    AntiSitEnabled = false
    if AntiSitConn then AntiSitConn:Disconnect(); AntiSitConn = nil end
end

-- ═══════════ ANIMATION COPY ═══════════
local function startCopying(tp)
    stopCopying()
    if not tp or not AnimCopyEnabled then return end
    local myRig, tRig = getRig(LP), getRig(tp)
    if not myRig or not tRig then return end
    if myRig ~= tRig then notify("RED HUB", "Rig mismatch"); return end
    local tc, mc = tp.Character, LP.Character
    if not tc or not mc then return end
    local tH, mH = tc:FindFirstChildOfClass("Humanoid"), mc:FindFirstChildOfClass("Humanoid")
    if not tH or not mH then return end
    local tA, mA = tH:FindFirstChildOfClass("Animator"), mH:FindFirstChildOfClass("Animator")
    if not tA or not mA then return end
    for _, track in ipairs(tA:GetPlayingAnimationTracks()) do
        local ok, nt = pcall(function()
            local a = Instance.new("Animation"); a.AnimationId = track.Animation.AnimationId
            local t = mA:LoadAnimation(a)
            t:AdjustSpeed(V.Speed); t:Play(track.TimePosition or 0); return t
        end)
        if ok and nt then table.insert(CopiedTracks, nt) end
    end
    AnimCopyConn = tA.AnimationPlayed:Connect(function(track)
        if not AnimCopyEnabled then return end
        for _, t in ipairs(CopiedTracks) do pcall(function() t:Stop() end) end
        CopiedTracks = {}
        local ok, nt = pcall(function()
            local a = Instance.new("Animation"); a.AnimationId = track.Animation.AnimationId
            local t = mA:LoadAnimation(a); t:AdjustSpeed(V.Speed); t:Play(0); return t
        end)
        if ok and nt then table.insert(CopiedTracks, nt) end
    end)
end

local function updateCopySpeed()
    for _, t in ipairs(CopiedTracks) do pcall(function() t:AdjustSpeed(V.Speed) end) end
end

-- ═══════════ WELD CORE ═══════════
local function WeldTo(TPart, AnimId, UseCopy)
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or not char:FindFirstChildOfClass("Humanoid") then return nil end
    stopAllMyAnims()
    if UseCopy then
        startCopying(CurrentTarget)
    elseif AnimId and AnimId ~= 0 then
        stopCopying()
        local anim = char:FindFirstChildWhichIsA("Animator", true)
        if anim then
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. tostring(AnimId)
            local ok, tr = pcall(function() return anim:LoadAnimation(a) end)
            if ok and tr then
                pcall(function() tr:AdjustSpeed(V.Speed); tr:Play() end)
                table.insert(PlayedAnims, tr)
            end
        end
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false; p.Massless = true end
    end
    local Weld = {}; local conn
    conn = RunService.Heartbeat:Connect(function()
        if not char.Parent or not TPart.Parent then
            if Weld.Destroy then Weld:Destroy() end
            return
        end
        local offset = CFrame.new(V.X, V.Y, V.Z)
            * CFrame.Angles(math.rad(V.RX), math.rad(V.RY), math.rad(V.RZ))
        root.CFrame = TPart.CFrame * offset
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if sethiddenproperty then
            pcall(function()
                sethiddenproperty(root, "PhysicsRepRootPart", TPart)
                if InstanceHandleNew then
                    sethiddenproperty(root, "PhysicsRepRootRef", InstanceHandleNew(TPart))
                end
            end)
        end
    end)
    function Weld:Destroy()
        if conn then conn:Disconnect(); conn = nil end
        stopCopying(); stopAllMyAnims(); stopThrust(); stopMotion()
        if OriginalCameraSubject then
            pcall(function() workspace.CurrentCamera.CameraSubject = OriginalCameraSubject end)
            OriginalCameraSubject = nil
        end
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    return Weld
end

local function cleanAll()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld = nil end
    stopAllMyAnims(); stopCopying(); stopThrust(); stopMotion()
    if OriginalCameraSubject then
        pcall(function() workspace.CurrentCamera.CameraSubject = OriginalCameraSubject end)
        OriginalCameraSubject = nil
    end
end

-- ═══════════ AUTO RE-WELD ═══════════
local function storeWeldInfo(targetPlr, animId, wasThrust, type)
    LastWeldTargetUserId = targetPlr.UserId
    LastWeldAnimId = animId or 0
    LastWeldWasThrust = wasThrust or false
    LastWeldType = type or "weld"
end

local runBangAggressive, runFBangAggressive

local function performAutoReweld(targetPlr, reasonText)
    if not AutoReweldEnabled then return end
    if not targetPlr or not targetPlr.Character then return end
    local type = LastWeldType or "weld"
    if type == "fbangagg" and runFBangAggressive then
        task.wait(0.5); runFBangAggressive(); return
    elseif type == "bangagg" and runBangAggressive then
        task.wait(0.5); runBangAggressive(); return
    end
    local th = targetPlr.Character:FindFirstChildOfClass("Humanoid")
    if not th then return end
    local tr = ((th.RigType == Enum.HumanoidRigType.R15)
        and targetPlr.Character:FindFirstChild("UpperTorso")
        or  targetPlr.Character:FindFirstChild("Torso")
        or  targetPlr.Character:FindFirstChild("HumanoidRootPart"))
    if not tr then return end
    cleanAll()
    CurrentTarget = targetPlr
    selectedPlayer = targetPlr
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    local ok, w = pcall(function() return WeldTo(tr, LastWeldAnimId, AnimCopyEnabled) end)
    if ok and w then
        CurrentWeld = w
        if LastWeldWasThrust then startThrust() end
        sSuccess()
        notify("RED HUB", (reasonText or "Auto re-weld") .. " → " .. targetPlr.Name)
    end
end

local function hookTargetRespawn(targetPlr)
    if not targetPlr then return end
    if targetPlr:FindFirstChild("__RedHubRespawnHookV11") then return end
    local marker = Instance.new("BoolValue")
    marker.Name = "__RedHubRespawnHookV11"
    marker.Parent = targetPlr
    targetPlr.CharacterAdded:Connect(function()
        if not AutoReweldEnabled then return end
        if targetPlr ~= selectedPlayer then return end
        if LastWeldTargetUserId ~= targetPlr.UserId then return end
        task.wait(1.5)
        if not targetPlr.Character then return end
        if CurrentWeld then return end
        performAutoReweld(targetPlr, "Respawn re-weld")
    end)
end

