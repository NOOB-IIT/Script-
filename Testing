-- Auto-touch Bang (belly-to-belly)
local function runBang(animId, speed, rangeOverride)
    if not selectedPlayer then notify("RED HUB","Select player"); sError(); shake(main,5); return end
    if not selectedPlayer.Character then return end
    stopThrust(); stopMotion()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld = nil end
    stopAllMyAnims(); stopCopying()
    CurrentTarget = selectedPlayer

    local tc = selectedPlayer.Character
    local th = tc:FindFirstChildOfClass("Humanoid")
    local tr = ((th and th.RigType == Enum.HumanoidRigType.R15)
        and tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart"))
    if not tr then return end

    -- Auto-compute touch Z (belly-to-belly)
    local myDepth = getTorsoDepth(LP.Character)
    local theirDepth = getTorsoDepth(tc)
    local touchZ = (myDepth + theirDepth) / 2  -- touching distance

    V.X = 0; V.Y = 0; V.Z = touchZ
    V.RX, V.RY, V.RZ = 0, 0, 0

    ThrustTouchZ = touchZ
    ThrustDirection = 1
    if rangeOverride then ThrustRange = rangeOverride; SlThrustDist.set(rangeOverride, true) end
    ThrustSpeed = speed or ThrustSpeed

    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    storeWeldInfo(selectedPlayer, animId, true, "bang")
    hookTargetRespawn(selectedPlayer)

    local ok, w = pcall(function() return WeldTo(tr, animId, false) end)
    if ok and w then
        CurrentWeld = w
        startThrust()
        sSuccess(); screenFlash(T.Accent); burst(main, T.Accent, 14)
        notify("RED HUB", "💥 Bang → " .. selectedPlayer.Name)
    end
end

-- F.Bang (auto head-to-head)
local function runFBang(animId, speed, rangeOverride, isAggressive)
    if not selectedPlayer then notify("RED HUB","Select player"); sError(); shake(main,5); return end
    if not selectedPlayer.Character then return end
    stopThrust(); stopMotion()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld = nil end
    stopAllMyAnims(); stopCopying()
    CurrentTarget = selectedPlayer

    local tc = selectedPlayer.Character
    local head = tc:FindFirstChild("Head")
    if not head then notify("RED HUB","No head part"); sError(); return end

    -- Auto-compute head Y offset (my head height from HRP)
    local headHeight = getHeadHeight(LP.Character)
    local myHeadDepth = (LP.Character and LP.Character:FindFirstChild("Head") and LP.Character.Head.Size.Z) or 1
    local theirHeadDepth = head.Size.Z
    local touchZ = -(myHeadDepth + theirHeadDepth) / 2  -- heads touch when -1.0 apart

    V.X = 0
    V.Y = -headHeight           -- auto head level
    V.Z = touchZ
    V.RX, V.RY, V.RZ = 0, 180, 0

    ThrustTouchZ = touchZ
    ThrustDirection = -1
    if rangeOverride then ThrustRange = rangeOverride; SlThrustDist.set(rangeOverride, true) end
    if speed then ThrustSpeed = speed end

    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    storeWeldInfo(selectedPlayer, animId, true, isAggressive and "fbangagg" or "fbang")
    hookTargetRespawn(selectedPlayer)

    local ok, w = pcall(function() return WeldTo(head, animId, false) end)
    if ok and w then
        CurrentWeld = w
        startThrust()
        sSuccess(); screenFlash(T.Pink); burst(main, T.Pink, 16)
        notify("RED HUB", (isAggressive and "🔥💦 F.Bang Agg → " or "💦 F.Bang → ") .. selectedPlayer.Name)
    else
        sError(); shake(main, 5)
    end
end

