local function findPlayers(q)
    q = (q or ""):lower(); local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if q == "" or p.Name:lower():sub(1,#q) == q or p.DisplayName:lower():sub(1,#q) == q then
                table.insert(list, p)
            end
        end
    end
    return list
end

local function refreshList()
    for _, c in ipairs(listScroll:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
    local plrs = findPlayers(searchBox.Text)
    if #plrs == 0 then
        local e = Instance.new("TextLabel")
        e.Size = UDim2.new(1,0,0,30); e.BackgroundTransparency = 1
        e.Text = "No players online"; e.TextColor3 = T.Muted
        e.Font = Enum.Font.Gotham; e.TextSize = 11
        e.LayoutOrder = 1; e.ZIndex = 9; e.Parent = listScroll
