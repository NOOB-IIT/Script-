-- Extra feature: Fling
local function flingPlayer()
    if not selectedPlayer then notify("RED HUB","Select player"); sError(); shake(main,5); return end
    local tc = selectedPlayer.Character; if not tc then return end
    local hrp = tc:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    cleanAll()
    CurrentTarget = selectedPlayer
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    pcall(function() hrp:SetNetworkOwner(LP) end)
    storeWeldInfo(selectedPlayer, 0, false, "weld")
    hookTargetRespawn(selectedPlayer)
    local ok, w = pcall(function() return WeldTo(hrp, 0, false) end)
    if ok and w then
        CurrentWeld = w
        task.spawn(function()
            for i = 1, 60 do
                if not CurrentWeld then break end
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        math.random(-5000, 5000), math.random(3000, 8000), math.random(-5000, 5000)
                    )
                    hrp.AssemblyAngularVelocity = Vector3.new(
                        math.random(-100, 100), math.random(-100, 100), math.random(-100, 100)
                    )
                end)
                task.wait(0.03)
            end
        end)
        sSuccess(); screenFlash(T.Accent); burst(main, T.Accent, 20)
        notify("RED HUB", "🎪 FLINGING → " .. selectedPlayer.Name)
    end
end

