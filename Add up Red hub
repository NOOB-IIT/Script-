-- ═══════════ HELPERS ═══════════
local function getRig(p)
    if not p or not p.Character then return nil end
    local h = p.Character:FindFirstChildOfClass("Humanoid")
    return h and h.RigType or nil
end
local function isR15(p) return getRig(p) == Enum.HumanoidRigType.R15 end

local function stopAllMyAnims()
    for _, t in ipairs(PlayedAnims) do pcall(function() t:Stop() end); pcall(function() t:Destroy() end) end
    PlayedAnims = {}
end
local function stopCopying()
    if AnimCopyConn then AnimCopyConn:Disconnect(); AnimCopyConn = nil end
    for _, t in ipairs(CopiedTracks) do pcall(function() t:Stop() end); pcall(function() t:Destroy() end) end
    CopiedTracks = {}
end

local function stopThrust()
    ThrustActive = false
    if ThrustConn then ThrustConn:Disconnect(); ThrustConn = nil end
end

local function startThrust()
    stopThrust()
    ThrustActive = true
    local t0 = tick()
    ThrustConn = RunService.Heartbeat:Connect(function()
        if not ThrustActive then return end
        local elapsed = tick() - t0
        V.Z = ThrustBaseZ + math.sin(elapsed * ThrustSpeed * math.pi * 2) * ThrustAmp
    end)
end

-- ═══════════ ANTI-SIT ═══════════
local function antiSitTick()
    if not AntiSitEnabled then return end
    local c = LP.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    if h.Sit then
        h.Sit = false; h.Jump = true
        AntiSitCount = AntiSitCount + 1
        if AntiSitCountLabel then AntiSitCountLabel.Text = "🛡 Blocked: " .. AntiSitCount .. " times" end
    end
    for _, obj in ipairs(c:GetDescendants()) do
        if obj:IsA("Weld") and obj.Name == "SeatWeld" then
            pcall(function() obj:Destroy() end)
        end
    end
end

local function hookCharAntiSit(char)
    local h = char:FindFirstChildOfClass("Humanoid")
    if not h then return end
    h:GetPropertyChangedSignal("Sit"):Connect(function()
        if h.Sit and AntiSitEnabled then
            h.Sit = false; h.Jump = true
            AntiSitCount = AntiSitCount + 1
            if AntiSitCountLabel then AntiSitCountLabel.Text = "🛡 Blocked: " .. AntiSitCount .. " times" end
        end
    end)
end

local function enableAntiSit()
    AntiSitEnabled = true
    AntiSitCount = 0
    if AntiSitCountLabel then AntiSitCountLabel.Text = "🛡 Blocked: 0 times" end
    if AntiSitConn then AntiSitConn:Disconnect() end
    AntiSitConn = RunService.Heartbeat:Connect(antiSitTick)
    if AntiSitCharConn then AntiSitCharConn:Disconnect() end
    AntiSitCharConn = LP.CharacterAdded:Connect(function(char)
        task.wait(0.2); hookCharAntiSit(char)
    end)
    if LP.Character then hookCharAntiSit(LP.Character) end
end

local function disableAntiSit()
    AntiSitEnabled = false
    if AntiSitConn then AntiSitConn:Disconnect(); AntiSitConn = nil end
end

-- ═══════════ ANIMATION COPY ═══════════
local function startCopying(tp)
    stopCopying()
    if not tp or not AnimCopyEnabled then return end
    local myRig, tRig = getRig(LP), getRig(tp)
    if not myRig or not tRig then return end
    if myRig ~= tRig then notify("RED HUB", "Rig mismatch"); return end
    local tc, mc = tp.Character, LP.Character
    if not tc or not mc then return end
    local tH, mH = tc:FindFirstChildOfClass("Humanoid"), mc:FindFirstChildOfClass("Humanoid")
    if not tH or not mH then return end
    local tA, mA = tH:FindFirstChildOfClass("Animator"), mH:FindFirstChildOfClass("Animator")
    if not tA or not mA then return end

    for _, track in ipairs(tA:GetPlayingAnimationTracks()) do
        local ok, nt = pcall(function()
            local a = Instance.new("Animation")
            a.AnimationId = track.Animation.AnimationId
            local t = mA:LoadAnimation(a)
            t:AdjustSpeed(V.Speed); t:Play(track.TimePosition or 0)
            return t
        end)
        if ok and nt then table.insert(CopiedTracks, nt) end
    end
    AnimCopyConn = tA.AnimationPlayed:Connect(function(track)
        if not AnimCopyEnabled then return end
        for _, t in ipairs(CopiedTracks) do pcall(function() t:Stop() end) end
        CopiedTracks = {}
        local ok, nt = pcall(function()
            local a = Instance.new("Animation")
            a.AnimationId = track.Animation.AnimationId
            local t = mA:LoadAnimation(a)
            t:AdjustSpeed(V.Speed); t:Play(0)
            return t
        end)
        if ok and nt then table.insert(CopiedTracks, nt) end
    end)
end

local function updateCopySpeed()
    for _, t in ipairs(CopiedTracks) do pcall(function() t:AdjustSpeed(V.Speed) end) end
end

-- ═══════════ WELD ═══════════
local function WeldTo(TPart, AnimId, UseCopy)
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root or not char:FindFirstChildOfClass("Humanoid") then return nil end
    stopAllMyAnims()
    if UseCopy then
        startCopying(CurrentTarget)
    elseif AnimId and AnimId ~= 0 then
        stopCopying()
        local anim = char:FindFirstChildWhichIsA("Animator", true)
        if anim then
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. tostring(AnimId)
            local ok, tr = pcall(function() return anim:LoadAnimation(a) end)
            if ok and tr then
                pcall(function() tr:AdjustSpeed(V.Speed); tr:Play() end)
                table.insert(PlayedAnims, tr)
            end
        end
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false; p.Massless = true end
    end
    local Weld = {}; local conn
    conn = RunService.Heartbeat:Connect(function()
        if not char.Parent or not TPart.Parent then
            if Weld.Destroy then Weld:Destroy() end
            return
        end
        local offset = CFrame.new(V.X, V.Y, V.Z)
            * CFrame.Angles(math.rad(V.RX), math.rad(V.RY), math.rad(V.RZ))
        root.CFrame = TPart.CFrame * offset
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if sethiddenproperty then
            pcall(function()
                sethiddenproperty(root, "PhysicsRepRootPart", TPart)
                if InstanceHandleNew then
                    sethiddenproperty(root, "PhysicsRepRootRef", InstanceHandleNew(TPart))
                end
            end)
        end
    end)
    function Weld:Destroy()
        if conn then conn:Disconnect(); conn = nil end
        stopCopying(); stopAllMyAnims(); stopThrust()
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    return Weld
end

local function cleanAll()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld = nil end
    stopAllMyAnims(); stopCopying(); stopThrust()
end

