local function runPreset(x, y, z, rx, ry, rz, animId)
    if not selectedPlayer then notify("RED HUB","Select player"); sError(); shake(main,5); return end
    stopThrust()
    pcall(function() SlX.set(x, false); SlY.set(y, false); SlZ.set(z, false)
        SlRX.set(rx, false); SlRY.set(ry, false); SlRZ.set(rz, false) end)
    V.X, V.Y, V.Z = x, y, z; V.RX, V.RY, V.RZ = rx, ry, rz
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld = nil end
    stopAllMyAnims(); stopCopying()
    CurrentTarget = selectedPlayer
    local tc = selectedPlayer.Character
    if not tc then return end
    local th = tc:FindFirstChildOfClass("Humanoid")
    local tr = ((th and th.RigType == Enum.HumanoidRigType.R15)
        and tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart"))
    if not tr then return end
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    local ok, w = pcall(function() return WeldTo(tr, animId, false) end)
    if ok and w then
        CurrentWeld = w; sSuccess(); screenFlash(T.Accent); burst(main, T.Accent, 12)
        notify("RED HUB", "Preset → " .. selectedPlayer.Name)
    end
end

local function runFBang()
    if not selectedPlayer then notify("RED HUB","Select player"); sError(); shake(main,5); return end
    stopThrust()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld = nil end
    stopAllMyAnims(); stopCopying()

    local tc = selectedPlayer.Character
    if not tc then notify("RED HUB","Target missing"); sError(); return end
    local head = tc:FindFirstChild("Head")
    if not head then notify("RED HUB","No head part found"); sError(); return end

    CurrentTarget = selectedPlayer
    local myRig = getRig(LP)
    local yOff = (myRig == Enum.HumanoidRigType.R15) and -1.8 or -1.2

    V.X = 0; V.Y = yOff; V.Z = -1.8
    V.RX, V.RY, V.RZ = 0, 180, 0

    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    local ok, w = pcall(function() return WeldTo(head, 148840371, false) end)
    if ok and w then
        CurrentWeld = w
        ThrustBaseZ = -1.8
        startThrust()
        sSuccess(); screenFlash(T.Accent); burst(main, T.Accent, 16)
        notify("RED HUB", "🎯 F.Bang → " .. selectedPlayer.Name)
    else
        sError(); shake(main, 5)
    end
end

-- 🔥 Bang Aggressive (R15 only)
local function runBangAggressive()
    if not selectedPlayer then notify("RED HUB","Select player"); sError(); shake(main,5); return end
    if not selectedPlayer.Character then notify("RED HUB","Target missing"); sError(); return end

    if not isR15(LP) then
        notify("RED HUB", "R15 only — using Bang 2.0")
        runPreset(0, 0, 1.3, 0, 0, 0, 148840371)
        task.wait(0.1)
        ThrustBaseZ = 1.3
        startThrust()
        return
    end

    stopThrust()
    if CurrentWeld then pcall(function() CurrentWeld:Destroy() end); CurrentWeld = nil end
    stopAllMyAnims(); stopCopying()
    CurrentTarget = selectedPlayer

    local tc = selectedPlayer.Character
    local th = tc:FindFirstChildOfClass("Humanoid")
    local tr = ((th and th.RigType == Enum.HumanoidRigType.R15)
        and tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart"))
    if not tr then notify("RED HUB","No torso"); sError(); return end

    V.X = 0
    V.Y = 0.3
    V.Z = 1.1
    V.RX, V.RY, V.RZ = 0, 180, 0

    ThrustBaseZ = 1.1
    ThrustAmp   = 0.85
