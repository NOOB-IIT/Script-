local function burst(centerFrame, color, count)
    count = count or 16
    for i = 1, count do
        local p = Instance.new("Frame")
        p.Size = UDim2.new(0, 8, 0, 8)
        p.Position = UDim2.new(0.5, -4, 0.5, -4)
        p.BackgroundColor3 = color; p.BorderSizePixel = 0
        p.ZIndex = 160; p.Parent = centerFrame
        Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
        local ang = (i / count) * math.pi * 2 + math.random() * 0.3
        local dist = 80 + math.random(-20, 30)
        local dx, dy = math.cos(ang) * dist, math.sin(ang) * dist
        TweenService:Create(p, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, dx - 4, 0.5, dy - 4),
            Size = UDim2.new(0, 2, 0, 2), BackgroundTransparency = 1,
        }):Play()
        Debris:AddItem(p, 1)
    end
end

local function shake(frame, intensity)
    intensity = intensity or 4
    local orig = frame.Position
    for i = 1, 6 do
        TweenService:Create(frame, TweenInfo.new(0.04), {
            Position = orig + UDim2.new(0, math.random(-intensity, intensity), 0, math.random(-intensity, intensity))
        }):Play()
        task.wait(0.04)
    end
    TweenService:Create(frame, TweenInfo.new(0.1), {Position = orig}):Play()
end

