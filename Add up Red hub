-- ═══════════ CLOSE CONFIRM ═══════════
local function shutdown()
    cleanAll()
    pcall(function() workspace.FallenPartsDestroyHeight = OriginalFPDH end)
    gui:Destroy()
    print("[RED HUB] Closed")
end

local function showCloseConfirm()
    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.new(1,0,1,0); overlay.BackgroundColor3 = Color3.new(0,0,0)
    overlay.BackgroundTransparency = 1; overlay.ZIndex = 100; overlay.Parent = gui

    local dlg = Instance.new("Frame")
    dlg.Size = UDim2.new(0,0,0,0); dlg.Position = UDim2.new(0.5,0,0.5,0)
    dlg.BackgroundColor3 = T.Panel; dlg.BorderSizePixel = 0
    dlg.ZIndex = 101; dlg.Parent = gui
    Instance.new("UICorner", dlg).CornerRadius = UDim.new(0,14)

    local ds = Instance.new("UIStroke")
    ds.Color = T.Accent; ds.Thickness = 1.5; ds.Transparency = 0.3
    ds.Parent = dlg

    local dt = Instance.new("TextLabel")
    dt.Size = UDim2.new(1,-20,0,28); dt.Position = UDim2.new(0,10,0,14)
    dt.BackgroundTransparency = 1; dt.Text = "⚠  Close RED HUB?"
    dt.TextColor3 = T.Accent; dt.Font = Enum.Font.GothamBlack
    dt.TextSize = 15; dt.ZIndex = 102; dt.Parent = dlg

    local dm = Instance.new("TextLabel")
    dm.Size = UDim2.new(1,-20,0,44); dm.Position = UDim2.new(0,10,0,48)
    dm.BackgroundTransparency = 1
    dm.Text = "Do you want to close the script?\nAll welds and animations will stop."
    dm.TextColor3 = T.Muted; dm.Font = Enum.Font.Gotham
    dm.TextSize = 11; dm.TextWrapped = true
    dm.ZIndex = 102; dm.Parent = dlg

    local yb = Instance.new("TextButton")
    yb.Size = UDim2.new(0,110,0,34); yb.Position = UDim2.new(0.5,-115,1,-48)
    yb.Text = "YES"; yb.TextColor3 = Color3.new(1,1,1)
    yb.Font = Enum.Font.GothamBlack; yb.TextSize = 12
    yb.ZIndex = 102; yb.Parent = dlg
    Instance.new("UICorner", yb).CornerRadius = UDim.new(0,8)
    styleBtn(yb, T.Accent)

    local nb = Instance.new("TextButton")
    nb.Size = UDim2.new(0,110,0,34); nb.Position = UDim2.new(0.5,5,1,-48)
    nb.Text = "NO"; nb.TextColor3 = T.Text
    nb.Font = Enum.Font.GothamBlack; nb.TextSize = 12
    nb.ZIndex = 102; nb.Parent = dlg
    Instance.new("UICorner", nb).CornerRadius = UDim.new(0,8)
    styleBtn(nb, T.PanelLt)

    TweenService:Create(overlay, TweenInfo.new(0.2), {BackgroundTransparency = 0.5}):Play()
    TweenService:Create(dlg, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0,260,0,190), Position = UDim2.new(0.5,-130,0.5,-95),
    }):Play()

    local function dismiss()
        sClick()
        TweenService:Create(overlay, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
        TweenService:Create(dlg, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0,0,0,0), Position = UDim2.new(0.5,0,0.5,0),
        }):Play()
        task.wait(0.16); overlay:Destroy(); dlg:Destroy()
    end

    yb.MouseButton1Click:Connect(function() sToggleOff(); shutdown() end)
    nb.MouseButton1Click:Connect(dismiss)
    overlay.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            dismiss()
        end
    end)
end

btnClose.MouseButton1Click:Connect(function() sClick(); showCloseConfirm() end)

