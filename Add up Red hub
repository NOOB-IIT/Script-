    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    local ok, w = pcall(function() return WeldTo(tr, BANG_AGGRESSIVE_ANIM, false) end)
    if ok and w then
        CurrentWeld = w
        startThrust()
        sSuccess(); screenFlash(T.Accent); burst(main, T.Accent, 22)
        notify("RED HUB", "🔥 Bang Aggressive → " .. selectedPlayer.Name)
    else
        sError(); shake(main, 5)
    end
end

