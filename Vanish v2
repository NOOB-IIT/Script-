-- Key Authentication Logic
KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        if KeyInput.Text == "IITBOMBAY" then
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
            StatusLabel.Text = "Key Verified!"
            task.wait(0.5)
            
            KeyFrame.Visible = false
            LoadingFrame.Visible = true
            
            -- 5 Seconds Loading Bar Animation
            local tweenInfo = TweenInfo.new(5, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(BarFill, tweenInfo, {Size = UDim2.new(1, 0, 1, 0)})
            tween:Play()
            
            task.spawn(function()
                task.wait(1.5)
                LoadingText.Text = "Checking Whitelist..."
                task.wait(1.5)
                LoadingText.Text = "Loading UI..."
                task.wait(1.5)
                LoadingText.Text = "Ready!"
            end)
            
            tween.Completed:Wait()
            task.wait(0.3)
            
            LoadingFrame.Visible = false
            MainFrame.Visible = true
        else
            StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
            StatusLabel.Text = "incorrect key, try again"
            task.wait(1.5)
            StatusLabel.Text = ""
        end
    end
end)

