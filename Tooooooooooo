-- 10. FIXED & ENHANCED ANIMATION COPY ENGINE (TRACK SYNC)
--============================================================
CocaEngine.AnimCopy = {
	Active = false,
	HeartbeatConn = nil,
	AnimPlayedConn = nil,
	TargetChar = nil,
	Tracks = {} -- [animId] = { myTrack = track, tTrack = targetTrack, animObj = anim }
}

function CocaEngine.AnimCopy:Start(targetPlayer)
	self:Stop()
	if not targetPlayer or not targetPlayer.Character then
		Notify("ANIM COPY", "No valid target selected!", DANGER)
		return
	end
	local myChar = LP.Character
	local tChar = targetPlayer.Character
	if not myChar or not tChar then return end

	local myHum = hum(myChar)
	local tHum = hum(tChar)
	if not myHum or not tHum then return end

	local myAnim = getAnimator(myChar)
	local tAnim = getAnimator(tChar)
	if not myAnim or not tAnim then return end

	self.Active = true
	self.TargetChar = tChar

	local function mirrorTrack(tTrack)
		if not tTrack or not tTrack.Animation then return end
		local animId = tTrack.Animation.AnimationId
		if not animId or animId == "" then return end
		if self.Tracks[animId] then return end

		pcall(function()
			local animObj = Instance.new("Animation")
			animObj.AnimationId = animId
			local myTrack = myAnim:LoadAnimation(animObj)
			myTrack.Priority = Enum.AnimationPriority.Action4
			myTrack:AdjustSpeed(tTrack.Speed)
			myTrack:Play(0.05, 1, tTrack.Speed)
			pcall(function() myTrack.TimePosition = tTrack.TimePosition end)
			self.Tracks[animId] = {
				myTrack = myTrack,
				tTrack = tTrack,
				animObj = animObj
			}
		end)
	end

	-- Mirror existing active tracks
	for _, trk in ipairs(tAnim:GetPlayingAnimationTracks()) do
		mirrorTrack(trk)
	end

	-- Zero-delay hook for newly played animations
	self.AnimPlayedConn = tAnim.AnimationPlayed:Connect(function(newTrack)
		if self.Active then
			mirrorTrack(newTrack)
		end
	end)

	-- Continuous synchronization on Heartbeat
	self.HeartbeatConn = RunService.Heartbeat:Connect(function()
		if not self.Active or not self.TargetChar or not self.TargetChar.Parent or not myChar.Parent then
			self:Stop()
			return
		end

		for animId, item in pairs(self.Tracks) do
			if not item.tTrack.IsPlaying then
				pcall(function()
					item.myTrack:Stop(0.1)
					item.animObj:Destroy()
				end)
				self.Tracks[animId] = nil
			else
				pcall(function()
					item.myTrack:AdjustSpeed(item.tTrack.Speed)
					local diff = math.abs(item.myTrack.TimePosition - item.tTrack.TimePosition)
					if diff > 0.08 then
						item.myTrack.TimePosition = item.tTrack.TimePosition
					end
				end)
			end
		end

		-- Scan for missed tracks
		for _, tTrack in ipairs(tAnim:GetPlayingAnimationTracks()) do
			if tTrack.Animation and tTrack.Animation.AnimationId ~= "" then
				local aId = tTrack.Animation.AnimationId
				if not self.Tracks[aId] then
					mirrorTrack(tTrack)
				end
			end
		end
	end)

	Notify("ANIM COPY", "Replicating animations from " .. targetPlayer.Name, SUCCESS)
end

function CocaEngine.AnimCopy:Stop()
	self.Active = false
	if self.HeartbeatConn then self.HeartbeatConn:Disconnect(); self.HeartbeatConn = nil end
	if self.AnimPlayedConn then self.AnimPlayedConn:Disconnect(); self.AnimPlayedConn = nil end
	for animId, item in pairs(self.Tracks) do
		pcall(function()
			item.myTrack:Stop(0.05)
			item.animObj:Destroy()
		end)
	end
	self.Tracks = {}
	self.TargetChar = nil
end

