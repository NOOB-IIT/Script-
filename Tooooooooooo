	if activeTab == tab and flyout.Size.X.Offset > 0 then
		tab.Visible = false
		activeTab = nil
		CocaEngine.Tween(flyout, { Position = UDim2.new(1, -60, 0, 20), Size = UDim2.new(0, 0, 1, -40) }, 0.35, Enum.EasingStyle.Quint)
