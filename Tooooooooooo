-- 28. DYNAMIC TRAJECTORY & BEZIER ARC SIMULATION ENGINE
--============================================================
do
	local Trajectory = {}
	CocaEngine.Trajectory = Trajectory

	-- Pre-computed Tracing Tables for Ultra-Low Latency Zero-Allocation Physics
	Trajectory.TrigLookup = {}
	for deg = 0, 360 do
		local rad = math.rad(deg)
		Trajectory.TrigLookup[deg] = {
			Sin = math.sin(rad),
			Cos = math.cos(rad),
			Tan = math.tan(rad)
		}
	end

	-- Exact Parabolic Arc Projector
	function Trajectory.CalculateLaunchVelocity(startPos, endPos, timeToTarget, gravity)
		gravity = gravity or workspace.Gravity
		local displacement = endPos - startPos
		local vx = displacement.X / timeToTarget
		local vz = displacement.Z / timeToTarget
		local vy = (displacement.Y + 0.5 * gravity * (timeToTarget^2)) / timeToTarget
		return Vector3.new(vx, vy, vz)
	end

	-- Multi-Point Trajectory Interpolator
	function Trajectory.MultiPointPath(points, alpha)
		if #points < 2 then return points[1] or Vector3.zero end
		local segCount = #points - 1
		local scaledAlpha = alpha * segCount
		local segIdx = math.clamp(math.floor(scaledAlpha) + 1, 1, segCount)
		local localT = scaledAlpha - (segIdx - 1)
		return points[segIdx]:Lerp(points[segIdx + 1], localT)
	end
end

