		for _, data in ipairs(targetButtonData) do data.btn:Destroy() end
		targetButtonData = {}

		local all = getTargets()
		for _, t in ipairs(all) do
			if targetMatches(t, tSearch.Text) then
				local card = Instance.new("TextButton")
				card.Size = UDim2.new(1, 0, 0, 48)
				card.BackgroundColor3 = BG_ELEMENT
				card.Text = ""
				card.AutoButtonColor = false
				card.Parent = tList
				Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)
				local cStroke = Instance.new("UIStroke", card)
				cStroke.Color = Color3.fromRGB(45, 45, 55)

				-- Player Avatar Thumbnail
				local pImg = Instance.new("ImageLabel")
				pImg.Size = UDim2.new(0, 36, 0, 36)
				pImg.Position = UDim2.new(0, 6, 0.5, -18)
				pImg.BackgroundTransparency = 1
				pImg.Parent = card
				Instance.new("UICorner", pImg).CornerRadius = UDim.new(1, 0)

				task.spawn(function()
					if t.player then
						local ok, thumb = pcall(function()
							return Players:GetUserThumbnailAsync(t.player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
						end)
						if ok and thumb then pImg.Image = thumb end
					end
				end)

				-- Display Name
				local pName = Instance.new("TextLabel")
				pName.BackgroundTransparency = 1
				pName.Text = t.name
				pName.TextSize = 12
				pName.TextColor3 = TEXT_MAIN
				pName.Font = Enum.Font.GothamBold
				pName.Size = UDim2.new(1, -55, 0, 18)
				pName.Position = UDim2.new(0, 48, 0, 6)
				pName.TextXAlignment = Enum.TextXAlignment.Left
				pName.Parent = card

				-- Username
				local pUser = Instance.new("TextLabel")
				pUser.BackgroundTransparency = 1
				pUser.Text = "@" .. t.username
				pUser.TextSize = 10
				pUser.TextColor3 = TEXT_SUB
				pUser.Font = Enum.Font.Gotham
				pUser.Size = UDim2.new(1, -55, 0, 16)
				pUser.Position = UDim2.new(0, 48, 0, 24)
				pUser.TextXAlignment = Enum.TextXAlignment.Left
				pUser.Parent = card

				local isMatch = false
				if State.Target and State.Target.player == t.player then
					isMatch = true
					card.BackgroundColor3 = Color3.fromRGB(40, 70, 45)
					cStroke.Color = SUCCESS
					pName.TextColor3 = SUCCESS
				end

				card.MouseEnter:Connect(function()
					if not (State.Target and State.Target.player == t.player) then
						CocaEngine.Tween(card, {BackgroundColor3 = BG_HOVER}, 0.15)
					end
				end)
				card.MouseLeave:Connect(function()
					if not (State.Target and State.Target.player == t.player) then
						CocaEngine.Tween(card, {BackgroundColor3 = BG_ELEMENT}, 0.15)
					end
				end)

				card.Activated:Connect(function()
					Internal.ApplyTarget(t)
				end)

				table.insert(targetButtonData, {btn = card, targetData = t})
			end
		end
	end

	-- Autocatch Listener on typing
	tSearch:GetPropertyChangedSignal("Text"):Connect(function()
		local q = tSearch.Text
		if #q >= 2 then
			local caught = CocaEngine.Troll.FuzzyCatch(q)
			if caught and (not State.Target or State.Target.player ~= caught) then
				local tObj = {
					kind = "PLAYER",
					player = caught,
					instance = caught.Character,
					name = caught.DisplayName,
					username = caught.Name
				}
				Internal.ApplyTarget(tObj)
			end
		end
		Internal.RefreshTargets()
	end)

	-- Dynamic Real-Time Position, Velocity & Health Updater
	RunService.Heartbeat:Connect(function()
		local tc = getTargetChar()
		if tc and tc.Parent then
			local tr = root(tc)
			local th = hum(tc)
			if tr then
				intelCoords.Text = string.format("📍 Pos: X: %.2f | Y: %.2f | Z: %.2f", tr.Position.X, tr.Position.Y, tr.Position.Z)
				intelVel.Text = string.format("⚡ Vel: VX: %.2f | VY: %.2f | VZ: %.2f", tr.AssemblyLinearVelocity.X, tr.AssemblyLinearVelocity.Y, tr.AssemblyLinearVelocity.Z)

				local myChar = LP.Character
				local mr = myChar and root(myChar)
				if mr then
					local dist = (tr.Position - mr.Position).Magnitude
					local hp = th and th.Health or 0
					local maxHp = th and th.MaxHealth or 100
					intelDist.Text = string.format("Distance: %.1f Studs | HP: %d/%d", dist, math.floor(hp), math.floor(maxHp))
					local frac = math.clamp(hp / math.max(maxHp, 1), 0, 1)
					hpFill.Size = UDim2.new(frac, 0, 1, 0)
					for _, md in ipairs(miniDashes) do
						md.hpFill.Size = UDim2.new(frac, 0, 1, 0)
					end
				end
			end
		end
	end)

	-- Initial population & Player events
	Internal.RefreshTargets()
	Players.PlayerAdded:Connect(Internal.RefreshTargets)
	Players.PlayerRemoving:Connect(Internal.RefreshTargets)
end

