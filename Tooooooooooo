		tList.Size = UDim2.new(1, 0, 0, tListLayout.AbsoluteContentSize.Y)
	end)

	local targetButtonData = {}

	Internal.ApplyTarget = function(target)
		State.Target = target
		if not State.Target then
			CocaEngine.UpdateESP(nil)
			intelAvatar.Image = ""
			intelName.Text = "No Target Selected"
			intelName.TextColor3 = TEXT_SUB
			intelJoinDate.Text = "📅 Joined: N/A"
			intelAge.Text = "⏳ Age: N/A"
			intelOutfit.Text = "💎 Outfit Value: N/A"
			intelFriends.Text = "👥 Server: 0 | 🤝 Mutual: 0"
			intelCoords.Text = "📍 Pos: X: 0.00 | Y: 0.00 | Z: 0.00"
			intelVel.Text = "⚡ Vel: VX: 0.00 | VY: 0.00 | VZ: 0.00"
			intelDist.Text = "Distance: N/A | HP: 0/0"
			hpFill.Size = UDim2.new(0, 0, 1, 0)
			for _, md in ipairs(miniDashes) do
				md.avatar.Image = ""
				md.name.Text = "No Target"
				md.name.TextColor3 = TEXT_SUB
				md.hpFill.Size = UDim2.new(0, 0, 1, 0)
			end
			Internal.TargetUserId = nil
			Notify("TARGET", "Target lock cleared.", DANGER)
		else
			intelName.Text = State.Target.name .. " (@" .. State.Target.username .. ")"
			intelName.TextColor3 = TEXT_MAIN
			for _, md in ipairs(miniDashes) do
				md.name.Text = State.Target.name
				md.name.TextColor3 = ACCENT
			end

			if State.Target.kind == "PLAYER" and State.Target.player then
				local p = State.Target.player
				Internal.TargetUserId = p.UserId

				-- Load Avatar Thumbnail
				task.spawn(function()
					local ok, img = pcall(function()
						return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
					end)
					if ok and img then
						intelAvatar.Image = img
						for _, md in ipairs(miniDashes) do md.avatar.Image = img end
					end
				end)

				-- Calculate Join Date & Age
				intelJoinDate.Text = "📅 Joined: " .. CocaEngine.Troll.GetJoinDate(p)
				intelAge.Text = "⏳ Age: " .. tostring(p.AccountAge or 0) .. " Days Old"

				-- Compute Server & Mutual Friends
				task.spawn(function()
					local sFriends, mFriends = CocaEngine.Troll.GetFriendsData(p)
					intelFriends.Text = "👥 Server: " .. tostring(sFriends) .. " | 🤝 Mutual: " .. tostring(mFriends)
				end)

				-- Compute Outfit Value
				task.spawn(function()
					if p.Character then
						local val = CocaEngine.Troll.GetOutfitValue(p.Character)
						intelOutfit.Text = "💎 Outfit Value: ~" .. tostring(val) .. " R$"
					end
				end)

				if p.Character then CocaEngine.UpdateESP(p.Character) end
			else
				Internal.TargetUserId = nil
				intelAvatar.Image = ""
				intelJoinDate.Text = "📅 Joined: NPC"
				intelAge.Text = "⏳ Age: N/A"
				intelOutfit.Text = "💎 Outfit: N/A"
			end
			Notify("TARGET", "Locked onto " .. State.Target.name, SUCCESS)
		end

		-- Highlight selected card in list
		for _, data in ipairs(targetButtonData) do
			local isMatch = false
			if State.Target and State.Target.player == data.targetData.player then
				isMatch = true
			end
			local stroke = data.btn:FindFirstChildOfClass("UIStroke")
			if isMatch then
				data.btn.BackgroundColor3 = Color3.fromRGB(40, 70, 45)
				data.btn.TextColor3 = SUCCESS
				if stroke then stroke.Color = SUCCESS end
			else
				data.btn.BackgroundColor3 = BG_ELEMENT
				data.btn.TextColor3 = TEXT_MAIN
				if stroke then stroke.Color = Color3.fromRGB(45, 45, 55) end
			end
		end
