					if myRoot and tr and tr.Parent then
						local side = State.Anim.Side or "Right"
						local d = State.Anim.Distance or 3.0
						local off = Vector3.new(d, 0, 0)
						if side == "Left" then off = Vector3.new(-d, 0, 0)
						elseif side == "Front" then off = Vector3.new(0, 0, -d)
						elseif side == "Back" then off = Vector3.new(0, 0, d) end
						myRoot.CFrame = tr.CFrame * CFrame.new(off)
						myRoot.AssemblyLinearVelocity = tr.AssemblyLinearVelocity
					end
				end)
