-- 1. Account Join Date Calculator
function Troll.GetJoinDate(player)
	if not player or not player.AccountAge then return "N/A" end
	local createTimestamp = os.time() - (player.AccountAge * 86400)
	local d = os.date("!*t", createTimestamp)
	return string.format("%02d/%02d/%04d", d.day, d.month, d.year)
end

-- 2. Outfit Value Robux Evaluator (with Cache)
function Troll.GetOutfitValue(character)
	if not character then return 0 end
	local totalRobux = 0
	local scannedAccessories = 0

	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Accessory") then
			scannedAccessories = scannedAccessories + 1
			local handle = item:FindFirstChild("Handle")
			local assetId = nil
			if handle then
				local mesh = handle:FindFirstChildOfClass("SpecialMesh")
				if mesh and mesh.MeshId ~= "" then
					assetId = tonumber(mesh.MeshId:match("%d+"))
				end
			end

			if assetId then
				if State.Troll.OutfitCache[assetId] ~= nil then
					totalRobux = totalRobux + State.Troll.OutfitCache[assetId]
				else
					local ok, info = pcall(function()
						return MarketplaceService:GetProductInfo(assetId, Enum.InfoType.Asset)
					end)
					if ok and info and info.PriceInRobux then
						State.Troll.OutfitCache[assetId] = info.PriceInRobux
						totalRobux = totalRobux + info.PriceInRobux
					else
						-- Estimated typical accessory tier fallback (50-250 R$)
						local est = 100
						State.Troll.OutfitCache[assetId] = est
						totalRobux = totalRobux + est
					end
				end
			else
				totalRobux = totalRobux + 75
			end
		end
	end
	return totalRobux
end

-- 3. Server Friends & Mutual Friends Counter
function Troll.GetFriendsData(targetPlayer)
	if not targetPlayer then return 0, 0 end
	local serverFriends = 0
	local mutualFriends = 0
	local targetId = targetPlayer.UserId
	local localId = LP.UserId

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= targetPlayer and p ~= LP then
			local ok1, isTargetFriend = pcall(function() return targetPlayer:IsFriendsWith(p.UserId) end)
			if ok1 and isTargetFriend then
				serverFriends = serverFriends + 1
				local ok2, isLocalFriend = pcall(function() return LP:IsFriendsWith(p.UserId) end)
				if ok2 and isLocalFriend then
					mutualFriends = mutualFriends + 1
				end
			end
		end
	end

	-- Also check if target is friends with LocalPlayer directly
	local ok, directFriend = pcall(function() return targetPlayer:IsFriendsWith(localId) end)
	if ok and directFriend then
		serverFriends = serverFriends + 1
	end

	return serverFriends, mutualFriends
end

-- 4. Range Teleport Solver
function Troll.TeleportInRange(targetPlayer, distance, mode)
	if not targetPlayer or not targetPlayer.Character then
		Notify("TROLL", "No target character found!", DANGER)
		return
	end
	local tRoot = root(targetPlayer.Character)
	local myChar = LP.Character
	local myRoot = myChar and root(myChar)
	if not tRoot or not myRoot then return end

	distance = distance or 3.0
	mode = mode or "Behind"

	local offset = Vector3.new(0, 0, distance)
	if mode == "Behind" then
		offset = Vector3.new(0, 0, distance)
	elseif mode == "In Front" then
		offset = Vector3.new(0, 0, -distance)
	elseif mode == "Right" then
		offset = Vector3.new(distance, 0, 0)
	elseif mode == "Left" then
		offset = Vector3.new(-distance, 0, 0)
	elseif mode == "Above" then
		offset = Vector3.new(0, distance + 2, 0)
	elseif mode == "Below" then
		offset = Vector3.new(0, -distance, 0)
	end

	myRoot.CFrame = tRoot.CFrame * CFrame.new(offset)
	myRoot.AssemblyLinearVelocity = tRoot.AssemblyLinearVelocity
	myRoot.AssemblyAngularVelocity = Vector3.zero
	Notify("TROLL", "Teleported to " .. targetPlayer.Name .. " (" .. mode .. " " .. distance .. "s)", SUCCESS)
end

-- 5. Fuzzy Autocatch Matcher
function Troll.FuzzyCatch(text)
	text = string.lower(text or "")
	if text == "" then return nil end

	-- 1st pass: Exact username or display name match
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if string.lower(p.Name) == text or string.lower(p.DisplayName) == text then
				return p
			end
		end
	end

	-- 2nd pass: Prefix match
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if string.lower(p.Name):sub(1, #text) == text or string.lower(p.DisplayName):sub(1, #text) == text then
				return p
			end
		end
	end

	-- 3rd pass: Substring match
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			if string.lower(p.Name):find(text, 1, true) or string.lower(p.DisplayName):find(text, 1, true) then
				return p
			end
		end
	end
	return nil
end

