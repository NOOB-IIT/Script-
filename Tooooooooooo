-- 12. ZERO-DELAY PRECISION WELD & INTERACTION ENGINE
--============================================================
function CocaEngine.WeldTo(TPart, AnimId, customOffset)
	local char = LP.Character
	if not char then return nil end
	local myRoot = root(char)
	local myHum  = hum(char)
	if not myRoot or not myHum then return nil end

	StateManager:StopAllAnimations()

	-- Play requested animation if specified
	if AnimId and AnimId ~= 0 then
		local animator = getAnimator(char)
		if animator then
			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://" .. tostring(AnimId)
			local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
			if ok and track then
				pcall(function()
					track:AdjustSpeed(State.Moves.Speed / 40)
					track:Play()
				end)
				table.insert(StateManager.ActiveTracks, track)
			end
		end
	end

	-- Massless & NoCollide
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.Massless = true
		end
	end

	local off = customOffset or CFrame.new(State.Moves.X, State.Moves.Y, State.Moves.Z)
		* CFrame.Angles(math.rad(State.Moves.RX), math.rad(State.Moves.RY), math.rad(State.Moves.RZ))

	myRoot.CFrame = TPart.CFrame * off
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero

	local WeldObj = {}
	local conn = nil

	conn = RunService.Heartbeat:Connect(function()
		if not char.Parent or not TPart.Parent then
			if WeldObj.Destroy then WeldObj:Destroy() end
			return
		end
		local currentOff = customOffset or CFrame.new(State.Moves.X, State.Moves.Y, State.Moves.Z)
			* CFrame.Angles(math.rad(State.Moves.RX), math.rad(State.Moves.RY), math.rad(State.Moves.RZ))
		myRoot.CFrame = TPart.CFrame * currentOff
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
	end)

	function WeldObj:Destroy()
		if conn then conn:Disconnect(); conn = nil end
	end

	StateManager.CurrentWeld = WeldObj
	StateManager.WeldConn = conn
	return WeldObj
end

-- Procedural Arm Raising Engine for Hug & Kiss
function CocaEngine.StartProceduralArms(isKiss)
	StateManager:ResetProceduralMotors()
	local char = LP.Character
	if not char then return end
	local rig = CocaEngine.GetRig(char)

	if rig == "R6" then
		local torso = char:FindFirstChild("Torso")
		if not torso then return end
		local ls = torso:FindFirstChild("Left Shoulder")
		local rs = torso:FindFirstChild("Right Shoulder")
		if ls and rs then
			if not ls:GetAttribute("OrigC0") then ls:SetAttribute("OrigC0", ls.C0) end
			if not rs:GetAttribute("OrigC0") then rs:SetAttribute("OrigC0", rs.C0) end

			local t = 0
			StateManager.ProceduralConn = RunService.RenderStepped:Connect(function(dt)
				t = t + dt * 4
				local angleX = math.rad(85 + math.sin(t) * 3)
				local angleZ = math.rad(15 + math.cos(t) * 2)

				ls.C0 = ls:GetAttribute("OrigC0") * CFrame.Angles(angleX, 0, -angleZ)
				rs.C0 = rs:GetAttribute("OrigC0") * CFrame.Angles(angleX, 0, angleZ)
			end)
		end
	elseif rig == "R15" then
		local ut = char:FindFirstChild("UpperTorso")
		if not ut then return end
		local ls = ut:FindFirstChild("LeftShoulder")
		local rs = ut:FindFirstChild("RightShoulder")
		if ls and rs then
			if not ls:GetAttribute("OrigC0") then ls:SetAttribute("OrigC0", ls.C0) end
			if not rs:GetAttribute("OrigC0") then rs:SetAttribute("OrigC0", rs.C0) end

			local t = 0
			StateManager.ProceduralConn = RunService.RenderStepped:Connect(function(dt)
				t = t + dt * 4
				local angleX = math.rad(80 + math.sin(t) * 3)
				local angleZ = math.rad(15 + math.cos(t) * 2)

				ls.C0 = ls:GetAttribute("OrigC0") * CFrame.Angles(angleX, 0, -angleZ)
				rs.C0 = rs:GetAttribute("OrigC0") * CFrame.Angles(angleX, 0, angleZ)
			end)
		end
	end
end

-- Procedural Jerk Engine (High-Speed Right Shoulder Oscillation)
function CocaEngine.StartProceduralJerk(isTargetMode)
	StateManager:ResetProceduralMotors()
	local char = LP.Character
	if not char then return end
	local rig = CocaEngine.GetRig(char)
	local shoulder = nil

	if rig == "R6" then
		local torso = char:FindFirstChild("Torso")
		shoulder = torso and torso:FindFirstChild("Right Shoulder")
	else
		local ut = char:FindFirstChild("UpperTorso")
		shoulder = ut and ut:FindFirstChild("RightShoulder")
	end

	if not shoulder then return end
	if not shoulder:GetAttribute("OrigC0") then
		shoulder:SetAttribute("OrigC0", shoulder.C0)
	end

	local t = 0
	StateManager.ProceduralConn = RunService.RenderStepped:Connect(function(dt)
		t = t + dt * (State.Moves.Speed or 40)
		local osc = math.sin(t) * math.rad(25)
		local forwardAngle = math.rad(55) + osc
		shoulder.C0 = shoulder:GetAttribute("OrigC0") * CFrame.Angles(forwardAngle, 0, math.rad(-15))
	end)
end

