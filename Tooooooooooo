function CocaEngine.CreateCyclicStepper(parent, labelText, optionsArray, stateTable, stateKey)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 38)
	row.BackgroundColor3 = BG_ELEMENT
	row.Parent = parent
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
	local rStroke = Instance.new("UIStroke", row)
	rStroke.Color = Color3.fromRGB(45, 45, 55)

	local lbl = Instance.new("TextLabel")
	lbl.BackgroundTransparency = 1
	lbl.Text = "  " .. labelText
	lbl.TextSize = 12
	lbl.TextColor3 = TEXT_SUB
	lbl.Font = Enum.Font.GothamBold
	lbl.Size = UDim2.new(0.5, 0, 1, 0)
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local valBtn = Instance.new("TextButton")
	valBtn.BackgroundTransparency = 1
	valBtn.Text = tostring(stateTable[stateKey]) .. " ⟳"
	valBtn.TextSize = 12
	valBtn.TextColor3 = ACCENT
	valBtn.Font = Enum.Font.GothamBlack
	valBtn.Size = UDim2.new(0.5, -10, 1, 0)
	valBtn.Position = UDim2.new(0.5, 0, 0, 0)
	valBtn.TextXAlignment = Enum.TextXAlignment.Right
	valBtn.Parent = row

	local function getIndex()
		for i, v in ipairs(optionsArray) do
			if v == stateTable[stateKey] then return i end
		end
		return 1
	end

	valBtn.Activated:Connect(function()
		CocaEngine.PlaySound(CocaEngine.SOUNDS.Click, 0.3, 1.1)
		local idx = getIndex() + 1
		if idx > #optionsArray then idx = 1 end
		stateTable[stateKey] = optionsArray[idx]
		valBtn.Text = tostring(stateTable[stateKey]) .. " ⟳"
		CocaEngine.Tween(rStroke, {Color = GRAD_2}, 0.1)
		task.delay(0.15, function()
			CocaEngine.Tween(rStroke, {Color = Color3.fromRGB(45, 45, 55)}, 0.2)
		end)
	end)
	return row
end
