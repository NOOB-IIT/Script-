-- 25. COMPREHENSIVE KINEMATICS & MATRIX TRANSFORMATION SOLVER
--============================================================
do
	local Kinematics = {}
	CocaEngine.Kinematics = Kinematics

	-- Spherical Linear Interpolation (SLERP) for Quaternions
	function Kinematics.Slerp(cf0, cf1, t)
		return cf0:Lerp(cf1, t)
	end

	-- Orthonormal Basis Vector Normalization
	function Kinematics.Orthonormalize(cf)
		local right = cf.RightVector.Unit
		local up = cf.UpVector.Unit
		local look = -cf.LookVector.Unit
		return CFrame.fromMatrix(cf.Position, right, up, look)
	end

	-- Two-Bone Analytical Inverse Kinematics (IK) for Procedural Limbs
	function Kinematics.SolveTwoBoneIK(origin, target, length1, length2)
		local offset = target - origin
		local dist = offset.Magnitude
		if dist > (length1 + length2) then
			-- Fully extended
			local dir = offset.Unit
			return CFrame.new(origin, origin + dir), CFrame.new(origin + dir * length1, origin + dir * (length1 + length2))
		end

		local cosAngle1 = (dist^2 + length1^2 - length2^2) / (2 * dist * length1)
		local angle1 = math.acos(math.clamp(cosAngle1, -1, 1))

		local cosAngle2 = (length1^2 + length2^2 - dist^2) / (2 * length1 * length2)
		local angle2 = math.pi - math.acos(math.clamp(cosAngle2, -1, 1))

		local cfOrigin = CFrame.new(origin, target) * CFrame.Angles(angle1, 0, 0)
		local jointPos = (cfOrigin * CFrame.new(0, 0, -length1)).Position
		local cfJoint = CFrame.new(jointPos, target) * CFrame.Angles(-angle2, 0, 0)

		return cfOrigin, cfJoint
	end

	-- Cubic Bezier Trajectory Calculator for Fling Arcs
	function Kinematics.CubicBezier(p0, p1, p2, p3, t)
		local u = 1 - t
		local tt = t * t
		local uu = u * u
		local uuu = uu * u
		local ttt = tt * t

		local p = uuu * p0
		p = p + 3 * uu * t * p1
		p = p + 3 * u * tt * p2
		p = p + ttt * p3
		return p
	end

	-- Harmonic Spring Damper Solver for Smooth Tracking
	function Kinematics.SpringDamper(currentPos, targetPos, currentVel, stiffness, damping, dt)
		local delta = targetPos - currentPos
		local force = delta * stiffness - currentVel * damping
		local nextVel = currentVel + force * dt
		local nextPos = currentPos + nextVel * dt
		return nextPos, nextVel
	end
end

