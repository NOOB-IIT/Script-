function StateManager:StopAllAnimations()
	local char = LP.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, trk in ipairs(animator:GetPlayingAnimationTracks()) do
			pcall(function() trk:Stop(0.05); trk:Destroy() end)
		end
	end
	for _, trk in ipairs(self.ActiveTracks) do
		pcall(function() trk:Stop(0.05); trk:Destroy() end)
	end
	self.ActiveTracks = {}
end

function StateManager:StopWeld()
	if self.WeldConn then self.WeldConn:Disconnect(); self.WeldConn = nil end
	if self.ThrustConn then self.ThrustConn:Disconnect(); self.ThrustConn = nil end
	if self.CurrentWeld then
		pcall(function()
			if typeof(self.CurrentWeld) == "table" and self.CurrentWeld.Destroy then
				self.CurrentWeld:Destroy()
			elseif typeof(self.CurrentWeld) == "Instance" then
				self.CurrentWeld:Destroy()
			end
		end)
		self.CurrentWeld = nil
	end
	State.Moves.Running = false
end

function StateManager:ResetProceduralMotors()
	if self.ProceduralConn then
		self.ProceduralConn:Disconnect()
		self.ProceduralConn = nil
	end
	local char = LP.Character
	if not char then return end
	local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	if torso then
		for _, m in ipairs(char:GetDescendants()) do
			if m:IsA("Motor6D") and m.Name:find("Shoulder") then
				pcall(function()
					m.Transform = CFrame.identity
					if m:GetAttribute("OrigC0") then
						m.C0 = m:GetAttribute("OrigC0")
					end
				end)
			end
		end
	end
end

function StateManager:StopUtilities()
	if self.TargetCamLockConn then self.TargetCamLockConn:Disconnect(); self.TargetCamLockConn = nil end
	if self.ReversePOVConn then self.ReversePOVConn:Disconnect(); self.ReversePOVConn = nil end
	if self.AutoLookAtConn then self.AutoLookAtConn:Disconnect(); self.AutoLookAtConn = nil end
	if self.GhostModeConn then self.GhostModeConn:Disconnect(); self.GhostModeConn = nil end
	if self.SpinAttackConn then self.SpinAttackConn:Disconnect(); self.SpinAttackConn = nil end
	if self.FakeFlingArcConn then self.FakeFlingArcConn:Disconnect(); self.FakeFlingArcConn = nil end
	if self.CopyVelocityConn then self.CopyVelocityConn:Disconnect(); self.CopyVelocityConn = nil end
	if self.DistanceKeeperConn then self.DistanceKeeperConn:Disconnect(); self.DistanceKeeperConn = nil end
	if self.NoclipConn then self.NoclipConn:Disconnect(); self.NoclipConn = nil end

	local char = LP.Character
	if char then
		local root = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if root then
			root.Anchored = false
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		if hum then
			hum.AutoRotate = true
			if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
		end
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = 0
			end
		end
	end

	local cam = workspace.CurrentCamera
	if cam and self.OriginalCameraSubject then
		pcall(function() cam.CameraSubject = self.OriginalCameraSubject end)
		self.OriginalCameraSubject = nil
	end
end

