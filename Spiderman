local animationTracks = {}         -- Store animation tracks for cleanup

local function addConnection(conn)
    table.insert(connections, conn)
    return conn
end

local function cleanup()
    -- Stop and destroy music
    if musicSound then
        musicSound:Stop()
        musicSound:Destroy()
        musicSound = nil
    end

    -- Disconnect all stored connections
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    connections = {}

    -- Stop animation tracks
    for _, track in pairs(animationTracks) do
        pcall(function() track:Stop() end)
    end
    animationTracks = {}

    -- Re-enable the original Animate script if it exists and we disabled it
    if originalAnimateScript then
        pcall(function()
            originalAnimateScript.Disabled = false
        end)
        originalAnimateScript = nil
    end

    -- Reset AutoAnimate attribute
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            pcall(function()
                humanoid:SetAttribute("AutoAnimate", true)
            end)
        end
        -- If noclip was on, restore collision
        if noclip then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = true
                end
            end
        end
    end

    -- Destroy web if exists
    if currentWeb then
        currentWeb:Destroy()
        currentWeb = nil
    end

    -- Destroy main GUI
    if mainGui then
        mainGui:Destroy()
        mainGui = nil
    end

    -- Reset states
    noclip = false
    autoPull = false
    webPhysics = false
    spiderMode = false
    targetPos = nil
end

