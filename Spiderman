-- Intro animation
local function playIntroAnimation(callback)
    local success = pcall(function()
        local introGui = Instance.new("ScreenGui")
        introGui.Name = "IntroGui"
        introGui.Parent = player.PlayerGui
        introGui.ResetOnSpawn = false
        introGui.ZIndex = 100

        local bg = Instance.new("Frame")
        bg.Name = "Background"
        bg.Parent = introGui
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.Position = UDim2.new(0, 0, 0, 0)
        bg.BackgroundColor3 = Color3.new(0, 0, 0)
        bg.BorderSizePixel = 0

        local text = Instance.new("TextLabel")
        text.Name = "IntroText"
        text.Parent = bg
        text.Size = UDim2.new(0, 400, 0, 100)
        text.Position = UDim2.new(0.5, -200, 0.5, -50)
        text.Text = "RED HUB"
        text.TextColor3 = Color3.new(1, 0, 0)
        text.BackgroundTransparency = 1
        text.Font = Enum.Font.GothamBlack
        text.TextSize = 60

        local glow = Instance.new("TextLabel")
        glow.Name = "Glow"
        glow.Parent = bg
        glow.Size = UDim2.new(0, 400, 0, 100)
        glow.Position = UDim2.new(0.5, -200, 0.5, -50)
        glow.Text = "RED HUB"
        glow.TextColor3 = Color3.new(1, 0.2, 0.2)
        glow.BackgroundTransparency = 1
        glow.Font = Enum.Font.GothamBlack
        glow.TextSize = 60
        glow.TextTransparency = 0.5

        local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local scaleTween = TweenService:Create(text, tweenInfo, { TextSize = 80 })
        local fadeTween = TweenService:Create(bg, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
        local textFade = TweenService:Create(text, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 1 })
        local glowFade = TweenService:Create(glow, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextTransparency = 1 })

        scaleTween:Play()
        task.wait(0.8)
        fadeTween:Play()
        textFade:Play()
        glowFade:Play()

        fadeTween.Completed:Connect(function()
            introGui:Destroy()
            if callback then callback() end
        end)

        -- Fallback
        task.delay(4, function()
            if introGui and introGui.Parent then
                introGui:Destroy()
                if callback then callback() end
            end
        end)
    end)

    if not success then
        if callback then callback() end
    end
end

