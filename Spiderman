-- Custom animation setup (with proper cleanup)
task.spawn(function()
    task.wait(1)
    local character = player.Character or player.CharacterAdded:Wait()
    -- Instead of destroying the Animate script, disable it and store reference
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("LocalScript") and child.Name == "Animate" then
            originalAnimateScript = child
            child.Disabled = true
            break
        end
    end
    local humanoid = character:WaitForChild("Humanoid")
    humanoid:SetAttribute("AutoAnimate", false)

    local animations = {
        idle = "rbxassetid://112472797825991",
        walk = "rbxassetid://136382802509224",
        jump = "rbxassetid://133675142555339"
    }
    local walkAnim = Instance.new("Animation")
    walkAnim.AnimationId = animations.walk
    local walkTrack = humanoid:LoadAnimation(walkAnim)
    local idleAnim = Instance.new("Animation")
    idleAnim.AnimationId = animations.idle
    local idleTrack = humanoid:LoadAnimation(idleAnim)
    local jumpAnim = Instance.new("Animation")
    jumpAnim.AnimationId = animations.jump
    local jumpTrack = humanoid:LoadAnimation(jumpAnim)

    -- Store tracks for cleanup
    animationTracks = {walkTrack, idleTrack, jumpTrack}

    walkTrack.Looped = true
    idleTrack.Looped = true
    jumpTrack.Looped = false
    walkTrack.Priority = Enum.AnimationPriority.Action
    idleTrack.Priority = Enum.AnimationPriority.Action
    jumpTrack.Priority = Enum.AnimationPriority.Action

    idleTrack:Play()
    local lastAnim = idleTrack
    local function switchAnimation(newAnim)
        if lastAnim == newAnim then return end
        lastAnim:Stop()
        newAnim:Play()
        lastAnim = newAnim
    end

    -- Heartbeat and StateChanged connections (stored for cleanup)
    addConnection(game:GetService("RunService").Heartbeat:Connect(function()
        if humanoid.Health <= 0 then return end
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Jumping then
            switchAnimation(jumpTrack)
        elseif state == Enum.HumanoidStateType.Landed or state == Enum.HumanoidStateType.Freefall then
            -- keep current
        else
            local speed = humanoid.MoveDirection.Magnitude
            if speed > 0.5 then
                if lastAnim ~= walkTrack then switchAnimation(walkTrack) end
            else
                if lastAnim ~= idleTrack then switchAnimation(idleTrack) end
            end
        end
    end))

    addConnection(humanoid.StateChanged:Connect(function(oldState, newState)
        if newState == Enum.HumanoidStateType.Jumping then
            switchAnimation(jumpTrack)
        elseif newState == Enum.HumanoidStateType.Landed then
            if humanoid.MoveDirection.Magnitude > 0.5 then
                switchAnimation(walkTrack)
            else
                switchAnimation(idleTrack)
            end
        end
    end))
end)
