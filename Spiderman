    local function isTouchingUI(pos)
        local descendants = screenGui:GetDescendants()
        for _, obj in ipairs(descendants) do
            if obj:IsA("GuiObject") and obj.AbsoluteSize.X > 0 then
                local absPos = obj.AbsolutePosition
                if pos.X >= absPos.X and pos.X <= absPos.X + obj.AbsoluteSize.X and
                   pos.Y >= absPos.Y and pos.Y <= absPos.Y + obj.AbsoluteSize.Y then
                    return true
                end
            end
        end
        return false
    end

