local Tabs = {}
local function CreateTab(name, layoutOrder)
    local TabBtn = Create("TextButton", {
        Parent = TabContainer,
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = Settings.Theme.DarkRed,
        Text = name,
        TextColor3 = Color3.fromRGB(200, 200, 200),
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        LayoutOrder = layoutOrder
    })
    Create("UICorner", {Parent = TabBtn, CornerRadius = UDim.new(0, 6)})
    
    local TabContent = Create("ScrollingFrame", {
        Parent = ContentContainer,
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundTransparency = 1,
        ScrollBarThickness = 4,
        Visible = false
    })
    
    Tabs[name] = {Button = TabBtn, Content = TabContent}
    
    TabBtn.MouseButton1Click:Connect(function()
        for tName, tabData in pairs(Tabs) do
            if tName == name then
                TweenService:Create(tabData.Button, TweenInfo.new(0.3), {BackgroundColor3 = Settings.Theme.MainRed, TextColor3 = Settings.Theme.TextWhite}):Play()
                tabData.Content.Visible = true
            else
                TweenService:Create(tabData.Button, TweenInfo.new(0.3), {BackgroundColor3 = Settings.Theme.DarkRed, TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
                tabData.Content.Visible = false
            end
        end
    end)
    
    return TabContent
end

