        TweenService:Create(MainCanvas, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {Size = UDim2.new(0, 500, 0, 40)}):Play()
        TabContainer.Visible = false
        ContentContainer.Visible = false
    else
        TweenService:Create(MainCanvas, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {Size = UDim2.new(0, 500, 0, 350)}):Play()
        task.wait(0.2)
        TabContainer.Visible = true
        ContentContainer.Visible = true
    end
end)

