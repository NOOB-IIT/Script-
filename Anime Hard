-- Forward declaration
local askNextQuestion

-- SMART WAIT FUNCTION 
local function smartWait(seconds)
	local elapsed = 0
	while elapsed < seconds do
		if not quizActive then return false end
		task.wait(0.2)
		elapsed += 0.2
	end
	return true
end

-- Leaderboard Display
local function showLeaderboard()
	quizActive = false
	optionsAllowed = false
	sendChatMessage("📊 --- ANIME HARD FINAL LEADERBOARD ---")
	task.wait(4)
	
	local sortedScores = {}
	for userId, score in pairs(playerScores) do
		table.insert(sortedScores, {name = playerNames[userId] or "Unknown", score = score})
	end
	
	table.sort(sortedScores, function(a, b) return a.score > b.score end)
	
	if #sortedScores == 0 then
		sendChatMessage("Nobody scored any points! 😢")
	else
		for rank, data in ipairs(sortedScores) do
			sendChatMessage("🏅 Rank " .. rank .. ": " .. data.name .. " - " .. data.score .. " Pts")
			task.wait(3)
		end
	end
	
	task.wait(4)
	sendChatMessage("📢 Quiz finished! All rights reserved to NOT_IITIAN! 🛡️⭐")
end

-- Trigger Win Function
local function triggerWin(player)
	isProcessingAnswer = true
	quizActive = false
	optionsAllowed = false
	
	playerScores[player.UserId] = (playerScores[player.UserId] or 0) + 10
	playerNames[player.UserId] = player.DisplayName 
	
	sendChatMessage("🎉 " .. player.DisplayName .. " Correct answer! (+10 Pts) 🎉")
	currentQuestionIndex += 1
	
	task.wait(2)
	
	if currentQuestionIndex > #quizDatabase then 
		task.spawn(showLeaderboard)
	else
		isProcessingAnswer = false
		task.spawn(askNextQuestion)
	end
end

-- Core Answer Verification Logic
local function onPlayerChatted(player, message)
	if not quizActive or isProcessingAnswer then return end
	
	-- Blacklist check
	local playerNameUpper = string.upper(player.Name)
	local playerDisplayNameUpper = string.upper(player.DisplayName)
	if blacklistedPlayers[playerNameUpper] or blacklistedPlayers[playerDisplayNameUpper] then
		return
	end
	
	local rawTrimmed = string.match(message, "^%s*(.-)%s*$")
	local upperMsg = string.upper(rawTrimmed)
	local cleanMsg = string.gsub(upperMsg, "[^%w]", "")
	
	-- Check if input is an Option (A, B, C, D)
	local matchedLetter = string.match(upperMsg, "^([A-D])$") or string.match(upperMsg, "^([A-D])[%-%._%)%:]+$")
	
	if matchedLetter then
		-- OPTIONS CHECK: Allowed immediately after reading time completes
		if not optionsAllowed then return end
		
		if hasGuessedOption[player.UserId] then 
			return -- Already used option attempt for this question, ignore
		end
		
		hasGuessedOption[player.UserId] = true 
		
		if matchedLetter == correctAnswer then
			triggerWin(player)
		else
			return
		end
	else
		-- DIRECT WORD CHECK: Allowed INSTANTLY (Unlimited tries)
		if cleanMsg == currentWordAnswer then
			triggerWin(player)
		else
			return
		end
	end
end

-- SAFE CHAT LISTENER
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
	TextChatService.MessageReceived:Connect(function(t) 
		if t.TextSource then
			local p = Players:GetPlayerByUserId(t.TextSource.UserId) 
			if p then onPlayerChatted(p, t.Text) end 
		end
	end)
else
	local function hookPlayer(p)
		p.Chatted:Connect(function(m)
			onPlayerChatted(p, m)
		end)
	end

	Players.PlayerAdded:Connect(hookPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		hookPlayer(p)
	end
end

function askNextQuestion()
	if currentQuestionIndex > #quizDatabase then
		showLeaderboard()
		return
	end

	local currentQuiz = quizDatabase[currentQuestionIndex]
	correctAnswer = string.upper(string.gsub(currentQuiz.Answer, "[^%w]", ""))
	currentWordAnswer = string.upper(string.gsub(currentQuiz.WordAnswer, "[^%w]", ""))
	
	questionSession += 1
	local currentSession = questionSession
	
	hasGuessedOption = {} 
	quizActive = true
	optionsAllowed = false 
	isProcessingAnswer = false
	
	-- 1. Direct Word open message comes FIRST (Above the question)
	sendChatMessage("💡 Direct Word Guessing is OPEN NOW! (Unlimited Tries)")
	
	-- 2. 3 seconds gap between Direct Answer notice and Question
	if not smartWait(3) then return end 
	if not quizActive or questionSession ~= currentSession then return end
	
	-- 3. Question comes AFTER
	sendChatMessage(currentQuiz.Question)
	
	-- 4. Question Reading Time: 14 seconds
	if not smartWait(14) then return end 
	if not quizActive or questionSession ~= currentSession then return end
	
	-- 5. Reading time ends -> Instantly open option acceptance (no extra line text)
	optionsAllowed = true
	
	-- 6. Print options one by one with a 2-second gap between each option
	for _, opt in ipairs(currentQuiz.Options) do 
		sendChatMessage(opt)
		if not smartWait(2) then return end 
		if not quizActive or questionSession ~= currentSession then return end
	end
	
	if not smartWait(12) then return end 
	
	if quizActive and questionSession == currentSession then
		quizActive = false
		optionsAllowed = false
		sendChatMessage("⏳ Time's up! Correct answer was: " .. correctAnswer .. " (" .. currentWordAnswer .. ")")
		currentQuestionIndex += 1
		
		task.wait(3)
		
		if currentQuestionIndex <= #quizDatabase then 
			task.spawn(askNextQuestion) 
		else
			task.spawn(showLeaderboard) 
		end
	end
end

