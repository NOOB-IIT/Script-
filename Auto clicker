        settingsData.ScriptActive = false
        Rayfield:Destroy()
    end
end)

-- Zero-Lag Hyper-Optimized Click Loop (Optimized local caching to prevent micro-stutters)
local lastClickTick = 0
RunService.RenderStepped:Connect(function()
    if not settingsData.ScriptActive or not settingsData.Running then return end
    
    local currentTime = tick()
    local currentDelay = GetTotalDelay()
    
    if currentTime - lastClickTick >= currentDelay then
        lastClickTick = currentTime
        local mouseLocation = UserInputService:GetMouseLocation()
        VirtualInputManager:SendMouseButtonEvent(mouseLocation.X, mouseLocation.Y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(mouseLocation.X, mouseLocation.Y, 0, false, game, 1)
    end
end)

