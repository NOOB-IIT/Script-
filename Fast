local function RenderFriendsActivity()
    if FriendsEngine.IsLoading then return end
    FriendsEngine.IsLoading = true

    local ok, friends = pcall(function()
        if LocalPlayer.GetFriendsOnlineAsync then
            return LocalPlayer:GetFriendsOnlineAsync(200)
        else
            return LocalPlayer:GetFriendsOnline(200)
        end
    end)

    if not ok or not friends then
        FriendsEngine.IsLoading = false
        return
    end

    table.sort(friends, function(a, b)
        local aP, bP = getPlaceId(a), getPlaceId(b)
        local aU, bU = getUniverseId(a, aP), getUniverseId(b, bP)
        local aS = isSameExperience(a, aP, aU)
        local bS = isSameExperience(b, bP, bU)
        if aS and not bS then return true end
        if bS and not aS then return false end
        return (a.UserName or a.Name or "") < (b.UserName or b.Name or "")
    end)

    for _, child in ipairs(actScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    if #friends == 0 then
        local emptyCard = Instance.new("Frame")
        emptyCard.Size = UDim2.new(0, 580, 0, 160)
        emptyCard.BackgroundColor3 = Color3.fromRGB(15, 12, 19)
        emptyCard.BorderSizePixel = 0
        emptyCard.Parent = actScroll
        RedUI.Corner(emptyCard, 14)
        RedUI.Stroke(emptyCard, RedTheme.Get("CardStroke"), 1.2)

        RedUI.CreateRedRBadge(emptyCard, UDim2.new(0, 48, 0, 48), UDim2.new(0.5, -24, 0, 20))
        RedUI.Label(emptyCard, "NO FRIENDS CURRENTLY ACTIVE", UDim2.new(1, 0, 0, 22), UDim2.new(0, 0, 0, 80), Enum.Font.GothamBlack, 13, RedTheme.Get("Accent"), Enum.TextXAlignment.Center)
        RedUI.Label(emptyCard, "None of your mutual Roblox friends are online in a game right now.", UDim2.new(1, 0, 0, 18), UDim2.new(0, 0, 0, 106), Enum.Font.GothamMedium, 10, RedTheme.Get("TextSecondary"), Enum.TextXAlignment.Center)
        FriendsEngine.IsLoading = false
        return
    end

    for _, friend in ipairs(friends) do
        local userId      = friend.VisitorId or friend.UserId or friend.Id
        local userName    = friend.UserName or friend.userName or friend.Name or "Unknown"
        local displayName = friend.DisplayName or friend.displayName or userName
        local placeId     = getPlaceId(friend)
        local universeId  = getUniverseId(friend, placeId)
        local gameName    = getGameName(friend, placeId, universeId) or "In Game Experience"
        local sameExp     = isSameExperience(friend, placeId, universeId)
        local statusText, statusColor, statusIcon = getStatus(friend, placeId)

        -- Wide Card matching screenshot (270px width x 165px height)
        local card = Instance.new("Frame")
        card.Size = UDim2.new(0, 275, 0, 165)
        card.BackgroundColor3 = Color3.fromRGB(16, 13, 20)
        card.BorderSizePixel = 0
        card.ClipsDescendants = true
        card.Parent = actScroll
        RedUI.Corner(card, 14)
        RedUI.Stroke(card, sameExp and RedTheme.Get("Accent") or RedTheme.Get("CardStroke"), 1.4)

        -- Experience Thumbnail Background
        local bgThumb = Instance.new("ImageLabel")
        bgThumb.Size = UDim2.new(1, 0, 1, 0)
        bgThumb.Position = UDim2.new(0, 0, 0, 0)
        bgThumb.BackgroundColor3 = Color3.fromRGB(24, 20, 28)
        bgThumb.BorderSizePixel = 0
        bgThumb.ScaleType = Enum.ScaleType.Crop
        bgThumb.Parent = card
        RedUI.Corner(bgThumb, 14)

        applyThumbnail(bgThumb, universeId, placeId)

        -- Fallback Red R Logo for invisible or missing thumbnail
        if (not placeId or placeId == 0) or statusText == "Invisible" then
            bgThumb.Image = ""
            RedUI.CreateRedRBadge(bgThumb, UDim2.new(0, 54, 0, 54), UDim2.new(0.5, -27, 0.4, -27))
        end

        -- Voice Chat Mic Bubble Icon on top
        local micFrame = Instance.new("Frame")
        micFrame.Size = UDim2.new(0, 28, 0, 28)
        micFrame.Position = UDim2.new(0.5, -14, 0, 8)
        micFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        micFrame.BorderSizePixel = 0
        micFrame.Parent = card
        RedUI.Corner(micFrame, 14)

        local micIcon = Instance.new("ImageLabel")
        micIcon.Size = UDim2.new(0, 18, 0, 18)
        micIcon.Position = UDim2.new(0.5, -9, 0.5, -9)
        micIcon.Image = "rbxassetid://9069608974"
        micIcon.ImageColor3 = Color3.fromRGB(0, 200, 100)
        micIcon.BackgroundTransparency = 1
        micIcon.Parent = micFrame

        -- Bottom Glassmorphic Overlay Bar (matching screenshot)
        local botBar = Instance.new("Frame")
        botBar.Size = UDim2.new(1, 0, 0, 48)
        botBar.Position = UDim2.new(0, 0, 1, -48)
        botBar.BackgroundColor3 = Color3.fromRGB(12, 10, 15)
        botBar.BackgroundTransparency = 0.15
        botBar.BorderSizePixel = 0
        botBar.Parent = card

        -- Avatar Headshot on Left
        local avImg = Instance.new("ImageLabel")
        avImg.Size = UDim2.new(0, 34, 0, 34)
        avImg.Position = UDim2.new(0, 8, 0.5, -17)
        avImg.Image = userId and string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=100&h=100", userId) or "rbxassetid://0"
        avImg.BackgroundColor3 = Color3.fromRGB(20, 16, 24)
        avImg.BorderSizePixel = 0
        avImg.Parent = botBar
        RedUI.Corner(avImg, 17)
        RedUI.Stroke(avImg, RedTheme.Get("Accent"), 1.2)

        -- Game Name + Speaker Icon
