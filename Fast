local function toNum(v)
    if not v then return nil end
    if type(v) == "number" and v > 0 then return v end
    local n = tonumber(tostring(v))
    if n and n > 0 then return n end
    return nil
end

local function getPlaceId(friend)
    local pid = toNum(friend.PlaceId or friend.placeId)
    if pid then return pid end
    local url = friend.LastLocation or friend.lastLocation
    if url and type(url) == "string" then
        local id = string.match(url, "/games/(%d+)")
        if id then return tonumber(id) end
    end
    return nil
end

local function getUniverseId(friend, placeId)
    local gid = toNum(friend.GameId or friend.gameId)
    if gid then return gid end
    if placeId then
        if FriendsEngine.UniverseCache[placeId] ~= nil then
            return FriendsEngine.UniverseCache[placeId] or nil
        end
        local ok, response = pcall(function()
            return game:HttpGet("https://apis.roblox.com/universes/v1/places/" .. tostring(placeId) .. "/universe")
        end)
        if ok and response and type(response) == "string" then
            local ok2, data = pcall(function()
                return HttpService:JSONDecode(response)
            end)
            if ok2 and data and data.universeId then
                FriendsEngine.UniverseCache[placeId] = tonumber(data.universeId)
                return tonumber(data.universeId)
            end
        end
        FriendsEngine.UniverseCache[placeId] = false
    end
    return nil
end

local function getGameName(friend, placeId, universeId)
    if placeId and FriendsEngine.GameNameCache[placeId] ~= nil then
        local cached = FriendsEngine.GameNameCache[placeId]
        if cached then return cached end
    end
    local name = friend.GameName or friend.Location or friend.PlaceName
    if name and type(name) == "string" and name ~= ""
       and name ~= "Website" and name ~= "Online" and name ~= "Offline"
       and name ~= "In Game" then
        if placeId then FriendsEngine.GameNameCache[placeId] = name end
        return name
    end
    local ll = friend.LastLocation or friend.lastLocation
    if ll and type(ll) == "string" and ll ~= ""
       and ll ~= "Website" and ll ~= "Online" and ll ~= "Offline"
       and ll ~= "In Game" then
        local slug = string.match(ll, "/games/%d+/([^/?]+)")
        if slug then
            local parsed = (slug:gsub("%%20", " "):gsub("%-", " "))
            if placeId then FriendsEngine.GameNameCache[placeId] = parsed end
            return parsed
        end
        if not string.find(ll, "://") then
            if placeId then FriendsEngine.GameNameCache[placeId] = ll end
            return ll
        end
    end
    if universeId then
        local ok, response = pcall(function()
            return game:HttpGet("https://games.roblox.com/v1/games?universeIds=" .. tostring(universeId))
        end)
        if ok and response and type(response) == "string" then
            local ok2, data = pcall(function()
                return HttpService:JSONDecode(response)
            end)
            if ok2 and data and data.data and data.data[1] and data.data[1].name then
                local realName = data.data[1].name
                if placeId then FriendsEngine.GameNameCache[placeId] = realName end
                return realName
            end
        end
    end
    if placeId then
        local ok, info = pcall(function()
            return MarketplaceService:GetProductInfo(placeId)
        end)
        if ok and info and info.Name and info.Name ~= "" then
            FriendsEngine.GameNameCache[placeId] = info.Name
            return info.Name
        end
    end
    if placeId then FriendsEngine.GameNameCache[placeId] = false end
    return nil
end

local function getStatus(friend, placeId)
    if placeId and placeId > 0 then
        return "In Game", Color3.fromRGB(80, 220, 140), "GAME"
    end
    local lt = friend.LocationType or friend.locationType
    local ll = friend.LastLocation or friend.lastLocation
    if lt == 2 then return "In Game", Color3.fromRGB(80, 220, 140), "GAME" end
    if lt == 3 or ll == "Studio" then return "In Studio", Color3.fromRGB(120, 160, 255), "STUDIO" end
    if lt == 1 or ll == "Website" then return "On Website", Color3.fromRGB(160, 160, 170), "WEB" end
    if lt == 4 then return "Invisible", Color3.fromRGB(130, 130, 140), "INVIS" end
    return "In Game", Color3.fromRGB(80, 220, 140), "GAME"
end

