-- 1. FPS Tracker
task.spawn(function()
    local frameCount = 0
    local lastCheck = tick()
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastCheck >= 0.5 then
            RedTelemetry.FPS = math.floor(frameCount / (now - lastCheck))
            frameCount = 0
            lastCheck = now
            if fpsLbl and fpsLbl.Parent then fpsLbl.Text = tostring(RedTelemetry.FPS) .. " FPS" end
            if topFpsLbl and topFpsLbl.Parent then topFpsLbl.Text = "FPS: " .. tostring(RedTelemetry.FPS) end
        end
    end)
end)

-- 2. Ping Tracker
task.spawn(function()
    while MainGui and MainGui.Parent do
        pcall(function()
            local pingVal = 0
            if game:GetService("Stats").Network.ServerStatsItem:FindFirstChild("Data Ping") then
                pingVal = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
            end
            RedTelemetry.Ping = pingVal
            if pingLbl and pingLbl.Parent then pingLbl.Text = tostring(pingVal) .. " MS" end
            if topPingLbl and topPingLbl.Parent then topPingLbl.Text = "Ping: " .. tostring(pingVal) .. "ms" end
        end)
        task.wait(1)
    end
end)

-- 3. Live Physics (Character World Position & Speed)
task.spawn(function()
    while MainGui and MainGui.Parent do
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    RedTelemetry.CharPosition = hrp.Position
                    RedTelemetry.CharVelocity = hrp.AssemblyLinearVelocity or hrp.Velocity or Vector3.new(0, 0, 0)
                end
            end
        end)
        task.wait(0.1)
    end
end)

