                if placeId and placeId > 0 then
                    local rawGameId = friend.GameId or friend.gameId
                    if rawGameId and tostring(rawGameId) ~= "" then
                        TeleportService:TeleportToPlaceInstance(placeId, tostring(rawGameId), LocalPlayer)
                    else
                        TeleportService:Teleport(placeId, LocalPlayer)
                    end
                end
            end)
        end)
        RedUI.Corner(joinBtn, 8)
