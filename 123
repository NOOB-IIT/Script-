local function runPreset(x, y, z, rx, ry, rz, animId)
    if not selectedPlayer then notify("RED HUB","Select player"); sError(); return end
    stopEverything()
    pcall(function()
        SlX.set(x, false); SlY.set(y, false); SlZ.set(z, false)
        SlRX.set(rx, false); SlRY.set(ry, false); SlRZ.set(rz, false)
    end)
    V.X, V.Y, V.Z = x, y, z; V.RX, V.RY, V.RZ = rx, ry, rz
    CurrentTarget = selectedPlayer
    local tc = selectedPlayer.Character
    if not tc then return end
    local th = tc:FindFirstChildOfClass("Humanoid")
    local tr = ((th and th.RigType == Enum.HumanoidRigType.R15)
        and tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart"))
    if not tr then return end
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    storeWeldInfo(selectedPlayer, animId, false, "weld")
    hookTargetRespawn(selectedPlayer)
    local ok, w = pcall(function() return WeldTo(tr, animId, false) end)
    if ok and w then
        CurrentWeld = w; sSuccess(); screenFlash(T.Accent); burst(main, T.Accent, 12)
        notify("RED HUB", "Preset → " .. selectedPlayer.Name)
    end
end

local function runBang(animId, speed, rangeOverride)
    if not selectedPlayer or not selectedPlayer.Character then
        notify("RED HUB","Select player"); return
    end
    stopEverything()
    CurrentTarget = selectedPlayer
    local tc = selectedPlayer.Character
    local th = tc:FindFirstChildOfClass("Humanoid")
    local tr = ((th and th.RigType == Enum.HumanoidRigType.R15)
        and tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart"))
    if not tr then return end
    local touchZ = (getTorsoDepth(LP.Character) + getTorsoDepth(tc)) / 2 + 0.15
    V.X = 0; V.Y = 0; V.Z = touchZ
    V.RX, V.RY, V.RZ = 0, 0, 0
    ThrustTouchZ = touchZ; ThrustDirection = 1
    if rangeOverride then
        ThrustRange = rangeOverride
        pcall(function() if UIRefs.SlThrustDist then UIRefs.SlThrustDist.set(rangeOverride, true) end end)
    end
    if speed then ThrustSpeed = speed end
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    storeWeldInfo(selectedPlayer, animId, true, "bang")
    hookTargetRespawn(selectedPlayer)
    local ok, w = pcall(function() return WeldTo(tr, animId, false) end)
    if ok and w then
        CurrentWeld = w; startThrust(); sSuccess(); screenFlash(T.Accent); burst(main, T.Accent, 14)
        notify("RED HUB", "💥 Bang → " .. selectedPlayer.Name)
    end
end

local function runFBang(animId, speed, rangeOverride, isAggressive, wType)
    if not selectedPlayer or not selectedPlayer.Character then return end
    stopEverything()
    CurrentTarget = selectedPlayer
    local head = selectedPlayer.Character:FindFirstChild("Head")
    if not head then return end
    V.X = 0; V.Y = 2.5; V.Z = -1.5
    V.RX, V.RY, V.RZ = 0, 180, 0
    startThrust(-4.0, -0.4)
    if speed then ThrustSpeed = speed end
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    storeWeldInfo(selectedPlayer, animId, true, wType or "fbang")
    hookTargetRespawn(selectedPlayer)
    local ok, w = pcall(function() return WeldTo(head, animId, false) end)
    if ok and w then
        CurrentWeld = w; sSuccess()
        screenFlash(isAggressive and T.Pink or T.Accent)
        burst(main, isAggressive and T.Pink or T.Accent, 16)
        notify("RED HUB", "💦 Face Bang → " .. selectedPlayer.Name)
    end
end

local runBangAggressive, runFBangAggressive
runBangAggressive = function()
    if not isR15(LP) then runBang(ANIM.BANG_DEFAULT, 2.2)
    else runBang(ANIM.BANG_AGGR, 5.0, 1.2) end
    LastWeldType = "bangagg"
end
runFBangAggressive = function()
    if not isR15(LP) then runFBang(ANIM.BANG_DEFAULT, 2.2, nil, false, "fbang")
    else runFBang(ANIM.BANG_AGGR, 5.5, 1.0, true, "fbangagg") end
    LastWeldType = "fbangagg"
end

performAutoReweld = function(targetPlr, reasonText)
    if not AutoReweldEnabled or not targetPlr or not targetPlr.Character then return end
    if LastWeldType == "fbangagg" then task.wait(0.5); runFBangAggressive(); return end
    if LastWeldType == "bangagg" then task.wait(0.5); runBangAggressive(); return end
    local th = targetPlr.Character:FindFirstChildOfClass("Humanoid")
    if not th then return end
    local tr = ((th.RigType == Enum.HumanoidRigType.R15)
        and targetPlr.Character:FindFirstChild("UpperTorso")
        or  targetPlr.Character:FindFirstChild("Torso")
        or  targetPlr.Character:FindFirstChild("HumanoidRootPart"))
    if not tr then return end
    stopEverything()
    CurrentTarget = targetPlr; selectedPlayer = targetPlr
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    local ok, w = pcall(function() return WeldTo(tr, LastWeldAnimId, AnimCopyEnabled) end)
    if ok and w then
        CurrentWeld = w
        if LastWeldWasThrust then startThrust() end
        sSuccess(); notify("RED HUB", (reasonText or "Auto re-weld") .. " → " .. targetPlr.Name)
    end
end

