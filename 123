local function startThrust(customMin, customMax)
    stopThrust()
    ThrustActive = true
    if customMin and customMax then
        IsCustomZThrust = true
        ThrustZMin = customMin; ThrustZMax = customMax
    end
    local t0 = tick()
    ThrustConn = RunService.Heartbeat:Connect(function()
        if not ThrustActive then return end
        local elapsed = tick() - t0
        local phase = (math.sin(elapsed * ThrustSpeed * math.pi * 2) + 1) / 2
        if IsCustomZThrust then
            V.Z = ThrustZMin + phase * (ThrustZMax - ThrustZMin)
        else
            V.Z = ThrustTouchZ + ThrustDirection * phase * ThrustRange
        end
    end)
end

local function startMotion(mode)
    stopMotion()
    MotionMode = mode
    local t0 = tick()
    MotionConn = RunService.Heartbeat:Connect(function()
        if MotionMode == "none" then return end
        local t = tick() - t0
        if MotionMode == "orbit" then
            local angle = t * OrbitSpeed * math.pi * 2
            V.X = math.cos(angle) * OrbitRadius
            V.Z = math.sin(angle) * OrbitRadius
            V.Y = 0
        elseif MotionMode == "bounce" then
            V.Y = math.abs(math.sin(t * BounceSpeed * math.pi)) * BounceHeight
        elseif MotionMode == "suck" then
            local p = math.min(t / SuckDuration, 1)
            V.Z = 8 - (8 - 1.0) * p
            if p >= 1 then stopMotion() end
        end
    end)
end

local function startCopying(tp)
    stopCopying()
    if not tp or not AnimCopyEnabled then return end
    if getRig(LP) ~= getRig(tp) then return end
    local tc, mc = tp.Character, LP.Character
    if not tc or not mc then return end
    local tH = tc:FindFirstChildOfClass("Humanoid")
    local mH = mc:FindFirstChildOfClass("Humanoid")
    if not tH or not mH then return end
    local tA = tH:FindFirstChildOfClass("Animator")
    local mA = mH:FindFirstChildOfClass("Animator")
    if not tA or not mA then return end
    for _, track in ipairs(tA:GetPlayingAnimationTracks()) do
        local ok, nt = pcall(function()
            local a = Instance.new("Animation")
            a.AnimationId = track.Animation.AnimationId
            local t = mA:LoadAnimation(a)
            t:AdjustSpeed(V.Speed); t:Play(track.TimePosition or 0)
            return t
        end)
        if ok and nt then table.insert(CopiedTracks, nt) end
    end
    AnimCopyConn = tA.AnimationPlayed:Connect(function(track)
        if not AnimCopyEnabled then return end
        for _, t in ipairs(CopiedTracks) do pcall(function() t:Stop() end) end
        CopiedTracks = {}
        local ok, nt = pcall(function()
            local a = Instance.new("Animation")
            a.AnimationId = track.Animation.AnimationId
            local t = mA:LoadAnimation(a); t:AdjustSpeed(V.Speed); t:Play(0); return t
        end)
        if ok and nt then table.insert(CopiedTracks, nt) end
    end)
end

local function updateCopySpeed()
    for _, t in ipairs(CopiedTracks) do pcall(function() t:AdjustSpeed(V.Speed) end) end
end

local function loadAnim(char, id, speed, loop)
    if not char or not id then return nil end
    local animator = char:FindFirstChildWhichIsA("Animator", true)
    if not animator then return nil end
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://" .. tostring(id)
    local ok, tr = pcall(function() return animator:LoadAnimation(a) end)
    if ok and tr then
        pcall(function()
            tr:AdjustSpeed(speed or 1)
            tr.Looped = loop ~= false
            tr:Play()
        end)
        table.insert(PlayedAnims, tr)
        return tr
    end
    return nil
end

-- ═══════════ WELD ═══════════
local function WeldTo(TPart, AnimId, UseCopy)
    local char = LP.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return nil end
    stopAllMyAnims()
    if UseCopy then
        startCopying(CurrentTarget)
    elseif AnimId and AnimId ~= 0 then
        stopCopying()
        loadAnim(char, AnimId, V.Speed)
    end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false; p.Massless = true
        end
    end
    local Weld = {}; local conn
    conn = RunService.Heartbeat:Connect(function()
        if not char.Parent or not TPart.Parent then
            if Weld.Destroy then Weld:Destroy() end
            return
        end
        local offset = CFrame.new(V.X, V.Y, V.Z)
            * CFrame.Angles(math.rad(V.RX), math.rad(V.RY), math.rad(V.RZ))
        root.CFrame = TPart.CFrame * offset
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if sethiddenproperty then
            pcall(function()
                sethiddenproperty(root, "PhysicsRepRootPart", TPart)
                if InstanceHandleNew then
                    sethiddenproperty(root, "PhysicsRepRootRef", InstanceHandleNew(TPart))
                end
            end)
        end
    end)
    function Weld:Destroy()
        if conn then conn:Disconnect(); conn = nil end
        stopCopying(); stopAllMyAnims(); stopThrust(); stopMotion(); resetArms()
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    return Weld
end

