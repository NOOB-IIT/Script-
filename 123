local function makeSlider(parent, order, label, minV, maxV, defV, onChange)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1,0,0,34); row.BackgroundColor3 = T.Panel
    row.BorderSizePixel = 0; row.LayoutOrder = order
    row.ClipsDescendants = true; row.ZIndex = 7; row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0,7)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0,32,1,0); lbl.Position = UDim2.new(0,8,0,0)
    lbl.BackgroundTransparency = 1; lbl.Text = label
    lbl.TextColor3 = T.Text; lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11; lbl.ZIndex = 8; lbl.Parent = row

    local bg = Instance.new("TextButton")
    bg.Size = UDim2.new(1,-100,0,8); bg.Position = UDim2.new(0,44,0.5,-4)
    bg.BackgroundColor3 = T.PanelLt; bg.Text = ""; bg.AutoButtonColor = false
    bg.ZIndex = 8; bg.Parent = row
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0,0,1,0); fill.BackgroundColor3 = T.Accent
    fill.BorderSizePixel = 0; fill.ZIndex = 9; fill.Parent = bg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1,0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0,18,0,18); knob.Position = UDim2.new(0,-9,0.5,-9)
    knob.BackgroundColor3 = Color3.new(1,1,1); knob.BorderSizePixel = 0
    knob.ZIndex = 10; knob.Parent = bg
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1,0)
    local knobStroke = Instance.new("UIStroke")
    knobStroke.Color = T.Accent; knobStroke.Thickness = 2; knobStroke.Parent = knob

    local vb = Instance.new("TextBox")
    vb.Size = UDim2.new(0,50,0,24); vb.Position = UDim2.new(1,-54,0.5,-12)
    vb.BackgroundColor3 = T.PanelLt; vb.Text = tostring(defV)
    vb.TextColor3 = T.Text; vb.Font = Enum.Font.Gotham; vb.TextSize = 11
    vb.ClearTextOnFocus = false; vb.ZIndex = 8; vb.Parent = row
    Instance.new("UICorner", vb).CornerRadius = UDim.new(0,4)

    local cur = defV
    local function setVal(v, fire)
        v = math.clamp(v, minV, maxV); cur = v
        vb.Text = tostring(math.floor(v*100+0.5)/100)
        local pct = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -9, 0.5, -9)
        if fire and onChange then onChange(v) end
    end
    local drag = false
    local function upd(inp)
        local rX = inp.Position.X - bg.AbsolutePosition.X
        local pct = math.clamp(rX / bg.AbsoluteSize.X, 0, 1)
        setVal(minV + pct * (maxV - minV), true)
    end
    bg.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            drag = true; upd(inp); sHover()
        end
    end)
    bg.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
            upd(inp)
        end
    end)
    vb.FocusLost:Connect(function()
        local n = tonumber(vb.Text)
        if n then setVal(n, true); sClick() else setVal(cur, false) end
    end)
    setVal(defV, false)
    return { set = setVal, get = function() return cur end }
end

