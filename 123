local function jumpscarePlayer()
    if not selectedPlayer or not selectedPlayer.Character then return end
    local head = selectedPlayer.Character:FindFirstChild("Head"); if not head then return end
    local myChar = LP.Character; if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart"); if not myRoot then return end
    local origCF = myRoot.CFrame
    stopEverything()
    CurrentTarget = selectedPlayer
    V.X = 0; V.Y = -getHeadHeight(LP.Character); V.Z = -1.0; V.RX, V.RY, V.RZ = 0, 0, 0
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    sScream()
    local ok, w = pcall(function() return WeldTo(head, ANIM.BANG_AGGR, false) end)
    if ok and w then
        CurrentWeld = w
        for _, t in ipairs(PlayedAnims) do pcall(function() t:AdjustSpeed(2.5) end) end
        screenFlash(Color3.fromRGB(255, 0, 0)); shake(main, 10)
        notify("RED HUB", "😱 JUMPSCARED → " .. selectedPlayer.Name); sSuccess()
        task.delay(1.5, function()
            if CurrentWeld then CurrentWeld:Destroy(); CurrentWeld = nil end
            pcall(function() myRoot.CFrame = origCF end)
            notify("RED HUB", "⚡ Snapped back!")
        end)
    end
end

