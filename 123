    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    storeWeldInfo(selectedPlayer, 0, false, "follow")
    hookTargetRespawn(selectedPlayer)
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not char.Parent or not tc.Parent then if conn then conn:Disconnect() end return end
        if tHum then hum.WalkSpeed = tHum.WalkSpeed else hum.WalkSpeed = 16 end
        local targetCF = tr.CFrame * CFrame.new(0, 0, 3)
        root.CFrame = root.CFrame:Lerp(targetCF, 0.2)
    end)
    local Weld = {}
    function Weld:Destroy()
        if conn then conn:Disconnect(); conn = nil end
        hum.WalkSpeed = 16
    end
    CurrentWeld = Weld
    sSuccess(); notify("RED HUB", "👣 Following " .. selectedPlayer.Name)
end

