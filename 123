-- ═══════════ ARM OVERRIDE ═══════════
local function raiseArms(char, pitch)
    pitch = pitch or math.rad(-80)
    if not char then return end
    if ArmOverride then
        pcall(function()
            if ArmOverride.rShoulder and ArmOverride.rShoulder.Parent then ArmOverride.rShoulder.C0 = ArmOverride.rC0 end
            if ArmOverride.lShoulder and ArmOverride.lShoulder.Parent then ArmOverride.lShoulder.C0 = ArmOverride.lC0 end
        end)
        ArmOverride = nil
    end
    local saved = {}
    local rUpper = char:FindFirstChild("RightUpperArm")
    local lUpper = char:FindFirstChild("LeftUpperArm")
    if rUpper and lUpper then
        local rSh = rUpper:FindFirstChild("RightShoulder")
        local lSh = lUpper:FindFirstChild("LeftShoulder")
        if rSh and lSh then
            saved.rShoulder, saved.lShoulder = rSh, lSh
            saved.rC0, saved.lC0 = rSh.C0, lSh.C0
            rSh.C0 = CFrame.new(rSh.C0.Position) * CFrame.Angles(pitch, 0, 0)
            lSh.C0 = CFrame.new(lSh.C0.Position) * CFrame.Angles(pitch, 0, 0)
            ArmOverride = saved
            return
        end
    end
    local torso = char:FindFirstChild("Torso")
    if torso then
        local rSh = torso:FindFirstChild("Right Shoulder")
        local lSh = torso:FindFirstChild("Left Shoulder")
        if rSh and lSh then
            saved.rShoulder, saved.lShoulder = rSh, lSh
            saved.rC0, saved.lC0 = rSh.C0, lSh.C0
            rSh.C0 = CFrame.new(rSh.C0.Position) * CFrame.Angles(pitch, 0, 0)
            lSh.C0 = CFrame.new(lSh.C0.Position) * CFrame.Angles(pitch, 0, 0)
            ArmOverride = saved
        end
    end
end

local function resetArms()
    if ArmOverride then
        pcall(function()
            if ArmOverride.rShoulder and ArmOverride.rShoulder.Parent then ArmOverride.rShoulder.C0 = ArmOverride.rC0 end
            if ArmOverride.lShoulder and ArmOverride.lShoulder.Parent then ArmOverride.lShoulder.C0 = ArmOverride.lC0 end
        end)
        ArmOverride = nil
    end
end

