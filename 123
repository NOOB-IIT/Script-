local function activateNebula(duration)
    if not selectedPlayer or not selectedPlayer.Character then
        notify("RED HUB", "Select player first"); sError(); return
    end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local targetHrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetHrp then return end

    stopEverything(true)
    CurrentTarget = selectedPlayer
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    pcall(function() targetHrp:SetNetworkOwner(LP) end)
    storeWeldInfo(selectedPlayer, 0, false, "weld")
    hookTargetRespawn(selectedPlayer)

    NebulaActive = true
    NebulaHrp = hrp
    NebulaStartCF = hrp.CFrame
    NebulaUnlimited = (duration == nil)
    NebulaEndTime = duration and (tick() + duration) or 0

    local statusLabel = createNebulaPanel(duration or 0, NebulaUnlimited)

    NebulaConn = RunService.Heartbeat:Connect(function()
        if not NebulaActive then return end
        if not char.Parent or not targetHrp.Parent then stopNebula(); return end
        if not NebulaUnlimited and tick() >= NebulaEndTime then
            stopNebula(); notify("RED HUB", "✨ Nebula Fling Finished!"); return
        end
        local t = tick() * 20
        local orbitDist = 3.5
        local offsetX = math.cos(t) * orbitDist
        local offsetZ = math.sin(t) * orbitDist
        hrp.CFrame = targetHrp.CFrame
            * CFrame.new(offsetX, 2, offsetZ)
            * CFrame.Angles(math.random(-10,10), t, math.random(-10,10))
        hrp.AssemblyLinearVelocity = Vector3.new(math.random(-4000,4000), math.random(3000,6000), math.random(-4000,4000))
        hrp.AssemblyAngularVelocity = Vector3.new(math.random(-500,500), math.random(-500,500), math.random(-500,500))
        if statusLabel and statusLabel.Parent and not NebulaUnlimited then
            local rem = math.max(0, math.floor(NebulaEndTime - tick()))
            statusLabel.Text = "⏱ " .. rem .. "s remaining"
        end
    end)

    sSuccess()
    notify("RED HUB", "✨ Nebula Fling (" .. (duration and (duration .. "s") or "Unlimited") .. ") → " .. selectedPlayer.Name)
end

