    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            if q == "" or p.Name:lower():sub(1,#q) == q or p.DisplayName:lower():sub(1,#q) == q then
                table.insert(list, p)
            end
        end
    end
    return list
end

local function refreshList()
    for _, c in ipairs(listScroll:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
    local plrs = findPlayers(searchBox.Text)
    if #plrs == 0 then
        local e = Instance.new("TextLabel")
        e.Size = UDim2.new(1,0,0,30); e.BackgroundTransparency = 1
        e.Text = "No players online"; e.TextColor3 = T.Muted
        e.Font = Enum.Font.Gotham; e.TextSize = 11
        e.LayoutOrder = 1; e.ZIndex = 9; e.Parent = listScroll
        return
    end
    for i, p in ipairs(plrs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1,-6,0,32)
        btn.BackgroundColor3 = (selectedPlayer == p) and T.Accent or T.PanelLt
        btn.Text = ""; btn.AutoButtonColor = false
        btn.LayoutOrder = i; btn.ZIndex = 9
        btn.ClipsDescendants = true; btn.Parent = listScroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
        styleBtn(btn, (selectedPlayer == p) and T.Accent or T.PanelLt)

        local av = Instance.new("ImageLabel")
        av.Size = UDim2.new(0,24,0,24); av.Position = UDim2.new(0,4,0.5,-12)
        av.BackgroundColor3 = T.Panel
        av.Image = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=48&h=48"
        av.ZIndex = 10; av.Parent = btn
        Instance.new("UICorner", av).CornerRadius = UDim.new(1,0)

        local nm = Instance.new("TextLabel")
        nm.Size = UDim2.new(1,-36,1,0); nm.Position = UDim2.new(0,32,0,0)
        nm.BackgroundTransparency = 1
        nm.Text = p.Name .. (p.DisplayName ~= p.Name and (" (" .. p.DisplayName .. ")") or "")
        nm.TextColor3 = Color3.new(1,1,1); nm.Font = Enum.Font.GothamBold
        nm.TextSize = 11; nm.TextXAlignment = Enum.TextXAlignment.Left
        nm.ZIndex = 10; nm.Parent = btn

        btn.MouseButton1Click:Connect(function()
            selectedPlayer = p
            footerLabel.Text = "👤 " .. p.Name
            footerSub.Text = "Tap WELD"
            sClick(); refreshList()
        end)
    end
end

pcall(function() refreshList() end)
searchBox:GetPropertyChangedSignal("Text"):Connect(function() pcall(refreshList) end)

Players.PlayerAdded:Connect(function(p)
    task.wait(0.5)
    pcall(refreshList)
    if AutoReweldEnabled and LastWeldTargetUserId and p.UserId == LastWeldTargetUserId then
        task.wait(1.5)
        if not p.Character then return end
        selectedPlayer = p
        footerLabel.Text = "👤 " .. p.Name
        footerSub.Text = "Rejoined — re-welding..."
        if performAutoReweld then performAutoReweld(p, "Rejoin re-weld") end
        hookTargetRespawn(p)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if selectedPlayer == p then
        if AutoReweldEnabled and LastWeldTargetUserId == p.UserId then
            footerLabel.Text = "👤 " .. p.Name .. " (left)"
            footerSub.Text = "⏳ Waiting for rejoin..."
            stopEverything()
        else
            selectedPlayer = nil
            footerLabel.Text = "👤 No player selected"
            footerSub.Text = "Select a player to begin"
        end
    end
    task.wait(0.1); pcall(refreshList)
end)

