local function stareAtPlayer()
    if not selectedPlayer or not selectedPlayer.Character then return end
    stopEverything()
    CurrentTarget = selectedPlayer
    local tc = selectedPlayer.Character
    local tr = tc:FindFirstChild("HumanoidRootPart")
    if not tr then return end
    V.X = 0; V.Y = 0; V.Z = -2.5; V.RX, V.RY, V.RZ = 0, 0, 0
    pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)
    storeWeldInfo(selectedPlayer, 0, false, "stare"); hookTargetRespawn(selectedPlayer)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not char.Parent or not tc.Parent then if conn then conn:Disconnect() end return end
        root.CFrame = CFrame.new(tr.Position + tr.CFrame.LookVector * 2.5, tr.Position)
        root.AssemblyLinearVelocity = Vector3.zero
